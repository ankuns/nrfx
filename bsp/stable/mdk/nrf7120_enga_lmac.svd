                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Main</name>
                  <description>Main mode. IN_XO_SIN or IN_XC2_INT depending on SELECT register</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
