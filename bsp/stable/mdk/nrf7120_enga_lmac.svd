                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BLE2m</name>
                    <description>Radio mode BLE2M is used</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
