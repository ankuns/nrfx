                <lsb>30</lsb>
                <msb>30</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Valid</name>
                    <description>VBUS is valid, and the pull up resistor on D+ is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NotValid</name>
                    <description>VBUS is not valid, and the pull up resistor on D+ is disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ID</name>
                <description>Overrides OTG ID pin signal</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>BISTOVERRIDE</name>
