            <field>
              <name>CLOCKSWITCHSTATE</name>
              <description>The state of the clock switching state machine</description>
              <lsb>8</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>UNITRIGCALSTATE</name>
