                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SENDSTALL</name>
                  <description>Send a STALL handshake on a nonzero-length status OUT transaction and do not send the received OUT packet to the application</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
