                <enumeratedValues>
                  <enumeratedValue>
                    <name>None</name>
                    <description>Nothing selected.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Vref</name>
                    <description>Voltage reference output. Approximately 0.76V</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>V1v5Reg</name>
                    <description>1.5V regulator output voltage.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>V0V8Reg</name>
                    <description>0.8V regulator output voltage.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VPierce</name>
                    <description>IPIERCE voltage. XO core imminent supply voltage.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SELMUX1</name>
                <description>Test mux control for ATB1.</description>
                <lsb>3</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>None</name>
                    <description>Nothing selected.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VAteg</name>
                    <description>AREG block test voltage. Xo level dependent.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VChirp</name>
                    <description>Chirp generator test voltage.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VTS</name>
                    <description>Temp Sensor test voltage.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VGnd</name>
                    <description>Connected to XO VSS/ground. Use as reference voltage for GND.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>EN</name>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Analog test busses are disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Analog test busses are enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
