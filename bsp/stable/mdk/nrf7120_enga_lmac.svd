          <register>
            <name>CFGCORECTRL</name>
            <description>Configuration register for 0010_AXON</description>
            <addressOffset>0x074</addressOffset>
            <access>read-write</access>
            <resetValue>0x02000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGSOFTRESET</name>
                <description>Active high soft reset of the AXON IP. Does not reset configuration registers. Reset is performed asynchronously. Deassertion of reset is synchronoush and only takes a few cycles to propagate through synchrnonizers. Should be used to recover from any error interrupt by performing soft reset, then clearing all interrupts then retrying all descriptor batch.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORMALOPERATION</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RESET</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGMASTERDMAMODE</name>
                <description>Master DMA mode setting.</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PERFORMANCE</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LEGACY</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BOTH</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGCOREDISABLE</name>
                <description>Active high clock gating. Does not gate off clock to LBI configuration registers to avoid lockup. This can be used to measure AXON leakage power in silicon when clocks are disabled.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLOCKENABLED</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLOCKDISABLED</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGSTEPEN</name>
                <description>set 1 to enable FW to step each descriptor processed by triggering req_new_cmd_ready. set 0 so no FW involvement is needed per descriptor.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>CFGWATCHDOGENHREADY</name>
                <description>set 1 to enable watchdog timer for receiving hready on AHB master port. set 0 to disable watchdog timer.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>CFGWATCHDOGENCMD</name>
                <description>set 1 to enable watchdog timer for processing each command. set 0 to disable watchdog timer.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>CFGWATCHDOGENDESC</name>
                <description>set 1 to enable watchdog timer for processing all the descriptors. set 0 to disable watchdog timer.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CFGMAXAHBBURST</name>
                <description>Specifies the maximum allowed burst size on the master AHB port.</description>
                <lsb>24</lsb>
                <msb>25</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NONE</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FOURBEATS</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EIGHTBEATS</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SIXTEENBEATS</name>
                    <description>Unspecified</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGSTOPONERR</name>
                <description>set 1, AXON will stop when an error is detected for FW to perform a sw reset using cfg_soft_reset. When 0, AXON statemachine will keep going when an error is detected.</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGSLEEPCTRL</name>
