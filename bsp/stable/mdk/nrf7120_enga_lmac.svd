                </field>
                <field>
                  <name>TRIMCOMPENSATIONTHRESHOLD</name>
                  <description>Threshold for enabling trim compenastion. Trim compensation actived when measured cycles are below the threshold.</description>
                  <lsb>24</lsb>
                  <msb>27</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>T132</name>
                      <description>Threshold at 132 cycles (~0.75  percent)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T131</name>
                      <description>Threshold at 131 cycles (~1.5  percent)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T117</name>
                      <description>Threshold at 117 cycles (~12  percent)</description>
                      <value>0xF</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TRIMCOMPENSATIONVALUE</name>
                  <description>Trim compensation when deviation larger than TRIMCOMPENSATIONTHRESHOLD is detected.</description>
                  <lsb>28</lsb>
                  <msb>30</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
