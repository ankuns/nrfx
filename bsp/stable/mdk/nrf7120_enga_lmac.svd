                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>U</name>
                <description>NFCID1 byte U</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>T</name>
                <description>NFCID1 byte T</description>
