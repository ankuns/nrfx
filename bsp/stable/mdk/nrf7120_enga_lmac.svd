            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VDD</name>
                <description>Mask VDD</description>
                <lsb>0</lsb>
                <msb>0</msb>
