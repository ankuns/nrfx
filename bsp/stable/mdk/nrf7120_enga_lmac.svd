          <register>
            <name>PCNF1</name>
            <description>Packet configuration register 1</description>
            <addressOffset>0x028</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MAXLEN</name>
                <description>Maximum length of packet payload. If the packet payload is larger than MAXLEN, the radio will truncate the payload to MAXLEN.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>STATLEN</name>
                <description>Static length in number of bytes</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>BALEN</name>
                <description>Base address length in number of bytes</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>STATLENLONG</name>
                <description>Experimental option to add additional length to the payload. Concatenated as MSBs with STATLEN</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>PREAMBLEEXTEND</name>
                <description>Extra bit to enable longer preambles. Length is PREAMBLEEXTEND,PCNF0.PLEN bytes + 8bits (or 4bits for LR and 15.4)</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>ENDIAN</name>
                <description>On-air endianness of packet, this applies to the S0, LENGTH, S1, and the PAYLOAD fields.</description>
                <lsb>24</lsb>
                <msb>24</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Little</name>
                    <description>Least significant bit on air first</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Big</name>
                    <description>Most significant bit on air first</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WHITEEN</name>
                <description>Enable or disable packet whitening</description>
                <lsb>25</lsb>
                <msb>25</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WHITEOFFSET</name>
                <description>If whitening is enabled S0 can be configured to be excluded from whitening</description>
                <lsb>26</lsb>
                <msb>26</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Include</name>
                    <description>S0 included in whitening</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Exclude</name>
                    <description>S0 excluded from whitening</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>REPEATPAYLOAD</name>
                <description>Used to repeat payload content in Tx mode. Transmits PREAMBLE, ADDRESS once, but S0, LENGTH, S1 field size must be set to 0 to avoid repeating those as well</description>
                <lsb>28</lsb>
                <msb>28</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXFROMRAM</name>
                <description>Used to bypass PREAMBLE, ADDRESS, S0, LENGTH, S1 field and go straight to PAYLOAD state</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Bypass</name>
                    <description>Bypass</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
