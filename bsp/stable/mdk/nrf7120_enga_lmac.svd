          <fields>
            <field>
              <name>VAL</name>
              <description>Voltage value when HVBUCK in UPSCALE state. Note: Reset value of this register is 0x00 and proper value must be written before releasing HVBUCK from forced HP mode.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PULLDOWNTIMER</name>
          <description>Timer for pull down resistor enable</description>
          <addressOffset>0x424</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Pull Down enable time: from 350 to 1342us with 32us step</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITHRESHOLD</name>
          <description>Current threshold for HP mode</description>
          <addressOffset>0x428</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000000A</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Threshold value in mA</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>IHYSTERESIS</name>
          <description>Hysteres to switch back to LP mode</description>
          <addressOffset>0x42C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Hysteresis value in mA</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PWRUPCTRL</name>
          <description>Powerup control</description>
          <addressOffset>0x430</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>0: Auto
1: Power up
2: Power down</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MODECTRL</name>
          <description>Buck mode control</description>
          <addressOffset>0x434</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>0: Auto
1: LP hyst
2: HP hyst
3: PWM</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>UPSCALE2OFFSET</name>
          <description>PWM Vout offset in PWM_UPSCALE2 state</description>
          <addressOffset>0x43C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Output voltage in PWM_UPSCALE2 state is determined by equation 1.1V + TRIM.VOUTPWM + UPSCALE2OFFSET. For example TRIM.VOUTPWM can contain -96mV offset and UPSCALE2OFFSET +96mV. This would results 1.04V in PWM state and 1.1V in PWM_UPSCALE2 state.</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PULLDOWNCTRL</name>
          <description>Pull down resistor control</description>
          <addressOffset>0x440</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>0: Auto
1: On
2: Off
3 Not used</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>UPSCALE2RAMPTIME</name>
          <description>Number of clock cycles to ramp to upscale2Offset</description>
          <addressOffset>0x444</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>if upscale2Offset &amp;gt; upscale2RampTime, upscale2RampTime is set equal to upscale2Offset internally.</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>UPSCALE1VDETDELAY</name>
          <description>Number of clock cycles to wait before give ackUpscale1</description>
          <addressOffset>0x448</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>UPSCALE2VDETDELAY</name>
