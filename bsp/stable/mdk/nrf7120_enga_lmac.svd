                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TXRTUNE</name>
                    <description>The TXRTUNE pin, external resistor REXT, and resulting internal
              digital calibration code are used for tuning the high-speed source
              impedance.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RTUNE</name>
                    <description>The RCALCODE value is used for tuning the high-speed source impedance.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RCALCODE</name>
                <description>This signal is used to tune the internal 200 ohm resistor or the USBHS DP and DM high-speed source impedance.</description>
                <lsb>1</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
