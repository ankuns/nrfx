                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SYMSBEFORESFD</name>
                <description>Number of preamble symbols before SFD to match, by default 2 symbols.</description>
                <lsb>24</lsb>
                <msb>26</msb>
              </field>
