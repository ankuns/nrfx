                </enumeratedValue>
                <enumeratedValue>
                  <name>EnablePageErase</name>
                  <description>Erase page and read are allowed</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EnableWordErase</name>
                  <description>Erase word and read are allowed</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DISABLEECC</name>
              <description>Disable ECC. It is enabled by default</description>
              <lsb>8</lsb>
              <msb>8</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EnableECC</name>
                  <description>Enable ECC</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DisableECC</name>
                  <description>Disable ECC</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTOREADMODE</name>
          <description>Automatically disables the write and erases on timeout and 
      enters into read mode.</description>
          <addressOffset>0x504</addressOffset>
