                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bypass</name>
                  <description>Bypass through majority vote</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SOFTBITMODE</name>
              <description>Method used for the softbit calulation</description>
              <lsb>8</lsb>
              <msb>9</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Max</name>
                  <description>Softbit calculation in MFB uses the maximum</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Sum</name>
                  <description>Softbit calculation in MFB uses the sum</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WSum1</name>
                  <description>Softbit calculation in MFB uses the weighted sum 1</description>
