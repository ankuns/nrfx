    <peripheral>
      <name>GLOBAL_GRTC</name>
      <description>Global Real-time counter</description>
      <baseAddress>0x500E2000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <!--Split access-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
