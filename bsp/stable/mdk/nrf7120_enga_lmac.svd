                <description>Override VDETAO0V8_BOD_AO_0V8, VDETAO0V8_BOD_AO_1V8 and VDETAO0V8_PGD_AO_0V8 to 0</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SETTLEDMBIASIBPSRFORECE0</name>
                <description>Force the SETTLED_MBIAS_IBPSR_BUF_AO_1V8 connected to the control logic to 0.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>PGDCOMPARATOR</name>
                <description>If bit TCFG.OVERRIDEN is one, this bit will directly control the internal power-up or power-down the PGD comparator.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>BODCOMPARATOR</name>
                <description>If bit TCFG.OVERRIDEN is one, this bit will directly control power-up or power-down the BOD comparator.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>BODCOMPARATOR1UA</name>
                <description>If bit TCFG.OVERRIDEN is one, this bit will directly control power-up or power-down the BOD comparator 500nA bias.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>LOCKBOD</name>
                <description>Lock the BOD deglitch logic when TCFG.OVERRIDEN is one. No effect when bit TCFG.OVERRIDEN is 0.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>OVERRIDEN</name>
                <description>Override of the internal logic to change the power-up and power-down of internal blocks independently.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>DISCONNECTSENSE</name>
                <description>Disconnect the sense line of the comparator and short-circuit both inputs of the comparator to vref.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
