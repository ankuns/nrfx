          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RADIOMODEINT</name>
              <description>Internal radio mode consists of sSel, zeroIf, deModN and mode[3:0]</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>USERADIOMODEINT</name>
              <description>0: use radioMode/radioModeUpdate from port (controlled from top), 1: use radioMode/radioModeUpdate from registers in this IP</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DEBUGRADIOPHY</name>
          <description>Debug for radio PHY</description>
          <addressOffset>0x7FC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000100</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>BUFFEREDTXPWR</name>
              <description>Set to high to buffer TXPOWER so that sub-modules in the MMI will only update next tx power config at TX_EN, RX_EN and LB_EN. Set to low if special test is needed for Tx test.</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>TIEADCBITOZERO</name>
              <description>0: output normal adcBinaryBI, 1: tie adcBinaryBI to zero</description>
              <lsb>9</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>TIEADCBQTOZERO</name>
              <description>0: output normal adcBinaryBQ, 1: tie adcBinaryBQ to zero</description>
              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>CALINVERTCODE</name>
              <description>1: Invert all calibration codes</description>
              <lsb>11</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>USEMODEDEPENDENTTDELTA</name>
              <description>1: use TDELTAPIPE and TDELTAPWRDNPA from MODEDEPENDENT register instead of TIMINGTX2</description>
              <lsb>13</lsb>
              <msb>13</msb>
            </field>
          </fields>
