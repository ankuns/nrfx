        <cluster>
          <name>RXAGC</name>
          <description>Unspecified</description>
          <headerStructName>RADIO_RXAGC</headerStructName>
          <access>read-write</access>
          <addressOffset>0x7D0</addressOffset>
          <register>
            <name>GAIN</name>
            <description>Gain boundary settings and gain steps</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x11091107</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCRFGAINMAX</name>
                <description>Maximum gain of RF gain</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>AGCRFGAINMIN</name>
                <description>Minimum gain of RF gain</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>AGCRFGAINSTEPUP</name>
                <description>gain step for increasing RF gain</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>AGCRFGAINSTEPDOWN</name>
                <description>gain step for decreasing RF gain</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>AGCIFGAINMAX</name>
                <description>Maximum gain of IF gain</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>AGCIFGAINMIN</name>
                <description>Minimum gain of IF gain</description>
                <lsb>20</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>AGCIFGAINSTEPUP</name>
                <description>gain step for increasing IF gain</description>
                <lsb>24</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>AGCIFGAINSTEPDOWN</name>
                <description>gain step for decreasing IF gain</description>
                <lsb>28</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>Configuration to adjust gain control loop</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x001230C3</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCENABLEGAINSWITCH</name>
                <description>Causes the RF gain to be decreased and the IF gain to be increased if the overall gain can be maintained</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>AGCRFPKDETRESETCOUNT</name>
                <description>The number of clock cycles after the adjustment of gain that the reset signal to the RF peak detector is set high</description>
                <lsb>1</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>AGCWAIT</name>
                <description>The number of clock cycles between each adjustment of the gain while addressMatch is low</description>
                <lsb>5</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>AGCWAITPACKET</name>
                <description>The number of clock cycles between each adjustment of the gain while addressMatch is high</description>
                <lsb>11</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>AGCAAFOVERRIDE</name>
                <description>Override value for aafGain</description>
                <lsb>17</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>AGCMIXOVERRIDE</name>
                <description>Override value for mixGain</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>AGCLNAOVERRIDE</name>
                <description>Override value for lnaGain</description>
                <lsb>22</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>AGCOVERRIDEGAIN</name>
                <description>0: AGC takes control of all gains, 1: Control all gains (aafGain, mixGain, lnaGain) from registers</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>AGCTOGGLE</name>
                <description>Enable(1) or disable(0) functional testmode for AGC</description>
                <lsb>29</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>AGCENABLEGAINREVERT</name>
                <description>Gain reversion. 0: reduce IF gain before RF gain, 1: reduce RF gain before IF gain.</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CALIBRATION</name>
            <description>Calibrate RSSI and Energy Detect values</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSICAL</name>
                <description>RSSI calibration value (this field affects the value of both RSSISAMPLE and EDSAMPLE)</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>ED154CAL</name>
                <description>802154 Energy Detect calibration value</description>
                <lsb>7</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>Readout latest gain control status</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-only</access>
            <resetValue>0x0000007F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSI</name>
                <description>Raw status of received signal strength indicator, directly from RxAgc without buffering</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>AAFGAIN</name>
                <description>Raw AAF gain status</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>MIXGAIN</name>
                <description>Raw mixer gain status</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LNAGAIN</name>
                <description>Raw LNA gain status</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>RFPKDET</name>
                <description>RF peak detector output after sync. Represent state[5:4] in RxAgc.</description>
                <lsb>24</lsb>
                <msb>25</msb>
              </field>
              <field>
                <name>IFPKDET</name>
                <description>IF peak detector output. Represent state[3:2] in RxAgc.</description>
                <lsb>26</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>BBPKDET</name>
                <description>BB peak detector output. Represent state[1:0] in RxAgc.</description>
                <lsb>28</lsb>
                <msb>29</msb>
              </field>
            </fields>
          </register>
        </cluster>
