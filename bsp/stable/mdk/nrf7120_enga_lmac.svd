            <register>
              <name>DMACR</name>
              <description>DMA Control Register</description>
              <addressOffset>0x04C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>RDMAE</name>
                  <description>Receive DMA Enable. This bit enables/disables the receive FIFO DMA channel.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLE</name>
                      <description>Receive DMA disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>Receive DMA enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TDMAE</name>
                  <description>Transmit DMA Enable. This bit enables/disables the transmit FIFO DMA channel.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLE</name>
                      <description>Transmit DMA disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>Transmit DMA enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>IDMAE</name>
                  <description>Internal DMA Enable. This bit should be enabled only when CTRLR0.FRF = 0 (Motorola SPI) and CTRLR0.SPI_FRF &amp;gt; 0.</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>ATW</name>
                  <description>AXI transfer width for DMA transfers mapped to arsize/awsize. This value must be less than or equal to SSIC_AXI_DW. Values:</description>
                  <lsb>3</lsb>
                  <msb>4</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>RSVDDMACR5</name>
                  <lsb>5</lsb>
                  <msb>5</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AINC</name>
                  <description>Address Increment. Indicates whether to increment the AXI address on every transfer.</description>
                  <lsb>6</lsb>
                  <msb>6</msb>
                  <access>read-only</access>
