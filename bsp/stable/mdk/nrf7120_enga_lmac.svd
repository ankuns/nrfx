              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>IREF</name>
              <description>Calibration control for reference current. IREF is 2s complement, 4.45 percent step size</description>
              <lsb>8</lsb>
              <msb>11</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Max</name>
                  <description>Maximum current (+31.3 percent ish)</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Default current (10uA)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Min</name>
                  <description>Minimum current (-35.6 percent ish)</description>
                  <value>0x8</value>
                </enumeratedValue>
