                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MAG</name>
                <description>Mean magnitude</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IQRAWMEAN</name>
