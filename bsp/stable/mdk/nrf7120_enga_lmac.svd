          <addressOffset>0x0808</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DEVIATION</name>
              <description>Frequency deviation for modulation</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MODRATE</name>
          <description>Select modulation rate</description>
          <addressOffset>0x080C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MODRATE</name>
              <description>Select modulation rate</description>
              <lsb>0</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>250Kbit</name>
                  <description>250 kbps</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>500Kbit</name>
                  <description>500 kbps</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1Mbit</name>
                  <description>1 Mbps</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2Mbit</name>
                  <description>2 Mbps</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4Mbit</name>
                  <description>4 Mbps</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MODFILTERING</name>
          <description>Select gaussian filtering mode</description>
          <addressOffset>0x0810</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MODFILTERING</name>
              <description>Select gaussian filtering mode</description>
              <lsb>0</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No filtering</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1bt00</name>
                  <description>Gfsk Bt=1.00</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt60</name>
                  <description>Gfsk Bt=0.60</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2bt00</name>
                  <description>Gfsk Bt=2.00</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt40</name>
                  <description>Gfsk Bt=0.40</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt45</name>
                  <description>Gfsk Bt=0.45</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt50</name>
                  <description>Gfsk Bt=0.50</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt55</name>
                  <description>Gfsk Bt=0.55</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CUSTOMMODULATION</name>
          <description>Enable reading from memory and passing data over to AdPll</description>
          <addressOffset>0x0814</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable reading from memory and passing data over to AdPll</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Custom modulation disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Custom modulation enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CIRCULARDMA</name>
              <description>If set to 1, the END event of the DMA will trigger the START task in order to transmit the same data over and over again (only works if DmaChannelPeripheral is inside AdPllCompanion)</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSCLOCKSELECT</name>
          <description>Set the clock source for the AdPll digital island</description>
          <addressOffset>0x0818</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>INTERNAL</name>
              <description>Set the clock source for the AdPll digital island when fsStart is high</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>CORE</name>
              <description>Set the clock source for the AdPll digital island when fsStart is low</description>
              <lsb>2</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>STOP</name>
              <description>Force-stopping the clock internally in the AdPll island</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>OVRVAL</name>
              <description>Used instead of 'fsStart' if FSCLOCKSELECT.OVREN is set</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
            <field>
              <name>OVREN</name>
              <description>Override enable for setting the clock switch. If 0, fsStart decides which clock to use. If 1, FSCLOCKSELECT.OVRVAL selects which clock to use</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSUNITRIGCALVAL</name>
          <description>Read the calibrated value for the universal trigger</description>
          <addressOffset>0x081C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FSUNITRIGCALVAL</name>
              <description>Read the calibrated value for the universal trigger</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSUNITRIGMANUAL</name>
