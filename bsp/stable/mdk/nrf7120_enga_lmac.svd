              <name>VREF</name>
              <description>Offset binary coding</description>
              <lsb>0</lsb>
              <msb>5</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Default vref, in typical corner VREF=1.024V</description>
                  <value>0x00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Low output code (high reference voltage)</description>
                  <value>0x3F</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>High output code (low reference voltage)</description>
                  <value>0x00</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VREFLPFDISABLE</name>
