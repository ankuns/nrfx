                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable clock request filter</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
