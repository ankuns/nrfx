          <name>FSFREQFINETUNE</name>
          <description>Allows fine-tuning the RF frequency with a very fine resolution</description>
          <addressOffset>0x0804</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FSFREQFINETUNE</name>
              <description>2-complement number for fine-tuning the frequency in steps of 488.28 Hz</description>
              <lsb>0</lsb>
              <msb>12</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVIATION</name>
