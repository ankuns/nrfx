                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>on</name>
                  <description>IQ RAM select on</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
