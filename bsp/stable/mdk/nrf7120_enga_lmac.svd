              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Classic</name>
                  <description>Use classic demodulator</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ieee154SyncEngine</name>
                  <description>Use IEEE 802.15.4 sync demodulator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SFDMATCHRXSYNC154</name>
              <description>SFD match configuration in RxSyncEngine for improved IEEE 802.15.4</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Use SFD match from RxSyncEngine</description>
                  <value>0x0</value>
