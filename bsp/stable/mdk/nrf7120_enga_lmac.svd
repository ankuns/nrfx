              </field>
              <field>
                <name>LOWTHRES</name>
                <description>Low threshold of IF peak detector. This valued is based on the 11-bits ADC of SPHYNX_ANA.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
