              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>USEMJFB</name>
              <description>Use hard bit from majority vote as the feedback inside the RxMFB. Use hard bit from soft bit generator otherwise.</description>
              <lsb>11</lsb>
              <msb>11</msb>
