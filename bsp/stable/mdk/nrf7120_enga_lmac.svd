                </enumeratedValue>
                <enumeratedValue>
                  <name>2MHz</name>
                  <description>2 MHz IF</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4MHz</name>
                  <description>4 MHz IF</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ADPLLCOMPANIONSTATE</name>
          <description>State in the AdPllCompanion state machines</description>
          <addressOffset>0x0858</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>BUSSCHEDULERSTATE</name>
              <description>The state of the state machine which sends commands automatically at startup</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>BUSMASTERSTATE</name>
