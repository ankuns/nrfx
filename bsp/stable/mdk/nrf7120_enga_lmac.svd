                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T1</name>
                      <description>Compensate with 1 trim step (~1.5  percent)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T7</name>
                      <description>Compensate with 7 trim step (~10.5  percent)</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
