                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2BT00</name>
                  <description>BT=2.00</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0BT40</name>
                  <description>BT=0.40</description>
