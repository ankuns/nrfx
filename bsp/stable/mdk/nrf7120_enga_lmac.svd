                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>R</name>
                <description>NFCID1 byte R</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>Q</name>
                <description>NFCID1 byte Q</description>
                <lsb>16</lsb>
                <msb>23</msb>
