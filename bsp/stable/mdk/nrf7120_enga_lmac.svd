            <field>
              <name>VAL_1</name>
              <description>Idle output value for PWM channel [1]</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>VAL_2</name>
              <description>Idle output value for PWM channel [2]</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>VAL_3</name>
              <description>Idle output value for PWM channel [3]</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x020</dimIncrement>
          <name>SEQ[%s]</name>
          <description>Unspecified</description>
          <headerStructName>PWM_SEQ</headerStructName>
          <access>read-write</access>
          <addressOffset>0x520</addressOffset>
          <register>
            <name>REFRESH</name>
