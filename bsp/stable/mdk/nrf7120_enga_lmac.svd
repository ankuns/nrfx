              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reference</name>
                  <description>At the start of the reference antenna period</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Switching</name>
                  <description>At the start of antenna switching after the reference antenna period</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>When it is triggered Either TASKS_DFESTART, address match or AoA/AoD procedure trigger source</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Guard</name>
                  <description>At the start of the GUARD period</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNORE8USLENGTH</name>
              <description>Ignore the length specification in numberOf8us</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DoNotIgnore</name>
                  <description>Use the length specification</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ignore</name>
