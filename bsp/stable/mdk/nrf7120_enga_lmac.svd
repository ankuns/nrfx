              <lsb>16</lsb>
              <msb>27</msb>
            </field>
            <field>
              <name>DONOTTRANSFER</name>
              <description>When 1, we do not transfer this word to AdPll at power up</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ADPLLTRIMCOMMAND_1</name>
          <description>This value is written to the AdPll when powering up the digital island. Never reset with SOFTRESET.</description>
          <addressOffset>0x08A4</addressOffset>
