            <size>0x20</size>
            <fields>
              <field>
                <name>SYMBOLNUMBERA</name>
                <description>The current state of the symbol counter for frame A.  Can be written for immediate symbol counter update.</description>
                <lsb>0</lsb>
                <msb>15</msb>
