                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>XIntermediateStateB</name>
                    <description>X     - Intermediate state before determining packet is either HE-MU or HE-ER</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeMuPacketDetermin</name>
                    <description>HE-MU - Packet determined as HE-MU</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeErPacketDetermin</name>
                    <description>HE-ER - Packet determined as HE-ER</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGHEMUEXTRALDPC</name>
                <description>Force LDPC extra segment flag for decoder configuration for HE-MU packet decoding.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGHESIGBMODE</name>
                <description>Indicates if HE-SIG-B is being decoded and its format:</description>
                <lsb>13</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalVhtPacket</name>
                    <description>Normal VHT packet</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBUncompressed</name>
                    <description>HE-SIG-B uncompressed 20/40 MHz ppduBW (18-bit common field, 52-bit User block field)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBUncompressed2</name>
                    <description>HE-SIG-B uncompressed 80 MHz ppduBw (27-bit common field,  52-bit User block field)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBCompressed</name>
                    <description>HE-SIG-B compressed (no common field, 52-bit User block field)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
