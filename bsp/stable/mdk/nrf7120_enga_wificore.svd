                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt55</name>
                  <description>Gfsk Bt=0.55</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CUSTOMMODULATION</name>
