        <cluster>
          <name>NFCID1</name>
          <description>Unspecified</description>
          <headerStructName>NFCT_NFCID1</headerStructName>
          <access>read-write</access>
          <addressOffset>0x590</addressOffset>
          <register>
            <name>LAST</name>
