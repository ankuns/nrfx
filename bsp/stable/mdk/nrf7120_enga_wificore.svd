          <register>
            <name>DISABLEMISCCOMPUTATIONS</name>
            <description>WLAN MAC CTRL AGG DISABLE MISC COMPUTATIONS</description>
            <addressOffset>0xC68</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION0</name>
                <description>Disable TxPower computaion and take power from higher layers</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION1</name>
                <description>Disable programming of CFO value taken from RX vector</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION2</name>
                <description>Used for setting operating mode 5 or 2.4 GHz, set 1 for 5 GHz</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION3</name>
                <description>Used for setting two Tx vector enable logic</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION4</name>
                <description>Power save bit used for HEFRAMES (QOS NULL)</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANMACCTRLAGGDISABLEMISCCOMPUTATION5</name>
                <description>Power save bit used for SIFS frames</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
