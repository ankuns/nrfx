                    <value>0x0D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HedataEr</name>
                    <description>HEDATAER (HE)</description>
                    <value>0x0E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HedataMu</name>
                    <description>HEDATAMU (HE)</description>
                    <value>0x0F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Usig1</name>
                    <description>USIG1 (HT)</description>
                    <value>0x10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Usig2</name>
