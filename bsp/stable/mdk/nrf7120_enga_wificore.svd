                  <name>NFCA</name>
                  <description>Initial value for NFC-A</description>
                  <value>0x6363</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NFCBF</name>
                  <description>Initial value for NFC-B and NFC-F</description>
                  <value>0xFFFF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
