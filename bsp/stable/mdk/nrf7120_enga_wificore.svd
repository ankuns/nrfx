                  <enumeratedValue>
                    <name>Valid</name>
                    <description>Valid, Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Sticky</name>
                    <description>Sticky(Valid), Sticky(Enable)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnable</name>
                    <description>Valid &amp;amp; Enable, Sticky(Valid &amp;amp; Enable)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGVALID</name>
            <description>WLAN FFT DEBUG VALID</description>
            <addressOffset>0xC0</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDEBUGVALID</name>
                <description>Live state of the valid flow control signals
          0: FFT WR
          1: Unused - Tied to 0
          2: Unused - Tied to 0
          3: Null SC Insertion Input
          4: Null SC Insertion Output
          5: FFT Input FIFO Input
          6: FFT Input FIFO Output
          7: Engine Input
          8: Engine Output
          9: RTM FFT Input
          10: RTM FFT Output
          11: FFT Output FIFO Input
          12: FFT Output FIFO Output
          13: Raw FFT Output
          14: Unused - Tied to 0
          15: Unused - Tied to 0
          16: Unused - Tied to 0
          17: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
