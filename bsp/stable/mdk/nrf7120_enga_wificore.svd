          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Voltage value when HVBUCK in LP state. Note: Reset value of this register is 0x00 and proper value must be written before releasing HVBUCK from forced HP mode.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>VOUT0V8HP</name>
          <description>Voltage control word for 0v8</description>
