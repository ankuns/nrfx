          This value will be used by MAC controller to generate compressed beamforming report information.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANSVDSNRENABLE</name>
                <description>Enable SNR calculation: 0: disabled, 1: enabled.</description>
                <lsb>8</lsb>
                <msb>8</msb>
