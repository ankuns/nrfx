        <register>
          <name>NOISESHAPE</name>
          <description>SAADC provides two operational noise shaping modes (one that prioritizes higher bandwith, while the other prioritizes higher accuracy) that allow trade-offs between ADC resolution, power consumption, and signal bandwidth.</description>
          <addressOffset>0x654</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>NOISESHAPE</name>
              <description>Noise shaping configuration</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable noiseshaping. Configurable oversampling.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NS1</name>
                  <description>Noiseshaping and decimating. Larger passband. Provides a 100 kS/s cut off frequency, 8x the oversampling ratio. Takes precedence over the OVERSAMPLING register.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NS2</name>
                  <description>Noiseshaping and decimating. Smaller passband. Recommended resolution setting is 14 bits. Provides a 10 kS/s cut off frequency, 32x the oversampling ratio. Takes precedence over the OVERSAMPLING register.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Audio</name>
                  <description>Deprecated enumerator -  Use enumerator NS1 for future compatibility.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Accuracy</name>
                  <description>Deprecated enumerator -  Use enumerator NS2 for future compatibility.</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
