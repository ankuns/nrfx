            <addressOffset>0xB4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>IQCORROUT</name>
                <description>IQ Correlator output for detecting angle error on a Zero-IF input signal.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>0</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCNOISEPERIOD</name>
            <description>SCP AGC NOISE PERIOD</description>
            <addressOffset>0xB8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NOISEPERIOD</name>
                <description>Period of the input sample counter - 1
          e.g. 0 gives period of sample length 1, 1 gives period of sample length 2, 2 gives period of sample length 3.
          The value has to be already adjusted according to DRM decimation factor, resampling rate and CIC &amp;amp; FIR decimation factors.
          NOISEPERIOD = ((AGCPERIOD / (((RESAMPBASE * 2^23) + RESAMPCONTROL) / 2^25)) / P) / N.</description>
                <lsb>5</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCCLIPCONTROL</name>
            <description>SCP AGC CLIP CONTROL</description>
            <addressOffset>0xC0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCCLIP</name>
                <description>Threshold value against which the absolute value of IF samples is compared in the logic that generates CLIPCOUNT.
          Bits 18:8 valid for 12-bit SCP, bits 18:4 valid for 16-bit SCP.</description>
                <lsb>4</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCTHRESHCONTROL</name>
            <description>SCP AGC THRESH CONTROL</description>
            <addressOffset>0xC4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCTHRESH</name>
                <description>Threshold value against which the absolute value of IF samples is compared in the logic that generates THRESHCOUNT.
          Bits 18:8 valid for 12-bit SCP, bits 18:4 valid for 16-bit SCP.</description>
                <lsb>4</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCPERIOD</name>
            <description>SCP AGC PERIOD</description>
            <addressOffset>0xC8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCPERIOD</name>
                <description>Period of the input sample counter - 1
          e.g. 0 gives period of sample length 1, 1 gives period of sample length 2, 2 gives period of sample length 3.
          The value has to be already adjusted according to DRM decimation factor.</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
