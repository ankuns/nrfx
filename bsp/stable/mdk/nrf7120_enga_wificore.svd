            <addressOffset>0x1A0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SYMBOLPERIODA</name>
                <description>The number of SCP samples between the starts of two successive symbols in
          frame A. Must be &amp;gt; 1 in current implementation for DMA synchronization to work.
          Note that setting this register sets SYMBOLPERIODADJUSTA to the same value.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
