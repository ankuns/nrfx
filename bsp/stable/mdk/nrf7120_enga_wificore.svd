          <register>
            <name>ERROR</name>
            <description>CRYPTO PERIP ERROR</description>
            <addressOffset>0x48</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ERRORRXAMPDULENGTH</name>
                <description>Received rxampdulength is larger than 0xFFFF. Crypto will push valid=1 mask=1 eop=1 data=0 byte into the output, discard remaining inputs until sync flag received then start new job.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>ERRORWRITESYNCEARLY</name>
                <description>TBus write sync flag appears earlier than expected. Crypto will terminate current engine job if started, push valid=1 mask=1 eop=1 data=0 byte into the output, discard remaining inputs until sync flag received then start new job.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>ERRORWRITESYNCLATE</name>
                <description>TBus write sync flag appears later than expected. Crypto will set eop=1 on the last valid output byte, discard remaining inputs until sync flag received then start new job.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>ERRORPAYLOADLENGTH</name>
                <description>Received payload length is less than 0. Crypto will push valid=1 mask=1 eop=1 data=0 byte into the output, discard remaining inputs until sync flag received then start new job.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
