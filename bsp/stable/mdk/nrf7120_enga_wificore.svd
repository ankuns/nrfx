                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>IQSamplesAreNotDele</name>
                    <description>I/Q samples are not deleted but counters operate normally</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IQSamplesAreDeleted</name>
                    <description>I/Q samples are deleted as indicated by deletion logic</description>
