            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SYMBOLPERIODADJUSTA</name>
                <description>The value written to this field defines the duration of the next symbol only. At the end of the adjusted symbol this field is automatically set to equal the value of SYMBOLPERIODA.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
