                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Shift1110DbBwFs</name>
                    <description>SHIFT=11   -10 dB BW ~= Fs / 2500    for L=0</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Shift1010DbBwFs</name>
