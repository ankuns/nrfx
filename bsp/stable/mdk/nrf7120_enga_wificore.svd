              <field>
                <name>WLANTXPSTREAMPARSEROUTPUTSTATE</name>
                <description>This is a read-only field. Value read out indicates the output state of the Stream Parser in the TXP Core.
          Writing to field would not change its value.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputEnabled</name>
                    <description>Output enabled, normal operation.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OutputDisabledAfterR</name>
                    <description>Output disabled after required symbols and samples have been sent out. Re-enable by asserting a soft or hard reset on the entire TXP (this will also reset any data in the pipeline).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANTXPAGGRIDLE</name>
                <description>This is a read-only field. Value read out indicates the state of the TXP Aggregation.
