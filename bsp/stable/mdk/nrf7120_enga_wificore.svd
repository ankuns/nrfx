          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL_0</name>
              <description>Idle output value for PWM channel [0]</description>
              <lsb>0</lsb>
              <msb>0</msb>
