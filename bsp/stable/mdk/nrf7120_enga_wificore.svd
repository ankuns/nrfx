            <resetValue>0x00002800</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CTEINLINECTRLEN</name>
                <description>Enable parsing of CTEInfo from received packet in BLE modes</description>
                <lsb>0</lsb>
