            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ERRFLAGCLR</name>
                <description>Writing 1 to this bit clears the UNDERFLOW and OVERFLOW bits in this register.
          The QMERROR event flag will be clear following this action for either state of ERRFLAGEN.
          This bit is cleared automatically after it has taken effect.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ERRORSTATUS</name>
