            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANTXPHEADERGENERATORVHTSIGBLENGTH</name>
                <description>Length field in the VHT-SIG-B header, equal to ceil(APEP length / 4)
          where APEP length comes from the Tx Vector.
          For 20 MHz only the least-significant 17 bits are used.
          For 40 MHz only the least-significant 19 bits are used.
          Only used if WLANTXPTXMODE is 0 and WLANTXPPACKETTYPE is 3.</description>
                <lsb>0</lsb>
                <msb>20</msb>
              </field>
            </fields>
