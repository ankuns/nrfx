        <register>
          <name>TIFS</name>
          <description>Interframe spacing in us</description>
          <addressOffset>0x714</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TIFS</name>
              <description>Interframe spacing in us. Interframe space is the time interval between two consecutive packets. It is defined as the time, in microseconds, from the end of the last bit of the previous packet to the start of the first bit of the subsequent packet.</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RSSISAMPLE</name>
          <description>RSSI sample</description>
          <addressOffset>0x718</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000007F</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RSSISAMPLE</name>
              <description>RSSI sample result. The value of this register is read as a positive value while the actual received signal strength is a negative value. Actual received signal strength is therefore as follows: received signal strength = -A dBm.</description>
              <lsb>0</lsb>
              <msb>6</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>EVENTCONFIG</name>
          <description>Event configuration</description>
          <addressOffset>0x71C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TTXDISABLE</name>
              <description>Transition time from TXDISABLE state to DISABLED state Configurable time, in us, between RADIO.EVENTS_END and RADIO.EVENTS_DISABLED when using the shortcut between RADIO.EVENTS_END and RADIO.TASKS_DISABLE. The minimum time between RADIO.TASKS_DISABLE and RADIO.EVENTS_DISABLED is described in the electrical parameters. The minimum time will be used if the configured time is set shorter than the minimum time. Depending on configuration setting the DISABLED event may experience some jitter, see electrical parameters for more information. Note: The RADIO shall be disabled as normal when DISABLE task is triggered, it is only the DISABLED event that can be delayed. Note: The TIFS mechanism shall not be affected by the value specified in this field. (unit: 1us)</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>TRXDISABLE</name>
              <description>Transition time from RXDISABLE state to DISABLED state Configurable time, in us, between RADIO.EVENTS_END and RADIO.EVENTS_DISABLED when using the shortcut between RADIO.EVENTS_END and RADIO.TASKS_DISABLE. The minimum time between RADIO.TASKS_DISABLE and RADIO.EVENTS_DISABLED is described in electrical parameters. The minimum time will be used if the configured time is set shorter than the minimum time. Depending on configuration setting the DISABLED event may experience some jitter, see electrical parameters for more information. (unit: 1us)</description>
              <lsb>8</lsb>
              <msb>12</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <name>CALIBRATION</name>
          <description>Unspecified</description>
          <headerStructName>RADIO_CALIBRATION</headerStructName>
          <access>read-write</access>
          <addressOffset>0x720</addressOffset>
          <register>
            <name>TARGET</name>
            <description>Select target for calibration</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CALTARGET</name>
                <description>Calibration target selection for calibration engine, 0: DC_CAL, 1: RC_CAL</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCCONFIG</name>
            <description>Calibration config when CALTARGET=DC_CAL</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x74021F0D</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CALTSTART</name>
                <description>Startup wait time (default 437.5ns)</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CALTSETTLE</name>
                <description>Settle wait time (default 1000ns)</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CALTCOMPARE</name>
                <description>Compare wait time (default 93.75ns)</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CALMSB</name>
                <description>Index of most significant bit to be calibrated (add 1 to get number of bits)</description>
                <lsb>24</lsb>
                <msb>26</msb>
              </field>
              <field>
                <name>CALINVERTCMPI</name>
                <description>1: invert calCmp1 (I) before it goes into calibration engine #1</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>CALINVERTCMPQ</name>
                <description>1: invert calCmp2 (Q) before it goes into calibration engine #2</description>
                <lsb>29</lsb>
                <msb>29</msb>
              </field>
              <field>
                <name>CALCODEFORMAT</name>
                <description>0: 2's complement, 1: sign-magnitude</description>
                <lsb>30</lsb>
                <msb>30</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RCCONFIG</name>
            <description>Calibration config when CALTARGET=RC_CAL</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x03165204</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CALTSTART</name>
                <description>Startup wait time (default 156.25ns)</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CALTSETTLE</name>
                <description>Settle wait time (default 2593.75ns)</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CALTCOMPARE</name>
                <description>Compare wait time (default 718.75ns)</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CALMSB</name>
                <description>Index of most significant bit to be calibrated (add 1 to get number of bits)</description>
                <lsb>24</lsb>
                <msb>26</msb>
              </field>
              <field>
                <name>CALINVERTCMP</name>
                <description>1: invert calCmp1 before it goes into calibration engine #1</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RESULT</name>
            <description>Calibration result</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RCCALCODE</name>
                <description>Calibration result from RC calibration</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>RFMIXDCCALI</name>
                <description>Calibration result from DC offset calibration on channel I</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>RFMIXDCCALQ</name>
                <description>Calibration result from DC offset calibration on channel Q</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
        </cluster>
