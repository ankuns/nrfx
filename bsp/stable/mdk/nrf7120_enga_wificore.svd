    <peripheral>
      <name>GLOBAL_LFXO</name>
      <description>LFXO peripheral</description>
      <baseAddress>0x50122000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>LFXO</name>
        <value>290</value>
      </interrupt>
      <groupName>LFXO</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>EVENTS_MODECHANGED</name>
          <description>LFXO mode changed</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
