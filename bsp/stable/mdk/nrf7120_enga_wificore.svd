                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>500ns</name>
                    <description>0.5us</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>250ns</name>
