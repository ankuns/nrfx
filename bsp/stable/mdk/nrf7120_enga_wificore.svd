            <access>read-write</access>
            <addressOffset>0xE50</addressOffset>
            <register>
              <name>L3CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L3 CHECKSUM TX</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L3CHECKSUMTX</name>
                  <description>Calculated L3 checksum.
          Note: L3 checksum is calculated only for IPV4 ethernet type.
          This register will hold calculated L3 checksum value for both operations TX and RX and
          it will be cleared at the start of every new packet.
          Note: This field should be read once the TXCHECKSUMVALID flag is asserted in TX operation.
          In RX operation this value can be used for debug and checked after RXCHECKSUMVALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3CHECKSUMTXOFFSET</name>
                  <description>L3 checksum TX offset.
          This field gives the information on offset of L3 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>20</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L4CHECKSUMTX</name>
                  <description>Calculated L4 checksum.
          This field will hold calculated L4 checksum value for both operations TX and RX
          and it will be cleared at the start of every new packet.
          Note: This field should be read once the TXCHECKSUMVALID flag is asserted in TX operation.
          In RX operation this value can be used for debug and checked after RXCHECKSUMVALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L4CHECKSUMTXOFFSET</name>
                  <description>L4 checksum TX offset.
          This field gives the information on offset of L4 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>22</msb>
                </field>
                <field>
                  <name>TXCHECKSUMVALID</name>
                  <description>TX checksum valid flag.
          This bit gets set once the L4 checksum calculation for TX operation is completed
          and it will be cleared at the start of every new packet.</description>
                  <lsb>23</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTXRXSTATUS</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX RX STATUS</description>
              <addressOffset>0x008</addressOffset>
