          <register>
            <name>SAMPLENUMBER</name>
            <description>SCP SAMPLE NUMBER</description>
            <addressOffset>0x160</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SAMPLENUM</name>
                <description>The current state of the sample counter for the active frame.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SYMBOLNUMBER</name>
            <description>SCP SYMBOL NUMBER</description>
            <addressOffset>0x164</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SYMBOLNUM</name>
                <description>The current state of the symbol counter for the active frame.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SAMPLENUMBERA</name>
            <description>SCP SAMPLE NUMBER A</description>
            <addressOffset>0x168</addressOffset>
            <access>read-only</access>
