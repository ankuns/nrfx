            <size>0x20</size>
            <fields>
              <field>
                <name>FRAMESYMSADJUSTA</name>
                <description>The value written to this field defines the number of symbols in the current frame only. At the end of the current frame this field is automatically set to equal the value of FRAMESYMSA.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FINALPERIODADJUSTA</name>
            <description>SCP FINAL PERIOD ADJUST A</description>
            <addressOffset>0x1B4</addressOffset>
