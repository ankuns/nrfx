                    <value>0x06</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rlsig</name>
                    <description>RLSIG (L)</description>
                    <value>0x07</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HesigaSu</name>
