            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDEBUGENABLE</name>
                <description>Live state of the enable flow control signals
          0: FFT WR
          1: Unused - Tied to 0
          2: Unused - Tied to 0
          3: Null SC Insertion Input
          4: Null SC Insertion Output
          5: FFT Input FIFO Input
          6: FFT Input FIFO Output
          7: Engine Input
          8: Engine Output
          9: RTM FFT Input
          10: RTM FFT Output
          11: FFT Output FIFO Input
          12: FFT Output FIFO Output
          13: Raw FFT Output
          14: Unused - Tied to 0
          15: Unused - Tied to 0
          16: Unused - Tied to 0
          17: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
