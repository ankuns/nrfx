                <msb>7</msb>
              </field>
              <field>
                <name>WLANRXPCPESTBC</name>
                <description>Selects STBC mode. HT-packets only.</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonStbc</name>
                    <description>non-STBC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Stbc</name>
                    <description>STBC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCPEBYPASS</name>
                <description>CPE compensation control.
          This field is used when REMOVESUBCARRIERS is active (RX mode).
          In both cases pilots will be discarded but when bypass is not active
          CPE compensation will be performed.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CpeCompensation</name>
                    <description>CPE compensation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Bypass</name>
                    <description>Bypass</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPDLBBYPASS</name>
                <description>Delay buffer bypass</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DlbEnabled</name>
                    <description>DLB enabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DlbBypassed</name>
                    <description>DLB bypassed</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPSIGNALBANDWIDTH</name>
                <description>Selects the signal bandwidth
          Must be equal or less than CHANNELBANDWIDTH.
          For receive, see the OPERATINGWINDOW description.
          For transmit, when signal bandwidth is less than channel bandwidth, input OFDM symbol will be duplicated
          before performing inverse FFT. If channel bandwidth is two times signal bandwidth then OFDM symbol will be
          duplicated and if channel bandwidth is four times signal bandwidth then OFDM symbol will be quadrupled.</description>
                <lsb>12</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCPERU</name>
                <description>HE resource unit allocation for CPE module</description>
                <lsb>14</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>WLANRXPMCSVALUE</name>
                <description>Modulation and coding scheme</description>
                <lsb>21</lsb>
                <msb>24</msb>
              </field>
            </fields>
