              <name>DRIFTVALIDTH125</name>
              <description>Value for driftValidTh, drift estimator (despreadLELLong)</description>
              <lsb>8</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>DRIFTLOWTH125</name>
              <description>Value for driftLowTh, drift estimator (despreadLELLong)</description>
              <lsb>24</lsb>
