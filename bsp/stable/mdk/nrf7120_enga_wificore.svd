                <name>FRAMESYMSA</name>
                <description>The number of symbols in frame A.  Note that setting this register sets FRAMESYMSADJUSTA to the same value.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
