            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>IENERGY0</name>
                <description>Represents a measure of the negated in-phase signal component suppressed by notch filter 0 in 2' complement format.
          13-bit value sign extended to 16 bits in bits 23:8 valid for 12-bit SCP, 17-bit value in bits 23:7 valid for 16-bit SCP.</description>
                <lsb>7</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>NOTCHENERGY0Q</name>
            <description>SCP NOTCHENERGY 0 Q</description>
            <addressOffset>0x258</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>QENERGY0</name>
                <description>Represents a measure of the negated quadrature signal component suppressed by notch filter 0 in 2' complement format.
          This register will hold the current Q value after a read command is issued to the SCPNOTCHENERGY0I register until this register is read.
          13-bit value sign extended to 16 bits in bits 23:8 valid for 12-bit SCP, 17-bit value in bits 23:7 valid for 16-bit SCP.</description>
                <lsb>7</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
