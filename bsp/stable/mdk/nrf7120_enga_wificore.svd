            <addressOffset>0x028</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGMEMQADDR</name>
                <description>First register address for Q-block in SysMem. This address needs to be 16 byte algined when 8 bit packing is used, 8 byte aligned when 12/16 but packing issued and 4 byte aligned otherwise. Recommend to by 16 byte aligned to satisfy all modes. When packing auumulator in memory (cfg_write_acc and cfg_acc_pack are 1), the address must be written in sequence (least signifcant two bits 0,1,2,3 for 8 bit packing  and  0,2 for 12/16 bit packing) to trigger writing the packed accumulator into memory.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
