              <field>
                <name>TBUSFIFOFLUSH</name>
                <description>Writing '1' to this field causes the TBus output FIFO to be flushed.  This bit clears automatically.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>MODE</name>
                <description>Defines the operating mode of the SCP as follows:</description>
                <lsb>21</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalOperation</name>
                    <description>Normal operation; SCP samples are output</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LoPhaseAccumulator</name>
                    <description>LO phase accumulator; (MSB:MSB-11) is output on I, LO phase accumulator(MSB-12:MSB-23) is output on Q</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BypassMode1</name>
                    <description>Bypass mode 1; resampler results are output on I and Q</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BypassMode2</name>
                    <description>Bypass mode 2; mixer results are output on I and Q</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SamplesBypassTheScpC</name>
                    <description>Samples bypass the SCP completely</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>SCP STATUS</description>
            <addressOffset>0x4</addressOffset>
            <access>read-only</access>
            <resetValue>0x001BC000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPCOEFFLOADED</name>
                <lsb>12</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CoeffsAreNotLoaded</name>
                    <description>Coeffs are not loaded.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CoeffsSet0IsLoaded</name>
                    <description>Coeffs set 0 is loaded.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CoeffsSet1IsLoaded</name>
                    <description>Coeffs set 1 is loaded.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SCPPOWER</name>
                <lsb>14</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Undefined</name>
                    <description>Undefined</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LowPowerMode</name>
                    <description>Low-power mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOn</name>
                    <description>Power-on</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOff</name>
                    <description>Power-off</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ADCPOWER</name>
                <lsb>16</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Undefined</name>
                    <description>Undefined</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LowPowerMode</name>
                    <description>Low-power mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOn</name>
                    <description>Power-on</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOff</name>
                    <description>Power-off</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ACTIVEFRAME</name>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FrameAActive</name>
                    <description>FrameA active</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FrameBActive</name>
                    <description>FrameB active</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INPUTSAMPLEENABLE</name>
                <lsb>19</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ScpNotReadyForWriteT</name>
                    <description>SCP not ready for write to SCPINPUTSAMPLE register.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ScpReadyForWriteToSc</name>
                    <description>SCP ready for write to SCPINPUTSAMPLE register.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IFENABLE</name>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>InputSynchroniserNot</name>
                    <description>Input synchroniser not enabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>InputSynchroniserEna</name>
                    <description>Input synchroniser enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IRQSCP</name>
                <description>This signal reflects the state of the IRQSCP interrupt.
          This interrupt is controlled by SCPInterruptEnable.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTERRUPTSTATUS</name>
            <description>SCP INTERRUPT STATUS</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYEVENT</name>
                <description>This bit is set to 1 when Energy Monitor outputs are ready to be read.
          Writing 1 sets this bit for test purposes (and hence asserts the interrupt if ENERGYENABLE is also set).</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWEVENT</name>
                <description>This bit is set to 1 if the TBus output FIFO overflows.
          Writing 1 sets this bit for test purposes (and hence asserts the interrupt if TBUSOVERFLOWENABLE is also set).</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWEVENT</name>
                <description>This bit is set to 1 when the input synchroniser has overflowed.
          Writing 1 sets this bit for test purposes (and hence asserts the interrupt if OVERFLOWENABLE is also set).</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPAREEVENT</name>
                <description>This bit is set to 1 when the frame compare test has matched.
          Writing 1 sets this bit for test purposes (and hence asserts the interrupt if COMPAREENABLE is also set).</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSEVENT</name>
                <description>This bit is set to 1 when the AGC period has completed.
          Writing 1 sets this bit for test purposes (and hence asserts the interrupt if AGCCOUNTSENABLE is also set).</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTERRUPTENABLE</name>
            <description>SCP INTERRUPT ENABLE</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYENABLE</name>
                <description>IRQSCP is asserted when ENERGYEVENT=1 and ENERGYENABLE=1.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWENABLE</name>
                <description>IRQSCP is asserted when TBUSOVERFLOWEVENT=1 and TBUSOVERFLOWENABLE=1.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWENABLE</name>
                <description>IRQSCP is asserted when OVERFLOWEVENT=1 and OVERFLOWENABLE=1.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPAREENABLE</name>
                <description>IRQSCP is asserted when COMPAREEVENT=1 and COMPAREENABLE=1.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSENABLE</name>
                <description>IRQSCP is asserted when AGCCOUNTSEVENT=1 and AGCCOUNTSENABLE=1.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTERRUPTCLEAR</name>
            <description>SCP INTERRUPT CLEAR</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYCLEAR</name>
                <description>Writing 1 to this bit sets ENERGYEVENT to 0</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWCLEAR</name>
                <description>Writing 1 to this bit sets TBUSOVERFLOWEVENT to 0</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWCLEAR</name>
                <description>Writing 1 to this bit sets OVERFLOWEVENT to 0</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPARECLEAR</name>
                <description>Writing 1 to this bit sets COMPAREEVENT to 0</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSCLEAR</name>
                <description>Writing 1 to this bit sets AGCCOUNTSEVENT to 0.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INPUTSAMPLE</name>
            <description>SCP INPUT SAMPLE</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INPUTQ</name>
                <description>For 12-bit SCP : input sample Q component.
          For 16-bit SCP : write input sample I[11:0] followed by Q[11:0].
          Poll for INPUTSAMPLEENABLE=1 before writing.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>INPUTI</name>
                <description>For 12-bit SCP : write input sample I component.
          For 16-bit SCP : write input sample I[15:12] followed by Q[15:12].
          Poll for INPUTSAMPLEENABLE=1 before writing.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>REFERENCECLOCKCONTROLN</name>
            <description>SCP REFERENCE CLOCK CONTROL N</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>N</name>
                <description>The frequency of the output refclk is R x (N[14:0] / (M * 2)), where R is the SCP output sample frequency when N[15]=0, else the core clock frequency.
          If N and M are to be used to scale the reference clock M must be programmed first followed by N.
          Note that the reference clock control can only act as a divider not as a multiplier so the ratio (N[14:0] / (M * 2)) must be less than or equal to 0.5.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>REFERENCECLOCKCONTROLM</name>
            <description>SCP REFERENCE CLOCK CONTROL M</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>M</name>
                <description>The frequency of the output refclk is R x (N[14:0] / (M * 2)), where R is the SCP sample frequency when N[15]=0, else the core clock frequency.
          If N and M are to be used to scale the reference clock M must be programmed first followed by N.
          Note that the Reference clock control can only act as a divider not as a multiplier so the ratio (N[14:0] / (M * 2)) must be less than or equal to 0.5.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CICBYPASS</name>
            <description>SCP CIC BYPASS</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CICBYPASS</name>
                <description>Used to set the bypass mode of the CIC block.  When bypass is set the CIC block is powered down and data passes around it unaltered.  When cleared the block operates as programmed by the registers that control it.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalOperation</name>
                    <description>Normal operation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BlockBypassed</name>
                    <description>Block Bypassed (overrules any other block settings)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>RSSIINPUT</name>
            <description>SCP RSSI INPUT</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIINPUT</name>
                <description>RSSI (Received Signal Strength Indicator) ADC input captured on AGC sample period trigger</description>
                <lsb>8</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONTROL2</name>
            <description>SCP CONTROL2</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPKICKENABLE</name>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WritesToSetAdcPowe</name>
                    <description>Writes to SETADCPOWER/SETSCPPOWER/NEWADCPOWER/NEWSCPPOWER/INPUTI/INPUTQ registers not deferred until kick received from EDCSCPKICK register to synchroniser update of these registers to multiple SCPs.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WritesToSetAdcPowe1</name>
                    <description>Writes to SETADCPOWER/SETSCPPOWER/NEWADCPOWER/NEWSCPPOWER/INPUTI/INPUTQ registers deferred until kick received from EDCSCPKICK register to synchroniser update of these registers to multiple SCPs.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANEDAGCSTART</name>
                <description>Note: In mode 1 the input data rate to the SCP must be greater than or equal to the output data rate.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ScpNotUsedForProcess</name>
                    <description>SCP not used for processing Wi-Fi samples. No hold off provided to synchronize output samples with ADC input, DMA output enabled at start of frame.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ScpUsedForProcessing</name>
                    <description>SCP used for processing Wi-Fi samples. Provides hold off to synchronize output samples with ADC input, DMA output enabled by agcdone signal from Wi-Fi AGC.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGGING</name>
            <description>SCP DEBUG</description>
            <addressOffset>0x2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPSTARTSAMPLES</name>
                <description>Number of samples before enabling SCP output when SCPSTARTMODE=1</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>DISCARDINITIALSAMPLES</name>
                <description>Number of initial ADC samples to discard</description>
                <lsb>8</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>SCPDEBUG</name>
                <description>Enable debug registers SCPDEBUGVALID and SCPDEBUGENABLE</description>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Valid</name>
                    <description>Valid, Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Sticky</name>
                    <description>Sticky(Valid), Sticky(Enable)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnable</name>
                    <description>Valid &amp;amp; Enable, Sticky(Valid &amp;amp; Enable)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SCPSTARTMODE</name>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputAllScpOutputSa</name>
                    <description>Output all SCP output samples, or all samples after ED event when WLANEDAGCSTART=1</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DiscardFirstScpStar</name>
                    <description>Discard first SCPSTARTSAMPLES SCP output samples</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DISCARDINITIALZEROS</name>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ProcessAllAdcInputSa</name>
                    <description>Process all ADC input samples</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DiscardInitialAdcInp</name>
                    <description>Discard initial ADC input data until first non-zero sample</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGVALID0</name>
            <description>SCP DEBUG VALID 0</description>
            <addressOffset>0x30</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPDEBUGVALID0</name>
                <description>Live state of the valid flow control signals
          0: Source Synchroniser Output
          1: RI/Q Formatter Input
          2: RI/Q Formatter Output
          3: NDRM Decimator Input
          4: NDRM Decimator Output
          5: FDC Offset Input
          6: FDC Offset Output
          7: EEarly Gain Input
          8: EEarly Gain Output
          9: RMixer Input
          10: Mixer Output
          11: Resampler Input
          12: Resampler Output
          13: IQ Imbalance Input
          14: IQ Imbalance Output
          15: CIC Decimator Input
          16: CIC Decimator Output
          17: FIR Decimator Input
          18: FIR Decimator Output
          19: Notch Filter Input
          20: Notch Filter Output
          21: Late Gain Input
          22: Late Gain Output
          23: Impulse Filter Input</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGVALID1</name>
            <description>SCP DEBUG VALID 1</description>
            <addressOffset>0x34</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPDEBUGVALID1</name>
                <description>Live state of the valid flow control signals
          0: Impulse Filter Output
          1: Output Mux Input
          2: FIFO Write
          3: FIFO Output
          4: Unpacker Input
          5: EDC T-Bus Read Peripheral Input
          6: EDC T-Bus Read Peripheral Output</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGENABLE0</name>
            <description>SCP DEBUG ENABLE 0</description>
            <addressOffset>0x38</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPDEBUGENABLE0</name>
                <description>Live state of the valid flow control signals
          0: Source Synchroniser Output
          1: RI/Q Formatter Input
          2: RI/Q Formatter Output
          3: NDRM Decimator Input
          4: NDRM Decimator Output
          5: FDC Offset Input
          6: FDC Offset Output
          7: EEarly Gain Input
          8: EEarly Gain Output
          9: RMixer Input
          10: Mixer Output
          11: Resampler Input
          12: Resampler Output
          13: IQ Imbalance Input
          14: IQ Imbalance Output
          15: CIC Decimator Input
          16: CIC Decimator Output
          17: FIR Decimator Input
          18: FIR Decimator Output
          19: Notch Filter Input
          20: Notch Filter Output
          21: Late Gain Input
          22: Late Gain Output
          23: Impulse Filter Input</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGENABLE1</name>
            <description>SCP DEBUG ENABLE 1</description>
            <addressOffset>0x3C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPDEBUGENABLE1</name>
                <description>Live state of the valid flow control signals
          0: Impulse Filter Output
          1: Output Mux Input
          2: FIFO Full
          3: FIFO Output
          4: Unpacker Input
          5: EDC T-Bus Read Peripheral Input
          6: EDC T-Bus Read Peripheral Output</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COEFFADDR</name>
            <description>SCP COEFF ADDR</description>
            <addressOffset>0x40</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPCOEFFADDR</name>
                <description>Address for coefficient of final (FIR) decimation filter.
          NOTE: use FIRCOEFFSETSEL to select the coefficients set.</description>
                <lsb>0</lsb>
                <msb>5</msb>
