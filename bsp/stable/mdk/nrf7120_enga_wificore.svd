                  <value>0x02</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SDD00100</name>
                  <description>SDD pattern 00100</description>
                  <value>0x04</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SDD01000</name>
                  <description>SDD pattern 01000</description>
                  <value>0x08</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SDD10000</name>
