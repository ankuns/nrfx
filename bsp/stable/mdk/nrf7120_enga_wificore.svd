                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>125ns</name>
                    <description>0.125us</description>
                    <value>0x6</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
