                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>31</name>
                    <description>31 in 8us unit</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>63</name>
                    <description>63 in 8us unit</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CTEINLINERXMODE1US</name>
                <description>Spacing between samples for the samples in the SWITCHING period when CTEINLINEMODE is set</description>
                <lsb>10</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>8us</name>
                    <description>8us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4us</name>
                    <description>4us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2us</name>
                    <description>2us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1us</name>
                    <description>1us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>500ns</name>
                    <description>0.5us</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>250ns</name>
                    <description>0.25us</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>125ns</name>
                    <description>0.125us</description>
                    <value>0x6</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CTEINLINERXMODE2US</name>
                <description>Spacing between samples for the samples in the SWITCHING period when CTEINLINEMODE is set</description>
                <lsb>13</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>8us</name>
                    <description>8us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4us</name>
                    <description>4us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2us</name>
                    <description>2us</description>
