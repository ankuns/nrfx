            <name>WLANEDOFDMCORRCONFIG2</name>
            <description>WLAN ED OFDM CORR CONFIG 2</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00DB6E7C</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFDMCORRS2LTHRESMETRIC1</name>
                <description>OFDM correlation S2l metric 1 threshold. It has a range of -31 .. 0. Default value is -4.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>OFDMCORRS2LTHRESMETRIC2</name>
