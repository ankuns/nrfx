          <cluster>
            <dim>8</dim>
            <dimIncrement>0x00C</dimIncrement>
            <name>EARLYGAINLUT[%s]</name>
            <description>Unspecified</description>
            <headerStructName>WIFIPHY_SCP_EARLYGAINLUT</headerStructName>
            <access>read-write</access>
            <addressOffset>0x2E0</addressOffset>
            <register>
              <name>EARLYFINEGAINI</name>
              <description>Description cluster: SCP EARLY FINE GAIN I</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00200000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>EARLYIGAIN</name>
                  <description>2's complement value that multiplies I value from SCP.
          This is a linear gain where 0x800 represents the 0dB point, thus the fine gain is EARLYIGAIN/0x800.
          Bits 23:13 valid for 12-bit SCP, bits 23:10 valid for 16-bit SCP.</description>
                  <lsb>10</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>EARLYFINEGAINQ</name>
              <description>Description cluster: SCP EARLY FINE GAIN Q</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00200000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>EARLYQGAIN</name>
                  <description>2's complement value that multiplies Q value from SCP.
          This is a linear gain where 0x800 represents the 0dB point, thus the fine gain is EARLYQGAIN/0x800.
          Bits 23:13 valid for 12-bit SCP, bits 23:10 valid for 16-bit SCP.</description>
                  <lsb>10</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>EARLYANGLEIQ</name>
              <description>Description cluster: SCP EARLY ANGLE IQ</description>
              <addressOffset>0x008</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>EARLYITOQGAIN</name>
                  <description>2's complement value that multiplies I value before addition to Q value in the early gain block.
          Qout = Q + (I * EARLYITOQGAIN &amp;gt;&amp;gt; 13).
          Bits 23:13 valid for 12-bit SCP, bits 23:10 valid for 16-bit SCP.</description>
                  <lsb>10</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <register>
            <name>COREID</name>
            <description>SCP CORE ID</description>
            <addressOffset>0x340</addressOffset>
            <access>read-only</access>
            <resetValue>0x000F0200</resetValue>
            <size>0x20</size>
            <fields>
              <field>
