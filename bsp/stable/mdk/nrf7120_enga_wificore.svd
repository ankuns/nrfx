          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Voltage value when HVBUCK in HP state. Note: Reset value of this register is 0x00 but in cold boot internal reset values are applied until this register is written first time and mirror written low.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>VOUTUPSCALE</name>
