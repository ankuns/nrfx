              <name>STTERRORTH</name>
              <description>Strobe time tracking: strobe time error threshold</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>STTTIMEOUT</name>
              <description>Period in bits where it is not allowed to set incStrb or decStrb</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>PAYLOADSIZE</name>
              <description>Minumum payload size for when STT is enabled</description>
              <lsb>16</lsb>
              <msb>23</msb>
