        <cluster>
          <name>RFCTRL</name>
          <description>Unspecified</description>
          <headerStructName>RPURFBUS_RFCTRL</headerStructName>
          <access>read-write</access>
          <addressOffset>0x10000</addressOffset>
          <register>
            <name>AXIMASTERACCESS</name>
            <description>RF CTRL AXI MASTER ACCESS</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RESTRICTED</name>
                <description>Enable restricted access to RF slave registers:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UnrestrictedAccess</name>
                    <description>Unrestricted access</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RestrictAccessToMast</name>
                    <description>Restrict access to master specified by MASTERID</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MASTERID</name>
                <description>When RESTRICTED=1 select master with access to RF slave registers:</description>
                <lsb>4</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RiscVCpu0</name>
                    <description>RISC-V CPU 0</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
