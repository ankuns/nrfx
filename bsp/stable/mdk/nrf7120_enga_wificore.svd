    <peripheral>
      <name>GLOBAL_FICR</name>
      <description>Factory Information Configuration Registers</description>
      <baseAddress>0x00FFC000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>FICR</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <dim>64</dim>
          <dimIncrement>0x008</dimIncrement>
          <name>CHIPCONF[%s]</name>
          <description>Unspecified</description>
          <headerStructName>FICR_CHIPCONF</headerStructName>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <name>ADDR</name>
            <description>Description cluster: Address of the APB register which will be written</description>
            <addressOffset>0x000</addressOffset>
            <access>read-only</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ADDRESS</name>
                <description>Address</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DATA</name>
            <description>Description cluster: Data to be written into the APB register</description>
            <addressOffset>0x004</addressOffset>
            <access>read-only</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DATA</name>
                <description>Data</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>DFTENABLE</name>
          <description>DFT Enable Registers</description>
          <headerStructName>FICR_DFTENABLE</headerStructName>
          <access>read-writeonce</access>
          <addressOffset>0x200</addressOffset>
          <register>
            <name>PROTECT0</name>
            <description>DFT enable register</description>
            <addressOffset>0x000</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Allow DFT and unlock TAMPC PROTECT.DFT.ENABLE signal protector.</description>
                    <value>0xDF7EDF7E</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x3</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>UNPROTECT0[%s]</name>
            <description>Description collection: DFT enable register n</description>
            <addressOffset>0x004</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x3</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>UNPROTECT1[%s]</name>
            <description>Description collection: DFT enable register n</description>
            <addressOffset>0x010</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PROTECT1</name>
            <description>DFT enable register</description>
            <addressOffset>0x01C</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Allow DFT and unlock TAMPC PROTECT.DFT.ENABLE signal protector.</description>
                    <value>0xDF7EDF7E</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>INFO</name>
          <description>Device info</description>
          <headerStructName>FICR_INFO</headerStructName>
          <access>read-write</access>
          <addressOffset>0x300</addressOffset>
