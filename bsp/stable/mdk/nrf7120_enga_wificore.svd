            <resetValue>0x0000C498</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LGLNAGAINTABLE0</name>
                <description>This value of 6-bit signed is the LNA gain for stage 0. Default value is 24.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>LGLNAGAINTABLE1</name>
                <description>This value of 6-bit signed is the LNA gain for stage 1. Default value is 18.</description>
                <lsb>6</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>LGLNAGAINTABLE2</name>
                <description>This value of 6-bit signed is the LNA gain for stage 2. Default value is 12.</description>
                <lsb>12</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>LGLNAGAINTABLE3</name>
                <description>This value of 6-bit signed is the LNA gain for stage 3. Default value is 0.</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCLGCCONFIG4</name>
            <description>WLAN AGC LGC CONFIG 4</description>
            <addressOffset>0x54</addressOffset>
            <access>read-write</access>
            <resetValue>0x000000F4</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LGLNAGAINTABLE4</name>
                <description>This value of 6-bit signed is the LNA gain for stage 4. Default value is -12.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>LGRSSIINCRPOWERFACTOR</name>
                <description>The 3-bit RFRSSIVAL feedback from RF increments by 1 for every LGRSSIINCRPOWERFACTOR increase in LNA input signal power in dBm. Unit is dB. For vega this value is 3.
          It has a range of 0 .. 7. Default value is 3.</description>
                <lsb>6</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>LGRFRAMPUPTIME</name>
                <description>Holds number of samples to wait for before starting LNA gain search. This value is set to zero currently as the ramp up time is handled by AGCWAITTIMEAFTERTRIG.
          It has a range of 0 .. 127. Default value is 0.</description>
                <lsb>9</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>LGRFLNARSSITHRES</name>
                <description>When final LNA stage is 0, RF RSSI value needs to be above this value in order to compute valid LNA RSSI, otherwise LNA RSSI set to -128.
          It has a range of 0 .. 7. Default value is 0.</description>
                <lsb>17</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
