            <resetValue>0x00050000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANCTRLWATCHDOGEFSTATUS</name>
                <description>WLAN watchdog event flag status.  Latched high when watchdog timer reaches programmed threshold
          Can be forced high by writing 1 to this register for debug purposes (to test event flag connectivity in hardware and software).</description>
                <lsb>0</lsb>
                <msb>0</msb>
