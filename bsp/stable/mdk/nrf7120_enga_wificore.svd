            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYBLOCKSIZE</name>
                <description>Block size for the energy calculation at the CIC decimator and the late gain stage, shifted right by 6.  Takes values in the range [1 ~ 2^14] and must be a power of 2.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>ENERGYCICENABLE</name>
                <description>Enable, disable the energy calculation on the input of the CIC decimator block.</description>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>EnergyCalculationDis</name>
                    <description>Energy calculation disabled.</description>
