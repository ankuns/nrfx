            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCMONITORSOURCE</name>
                <description>Selects the source for input to the DC Monitor:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TheOutputOfTheDrmDec</name>
