            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGRXLBDTIMMIXEREN</name>
                <description>Description of register goes here.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGRXLBDTIMV2IEN</name>
                <description>Description of register goes here.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGRXLBLNABTEN</name>
                <description>Description of register goes here.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLDIGRXLBLNAEN</name>
                <description>Description of register goes here.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGRXLBMAINDPDEN</name>
                <description>Description of register goes here.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGRXLBMAINLODIVEN</name>
                <description>Description of register goes here.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLDIGRXLBMAINMIXEREN</name>
                <description>Description of register goes here.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLDIGRXLBMAINV2IEN</name>
                <description>Description of register goes here.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGRXLBRSSIATBEN</name>
                <description>Description of register goes here.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLDIGRXLBRSSIEN</name>
                <description>Description of register goes here.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLDIGRXLBTRXSWEN</name>
                <description>Description of register goes here.</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLDIGRXLBV2ISWEN</name>
                <description>Description of register goes here.</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGRXLBWURLNAEN</name>
                <description>Description of register goes here.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLDIGRXLBWURLOBUFFEREN</name>
                <description>Description of register goes here.</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLDIGRXLBWURMIXEREN</name>
                <description>Description of register goes here.</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLDIGDIGHWMRXLBRSSIBUFEN</name>
                <description>Register enable for Rssi buffer enable</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPWRENABLE0</name>
            <description>Unspecified</description>
            <addressOffset>0x0E50</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGRXPWRBGCTATHPEN</name>
                <description>Enable high power constant temperature coefficient current reference</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGRXPWRBGCTATLPEN</name>
                <description>Enable low power constant temperature coefficient current reference</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGRXPWRBGEN</name>
                <description>Enable bandgap</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOEN</name>
                <description>Enable RXLDO
  0 : Power-down mode with bleed current
  1 : Startup and shut down with bleed current
  1 : Normal mode with regulated output
  0 : High impedance mode (LDO output = high impedance, do not use)</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOBLEEDENN</name>
                <description>Disable bleed current (resistive load)
  0 : Power-down mode with bleed current
  0 : Startup and shut down with bleed current
  1 : Normal mode with regulated output
  1 : High impedance mode (LDO output = high impedance, do not use)</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOLOADEN</name>
                <description>Enable resistive dummy load on RXVDD
  0 : 0uA (default)
  1 : 16.2uA</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RXPWRSCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x0E60</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000400</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGRXPWRBGCTATHPCTRL</name>
                <description>Adjust high power constant temperature coefficient current reference
  0 : 0.0 percent (expects VREF = 0.84V from WLPWR, default)
  1 : +10.0 percent (expects VREF = 0.76V from RXPWR)</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGRXPWRBGTRIM</name>
                <description>Adjust high power bandgap, temperature Coefficient
  0000 : TC 0.0 percent (default)
  0001 : TC -2.0 percent
  0010 : TC -1.0 percent
  0100 : TC +1.0 percent 
  1000 : TC +2.0 percent</description>
                <lsb>1</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOBIASCTRL</name>
                <description>Adjust RXLDO bias and stability. Higher equals better PSRR performance
  000 : 1.6uA (default)
  001 : 2.9uA
  011 : 4.2uA
  111 : 5.6uA
  
  WLDIGRXPWRLDOBIASCTRL and
  WLDIGRXPWRLDOSTBCTRL shall always be equal!</description>
                <lsb>5</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOTRIM</name>
                <description>Adjust RXVDD, only valid with the internal bandgap (WLDIGRXPWRVBGRXSEL = 1)
  0000 : 0.76V
  0001 : 0.76V
  0010 : 0.80V
  0100 : 0.84V (default)
  1000 : 0.88V</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGRXPWRATBTM1</name>
                <description>Enable ATB test mode 1</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLDIGRXPWRATBTM2</name>
                <description>Enable ATB test mode 2</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLDIGRXPWRVBGRXSEL</name>
                <description>Select bandgap voltage reference to RXLDO
  0 : External reference from WLPWR (default)
  1 : Internal reference from RXPWR</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLDIGRXPWRVBGSXSEL</name>
                <description>Select bandgap voltage reference to VBGSX output, connected to SXLP
  0 : External reference from WLPWR (default)
  1 : Internal reference from RXPWR</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLDIGRXPWRLDOSTBCTRL</name>
                <description>Adjust RXLDO bias and stability. Higher equals better PSRR performance
  000 : 1.6uA (default)
  001 : 2.9uA
  011 : 4.2uA
  111 : 5.6uA
  
  WLDIGRXPWRLDOBIASCTRL and
  WLDIGRXPWRLDOSTBCTRL shall always be equal!</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXHPMISC0</name>
            <description>Unspecified</description>
            <addressOffset>0x0E70</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXHPADPLLARSTN</name>
                <description>Asynchronous reset signal from AdPllCompanion. Operation will start when released.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGSXHPADPLLSTART</name>
                <description>The AdPll state machine for calibration starts when this signal goes from low to high.  The signal is fed back to Cell WLSXPWRSHIFT as signal name WLSXADPLLCLOCKSTARTEDINT where it is fed  to an AND gate together with WLSXPWRSXDIGVDDUP. The output from the AND is WLSXADPLLCLOCKSTARTED.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENALCRST</name>
                <description>Reset signal to WLLOALCFLASHADC2 for ALC in LOGEN.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENALCSAMPLE</name>
                <description>Sample signal to WLLOALCFLASHADC2 for ALC in LOGEN.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXHPSCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x0E80</addressOffset>
            <access>read-write</access>
            <resetValue>0x00100000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXHPATBCTRL</name>
                <description>Controls the ATB output. The order is  SXLOVDD,SXVCODVDD,SXVCOVDD,VREFTEST,SXDIGVDD,SXPQVDD,SXDTCDVDD,SXDTCVDD, ILOVDDDIV200,IVCOVDDDIV200,IPTATH[2],ICTAT[1],WLSXTDCATB,SXLOVDDUP,SXVCOVDDUP.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGSXHPBGCTRL</name>
                <description>Control word for bandgap WLSXPWRREF, one hot encoding. 0001 TC -2.0 percent 0010 TC -1.0 percent 0000 TC  0.0 percent (reset) 0100 TC +1.0 percent 1000 TC +2.0 percent</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGSXHPDCOBIASCTRL</name>
                <description>Programmability for DCO bias current 4'b0000 DCOBIAS=3.8mA 4'b0001 DCOBIAS=4.3mA 4'b0010 DCOBIAS=4.5mA 4'b0011 DCOBIAS=4.8mA 4'b0100 DCOBIAS=5.0mA (reset) 4'b0101 DCOBIAS=5.2mA 4'b0110 DCOBIAS=5.35mA 4'b0111 DCOBIAS=5.45mA 4'b1000 DCOBIAS=5.6mA 4'b1001 DCOBIAS=5.75mA 4'b1010 DCOBIAS=5.85mA 4'b1011 DCOBIAS=5.95mA 4'b1100 DCOBIAS=6.05mA 4'b1101 DCOBIAS=6.1mA 4'b1110 DCOBIAS=6.2mA 4'b1111 DCOBIAS=6.25mA</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGSXHPDTBCTRL</name>
                <description>DTB control</description>
                <lsb>12</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLDIGSXHPDTCCTRL</name>
                <description>Bit 1 WLSXDIGDTCCTRL[0] VDDDTC BLEED current WLSXDIGDTCCTRL[1] DTC bypass enable Rest is not connected.</description>
                <lsb>15</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>WLDIGSXHPDTCEDGEALIGN</name>
                <description>Signal in WLSXDTCDIG to switch FSDIV2PHASESELREGDTC0V8 either on  negative edge of CKREF or directly use from digital (pos edge).</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENBIASCTRL</name>
                <description>LOGEN bias setting.</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXHPSCTRL1</name>
            <description>Unspecified</description>
            <addressOffset>0x0E90</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXHPSXDIGVDDCTRL</name>
                <description>One hot encoding connected to IWLSXPWRLDOHLOGEN for Supply triming of Adpll.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXLOVDDCTRL</name>
                <description>One hot encoding connected to IWLSXPWRLDOHLOGEN for Supply triming of LOGEN.</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXPQVDDCTRL</name>
                <description>One hot encoding connected to IWLSXPWRLDOPQ for Supply triming of PHASEQUANT.</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXDTCVDDCTRL</name>
                <description>One hot encoding connected to IWLSXPWRDTCLDO for Supply triming of DTC.</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXVCOVDDCTRL</name>
                <description>One hot encoding connected to IWLSXPWRLDOHDCO for Supply triming of DCO.</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLDIGSXHPTDCCTRL</name>
                <description>Control word for TDC common mode voltage trimming.</description>
                <lsb>20</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXHPENABLE0</name>
            <description>Unspecified</description>
            <addressOffset>0x0EA0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000002</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXHPBGEN</name>
                <description>Enable signal for HP bandgap WLSXPWRREF.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGSXHPBGFILTERBYPEN</name>
                <description>Short circuits a resistance in the WLSXPWRREF bandgap filter to reduce startup time.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGSXHPCLKEN</name>
                <description>Not connected.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLDIGSXHPDCOEN</name>
                <description>Enables DCO.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENALCEN</name>
                <description>Enable LOGEN ALC</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENEN</name>
                <description>Enable LOGEN</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXDIGVDDEN</name>
                <description>Enable signal connected to Adpll LDO, IWLSXPWRLDOHLOGEN.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXDIGVDDBLEEDENN</name>
                <description>Enable LOW. Should be enabled (LOW) on startup and disabled in normal operation (HIGH).</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXLOVDDEN</name>
                <description>Enable signal connected to LOGEN LDO, IWLSXPWRLDOHLOGEN.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXLOVDDBLEEDENN</name>
                <description>Enable LOW. Should be enabled (LOW) on startup and disabled in normal operation (HIGH).</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXPQVDDEN</name>
                <description>Enable signal connected to PHASEQUANT LDO, IWLSXPWRLDOPQ.</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXPQVDDBLEEDENN</name>
                <description>Enable LOW. Should be enabled (LOW) on startup and disabled in normal operation (HIGH).</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXDTCVDDEN</name>
                <description>Enable signal connected to DTC LDO, IWLSXPWRDTCLDO.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXDTCVDDBLEEDENN</name>
                <description>Enable LOW. Should be enabled (LOW) on startup and disabled in normal operation (HIGH).</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXVCOVDDEN</name>
                <description>Enable signal connected to DCO LDO, IWLSXPWRLDOHDCO.</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>WLDIGSXHPSXVCOVDDBLEEDENN</name>
                <description>Enable LOW. Should be enabled (LOW) on startup and disabled in normal operation (HIGH).</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLDIGSXHPTDCPWRUPEN</name>
                <description>Enable signal for TDC.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXHPFCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x0EB0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXHPLOGENCAPCTRL</name>
                <description>Frequency dependent tuning cap for LOGEN matching.</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGSXHPLOGENDIVRATIOCTRL</name>
                <description>Ctrl divratio in LOGEN</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXLPMISC0</name>
            <description>Unspecified</description>
            <addressOffset>0x0EC0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXLPADPLLARSTN</name>
                <description>Asynchronous reset signal from AdPllCompanion. Operation will start when released</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGSXLPADPLLSTART</name>
                <description>The AdPll state machine for calibration starts when this signal goes from low to high.  The signal is fed back to Cell WLSXPWRSHIFT as signal name WLSXADPLLCLOCKSTARTEDINT where it is fed  to an AND gate together with WLSXPWRSXDIGVDDUP. The output from the AND is WLSXADPLLCLOCKSTARTED.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXLPFCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x0ED0</addressOffset>
            <access>read-write</access>
            <resetValue>0x000777A0</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXLPDCOACQOVRENCODED</name>
                <description>Override ACQ for free-running WUR mode. Binary, will be encoded as 'therm0' on output.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLDIGSXLPDCOPVTOVR</name>
                <description>Override PVT for free-running WUR mode.</description>
                <lsb>7</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGSXLPDCOTRKCOLOVRENCODED</name>
                <description>Override TRK column for free-running WUR mode. Binary, will be encoded as 'therm0' on output.</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLDIGSXLPDCOTRKROWOVRENCODED</name>
                <description>Override TRK row for free-running WUR mode. Binary, will be encoded as 'therm0' on output.</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SXLPSCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x0EE0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGSXLPATBCTRL</name>
                <description>Controls the ATB output.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGSXLPDCOBIASCTRLHB</name>
                <description>Programmability for DCO bias current.</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLDIGSXLPDCOBIASCTRLLB</name>
                <description>Programmability for DCO bias current.</description>
                <lsb>6</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLDIGSXLPDTBCTRL</name>
                <description>DTB setting.</description>
                <lsb>10</lsb>
                <msb>12</msb>
              </field>
