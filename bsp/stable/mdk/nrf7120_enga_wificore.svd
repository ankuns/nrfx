          <register>
            <name>IQCORRCONTROL</name>
            <description>SCP IQCORR CONTROL</description>
            <addressOffset>0xB0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>IQCORRENABLE</name>
                <description>Used to enable the IQ Correlator for detecting angle error on a Zero-IF input signal</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>IqCorrelatorIsDisabl</name>
                    <description>IQ Correlator is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IqCorrelatorIsEnable</name>
                    <description>IQ Correlator is enabled)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>IQCORRSTATUS</name>
