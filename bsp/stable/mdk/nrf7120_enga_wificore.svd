            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANSVDDMALENGTH</name>
                <description>Packed angles length in bytes. This length depends on the feedback type (SU or MU),
          on the number of sub-carriers (52 for VHT and 64 for HE) and on the number of LTFs (2, 3 or 4).
          For example, the maximum length will be for the case with 4 LTFs, MU type and 64 sub-carriers
          (6 angles per sub-carrier with length of 9+7+9+7+9+7 = 48 bits -&amp;gt; 64*48/8 = 384 bytes). (  .</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SNR</name>
