                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRTMTDCSMFCOESTDONE</name>
                <description>Indicates the fine frequency offset is estimated</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANRTMTDCSMDATAPROCESSED</name>
                <description>Indicates all the OFDM symbols are output to the FFT</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANRTMTDCCATIMERNONZERO</name>
                <description>CCA timer non-zero</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
            </fields>
