                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANFFTDYNAMICGAINSHIFTLOW</name>
                <description>FFT gain configuration (shift values) when WLANFFTDYNAMICGAIN is set and SC occupancy is Low</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
