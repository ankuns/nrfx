          <size>0x20</size>
          <fields>
            <field>
              <name>ALPHA</name>
              <description>Value for IIR feedback , drift estimator (hypermode)</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>VALIDTH</name>
              <description>Value for driftValidTh, drift estimator (hypermode)</description>
              <lsb>8</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>SATENABLEALWAYS</name>
              <description>Enable saturation in drift calculator for all modes</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DRIFT2</name>
          <description>Drift Estimator configuration</description>
          <addressOffset>0xB80</addressOffset>
          <access>read-write</access>
          <resetValue>0x0C8A0008</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>LOWTH</name>
              <description>Value for driftLowTh, drift estimator (hypermode)</description>
              <lsb>0</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>MAXDIST</name>
              <description>Value for driftMaxDist, drift estimator (hypermode)</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>DELAYTH</name>
              <description>Value for driftDelayTh, drift estimator (hypermode)</description>
              <lsb>20</lsb>
