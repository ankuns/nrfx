                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NOTCH0S</name>
                <description>Notch filter gain shift value</description>
                <lsb>4</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Shift1410DbBwFs</name>
                    <description>SHIFT=14   -10 dB BW ~= Fs / 20000  for L=0</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Shift1310DbBwFs</name>
                    <description>SHIFT=13   -10 dB BW ~= Fs / 10000  for L=0</description>
