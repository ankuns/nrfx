                    <value>0x08</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HesigaX</name>
                    <description>HESIGAX (HT)</description>
                    <value>0x09</value>
                  </enumeratedValue>
                  <enumeratedValue>
