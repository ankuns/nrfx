            <addressOffset>0x014</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGMEMYNUM</name>
                <description>Effective number of samples in Y-block, maximum 2048 12bits. Must by multiple of 4 for (FIR, FIR.X, L2NOM, ACC, MAR,MAR.X. Must be 512 for ACORR. Must be multiple of 2 for other operations.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>CFGMEMYSTRIDE</name>
                <description>Stride value, currently it is 2 bits.</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>CFGMEMYDATAWIDTH</name>
                <description>Data width for Y block, when cfg_mem_y_data_width_enable is 1. Otherwise cfg_cu_data_width is used.</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>CFGMEMYDATAWIDTHENABLE</name>
                <description>Enable use of Y block specific data width. Allowed only for MAR operation.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CFGMEMYOFFSET</name>
                <description>Offset value</description>
                <lsb>24</lsb>
                <msb>25</msb>
              </field>
              <field>
                <name>CFGMEMYMEMPACKEN</name>
                <description>Mem Pack Enable</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>CFGMEMYMEMPACK</name>
                <description>Mem Pack</description>
                <lsb>29</lsb>
                <msb>29</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGDESCAADDRRB</name>
            <description>A-block configuration register 1.</description>
            <addressOffset>0x018</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGAADDRRB</name>
                <description>First register address for A-block in SysMem. This should also be programmed to the delay value during Auto-Correlation comand (must be even value of delay).</description>
                <lsb>0</lsb>
                <msb>31</msb>
