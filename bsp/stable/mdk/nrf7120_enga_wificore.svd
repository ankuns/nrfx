                <description>Coefficient of final decimation filter in 2's complement format.
          Only valid for 12-bit SCP, SCPCOEFFADDR/DATA must be used for 16-bit SCP.
          NOTE: use FIRCOEFFSETSEL to select the coefficients set.</description>
                <lsb>14</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRBYPASS</name>
            <description>SCP FIR BYPASS</description>
            <addressOffset>0x238</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>FIRBYPASS</name>
                <description>Used to set the bypass mode of the FIR block.  When bypass is set the FIR block is powered down and data passes around it unaltered.  When set to Normal the block operates as programmed by the registers that control it.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalOperation</name>
                    <description>Normal operation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BlockBypassed</name>
                    <description>Block Bypassed (overrules any other block settings)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FIRCONTROL</name>
            <description>SCP FIR CONTROL</description>
            <addressOffset>0x23C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000005</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>FIROUTGAIN</name>
                <description>Selects Decimating FIR output gain to normalise the gain range (2.4 to 23):
          Where x is 0 for 12-bit SCP and 7 for 16-bit SCP.</description>
                <lsb>0</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GainOf132</name>
                    <description>Gain of 1/32 (&amp;gt;&amp;gt;14 + x) is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf116</name>
                    <description>Gain of 1/16 (&amp;gt;&amp;gt;13 + x) is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf18</name>
                    <description>Gain of 1/8  (&amp;gt;&amp;gt;12 + x) is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf14</name>
                    <description>Gain of 1/4  (&amp;gt;&amp;gt;11 + x) is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf12</name>
                    <description>Gain of 1/2  (&amp;gt;&amp;gt;10 + x) is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf10</name>
                    <description>Gain of 1.0  (&amp;gt;&amp;gt;9 + x)  is applied to the output of Final Stage Decimation - FIR Filter (default)</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf20</name>
                    <description>Gain of 2.0  (&amp;gt;&amp;gt;8 + x)  is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf40</name>
                    <description>Gain of 4.0  (&amp;gt;&amp;gt;7 + x)  is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf80</name>
                    <description>Gain of 8.0  (&amp;gt;&amp;gt;6 + x)  is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf160</name>
                    <description>Gain of 16.0 (&amp;gt;&amp;gt;5 + x)  is applied to the output of Final Stage Decimation - FIR Filter</description>
                    <value>0x9</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FIRCOEFFSETSEL</name>
                <description>Selects Decimating FIR Coefficients set (reading and writing):</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OfdmSet</name>
                    <description>OFDM set</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DsssSet</name>
                    <description>DSSS set</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FIRDYNAMICCOEFFS</name>
                <description>Enable dynamic decimation FIR coefficients selection (set 0 for OFDM, set 1 for DSSS).
          When disabled the set 0 is only used.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>FIRITERATIONNUM</name>
                <description>Number of FIR filter iteration cycles to perform per sample.  The FIR filter contains a filter with 24 taps.  Making use of the same filter for multiple cycles creates a virtual FIR filter with more taps.
          This field should be set as floor (FIRVIRTUALTAPNUM / FIRREALTAPNUM)-1, where FIRVIRTUALTAPNUM refers to the number of taps that are needed for the current application.
          Only valid for 16-bit SCP.</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>NOTCH0</name>
