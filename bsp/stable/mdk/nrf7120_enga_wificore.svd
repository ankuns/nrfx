            <size>0x20</size>
            <fields>
              <field>
                <name>MIXEROUTGAIN</name>
                <description>Selects Mixer output gain:
          NOTE: Using a setting of 2.0 increases the signal strength by 6 dB as both real &amp;amp; imaginary components are scaled.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GainOf10IsAppliedTo</name>
                    <description>Gain of 1.0 is applied to the output of Mixer rotator (default)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GainOf20IsAppliedTo</name>
                    <description>Gain of 2.0 is applied to the output of Mixer rotator (used to compensate for 0.5 gain in real input mode)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MIXERMETRICENABLE</name>
                <description>Used to enable the Mixer IQ level imbalance estimation metric generation:</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MixerIqMetricIsDisab</name>
                    <description>Mixer IQ metric is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MixerIqMetricIsEnabl</name>
                    <description>Mixer IQ metric is enabled)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>MIXERMETRICSTATUS</name>
