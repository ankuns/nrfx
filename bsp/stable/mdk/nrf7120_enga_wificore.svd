                <name>WLDIGTXPWRBGTRIM</name>
                <description>Adjust bandgap temperature coefficient
  0000 : TC 0.0 percent (default)
  0001 : TC -2.0 percent
  0010 : TC -1.0 percent
  0100 : TC +1.0 percent 
  1000 : TC +2.0 percent</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLDIGTXPWRLDOTRIM</name>
                <description>Adjust TXVDD
  0000 : 0.76V
  0001 : 0.76V
  0010 : 0.80V
  0100 : 0.84V (default)
  1000 : 0.88V</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLDIGTXPWRATBTM1</name>
                <description>Enable ATB test mode 1</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLDIGTXPWRATBTM2</name>
                <description>Enable ATB test mode 2</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TXPWRENABLE0</name>
            <description>Unspecified</description>
            <addressOffset>0x1040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGTXPWRLDOEN</name>
                <description>Enable TXLDO (TXVDD)
  0 : Power-down mode with bleed current
  1 : Startup and shut down mode with bleed current
  1 :  Normal mode with regulated output</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGTXPWRLDOBLEEDENN</name>
                <description>Disable bleed current (resistive load)
  0 : Power-down mode with bleed current
  0 : Startup and shut down mode with bleed current
  1 :  Normal mode with regulated output</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGTXPWRPWRMODEEN</name>
                <description>Select power mode
  0 : low power 
  1 : high power</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLDIGTXPWRREFEN</name>
                <description>Enable bandgap</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLPWRSCTRL0</name>
            <description>Unspecified</description>
            <addressOffset>0x1050</addressOffset>
            <access>read-write</access>
            <resetValue>0x001000C8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGWLPWRATBTM1</name>
                <description>Enable ATB test mode 1</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLDIGWLPWRATBTM2</name>
                <description>Enable ATB test mode 2</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLDIGWLPWRBGHPTRIM</name>
                <description>Adjust high power bandgap, temperature Coefficient
  0000 : TC +2 percent
  0001 : TC +1 percent
  0010 : TC 0 percent (default)
  0100 : TC -1 percent
  1000 : TC -2 percent</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLDIGWLPWRBGLPTRIM</name>
                <description>Adjust low power bandgap, absolute voltage and current
  0000 : +2 percent
  0001 : +1 percent
  0010 : 0 percent (default)
  0100 : -1 percent
  1000 : -2 percent</description>
                <lsb>6</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLDIGWLPWRIPTATPALDOSEL</name>
                <description>Select current bias source to PALDO
  0 : low power bandgap, 16uA from BGLP
  1 : high power bandgap, 16.8uA from BGHP (default)</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>WLDIGWLPWRIPTATRFLDOSEL</name>
                <description>Select current bias source to RFLDO
  0 : low power bandgap, 4uA (default)
  1 : high power bandgap, 16.8uA</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLDIGWLPWRIPTATTESTSEL</name>
                <description>Select current source to ATB
  0 : low power bandgap, 4uA from BGLP (default)
  1 : high power bandgap, from BGHP 16.8uA</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLDIGWLPWRPALDOBYP</name>
                <description>Enable bypass mode
  0 : Regulated output
  1 : PAVDD = RFVBAT (Target PAVDD= 3.6V)</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>WLDIGWLPWRPALDOTRIM</name>
                <description>Adjust PAVDD
  00000001: 2.70V
  00000010: 2.80V
  00000100: 2.90V
  00001000: 3.00V
  00010000: 3.10V
  00100000: 3.20V
  01000000: 3.30V (default)
  10000000: 3.40V</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLPWRSCTRL1</name>
            <description>Unspecified</description>
            <addressOffset>0x1060</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000004</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLDIGWLPWRRFLDOTRIM</name>
                <description>Adjust RFVDD
  00000 : 1.65V
  00001 : 1.70V
  00010 : 1.75V
  00100 : 1.80V (default)
  01000 : 1.85V
  10000 : 1.90V</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLDIGWLPWRVBGRFSEL</name>
                <description>Select voltage reference to RFLDO and PALDO
  0 : low power bandgap, 1.22V (default)
  1 : high power bandgap, 1.22V</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLDIGWLPWRATBVBGSEL</name>
                <description>Select bandgap voltage to ATB
  0 : Voltage reference, BGLP or BGHP (both 1.22V)
  1 : Voltage reference, BGLP (0.84V)</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
            </fields>
          </register>
