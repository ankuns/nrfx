                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AggregationIdle</name>
                    <description>Aggregation idle, can be reconfigured to process next job.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
