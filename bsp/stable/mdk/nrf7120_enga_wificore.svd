        <register>
          <name>CONFIG</name>
          <description>Configuration register</description>
          <addressOffset>0x50C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SLEEP</name>
              <description>Configure WDT to either be paused, or kept running, while the CPU is sleeping</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Pause</name>
                  <description>Pause WDT while the CPU is sleeping</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Run</name>
                  <description>Keep WDT running while the CPU is sleeping</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OFF</name>
              <description>Enable or disable override of system OFF mode</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>No impact on system OFF mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Prevent system OFF mode when WDT is running</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HALT</name>
              <description>Configure WDT to either be paused, or kept running, while the CPU is halted by the debugger</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <enumeratedValues>
