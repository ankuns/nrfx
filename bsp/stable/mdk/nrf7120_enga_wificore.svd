                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ehtdata</name>
                    <description>EHTDATA (HE)</description>
                    <value>0x13</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPGUARDDURATION</name>
                <description>Specifies the guard duration to be inserted or removed:</description>
                <lsb>5</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>04Us</name>
                    <description>0.4us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>08Us</name>
                    <description>0.8us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
