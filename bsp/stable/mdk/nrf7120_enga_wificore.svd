    <peripheral>
      <name>GLOBAL_GPIOINTERNALP2</name>
      <description>GPIO Internal</description>
      <baseAddress>0x50051E00</baseAddress>
      <headerStructName>GPIOINTERNAL</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <!--Split access-->
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>GPIOINTERNAL</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>LATCHCLRWAITCNT</name>
          <description>Select the number of wait cycles inserted on the bus when a LATCH register is cleared.</description>
          <addressOffset>0x40</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <!--Security securemapping=S-->
          <fields>
            <field>
              <name>LATCHCLRWAITCNT</name>
              <description>Select the number of wait cycles inserted on the bus when a LATCH register is cleared.</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FORCELDETECTLOWCNT</name>
          <description>Select the number of cycles that LDETECT is forced low after clearing a LATCH register.</description>
          <addressOffset>0x44</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <size>0x20</size>
          <!--Security securemapping=S-->
          <fields>
            <field>
              <name>FORCELDETECTLOWCNT</name>
              <description>Select the number of cycles that LDETECT is forced low after clearing a LATCH register.</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RESET</name>
          <description>Reset all GPIO registers.</description>
          <addressOffset>0x48</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <!--Security securemapping=S-->
          <fields>
            <field>
              <name>RESET</name>
              <description>Reset all GPIO registers.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Trigger reset</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NA</name>
                  <description>No effect</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SENSECONFIGCHANGECNT</name>
          <description>Selects the number of cycles before the SENSE configuration takes effect when it is changed. Setting this register lower than the reset value can lead to unwanted LATCH set
        when SENSE and INPUT fields (PIN[n].CNF) are changed simultaneously.</description>
          <addressOffset>0x4C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000003</resetValue>
          <size>0x20</size>
          <!--Security securemapping=S-->
          <fields>
            <field>
              <name>SENSECONFIGCHANGECNT</name>
              <description>Selects the number of cycles before the SENSE configuration takes effect when it is changed.</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <name>PCGC</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_GPIOINTERNAL_PCGC</headerStructName>
          <access>read-write</access>
          <addressOffset>0x160</addressOffset>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
