          <register>
            <name>STOPON</name>
            <description>Stop the DMA if the CORE goes into any of the enabled states.</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000003</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TXUNEXPECTEDIDLE</name>
                <description>The CORE will go into idle if the CORE buffer is emptied,
          if the DMA still has data to transfer the CORE is not expected to go into idle state. This constitutes a buffer underflow.
          The CORE migth also go into idle if an error occurs.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Stop on tx unexpected idle disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Stop on tx unexpected idle enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXOVERFLOW</name>
                <description>This condition occurrs if the DMA attempts to write to the RX buffer in the CORE, but the buffer is full. When this bit is enabled the DMA will stop when the CORE buffer experiences a rx buffer overflow</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Stop on rx overflow disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Stop on rx overflow enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INTERNALBUSERROR</name>
                <description>Terminate the transaction if a INTERNALBUSERROR event is detected.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMABUSERROR</name>
                <description>Terminate the transaction if a DMA.ERROR event is detected.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>AXIMODE</name>
            <description>Determines if AXI-lite or full AXI is used.</description>
            <addressOffset>0x010</addressOffset>
