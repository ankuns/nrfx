              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO0IN</name>
            <description>EDC GPIO0 IN</description>
            <addressOffset>0xC08</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO0IN</name>
                <description>Value input on bits 15:0 of UCCP top level GPIOIN pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO1IN</name>
            <description>EDC GPIO1 IN</description>
            <addressOffset>0xC0C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO1IN</name>
                <description>Value input on bits 31:16 of UCCP top level GPIOIN pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSRSTCTRL</name>
            <description>EDC PERIP TBUS RST CTRL</description>
            <addressOffset>0xC10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RESETTBUSID</name>
                <description>Port ID of TBus to reset.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>RESETOFFSETUNPACKER</name>
                <description>Reset Address Generator Offset unpacker.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>RESETTBUSWRUNPACKER</name>
                <description>Reset TBus write unpacker.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>RESETTBUSRDPACKER</name>
                <description>Reset TBus read packer.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>RESETTBUSRDPORT</name>
                <description>Reset TBus read port data held for next transfer.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PERFCTRL</name>
            <description>EDC PERIP PERF CTRL</description>
            <addressOffset>0xC14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMREADAHEAD</name>
                <description>For use in high read latency ExtRAM systems, should not be used in low latency ExtRAM systems as can reduce performance due to additional destination address generation latency.
          When enabled, address generator modes that make use of offsets (run-length, twisted-row-col, FIFO) are not supported for ExtRAM or GRAM TFRMODE=4 destination transfer from an ExtRAM source TFRMODE=1 transfer.
          ExtRAM-to-ExtRAM transfers are not supported when enabled.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotReadAheadFromE</name>
                    <description>Do not read-ahead from ExtRAM (appropriate setting for multi-channel ExtRAM reads).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ReadAheadFromExtram</name>
                    <description>Read-ahead from ExtRAM (appropriate setting for single-channel ExtRAM reads or multi-channel only where each channel has a unique EXTRAMID in range 0 to EDCEXTRAMREQS-1).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCSCPCTRL</name>
            <description>EDC SCP CTRL</description>
            <addressOffset>0xC18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EDCSCPKICK</name>
                <description>EDCSCPKICK[n]=1 causes update of SETADCPOWER/SETSCPPOWER/NEWADCPOWER/NEWSCPPOWER/INPUTI/INPUTQ registers within SCP[n] when SCPCONTROL2[n].SCPKICKENABLE=1.  Register auto-clears.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCDCPBASEADDR</name>
            <description>EDC DCP BASE ADDR</description>
            <addressOffset>0xC1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCPBASEADDR</name>
                <description>Base address of combined DCP code image (for use by debugger).</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANRXCTRL</name>
            <description>EDC PERIP WLAN RX CTRL</description>
            <addressOffset>0xC20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXFINAL</name>
                <description>Set to flag last Rx Job before posting final SCP input transfer.  Must be cleared following completion of SCP input job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXCTRL</name>
            <description>EDC PERIP WLAN TX CTRL</description>
            <addressOffset>0xC24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANTXFINAL</name>
                <description>Set to flag last Tx Job before posting final TX-SCP output transfer.  Must be cleared following completion of TX-SCP output job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS0</name>
            <description>EDC PERIP MEM ADDR MSBS0</description>
            <addressOffset>0xC2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID0ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 0 word address (bits 39:25 of the byte address).  Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS1</name>
            <description>EDC PERIP MEM ADDR MSBS1</description>
            <addressOffset>0xC30</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID1ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 1 word address (bits 39:25 of the byte address).  Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
