                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRXP11BPDCCRCFAIL</name>
                <description>Indicates PLCP header CRC check failure.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>WLANRXP11BSFSSYNCFOUND</name>
                <description>Indicates symbol synchronisation is found.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>WLANRXP11BCFOICOESTDONE</name>
