                <lsb>21</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UseHeSigBAndDataSy</name>
                    <description>Use HE-SIG-B and Data symbols CPE estimations (final HE-SIG-B in ppm is sum to the Data ppm estimations)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseHeSigBSymbolsCp</name>
                    <description>Use HE-SIG-B symbols CPE estimations only</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseDataSymbolsCpeEst</name>
                    <description>Use Data symbols CPE estimations only (if there is only one data Symbol then the HE-SIG-B is used)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTCPECFOESTDIS</name>
                <description>Disable the CFO estimation based on the CPE : ignore RXPCPECFOEST field</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
