                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANRXP11BPDCSFDDONE</name>
                <description>Indicates SFD has been detected.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANRXP11BPDCPLCPDONE</name>
