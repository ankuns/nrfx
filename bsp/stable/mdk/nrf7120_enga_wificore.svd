                <description>The ID number of the queue which caused the least recent error.  This field is read-only</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>OVERFLOW</name>
                <description>The least recent queue error was an overflow.  This field is read-only</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>UNDERFLOW</name>
                <description>The least recent queue error was an underflow.  This field is read-only</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
