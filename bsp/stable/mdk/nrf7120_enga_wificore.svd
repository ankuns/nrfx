            <size>0x20</size>
            <fields>
              <field>
                <name>SOFTRESET</name>
                <description>Timers core soft reset.  This bit is used to reset everything but the control registers.  The soft reset should be applied after reprogramming the control registers and setting TIMERSENABLE.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DeAssertResetToCore</name>
