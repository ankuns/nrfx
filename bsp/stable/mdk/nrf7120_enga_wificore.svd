                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>OPPTRC</name>
                <description>When executing primitive arithmetic operations, this pointer defines the location (0x0 to 0xF) where the result will be stored in memory.</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>OPPTRN</name>
