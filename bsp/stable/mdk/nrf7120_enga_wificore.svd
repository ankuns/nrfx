        <register>
          <name>DBCORRADAP</name>
          <description>Adaptive thresholds for double correlator.</description>
          <addressOffset>0xB58</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000037D</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TH</name>
              <description>A ratio to update the DBC ratio threshold when adaptive threshold is enabled and a strong peak is found. Fraction of highest correlator match historically seen. Setting of 0.90625 is default.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>DE</name>
              <description>A ratio to decay the DBC ration threshold when using adaptive threshold and a weak peak is found.</description>
              <lsb>5</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>OFFS</name>
              <description>Offset for comparing between current and historical DBC magnitude</description>
              <lsb>10</lsb>
              <msb>16</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MNSTORED</name>
          <description>Stored value of Cn and Pn from the double correlator at the last detect</description>
          <addressOffset>0xB5C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CNMIDSQUARED</name>
              <description>Squared value of Cn which can be used to find Mn associated with the last double correlator detect</description>
              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>PNMIDSQUARED</name>
              <description>Squared value of Pn which can be used to find Mn associated with the last double correlator detect</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CNEARLYLATE</name>
          <description>The Cn value associated with the clock cycle before and after the actually double correlator peak was found (detect)</description>
          <addressOffset>0xB60</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CNEARLYSQUARED</name>
              <description>Squared value of Cn before the peak</description>
              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>CNLATESQUARED</name>
              <description>Squared value of Cn after the peak</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
