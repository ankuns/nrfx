                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Custom modulation disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Custom modulation enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CIRCULARDMA</name>
              <description>If set to 1, the END event of the DMA will trigger the START task in order to transmit the same data over and over again (only works if DmaChannelPeripheral is inside AdPllCompanion)</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSCLOCKSELECT</name>
          <description>Set the clock source for the AdPll digital island</description>
          <addressOffset>0x0818</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>INTERNAL</name>
              <description>Set the clock source for the AdPll digital island when fsStart is high</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>CORE</name>
              <description>Set the clock source for the AdPll digital island when fsStart is low</description>
              <lsb>2</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>STOP</name>
              <description>Force-stopping the clock internally in the AdPll island</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>OVRVAL</name>
              <description>Used instead of 'fsStart' if FSCLOCKSELECT.OVREN is set</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
            <field>
              <name>OVREN</name>
              <description>Override enable for setting the clock switch. If 0, fsStart decides which clock to use. If 1, FSCLOCKSELECT.OVRVAL selects which clock to use</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSUNITRIGCALVAL</name>
          <description>Read the calibrated value for the universal trigger</description>
          <addressOffset>0x081C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FSUNITRIGCALVAL</name>
              <description>Read the calibrated value for the universal trigger</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSUNITRIGMANUAL</name>
