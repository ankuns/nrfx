            <size>0x20</size>
            <fields>
              <field>
                <name>NEWSCPPOWER</name>
                <description>This field determines the power state of the SCP following the next occurrence of the frame COMPAREEVENT.</description>
                <lsb>14</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoChange</name>
                    <description>No change</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LowPowerMode</name>
                    <description>Low-power mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOn</name>
                    <description>Power-on</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOff</name>
                    <description>Power-off</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NEWADCPOWER</name>
                <description>This field determines the power state of the ADC following the next occurrence of the frame COMPAREEVENT.</description>
                <lsb>16</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoChange</name>
                    <description>No change</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LowPowerMode</name>
                    <description>Low-power mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOn</name>
                    <description>Power-on</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PowerOff</name>
                    <description>Power-off</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NEWACTIVEFRAME</name>
                <description>This field determines which will be the active frame following the next occurrence of the frame COMPAREEVENT.</description>
                <lsb>18</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoChange</name>
                    <description>No change</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NoChange1</name>
                    <description>No change</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FrameAActive</name>
                    <description>Frame A Active</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FrameBActive</name>
                    <description>Frame B active</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FRAMECOMPARESYMBOL</name>
            <description>SCP FRAME COMPARE SYMBOL</description>
            <addressOffset>0x17C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>COMPARESYMBOLA</name>
                <description>COMPAREEVENT is asserted whenever the following condition is true:
          SYMBOLNUMBERA = COMPARESYMBOLA
          and
          SAMPLENUMBERA = COMPARESAMPLEA.
          This will cause the assertion of IRQSCP if COMPAREENABLE is set.</description>
                <lsb>8</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>FRAMECOMPARESAMPLE</name>
