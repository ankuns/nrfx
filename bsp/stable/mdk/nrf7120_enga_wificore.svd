                <lsb>16</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>S1INCL</name>
                <description>Include or exclude S1 field in RAM</description>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
