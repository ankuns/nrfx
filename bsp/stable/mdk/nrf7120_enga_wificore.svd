            <addressOffset>0x088</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGINFMAPCONFIGSTRIDE</name>
                <description>Offset value to required stripe of input feature map. Units in bytes. Minimum allowed value is equal to number of bytes in the columns width.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CFGINFMAPCONFIGBITWIDTH</name>
                <description>Bit width of input feature map pixels. For feature map only 4 and 8 bits are supported.</description>
                <lsb>16</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BITS04</name>
                    <description>Unspecified</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BITS08</name>
                    <description>Unspecified</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BITS16</name>
                    <description>Unspecified</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BITS32</name>
                    <description>Unspecified</description>
                    <value>0x5</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGINFMAPCONFIGDISABLELOAD</name>
                <description>When logic 1, AXON pro will not load input feature map from memory, instead it will reuse the previous data stored in the line buffer.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>CFGINFMAPCONFIGLINES</name>
                <description>Indicates the number of lines to prefetch and use in internal line buffer storage.</description>
                <lsb>20</lsb>
                <msb>29</msb>
              </field>
              <field>
                <name>CFGINFMAPCONFIGOFFSET</name>
                <description>When logic 1, starts at upper nibble of indicated byte address in 4 bit mode. When logic 0, starts at lower nibble of indicated byte address. Must be set to 0 if bit width is larger than 4 bits.</description>
                <lsb>30</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>CFGINFMAPCONFIGSTRIDEOFFSET</name>
                <description>When logic 1, addes a nibble offset to stride</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
