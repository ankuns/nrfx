    <peripheral>
      <name>GLOBAL_CCM00</name>
      <description>AES CCM Mode Encryption</description>
      <baseAddress>0x5004A000</baseAddress>
      <alternatePeripheral>GLOBAL_AAR00</alternatePeripheral>
      <headerStructName>CCM</headerStructName>
      <!--Security dma=SA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
