            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DRMDECRATIO</name>
                <description>Decimation ratio (if DRMDECEN is set):
          0:   Decimate by 1 (no decimation)
          1:   Decimate by 2
          15:   Decimate by 16</description>
                <lsb>8</lsb>
                <msb>11</msb>
