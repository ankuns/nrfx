            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCCOUNT</name>
                <description>Current value of the AGC sample counter. This counts pairs of input samples (I and Q).</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCCLIPCOUNTI</name>
            <description>SCP AGC CLIP COUNT I</description>
            <addressOffset>0xD0</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CLIPCOUNTI</name>
                <description>The number of IF samples at either extreme of the ADC range (greater than AGCCLIP) recorded during the last complete AGCPERIOD of the I sample stream.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCTHRESHCOUNTI</name>
            <description>SCP AGC THRESH COUNT I</description>
            <addressOffset>0xD4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>THRESHCOUNTI</name>
                <description>The number of IF samples with absolute value greater than AGCTHRESH recorded during the last complete AGCPERIOD of the I sample stream.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AGCCLIPCOUNTQ</name>
