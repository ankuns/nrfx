            <addressOffset>0xD8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CLIPCOUNTQ</name>
                <description>The number of IF samples at either extreme of the ADC range (greater than AGCCLIP) recorded during the last complete AGCPERIOD of the Q sample stream.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
