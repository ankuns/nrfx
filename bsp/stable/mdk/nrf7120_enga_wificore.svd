                    <description>64-QAM (Constellation size M =  64) (Nbpsc = 6, Nbpsc/2 = 3)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>256Qam</name>
                    <description>256-QAM (Constellation size M = 256) (Nbpsc = 8, Nbpsc/2 = 4)</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXPINTERLEAVER4CONTROL</name>
            <description>WLAN TXP INTERLEAVER 4 CONTROL</description>
            <addressOffset>0x1C</addressOffset>
