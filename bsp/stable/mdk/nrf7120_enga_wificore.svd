                    <value>0x05</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Vhtdata</name>
                    <description>VHTDATA (VHT)</description>
                    <value>0x06</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rlsig</name>
                    <description>RLSIG (L)</description>
                    <value>0x07</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HesigaSu</name>
                    <description>HESIGASU (HT)</description>
                    <value>0x08</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HesigaX</name>
                    <description>HESIGAX (HT)</description>
                    <value>0x09</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HesigaEr</name>
                    <description>HESIGAER (HT)</description>
                    <value>0x0A</value>
                  </enumeratedValue>
                  <enumeratedValue>
