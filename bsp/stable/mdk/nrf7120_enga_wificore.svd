                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>OFDMCORRDETTHRESMETRIC1</name>
                <description>OFDM correlation detection metric 1 threshold. It has a range of -31.75 .. 0 (s5.2). Default value is -1.5.</description>
                <lsb>1</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>OFDMCORRDETTHRESMETRIC2</name>
                <description>OFDM correlation detection metric 2 threshold. It has a range of -31.75 .. 0 (s5.2). Default value is -3.5.</description>
                <lsb>9</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDOFDMCORRCONFIG1</name>
            <description>WLAN ED OFDM CORR CONFIG 1</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00ECECEC</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFDMCORRDETTHRESMETRIC3</name>
                <description>OFDM correlation detection metric 3 threshold. It has a range of -31.75 .. 0 (s5.2). Default value is -5.0.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>OFDMCORRDETTHRESMETRIC4</name>
                <description>OFDM correlation detection metric 4 threshold. It has a range of -31.75 .. 0 (s5.2). Default value is -5.0.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>OFDMCORRDETTHRESMETRIC5</name>
                <description>OFDM correlation detection metric 5 threshold. It has a range of -31.75 .. 0 (s5.2). Default value is -5.0.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
