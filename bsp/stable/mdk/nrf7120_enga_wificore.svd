                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt40</name>
                  <description>Gfsk Bt=0.40</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0bt45</name>
