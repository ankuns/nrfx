            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCMONITORI</name>
                <description>Measures the DC component of the I signal from the ADC to allow feedback to the RF to reduce the long-term DC offset to zero.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCMONITORQ</name>
            <description>SCP DC MONITOR Q</description>
            <addressOffset>0xE4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCMONITORQ</name>
                <description>Measures the DC component of the Q signal from the ADC to allow feedback to the RF to reduce the long-term DC offset to zero.
          This value is latched and held when the IRQSCP interrupt is asserted due to AGCCOUNTSEVENT.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCBYPASS</name>
            <description>SCP DC BYPASS</description>
            <addressOffset>0xE8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCBYPASS</name>
                <description>Used to set the bypass mode of the DC Offset block.  When bypass is set the DC Offset block is powered down and data passes around it unaltered.  When set to Normal the block operates as programmed by the registers that control it.</description>
