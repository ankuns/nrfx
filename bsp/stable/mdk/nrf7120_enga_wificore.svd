                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AssertResetToCore</name>
                    <description>Assert reset to core</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TIMERSENABLE</name>
                <description>Timers module enable/disable.</description>
                <lsb>1</lsb>
