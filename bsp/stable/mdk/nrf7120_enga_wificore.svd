              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>ABSMAXTHR</name>
              <description>maximum baseline value before the peak at the double correlator output. if the baseline value is above the threshold, the following peak will be ignored. this value is ignored when CNABSMAXTHR is set to 0x0000.</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
