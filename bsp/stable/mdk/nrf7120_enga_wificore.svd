              <field>
                <name>WLANRXPAUTOCONFIGMCS</name>
                <description>MCS
          Legacy-0: BPSK rate 1/2
          Legacy-1: BPSK rate 3/4
          Legacy-2: QPSK rate 1/2
          Legacy-3: QPSK rate 3/4
          Legacy-4: 16-QAM rate 1/2
          Legacy-5: 16-QAM rate 3/4
          Legacy-6: 64-QAM rate 2/3
          Legacy-7: 64-QAM rate 3/4
          HT-0: BPSK rate 1/2
          HT-1: QPSK rate 1/2
          HT-2: QPSK rate 3/4
          HT-3: 16-QAM rate 1/2
          HT-4: 16-QAM rate 3/4
          HT-5: 64-QAM rate 2/3
          HT-6: 64-QAM rate 3/4
          HT-7: 64-QAM rate 5/6
          VHT-0: BPSK rate 1/2
          VHT-1: QPSK rate 1/2
          VHT-2: QPSK rate 3/4
          VHT-3: 16-QAM rate 1/2
          VHT-4: 16-QAM rate 3/4
          VHT-5: 64-QAM rate 2/3
          VHT-6: 64-QAM rate 3/4
          VHT-7: 64-QAM rate 5/6
          VHT-8: 256-QAM rate 3/4
          VHT-9: 256-QAM rate 5/6
          HE-0: BPSK rate 1/2
          HE-1: QPSK rate 1/2
          HE-2: QPSK rate 3/4
          HE-3: 16-QAM rate 1/2
          HE-4: 16-QAM rate 3/4
          HE-5: 64-QAM rate 2/3
          HE-6: 64-QAM rate 3/4
          HE-7: 64-QAM rate 5/6
          HE-8: 256-QAM rate 3/4
          HE-9: 256-QAM rate 5/6
          HE-10: 1024-QAM rate 3/4
          HE-11: 1024-QAM rate 5/6</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGFECTYPE</name>
