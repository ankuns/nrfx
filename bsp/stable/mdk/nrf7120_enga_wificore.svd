          <resetValue>0x00010000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SATURATIONMODE</name>
              <description>Set how input saturation will be present in the captured samples</description>
              <lsb>16</lsb>
              <msb>17</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Off</name>
                  <description>No saturation is presented</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SetMinVal</name>
                  <description>Saturation is marked by setting both I and Q to -32768 (or mag/phase if SAMPLETYPE is 1)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SaturationBit</name>
                  <description>Bit 15 of both the I and Q values indicates saturation. I and Q are hence only 15 bit values</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEVERIGNORESAT</name>
              <description>Selects whether saturation (being reported from the radio front-end) should be ignored in the beginning of the slot or not</description>
              <lsb>18</lsb>
              <msb>18</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Ignore</name>
                  <description>Saturation being indicated from the front-end is ignored if it happens in the first 40 percent of the sample spacing after a sample was saved to RAM</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NeverIgnore</name>
                  <description>Saturation is always reported in RAM if detected by the frontend</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DFEOFFSETSTDHYP</name>
              <description>Tuning of the timing difference between the hypermode demodulator and the standard demodulator for the DFE start event, in 62.5 ns units</description>
              <lsb>24</lsb>
              <msb>28</msb>
            </field>
          </fields>
