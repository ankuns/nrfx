              <field>
                <name>WLANTXPINTERLEAVER3BUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for TXP Bit Interleaver operation.  Note that each buffer storage element holds Nbpsc bits of data.
          It is defined as WLANTXPINTERLEAVER3NROWS multiplied by WLANTXPINTERLEAVER3NCOLS - the value in this register is ONLY valid when it is derived from valid values in those two registers.</description>
                <lsb>11</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANTXPINTERLEAVER3CONSTMAPMODE</name>
                <description>Specifies the constellation mapping mode.  Valid values are below.  Other values are reserved and should not be used.
          Relevant when WLANTXPTXMODE is 0. Note mapping mode of 256-QAM is only valid if WLANTXPWIFIACSUPPORT = 1.</description>
                <lsb>20</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Bpsk</name>
                    <description>BPSK   (Constellation size M =   2) (Nbpsc = 1, Nbpsc/2 = 1 rounded up from 0.5)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Qpsk</name>
                    <description>QPSK   (Constellation size M =   4) (Nbpsc = 2, Nbpsc/2 = 1)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Qam</name>
                    <description>16-QAM (Constellation size M =  16) (Nbpsc = 4, Nbpsc/2 = 2)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
