            <resetValue>0x00000191</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DSSSCORRENABLE</name>
                <description>Enable the WLAN ED DSSS correlation module.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DSSSCORRTHRES</name>
                <description>DSSS correlation threshold. It has a range of 0 .. 255.</description>
                <lsb>1</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRSSIESTCONFIG</name>
            <description>WLAN ED RSSI EST CONFIG</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00009F9F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIEDTHRESHOLDOFDM</name>
                <description>RSSI estimation threshold (dBm) to be used when ofdmDetected is true. It has a range of -128 .. 127. Default value is -97.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RSSIEDTHRESHOLDDSSS</name>
                <description>RSSI estimation threshold (dBm) to be used when dsssDetected is true. It has a range of -128 .. 127. Default value is -97.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRSSIESTCONFIG1</name>
            <description>WLAN ED RSSI EST CONFIG 1</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x000043AF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIESTCOMPFACTOR</name>
                <description>RSSI estimation compensation factor (F) in dB.
          It has a range of 0 .. 127.
          This is used in computing the RSSI given the variance and corresponding analog gain in dB.
          rssiInDbm = varDb - gainDb - RSSIESTCOMPFACTOR</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>RSSIESTACIENABLE</name>
                <description>Enable Adjacent Channel Interference.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RSSIESTACITHRESDB</name>
                <description>RSSI estimation ACI dB threshold. It has a range of 0 .. 63.</description>
                <lsb>8</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>RSSIESTLEEENABLE</name>
                <description>Enable Low Energy Event.</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>RSSIESTLEECLEAR</name>
                <description>Clear Low Energy Event.</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRSSIESTCONFIG2</name>
            <description>WLAN ED RSSI EST CONFIG 2</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00142288</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIESTLEEMARGINDB</name>
                <description>Low Energy Event dB margin. It has a range of 0 .. 31.</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>RSSIESTLEECONSECLOWS</name>
                <description>Number of consecutive lows for Low Energy Event. It has a range of 0 .. 15.</description>
                <lsb>5</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>RSSIESTPOPENABLE</name>
                <description>Enable Packet Over Packet.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>RSSIESTPOPDIFFTHRESOFDM</name>
                <description>Packet over packet difference threshold for OFDM. It has a range of 0 .. 255.</description>
                <lsb>10</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>RSSIESTPOPDIFFTHRESDSSS</name>
                <description>Packet over packet difference threshold for DSSS. It has a range of 0 .. 255.</description>
                <lsb>18</lsb>
                <msb>25</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRSSIESTCONFIG3</name>
            <description>WLAN ED RSSI EST CONFIG 3</description>
            <addressOffset>0x2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x0003C2AE</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIESTCCAP20DETTHRES</name>
                <description>Clear Channel Assessment detection threshold. It has a range of -127 .. 0. Default value is -82.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RSSIESTCCAP20BUSYTHRES</name>
                <description>Clear Channel Assessment busy threshold. It has a range of -127 .. 0. Default value is -62.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>RSSIESTCCASUPPRESSACI</name>
                <description>If this bit is '1', then CCA will be suppressed ('0') if ACI detected signal is '1'. Else CCA behaves normally.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>RSSIESTCCASUPPRESSAACI</name>
                <description>If this bit is '1', then CCA will be suppressed ('0') if AACI detected signal is '1'. Else CCA behaves normally.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRSSIESTCONFIG4</name>
            <description>WLAN ED RSSI EST CONFIG 4</description>
            <addressOffset>0x30</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000055</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIESTPOPTRIGAGCENABLE</name>
                <description>Enable POP trigger generation for AGC when POP event.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>RSSIESTPOPTRIGAGCTHRESDB</name>
                <description>POP trigger for AGC threshold. It has a range of 0 .. 127. Default value is 42.</description>
                <lsb>1</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMPRLCONFIG</name>
            <description>WLAN ED MPRL CONFIG</description>
            <addressOffset>0x34</addressOffset>
            <access>read-write</access>
            <resetValue>0x0020198A</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MPRLRESET</name>
                <description>Reset the DSSS mid-packet rejection logic. Default value is 0.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MPRLENABLE</name>
                <description>Enable the DSSS mid-packet rejection logic. Default value is 1.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>MPRLNUMEARLYEXITTRIG</name>
                <description>Number of consecutive DSSS early exits to trigger mid-packet detection. It has a range of 1 .. 15. Default value is 2.</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>MPRLPOWERRISEMARGINDB</name>
                <description>Power rise margin used to exit mid-packet rejection state (compared to the power at packet detection when rejection was triggered). It has a range of 1 .. 15. Default value is 6.</description>
                <lsb>6</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>MPRLPOWERFALLMARGINDB</name>
                <description>Power fall margin used to exit mid-packet rejection state (compared to the power at packet detection when rejection was triggered). It has a range of 1 .. 15. Default value is 6.</description>
                <lsb>10</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>MPRLDISAPPEARCOUNT</name>
                <description>Number of consecutive zeros for the DSSS correlation flag to consider DSSS signal disappeared (while RSSI is above DSSS threshold). It has a range of 1 .. 255. Default value is 128.</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDNHCONFIG</name>
            <description>WLAN ED NH CONFIG</description>
            <addressOffset>0x38</addressOffset>
            <access>read-write</access>
            <resetValue>0x00007640</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NHRESET</name>
                <description>Reset the noise histogram accumulator.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>NHENABLE</name>
                <description>Enable the noise histogram computation (Enable RSSI estimation accumulation).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>NHACCUMLEN</name>
                <description>Set the noise histogram accumulation length:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>2101</name>
                    <description>2^10-1</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2151</name>
                    <description>2^15-1</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2181</name>
                    <description>2^18-1</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2201</name>
                    <description>2^20-1</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NHCHLOADENABLE</name>
                <description>Enable noise histogram channel load counter.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>NHCHLOADTHRESH</name>
                <description>Noise histogram channel load threshold. It has a range from -127 .. 0.</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>NHCHLOADCOUNTLEN</name>
                <description>Noise histogram channel load length:</description>
                <lsb>13</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>2121</name>
                    <description>2^12-1</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2161</name>
                    <description>2^16-1</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2201</name>
                    <description>2^20-1</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2241</name>
                    <description>2^24-1</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR</name>
            <description>WLAN ED MONITOR</description>
            <addressOffset>0x3C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PACKETDETECTED</name>
                <description>'1' indicates either OFDM/DSSS packet has been detected and TD processing is in progress</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>PACKETTYPE</name>
                <description>Indicates the type of packet detected:</description>
                <lsb>1</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unknown</name>
                    <description>UNKNOWN,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ofdm</name>
                    <description>OFDM,</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Dsss</name>
                    <description>DSSS</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>S2LDONE</name>
                <description>'1' indicates s2l event has occurred (either s2lPass or s2lFail)</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>S2LPASS</name>
                <description>Holds the value of s2l pass/fail status. If '1' s2l Pass, '0' s2l fail(timeout). This is valid only when S2LEVENT is high</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>OFDMDETTOS2LCOUNT</name>
                <description>Contains the count in num of 20MHz samples from the time pktDetected happens to s2lPass</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>ACIDET</name>
                <description>'1' indicates an ACI signal is present and hence ED detections will not happen</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>CCARSSIABOVECCATHRES</name>
                <description>'1' indicates the RSSI is above the CCA threshold (RSSIESTCCAP20BUSYTHRES)</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>CCARSSIABOVEDETTHRES</name>
                <description>'1' indicates the RSSI is above the Detection threshold (RSSIESTCCAP20DETTHRES)</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CFOESTVALID</name>
                <description>'1' indicates CFO estimation is completed</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>OFDMDETMETRIC</name>
                <description>OFDM correlation metrics vector [metric5 .. metric1].</description>
                <lsb>17</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>JAMMERDETECTED</name>
                <description>'1' indicates a jammer signal is detected (number of consecutive s2l failures reach JRLNUMS2LFAILTRIG).</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>RSSIESTSLOWSTABLE</name>
                <description>RSSI estimation slow stable (s7.0).</description>
                <lsb>23</lsb>
                <msb>30</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR1</name>
            <description>WLAN ED MONITOR 1</description>
            <addressOffset>0x40</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFOESTATS2LREAL</name>
                <description>( 24-bit complex (s23.0)) Real part of CFO estimation e^j.theeta, where theeta = (2**pi**fHz**16/20e6) - fHz is CFO in Hz .</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>JAMMERDETECTEDTHRESHDB</name>
                <description>Jammer threshold in dB (s7.0).</description>
                <lsb>24</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR2</name>
            <description>WLAN ED MONITOR 2</description>
            <addressOffset>0x44</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFOESTATS2LIMAG</name>
                <description>( 24-bit complex (s23.0)) Imaginary part of CFO estimation e^j.theeta, where theeta = (2**pi**fHz**16/20e6) - fHz is CFO in Hz .</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR3</name>
            <description>WLAN ED MONITOR 3</description>
            <addressOffset>0x48</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCESTATS2LREAL</name>
                <description>Real part of DC estimation at s2L detection (12-bit complex (s9.2)).</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>DCESTATS2LIMAG</name>
                <description>Imag part of DC estimation at s2L detection (12-bit complex (s9.2)).</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>DCESTATS2LVALID</name>
                <description>DC estimation at s2L detection valid flag.</description>
                <lsb>24</lsb>
                <msb>24</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR4</name>
            <description>WLAN ED MONITOR 4</description>
            <addressOffset>0x4C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCESTATSECAGCREAL</name>
                <description>Real part of DC estimation at second AGC (12-bit complex (s9.2)).</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>DCESTATSECAGCIMAG</name>
                <description>Imag part of DC estimation at second AGC (12-bit complex (s9.2)).</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>DCESTATSECAGCVALID</name>
                <description>DC estimation at second AGC valid flag.</description>
                <lsb>24</lsb>
                <msb>24</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR5</name>
            <description>WLAN ED MONITOR 5</description>
            <addressOffset>0x50</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSIESTATPACKETDET</name>
                <description>RSSI estimation at packet detection (s7.0).</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RSSIESTATPACKETDETVALID</name>
                <description>RSSI estimation at packet detection valid flag.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>RSSIESTAFTERSECAGC</name>
                <description>RSSI estimation after second AGC (s7.0).</description>
                <lsb>9</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>RSSIESTAFTERSECAGCVALID</name>
                <description>RSSI estimation after second AGC valid flag.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>DSSSMIDPACKETDETECTED</name>
                <description>'1' indicates a DSSS mid-packet is detected (number of consecutive early exists reach MPRLNUMEARLYEXITTRIG).</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>DSSSMIDPACKETPOWER</name>
                <description>Detected DSSS mid-packet power (s7.0).</description>
                <lsb>19</lsb>
                <msb>26</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR6</name>
            <description>WLAN ED MONITOR 6</description>
            <addressOffset>0x54</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NHACCUMVALUE</name>
                <description>Noise histogram accumulation value. It has a range of 0 .. (2^28)-1. The average noise power in dBm is got by NHACCUMVALUE/NHACCUMCOUNT.</description>
                <lsb>0</lsb>
                <msb>27</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR7</name>
            <description>WLAN ED MONITOR 7</description>
            <addressOffset>0x58</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NHACCUMCOUNT</name>
                <description>Noise histogram accumulation count. It has a range of 0 .. (2^20)-1.  The average noise power in dBm is got by NHACCUMVALUE/NHACCUMCOUNT.</description>
                <lsb>0</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDMONITOR8</name>
            <description>WLAN ED MONITOR 8</description>
            <addressOffset>0x5C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NHCHANNELLOADCOUNT</name>
                <description>Noise histogram channel load count. It has a range of 0 .. (2^24)-1.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDSTATUS</name>
            <description>WLAN ED STATUS</description>
            <addressOffset>0x60</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EDEVENT</name>
                <description>Packet detection has happened. If this register contains a '1' in real time, it means the ED event has not been cleared by PHY indicating a lockup.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>S2LEVENT</name>
                <description>S2l Pass/Fail has happened. If this register contains a '1' in real time, it means the S2L event has not been cleared by PHY indicating a lockup.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>LOWENERGYEVENT</name>
                <description>Low Energy Event has happened (Jammer disappearance). If this register contains a '1' in real time, it means the LEE event has not been cleared by PHY indicating a lockup.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>POPEVENT</name>
                <description>Packet Over Packet event. If this register contains a '1' in real time, it means the POP event has not been cleared by PHY indicating a lockup.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>AGCPOPTRIG</name>
                <description>Packet Over Packet indication to AGC. If this register contains a '1' in real time, it means the AGC in-progess has not been set after a POP event indicating a lockup.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>AGCTRIGOVERPACKET</name>
                <description>AGC trigger Event after packet detection (equivalent to POPEVENT). If this register contains a '1' in real time, it means the AgcTrigger event has not been cleared by PHY indicating a lockup.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>OFDMFIFOOVERFLOWSTALL</name>
                <description>This field asserts if the ED ODFM FIFO has attempted to stall to prevent an overflow. Clear when OFDMFIFOSTALLFLAGSRESET is set.</description>
                <lsb>26</lsb>
                <msb>26</msb>
              </field>
              <field>
                <name>OFDMFIFOUNDERFLOWSTALL</name>
                <description>This field asserts if the ED ODFM FIFO has attempted to stall to prevent an underflow. Clear when OFDMFIFOSTALLFLAGSRESET is set.</description>
                <lsb>27</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>RSSIFIFOOVERFLOWSTALL</name>
                <description>This field asserts if the ED RSSI FIFO has attempted to stall to prevent an overflow. Clear when RSSIFIFOSTALLFLAGSRESET is set.</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>RSSIFIFOUNDERFLOWSTALL</name>
                <description>This field asserts if the ED RSSI FIFO has attempted to stall to prevent an underflow. Clear when RSSIFIFOSTALLFLAGSRESET is set.</description>
                <lsb>29</lsb>
                <msb>29</msb>
              </field>
              <field>
                <name>DATAFIFOOVERFLOWSTALL</name>
                <description>This field asserts if the ED DATA FIFO has attempted to stall to prevent an overflow. Clear when DATAFIFOSTALLFLAGSRESET is set.</description>
                <lsb>30</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>DATAFIFOUNDERFLOWSTALL</name>
                <description>This field asserts if the ED DATA FIFO has attempted to stall to prevent an underflow. Clear when DATAFIFOSTALLFLAGSRESET is set.</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDSTATSCOUNTER0</name>
            <description>WLAN ED STATS COUNTER 0</description>
            <addressOffset>0x64</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANEDPKTDETONACICOUNT</name>
                <description>Number of packet detections masked by ACI detection.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANEDPKTDETONAACICOUNT</name>
                <description>Number of packet detections masked by AACI detection.</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDJRLCONFIG</name>
            <description>WLAN ED JRL CONFIG</description>
            <addressOffset>0x68</addressOffset>
            <access>read-write</access>
            <resetValue>0x000000CA</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>JRLRESET</name>
                <description>Reset the OFDM jammer rejection logic. Default value is 0.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>JRLENABLE</name>
                <description>Enable the OFDM jammer rejection logic. Default value is 1.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>JRLNUMS2LFAILTRIG</name>
                <description>Number of consecutive s2l or LTF correlation failures to trigger jammer detection. It has a range of 1 .. 15. Default value is 2.
          NOTE: a value of 0 disables jammer detection.</description>
                <lsb>2</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>JRLDETRSSIMARGINDB</name>
                <description>Power increase margin used for packet detection while jammer is active (it is added to the power at packet detection when rejection was triggered). It has a range of 1 .. 15. Default value is 32.</description>
                <lsb>6</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRHCONFIG</name>
            <description>WLAN ED RH CONFIG</description>
            <addressOffset>0x70</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RHRESET</name>
                <description>Reset the RSSI histogram bins.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>RHENABLE</name>
                <description>Enable the RSSI histogram computation (Enable RSSI time binning).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>RHMEASTYPE</name>
                <description>Set the RSSI histogram measurement mode:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unconditional</name>
                    <description>Unconditional (accumulate when RHENABLE is set)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PacketDetected</name>
                    <description>Packet detected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PacketUndetected</name>
                    <description>Packet undetected</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RHMEASCADENCE</name>
                <description>Set the RSSI histogram measurement cadence:</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6 us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2 us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>64Us</name>
                    <description>6.4 us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>128Us</name>
                    <description>12.8 us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDRHDATA</name>
            <description>WLAN ED RH DATA</description>
            <addressOffset>0x74</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RHBININDEX</name>
                <description>The bin index of the RSSI histogram to be read out. From -100 dBm (index 0) to 3 dBm (index 25) in steps of 4.</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>RHBINRDDATA</name>
                <description>Bin count value corresponding to RHBININDEX (read-only).</description>
                <lsb>8</lsb>
                <msb>25</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDDEBUG</name>
            <description>WLAN ED DEBUG</description>
            <addressOffset>0x7C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DEBUGAGCGAINENA</name>
                <description>Enable AGC gain debug mode : overwrite agcGainDb with values in DEBUGAGCGAINATDET and DEBUGAGCGAINAT2ND (when 2nd agc is active).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>DEBUGAGCGAINATDET</name>
                <description>AGC gain in dB at packet detection (s7.0).</description>
                <lsb>1</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>DEBUGAGCGAINAT2ND</name>
                <description>AGC gain in dB at second agc (s7.0).</description>
                <lsb>9</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>DEBUGEDPKTTYPEENA</name>
                <description>Enable ED Packet Type debug mode : overwrite packetType with values in DEBUGEDPKTTYPE.</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>DEBUGEDPKTTYPE</name>
                <description>Forces the type of packet detected when DEBUGEDPKTTYPEENA is set:</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Ofdm</name>
                    <description>OFDM,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Dsss</name>
                    <description>DSSS</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DEBUGRSSIRSTPHYDIS</name>
                <description>When set prevents the RSSI estimations to be cleared on PHY reset.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>DEBUGED11KENA</name>
                <description>Enable ED IEEE802 11K ebug mode : overwrite macTxOn and macVccaOn with values in DEBUGED11KTXON and DEBUGED11KVCCAON.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>DEBUGED11KTXON</name>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>DEBUGED11KVCCAON</name>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WIFICOREAGC</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WIFICOREAGC</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0A000</addressOffset>
          <register>
            <name>WLANAGCRESET</name>
            <description>WLAN AGC RESET</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANAGCPULSEDSOFTWARERESET</name>
                <description>Self-clearing software reset.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANAGCLATCHEDSOFTWARERESET</name>
                <description>Latched software reset.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCCONFIG</name>
            <description>WLAN AGC CONFIG</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00264887</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCENABLE</name>
                <description>Bit field to enable AGC module. When AGC is disabled, the RF gain at the point in time will take effect and will not be modified.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SECONDAGCENABLE</name>
                <description>Switch to control whether second AGC on the HT/VHT/HE-stf fields should be done or not. If disabled, then the first AGC gain will continue till the end of packet.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AACIDETECTIONENABLE</name>
                <description>Enable for Non-adjacent channel interferer detection. AACI (Alternate Adjacent Channel Interference) is a legacy term. This logic enables early identification of the interferer and prevent pktDetected by ED module on those interfering packets.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AGCWAITTIMEAFTERTRIG</name>
                <description>After a new AGC trigger is received, the number of ADC samples to wait before kicking off the gain control process. This is to let the analog components to ramp up/down to the new packet power.</description>
                <lsb>3</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>AGCFREEZESOFTWARE</name>
                <description>When enabled, the LNA and BB gain are frozen at the current level and all AGC triggers will be ignored.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AGCFREEZEONPKTDET</name>
                <description>When enabled, the AGC will be freezed for the duration where pktDetected from ED module is active.</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AGCFREEZEONACIDET</name>
                <description>When enabled, the AGC will be freezed for the duration where aciDetected from ED module is active.</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MAXBBGAIN</name>
                <description>This value (in dB) indicates the Maximum Gain we can setin BaseBand. Value ranges between -128 and 127.</description>
                <lsb>13</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>AGCINTPOPTRIGENA</name>
                <description>When enabled, the AGC will generate an internal packet-over-packet trigger based on clipping.</description>
                <lsb>21</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AGCMONITORLATCHMODE</name>
                <description>Monitor signals latch mode:</description>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unlatched</name>
                    <description>Unlatched (live)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LatchOnceAtPhyReset</name>
                    <description>Latch once at phy reset (write AGCMONITORLATCHMODE=1 to trigger again)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LatchOnceAtAgcMonit</name>
                    <description>Latch once at AGCMONITORLATCHMODE=2 regiter write</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCCONFIG1</name>
            <description>WLAN AGC CONFIG 1</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00F44A00</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MINBBGAIN</name>
                <description>This value (in dB) indicates the Minimum Gain we can setin BaseBand. Value ranges between -128 and 127.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>MAXTOTALGAIN</name>
                <description>Max allowed Total gain in dB. (total gain = lna gain dB + bb gain dB).
          Value ranges between -128 and 127.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MINTOTALGAIN</name>
                <description>Min allowed Total gain in dB. (total gain = lna gain dB + bb gain dB).
          Value ranges between -128 and 127.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG</name>
            <description>WLAN AGC BBGC CONFIG</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00040810</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBINITWAITTIME</name>
                <description>Settling time in number of ADC samples after changing from current BB gain to bbInitGain.
          Value ranges between 0 and 127.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>BBSETTIMEDEEPCLIPFIRSTAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to DEEP clipping scenario during first AGC operation (on L-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>7</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>BBSETTIMEMODCLIPFIRSTAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to MODERATE clipping scenario during first AGC operation (on L-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>14</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG1</name>
            <description>WLAN AGC BBGC CONFIG 1</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00080810</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBSETTIMEMINCLIPFIRSTAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to MINIMUM clipping scenario during first AGC operation (on L-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>BBSETTIMEFINALGAINFIRSTAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain to final gain during first AGC operation (on L-STF field for OFDM packets).
          Value ranges between 0 and 255.</description>
                <lsb>7</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>BBSETTIMEDEEPCLIPSECONDAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to DEEP clipping scenario during second AGC operation (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>15</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG2</name>
            <description>WLAN AGC BBGC CONFIG 2</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00040810</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBSETTIMEMODCLIPSECONDAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to MODERATE clipping scenario during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>BBSETTIMEMINCLIPSECONDAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain in response to MINIMUM clipping scenario during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 127.</description>
                <lsb>7</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>BBSETTIMEFINALGAINSECONDAGC</name>
                <description>Settling time in number of ADC samples after changing current BB gain to final gain during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 255.</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG3</name>
            <description>WLAN AGC BBGC CONFIG 3</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x0090C624</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBCUTBACKDEEPCLIPFIRSTAGC</name>
                <description>BB Gain in dB to be cutback for DEEP clip scenario during first AGC operation  (on L-STF field for OFDM packets).
          Value ranges between 0 and 63 dB.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>BBCUTBACKMODCLIPFIRSTAGC</name>
                <description>BB Gain in dB to be cutback for MODERATE clip scenario during first AGC operation  (on L-STF field for OFDM packets).
          Value ranges between 0 and 63 dB.</description>
                <lsb>6</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>BBCUTBACKMINCLIPFIRSTAGC</name>
                <description>BB Gain in dB to be cutback for MINIMUM clip scenario during first AGC operation  (on L-STF field for OFDM packets).
          Value ranges between 0 and 63 dB.</description>
                <lsb>12</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>BBCUTBACKDEEPCLIPSECONDAGC</name>
                <description>BB Gain in dB to be cutback for DEEP clip scenario during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 63 dB.</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG4</name>
            <description>WLAN AGC BBGC CONFIG 4</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000318</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBCUTBACKMODCLIPSECONDAGC</name>
                <description>BB Gain in dB to be cutback for MODERATE clip scenario during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets).
          Value ranges between 0 and 63 dB.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>BBCUTBACKMINCLIPSECONDAGC</name>
                <description>BB Gain in dB to be cutback for MINIMUM clip scenario during second AGC operation  (on HT/VHT/HE-STF field for OFDM packets). Value ranges between 0 and 63 dB.</description>
                <lsb>6</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCBBGCCONFIG5</name>
            <description>WLAN AGC BBGC CONFIG 5</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00001332</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BBINITGAIN</name>
                <description>The initial Baseband gain in dB to be set after powering on AGC and in response to variance too low trigger.
          Value ranges between 0 and 127.</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>BBCLIPTRIGGAIN</name>
                <description>The initial Baseband gain in dB to be set in response to clip trigger or variance too high trigger. This value is smaller than the BBINITGAIN as we know that signal is already above the optimal bit occupancy and hence want to start AGC search with a cutdown value.
          Value ranges between 0 and 127.</description>
                <lsb>7</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCCLIPCOUNTCONFIG</name>
            <description>WLAN AGC CLIP COUNT CONFIG</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000DF4</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CCCLIPLEVEL</name>
                <description>The maximum value of ADC output beyond which clip is declared. This maximum value setting is valid for both I and Q samples at the output of ADC.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>CCCLIPTRIGTHRES</name>
                <description>The min clip count to be considered as clip trigger - to start AGC gain search.
          Value ranges between 0 and 255.</description>
                <lsb>10</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCCLIPCOUNTCONFIG1</name>
            <description>WLAN AGC CLIP COUNT CONFIG 1</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x000C060C</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CCNUMCLIPDEEPFIRSTAGC</name>
                <description>Minimum Number of clips to decide the occurence of deep saturation at first AGC. Value ranges between 0 and 255.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CCNUMCLIPMODFIRSTAGC</name>
                <description>Minimum Number of clips to decide the occurence of moderate saturation at first AGC.. Value ranges between 0 and 255.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CCNUMCLIPDEEPSECONDAGC</name>
                <description>Minimum Number of clips to decide the occurence of deep saturation at second AGC.. Value ranges between 0 and 255.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCCLIPCOUNTCONFIG2</name>
            <description>WLAN AGC CLIP COUNT CONFIG 2</description>
            <addressOffset>0x2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00021006</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CCNUMCLIPMODSECONDAGC</name>
                <description>Minimum Number of clips to decide the occurence of moderate saturation at second AGC.. Value ranges between 0 and 255.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CCCLIPCOUNTMAVGLEN</name>
                <description>Clip The window size (number of contiguous IQ samples) to be considered for counting the clips for Clip trigger.
          Value ranges between 0 and 63.</description>
                <lsb>8</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>CCCLIPINTPOPTHRES</name>
                <description>The min clip count to be considered for internal pop trigger.
          Value ranges between 0 and 255.</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCVARESTCONFIG</name>
            <description>WLAN AGC VAR EST CONFIG</description>
            <addressOffset>0x30</addressOffset>
            <access>read-write</access>
            <resetValue>0x0001A255</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VECOMPENSATEDC</name>
                <description>Bit field to enable DC compensation. Flag to control if the IQ samples are to be compensated for the DC before further power/clipping measurements.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disable</name>
                    <description>Disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VETARGETLEVELDB</name>
                <description>The optimum variance in dB of the ADC samples to be achieved by the AGC search. This is done on the ADC samples (after DC subtraction if COMPENSATEDC is enabled). It has a range of 0 .. 63.</description>
                <lsb>1</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>VETRIGUPPERTHRES</name>
                <description>A variance trigger will be issued if current variance goes above TARGETLEVELDB + TRIGUPPERTHRES.
          It has a range of -16 .. 15. Default value is 4.</description>
                <lsb>7</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>VETRIGLOWERTHRES</name>
                <description>A variance trigger will be issued if current variance goes below TARGETLEVELDB + TRIGLOWERTHRES.
          It has a range of -16 .. 15. Default value is -6.</description>
                <lsb>12</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCVARESTCONFIG1</name>
            <description>WLAN AGC VAR EST CONFIG 1</description>
            <addressOffset>0x34</addressOffset>
            <access>read-write</access>
            <resetValue>0x00015550</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VEESTWINDOWLENGTH</name>
                <description>Variance estimation window length in number of samples.
          It has a range of 0 .. 63. Default value is 16.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>VEWINDOWNORMFACT</name>
                <description>Normalisation factor for the sum of products in the variance estimation. The total number of products per window is equal to VEESTWINDOWLENGTH - 4.
          It has a format of u1.14. Default value is 1365.</description>
                <lsb>6</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCVARESTCONFIG2</name>
            <description>WLAN AGC VAR EST CONFIG 2</description>
            <addressOffset>0x38</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000002F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VERSSICOMPFACTOR</name>
                <description>The value in dB to be subtracted from agcVarDb to get the estimate of RF input signal power in the inband. (See VEWINDOWNORMFACT description). agcRssiDb = agcVarDb - agcTotalGainDb - VERSSICOMPFACTOR.
          It has a range of 0 .. 63. Default value is 47.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCAACIDETCONFIG</name>
            <description>WLAN AGC AACI DET CONFIG</description>
            <addressOffset>0x3C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00271028</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ADDETECTTHRESDB</name>
                <description>AACI Detection threshold. If the (lnaRssiDb - agcRssiDb) &amp;gt; ADDETECTTHRESDB, the aaciDetected signal is asserted.
          It has a range of 0 .. 63. Default value is 40.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>ADDISAPTIMEOUT</name>
                <description>The count in number of ADC input samples before with an AACI disappeared timeOut trigger will be issued, so the AGC gains are re-initialized and AGC operation is performed. This is used for the cases where disappearance of AACI signal is not detectable by the fall of agcVarDb (as the AACI leakage power is below the LNA noise floor).
          It has a range of 0 .. 262143. Default value is 40000.
          Timeout check is disabled when ADDISAPTIMEOUT = 0.</description>
                <lsb>6</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCAACIDETCONFIG1</name>
            <description>WLAN AGC AACI DET CONFIG 1</description>
            <addressOffset>0x40</addressOffset>
            <access>read-write</access>
            <resetValue>0x000001E8</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ADDISAPMARGINDB</name>
                <description>The amount in dB by which the agcVarDb should fall in order for it to be confirmed as AACI signal disappearance. This disappearance check is enabled aaciDetected is high.
          It has a range of 0 .. 15. Default value is 8.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>ADDETTARGETLEVELDB</name>
                <description>Provisional register to shift the target level of the agcVarDb when AACI signal is detected. This may be required for avoiding multiple AGC triggers when AACI signal has a variance &amp;gt; VETRIGUPPERTHRES/VETRIGLOWERTHRES.
          It has a range of 0 .. 63. Default value is 30.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCLGCCONFIG</name>
            <description>WLAN AGC LGC CONFIG</description>
            <addressOffset>0x44</addressOffset>
            <access>read-write</access>
            <resetValue>0x00450640</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LGLNABTFREEZEENA</name>
                <description>Flag to determine if the LNA gain should be freezed when btFreeze signal is high (from BT module). IF this flag is disabled, then even if btFreeze is high, the LNA gain will be changed based on the needs of wlanAgc.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>LGINITLNAGAIN</name>
                <description>The initial LNA gain stage to be used (start of the day and after every clip/variance trigger). Stage numbers 0 through 4 are valid. This is 3-bit valueDefault value is 0.</description>
                <lsb>1</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>LGRFMINGAINSTAGE</name>
                <description>The LNA gain stage which has the min Gain in DB. This is also the stage that has the max stage idx. In sheliak and vega this is stage 4 (-12dB).
          It has a range of 0 .. 4. Default value is 4.</description>
                <lsb>4</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>LGSEARCHSETTLETIME</name>
                <description>The number of samples to wait for the signal level to settle after LNA gain change.
          It has a range of 0 .. 127. Default value is 12.</description>
                <lsb>7</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>LGINCRSETTLETIME</name>
                <description>The number of samples to wait for the signal level to settle after WLAN increment.
          It has a range of 0 .. 127. Default value is 20.</description>
                <lsb>14</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>LGRFRSSITHRES</name>
                <description>The threshold above which the RF Rssi value that is feedback from RF (a 3 bit value from 0-7) is considered to be saturating the LNA and hence LNA gain needs to be lowered.
          It has a range of 0 .. 7. Default value is 2.</description>
                <lsb>21</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCLGCCONFIG1</name>
            <description>WLAN AGC LGC CONFIG 1</description>
            <addressOffset>0x48</addressOffset>
            <access>read-write</access>
            <resetValue>0x00A9A39D</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LGLNANOISEFLOORTABLE0</name>
                <description>The noise floor in dBm (noise power) corresponding to the LNA gain stage 0.
          This value of 8-bit signed is the noise floor expressed in dBm. Default value is -98.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>LGLNANOISEFLOORTABLE1</name>
                <description>The noise floor in dBm (noise power) corresponding to the LNA gain stage 1.
          This value of 8-bit signed is the noise floor expressed in dBm. Default value is -96.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>LGLNANOISEFLOORTABLE2</name>
                <description>The noise floor in dBm (noise power) corresponding to the LNA gain stage 2.
          This value of 8-bit signed is the noise floor expressed in dBm. Default value is -90.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCLGCCONFIG2</name>
            <description>WLAN AGC LGC CONFIG 2</description>
            <addressOffset>0x4C</addressOffset>
            <access>read-write</access>
            <resetValue>0x0002C1B5</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LGLNANOISEFLOORTABLE3</name>
                <description>The noise floor in dBm (noise power) corresponding to the LNA gain stage 3.
          This value of 8-bit signed is the noise floor expressed in dBm. Default value is -76.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>LGLNANOISEFLOORTABLE4</name>
                <description>The noise floor in dBm (noise power) corresponding to the LNA gain stage 4.
          This value of 8-bit signed is the noise floor expressed in dBm. Default value is -64.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>LGGAINADJMAXITER</name>
                <description>The number of (checkrfrssivalue, reducelnagain, wait for gain settle) cycles before the search is stopped.
          It has a range of 0 .. 3. Default value is 2.</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANAGCLGCCONFIG3</name>
