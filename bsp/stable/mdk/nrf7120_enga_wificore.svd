                <name>EDCBREAKNONLINEAR</name>
                <description>Defines whether ExtRAM bursts are broken on non-consecutive addresses.</description>
                <lsb>28</lsb>
                <msb>28</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotBreakBurstsOnNo</name>
                    <description>Do not break bursts on non-linear addresses</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BreakBurstsOnNonLin</name>
                    <description>Break bursts on non-linear addresses</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>EDCPAGEBREAK</name>
                <description>Defines page boundary on which ExtRAM bursts are broken.</description>
                <lsb>29</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>None</name>
                    <description>None</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>256ByteBoundary</name>
                    <description>256 Byte   Boundary</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>512ByteBoundary</name>
                    <description>512 Byte   Boundary</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1KbyteBoundary</name>
                    <description>1   kByte  Boundary (default)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2KbyteBoundary</name>
                    <description>2   kByte  Boundary</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4KbyteBoundary</name>
                    <description>4   kByte  Boundary</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>8KbyteBoundary</name>
                    <description>8   kByte  Boundary</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16KbyteBoundary</name>
                    <description>16  kByte  Boundary</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>EDCEXTRAMBURSTTIMEOUT[%s]</name>
            <description>Description collection: EDC EXT RAM BURST TIMEOUT</description>
            <addressOffset>0x438</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000100F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BURSTTIMEOUTVALUE</name>
                <description>Timeout counter value</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>BURSTTIMEOUTENABLE</name>
                <description>When set high burst timeouts are enabled.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIGURATIONSTATUS</name>
            <description>EDC SYS CONFIGURATION STATUS</description>
            <addressOffset>0x448</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>FULLAGENSTATUS</name>
                <description>Status register bit that indicates if full address generator is present or not.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FullAddressGenerator</name>
                    <description>Full address generator not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FullAddressGenerator1</name>
                    <description>Full address generator present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FULLOFFSETLUTSSTATUS</name>
                <description>Status register bit that indicates if GRAM offset LUTs are present or not.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GramOffsetLutsNotPre</name>
                    <description>GRAM offset LUTs not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GramOffsetLutsPresen</name>
                    <description>GRAM offset LUTs present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FULLOFFSETADJLUTSSTATUS</name>
                <description>Status register bit that indicates if GRAM offset adjustment LUTs are present or not.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GramOffsetAdjustment</name>
                    <description>GRAM offset adjustment LUTs not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GramOffsetAdjustment1</name>
                    <description>GRAM offset adjustment LUTs present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>EDCPERIP</name>
          <description>Unspecified</description>
          <headerStructName>RPUPBUS_EDCPERIP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x06000</addressOffset>
          <cluster>
            <dim>64</dim>
            <dimIncrement>0x020</dimIncrement>
            <name>EDCPERIPCHANREGS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDCPERIP_EDCPERIPCHANREGS</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0</addressOffset>
            <register>
              <name>BASIC0</name>
              <description>Description cluster: EDC PERIP BASIC0</description>
              <addressOffset>0x0</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LATCHEDRESET</name>
                  <description>Latched transfer engine channel software reset.
          Note: Use of PULSEDRESET is preferred over LATCHEDRESET.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                </field>
                <field>
                  <name>PULSEDRESET</name>
                  <description>Pulsed channel transfer engine software reset, clears automatically at start of next transfer on channel.
          Note: Once set must remain high before a DCP start/run instruction, so if set before ldbasic/ldfull it must be set again by the ldbasic/ldfull before the start/run.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                </field>
                <field>
                  <name>FINERATE</name>
                  <description>COARSERATE and FINERATE together define the rate at which EDCBURSTLENGTH byte bursts may be transferred on this channel.
          FR bursts every CR sysclk periods, giving (sysclk * EDCBURSTLENGTH * FR * CR)   bytes / sec)
          Notes:
          i. If COARSERATE=0 and FINERATE=0 then the burst rate is not controlled.
          ii. COARSERATE is unused for TFRMODE=100,101, where the COARSERATE for the ECN linked channel with TFRMODE=001,011 is used once for both transfers.</description>
                  <lsb>3</lsb>
                  <msb>4</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Fr7</name>
                      <description>FR = 7</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Fr6</name>
                      <description>FR = 6</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Fr5</name>
                      <description>FR = 5</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Fr4</name>
                      <description>FR = 4</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PERBUS</name>
                  <description>Selects bus for peripheral transfers:
          Notes:
          i. Must be set to 0 when TFRMODE=110.
          ii. Must be set to 1 when PW=11.</description>
                  <lsb>5</lsb>
                  <msb>5</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PeripheralTransferIs</name>
                      <description>Peripheral transfer is carried over the transfer bus (TBus) using hardware flow control of peripheral accesses.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PeripheralTransferIs1</name>
                      <description>Peripheral transfer is carried over the non-stalling peripheral bus (SysBus or PBus) using (PA + incrOffset) as the peripheral address</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TFRMODE</name>
                  <description>Notes: i.   ITEMS must match for peripheral to peripheral transfers.
          ii.  Partial address masks only supported at end of transfers.
          iii. 'from EDC channel (ECN)' transfers should be configured/started before 'to EDC channel (ECN)' transfers.
          iv.  ITEMBYTES must be set to 3 bytes for TFRMODE=110</description>
                  <lsb>6</lsb>
                  <msb>8</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>ReadFromMemory</name>
                      <description>Read from memory (MA+agenOffset), write to peripheral (PA+incrOffset)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromMemory1</name>
                      <description>Read from memory  (MA+agenOffset), write to EDC channel (ECN)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromPeripheral</name>
                      <description>Read from peripheral (PA+incrOffset), write to memory (MA+agenOffset)</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromPeripheral3</name>
                      <description>Read from peripheral (PA+incrOffset), write to EDC channel (ECN)</description>
                      <value>0x3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromEdcChannel</name>
                      <description>Read from EDC channel (ECN), write to memory (MA+agenOffset)</description>
                      <value>0x4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromEdcChannel5</name>
                      <description>Read from EDC channel (ECN), write to peripheral (PA+incrOffset)</description>
                      <value>0x5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFdsgLfsrPrbsOf</name>
                      <description>Read FDSG/LFSR/PRBS offsets from MMR (MA+[0:3]), write to transfer bus (TBus)</description>
                      <value>0x6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadFromPeripheral7</name>
                      <description>Read from peripheral (PA+incrOffset), write to peripheral (MA+incr2Offset)</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>EOPMASK</name>
                  <description>Selects the mask for the last memory write in case of EOP:</description>
                  <lsb>9</lsb>
                  <msb>9</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>MaskFromAddressGener</name>
                      <description>Mask from address generator is used.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>MaskFromTbusReadPort</name>
                      <description>Mask from TBus read port is used.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TRANSFERMODE</name>
                  <description>Selects multiple 16-bit items length or single 24-bit items length transfer:
          Notes:
          i.   TRANSFERSMODE must be written before writing TRANSFERS and ITEMS to BASIC1.
          ii.  TRANSFERS will always return 1 after switching TRANSFERSMODE from 1 to 0.
          iii. Single 24-bit items length transfer supported only when address generator is in row-column mode. Note that row-column mode is available only when EDCSYSCONFIGURATIONSTATUS[0] = '1'; therefore 24-bit items transfer
          is supported only when EDCSYSCONFIGURATIONSTATUS[0] = '1'.
          The required row-column parameters to have modulo addressing are N0=anything that divides N2 and such that N0 &amp;gt;= GRAMREQS-1 (the second condition is required to have best performance), N1=1, N2=modulo, A=0, B=0, O=start index.</description>
                  <lsb>10</lsb>
                  <msb>10</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PerformTransfersIte</name>
                      <description>Perform TRANSFERS * ITEMS item transfers.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PerformSingle</name>
                      <description>Perform single '(TRANSFERS &amp;lt;&amp;lt; 16) | ITEMS' item transfer.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>EOPMODE</name>
                  <description>Specifies the end of packet mode:
          Notes: 1. When enabled, EOP signal terminates all TRANSFERS, not just ITEMS within current transfer.</description>
                  <lsb>11</lsb>
                  <msb>12</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DmaJobCompletesAfter</name>
                      <description>DMA job completes after TRANSFERS*ITEMS transfers.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Reserve</name>
                      <description>This is reserved.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DmaJobCompletesAfter2</name>
                      <description>DMA job completes after TRANSFERS*ITEMS transfers, or on receipt of EOP signal from peripheral, whichever occurs first.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Reserve3</name>
                      <description>This is reserved.</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DISCARDOP</name>
                  <description>Controls whether output of transfers should be discarded:
          Notes:
          i. this control cannot be used for 'to EDC channel (ECN)' transfers where it should instead be set for the 'from EDC channel (ECN)' transfer.
          ii. this register is double buffered at start of job.</description>
                  <lsb>13</lsb>
                  <msb>13</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>OutputNotDiscarded</name>
                      <description>Output not discarded.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>OutputDiscarded</name>
                      <description>Output discarded, transfers otherwise operate as normal.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>INCR</name>
                  <description>Specifies incrementing peripheral address burst mode.  By default all operations to the peripheral are to a single register location.
          Note: Only applicable to SysBus or PBus transfers.</description>
                  <lsb>14</lsb>
                  <msb>14</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>StaticPeripheralAddr</name>
                      <description>Static peripheral address defined by PA.  Typically used when transferring to/from a FIFO mapped to a single data port peripheral address.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IncrementingPeripher</name>
                      <description>Incrementing peripheral address, start address defined by PA. Typically used when transferring to a block of configuration registers.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>BITREV</name>
                  <description>Specifies bit reversal within transferred bytes:
          Notes :
          i. Applied to destination transfers only.
          ii. Just the parameter for the destination channel is used when linked using ECN.</description>
                  <lsb>15</lsb>
                  <msb>15</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>BytesAreNotBitRevers</name>
                      <description>Bytes are not bit reversed</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>BytesAreBitReversed</name>
                      <description>Bytes are bit reversed</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>COARSERATE</name>
                  <description>COARSERATE defines the rate at which EDCBURSTLENGTH byte bursts may be transferred on this channel.
          FR bursts every CR sysclk periods, giving (sysclk * EDCBURSTLENGTH * FR * CR)   bytes / sec)
          Notes:
          i. If COARSERATE=0 and FINERATE=0 then the burst rate is not controlled.
          ii. COARSERATE is unused for TFRMODE=100,101, where the COARSERATE for the ECN linked channel with TFRMODE=001,011 is used once for both transfers.</description>
                  <lsb>16</lsb>
                  <msb>18</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Cr18</name>
                      <description>CR = 1 / 8</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr116</name>
                      <description>CR = 1 / 16</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr132</name>
                      <description>CR = 1 / 32</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr164</name>
                      <description>CR = 1 / 64</description>
                      <value>0x3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr1128</name>
                      <description>CR = 1 / 128</description>
                      <value>0x4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr1256</name>
                      <description>CR = 1 / 256</description>
                      <value>0x5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr1512</name>
                      <description>CR = 1 / 512</description>
                      <value>0x6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Cr11024</name>
                      <description>CR = 1 / 1024</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PALIGN</name>
                  <description>Specifies the alignment of peripheral data:</description>
                  <lsb>19</lsb>
                  <msb>19</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DataIsRightAligned</name>
                      <description>Data is right aligned</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DataIsLeftAligned</name>
                      <description>Data is left aligned</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PW</name>
                  <description>Specifies the width of the peripheral transfer.  If transfers are being performed on the wide Tbus then parallel transfers of this width take place.</description>
                  <lsb>20</lsb>
                  <msb>21</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>8Bit</name>
                      <description>8 bit  (PBus or TBus)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>16Bit</name>
                      <description>16 bit (PBus or TBus)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>24Bit</name>
                      <description>24 bit (PBus or TBus)</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>32Bit</name>
                      <description>32 bit (SysBus)</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DCPPRIORITY</name>
                  <description>Specifies the priority of DCP thread execution:</description>
                  <lsb>22</lsb>
                  <msb>22</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>LowPriorityDcpThread</name>
                      <description>Low priority DCP thread.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>HighPriorityDcpThrea</name>
                      <description>High priority DCP thread (use for realtime peripherals such as the SCP).</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>MEMBSWAP</name>
                  <description>Big/little endian byte swap.  If set, byte order will be reversed in all memory read/write transfers.  MEMBSWAP is applied on 24-bit GRAM or 32-bit External RAM memory accesses.  MEMBSWAP is applied on the memory word after the peripheral data to transfer has been packed, or on the memory word read from RAM before it is unpacked for transfer to the peripheral.
          Note : Applied to both source and destination memory transfers.</description>
                  <lsb>23</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC1</name>
              <description>Description cluster: EDC PERIP BASIC1</description>
              <addressOffset>0x4</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ITEMS</name>
                  <description>The number of items in each DMA transfer, represented in 'natural' format (ITEMS=1 gives one transfer).
          The total number of items in a DMA job is (TRANSFERS * ITEMS).
          If transferring to/from TBus peripherals, (ITEMBYTES+1)*ITEMS must be divisible by (PW+1)*PERIPNUM, with any surplus being discarded, and whilst a byte mask is
          provided to TBus peripherals to indicate shortfall few peripherals make use of this.
          Decremented by 'ITEMBYTES+1'.
          Note: This register is double buffered at start of job.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>TRANSFERS</name>
                  <description>When TRANSFERSMODE=0:
          The number of DMA transfers in the DMA job, represented in 'natural' format (TRANSFERS=1 specifies one transfer).
          TRANSFERS = 0 selects a different mode of operation -
          Skip the number of items defined by ITEMS, then generate one item without updating the state of the address generator.
          This mode is used for applying error correction to the Outer Decoder input data.
          When TRANSFERSMODE=1:
          ITEMS[23:0] (TRANSFERS is internally fixed at 1).
          Note: when EOPMODE = '10', TRANSFERS &amp;gt; 1 is not supported.</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC2</name>
              <description>Description cluster: EDC PERIP BASIC2</description>
              <addressOffset>0x8</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PA</name>
                  <description>For transfers over the non-stalling peripheral bus (SysBus or PBus), PA specifies the base peripheral address.
          For transfers over the stalling transfer bus (TBus), PA[13:0] selects the port ID within the following TBus read/write port selection groups:
          PA[15:14]=00 : Peripheral TBus write ports.
          PA[15:14]=01 : EDC Address Generator Offset write ports.
          PA[15:14]=10 : Peripheral TBus read ports
          Notes:
          1. INCR=1 produces a sequence of incrementing addresses  PA, PA+1, PA+2, ...
          2. Address generator offset TBus write requests must be allocated to a higher priority (lower number) EDC channel
          than the EDC channel address generator that they are feeding.
          3. Address generator offset TBus write requests EDC channel must be started before the EDC channel address generator that they are feeding.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>ECN</name>
                  <description>When TFRMODE=000 ... 110 :
          EDC channel number to connect with for memory-to-memory transfer
          Note: When linking channels using ECN the ITEMS setting for each channel must match, though TRANSFERS need not be the same.
          This hardware restriction arises because each transfer consists of a sequence of EDCBURSTLENGTH byte bursts,
          with one final burst which carries the number of bytes required to complete the transfer.
          The number of bytes in the final burst of a transfer is rem(ITEMS * (ITEMBYTES+1), EDCBURSTLENGTH).
          When TFRMODE=111 :
          ECN[4:3]=PW2 : Specifies the width of the destination peripheral transfer.  If transfers are being performed on the wide Tbus then parallel transfers of this width take place.
          00 : 8 bit  (PBus or TBus)
          01 : 16 bit (PBus or TBus)
          10 : 24 bit (PBus or TBus)
          11 : 32 bit (SysBus)
          ECN[2]=PALIGN2 : Specifies the alignment of destination peripheral data:
          0 : Data is right aligned
          1 : Data is left aligned
          ECN[1]=INCR2 : Specifies incrementing destination peripheral address burst mode.  By default all operations to the destination peripheral are to a single register location.
          0 : Static destination peripheral address defined by MA.  Typically used when transferring to a FIFO mapped to a single data port destination peripheral address.
          1 : Incrementing destination peripheral address, start address defined by MA. Typically used when transferring to a block of configuration registers.
          Note: Only applicable to SysBus or PBus transfers.
          ECN[0]=PERBUS2 : Selects bus for destination peripheral transfers:
          0 : Destination peripheral transfer is carried over the transfer bus (TBus) using hardware flow control of destination peripheral accesses.
          1 : Destination peripheral transfer is carried over the non-stalling peripheral bus (SysBus or PBus) using (MA + incr2Offset) as the destination peripheral address</description>
                  <lsb>16</lsb>
                  <msb>21</msb>
                </field>
                <field>
                  <name>PAEXT</name>
                  <description>Extended PA address bit.</description>
                  <lsb>22</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC3</name>
              <description>Description cluster: EDC PERIP BASIC3</description>
              <addressOffset>0xC</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>MA</name>
                  <description>When TFRMODE=000 ... 110 :
          Memory Address defines the base address of the memory transfers controlled by this DMA channel.
          The units of MA are physical RAM locations, and the physical RAM bus targetted by this DMA channel is selected by BUSBYTES. The byte address of the memory base in the chosen RAM space is MA * BUSBYTES.
          When TFRMODE=111 :
          For transfers over the non-stalling peripheral bus (SysBus or PBus), MA specifies the base peripheral address.
          For transfers over the stalling transfer bus (TBus), MA[13:0] selects the port ID within the following TBus write port selection groups:
          MA[15:14]=00 : Peripheral TBus write ports.
          MA[15:14]=01 : EDC Address Generator Offset write ports.
          Notes:
          1. INCR=1 produces a sequence of incrementing addresses  MA, MA+1, MA+2, ... (where MA is shadowed for transfer rather than current MA used by DCP)
          2. Address generator offset TBus write requests must be allocated to a higher priority (lower number) EDC channel
          than the EDC channel address generator that they are feeding.
          3. Address generator offset TBus write requests EDC channel must be started before the EDC channel address generator that they are feeding.
          4. This register is double buffered at start of job.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN4</name>
              <description>Description cluster: EDC PERIP AGEN4</description>
              <addressOffset>0x10</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N0</name>
                  <description>Address generator N0 parameter.  Use depends on selected mode:
          Modulo mode             : modulo (0 value gives 2^16 modulo)
          Repeat-skip mode        : number of items in one sequence
          Row-column mode         : number of items in one block (rows * columns)
          Twisted row-column mode : number of items in one burst
          Burst row-column mode   : number of items in one burst
          FIFO mode               : number of items in one burst (one burst for each FIFO )
          Run-length mode         : number of items to skip after one 'run'
          Row-column-CD mode      : number of FIFOs</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>BUSBYTES</name>
                  <description>The byte width of the memory bus targetted by the address generator.
          Note: this register is double buffered at start of job.</description>
                  <lsb>16</lsb>
                  <msb>16</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>3Bytes</name>
                      <description>3 bytes (global RAM bus)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>4Bytes</name>
                      <description>4 bytes (external RAM bus)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ITEMBYTES</name>
                  <description>The number of bytes in each item of the data structure accessed by the address generator.
          Notes:
          i. This must be programmed correctly even when the address generator is not in use.
          ii. This register is double buffered at start of job.</description>
                  <lsb>17</lsb>
                  <msb>18</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>1Byte</name>
                      <description>1 byte</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>2Bytes</name>
                      <description>2 bytes</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>3Bytes</name>
                      <description>3 bytes</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>4Bytes</name>
                      <description>4 bytes</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CLRABO</name>
                  <description>Setting CLR=1 clears the internal registers a, b and o in the address generator for this channel.  This register clears automatically.</description>
                  <lsb>19</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>MODE</name>
                  <description>Note: If EDCSYSCONFIGURATIONSTATUS[0] = '0', only modulo mode is supported.</description>
                  <lsb>21</lsb>
                  <msb>23</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Modulo</name>
                      <description>modulo</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RepeatSkip</name>
                      <description>repeat-skip</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RowColumn</name>
                      <description>row-column</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TwistedRowColumn</name>
                      <description>twisted row-column</description>
                      <value>0x3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>BurstRowColumn</name>
                      <description>burst row-column</description>
                      <value>0x4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Fifo</name>
                      <description>FIFO</description>
                      <value>0x5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RunLength</name>
                      <description>run-length</description>
                      <value>0x6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RowColCd</name>
                      <description>row-col-cd</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN5</name>
              <description>Description cluster: EDC PERIP AGEN5</description>
              <addressOffset>0x14</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N1</name>
                  <description>Address generator N1 parameter.  Use depends on EDCSYSCONFIGURATIONSTATUS register and OFFSETADD field of EDCPERIPJOB0 register:
          If EDCSYSCONFIGURATIONSTATUS[1] = '1' and OFFSETADD = '1' then only 10 LSBs are used and it represents the LUT read pointer. Automatically incremented. When LUT are used, address generator increment is not needed.
          Else use depends on selected mode:
          Modulo mode             : increment per item
          Repeat-skip mode        : number of repeats of each sequence
          Row-column mode         : number of rows
          Twisted row-column mode : number of rows
          Burst row-column mode   : number of rows
          FIFO mode               : number of FIFOs
          Run-length mode         : unused
          Row-column-CD mode      : rem((d1-d0) * numFifos + buffLen, buffLen), where d0 is the delay of FIFO 0 and d1 is the delay of FIFO 1, both measured in items
          Notes:
          1. If EDCSYSCONFIGURATIONSTATUS[1] = '1', this register is double buffered (only 10 LSBs) at start of job, to allow reconfiguration of LUT read pointer while job is still active.
          2. If EDCSYSCONFIGURATIONSTATUS[1:0] = '00', this register is not present and the increment per item if fixed to 1.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN6</name>
              <description>Description cluster: EDC PERIP AGEN6</description>
              <addressOffset>0x18</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N2</name>
                  <description>Address generator N2 parameter.  Use depends on selected mode:
          Modulo mode             : if AGENSTATEB[0]=0, start index (must be in the range 0 to N0-1), else unused
          Repeat-skip mode        : number of items from the start of one sequence to the start of the next sequence
          Row-column mode         : number of items in the set of blocks (rows * columns * blocks)
          Twisted row-column mode : number of items in one block  (rows * columns)
          Burst row-column mode   : number of items in one block minus number of items in one burst  (rows * columns - N0)
          FIFO mode               : number of items in the whole FIFO structure
          Run-length mode         : unused
          Row-column-CD mode      : number of items in the CD buffer.  Note: N2 must be an integer multiple of abs(d1-d0) * numFifos, where d0 is the delay of FIFO 0 and d1 is the delay of FIFO 1, both measured in items
          If OFFSETADD is in use and EDCSYSCONFIGURATIONSTATUS[1] = '1', N2 can be set to enforce a modulo on the LUT read pointer.
          Notes:
          1. This register is double buffered at start of job.
          2. If EDCSYSCONFIGURATIONSTATUS[0] = '0', only 16 LSBs are used.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN7</name>
              <description>Description cluster: EDC PERIP AGEN7</description>
              <addressOffset>0x1C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LP0</name>
                  <description>FIFO mode  : maxItems - the maximum number of items in a paired buffer
          Note: If read ITEMS is not equal to write ITEMS then LP0 must be &amp;gt;= 2 * EDCBURSTLENGTH
          BLOCK mode : itemsPerBlock - the number of items in a block</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>LP1</name>
                  <description>FIFO mode  : not used
          BLOCK mode : maxBlocks - the maximum number of blocks in a paired buffer</description>
                  <lsb>16</lsb>
                  <msb>21</msb>
                </field>
                <field>
                  <name>LINKMODE</name>
                  <description>Controls pairing of even numbered write channel 'N' and odd numbered read channel 'N+1':
          Notes:
          i.   Linked channels must have the same ITEMBYTES configuration.
          ii.  LINKMODE must be disabled on channels with EXTRAMREADAHEAD set to 1
          (but can be set on channels ECN linked to these that have EXTRAMREADAHEAD set to 0).
          iii. Changing LINKMODE setting causes read and write buffer counts to be reset.
          iv.  If EDCSYSCONFIGURATIONSTATUS[0] = '0', the pairing is not supported.</description>
                  <lsb>22</lsb>
                  <msb>23</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PairingDisabled</name>
                      <description>Pairing disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PairUsingFifoMode</name>
                      <description>Pair using FIFO mode</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PairUsingBlockMode</name>
                      <description>Pair using BLOCK mode</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Reserve</name>
                      <description>This is reserved.</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <dim>64</dim>
            <dimIncrement>0x010</dimIncrement>
            <name>EDCPERIPCTXTREGS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDCPERIP_EDCPERIPCTXTREGS</headerStructName>
            <access>read-write</access>
            <addressOffset>0x800</addressOffset>
            <register>
              <name>AGENCONTEXT0</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT0</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEA</name>
                  <description>Address generator A variable.
          If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGENCONTEXT1</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT1</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEB</name>
                  <description>Address generator B variable.
          If MODE=0 (modulo mode) AGENSTATEB[0]=1 causes N2 to be substituted with offsets fed from another channel.
          If AGENSTATEB[0]=1, N1 must be different than 1 to prevent linear mode logic to be enabled, since it does not support offset addition.
          If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGENCONTEXT2</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT2</description>
              <addressOffset>0x008</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEO</name>
                  <description>Address generator O variable.
          If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>STATUS</name>
              <description>Description cluster: EDC PERIP STATUS</description>
              <addressOffset>0x00C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ITEMSLEFT</name>
                  <description>The number of items remaining in each DMA transfer, represented in 'natural' format.
          Note: This is updated to represent the number of items completed when a job completes for EOPMODE=10.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>TRANSFERSLEFT</name>
                  <description>When TRANSFERSMODE=0:
          The number of DMA transfers remaining in the DMA job, represented in 'natural' format.
          When TRANSFERSMODE=1:
          ITEMSLEFT[23:0].</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <register>
            <name>EDCGPIO0OUT</name>
            <description>EDC GPIO0 OUT</description>
            <addressOffset>0xC00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO0OUT</name>
                <description>Value output on bits 15:0 of UCCP top level GPIOOUT pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO1OUT</name>
            <description>EDC GPIO1 OUT</description>
            <addressOffset>0xC04</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO1OUT</name>
                <description>Value output on bits 31:16 of UCCP top level GPIOOUT pins.</description>
                <lsb>0</lsb>
