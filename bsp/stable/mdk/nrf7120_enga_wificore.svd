                    <enumeratedValue>
                      <name>PassCalculatedL4Che</name>
                      <description>PASS - Calculated L4 checksum and L4 checksum extracted from packet header are matching.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CHECKSUMINFO</name>
                  <description>TXRX checksum info flag.
          Note: This bit is used for both TX and RX operation.
          It will be cleared at the start of every new packet.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>CalculationOfL4Check</name>
                      <description>Calculation of L4 checksum was skipped,</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>L4ChecksumCalculated</name>
                      <description>L4 checksum calculated and was not skipped.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>RXCHECKSUMVALID</name>
                  <description>RX checksum valid flag.
          This bit gets set once the L4 checksum calculation for RX operation is completed
          and L4 checksum status is ready. It will be cleared at the start of every new packet.</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                </field>
              </fields>
            </register>
