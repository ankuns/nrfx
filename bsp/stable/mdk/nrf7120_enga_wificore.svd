                <lsb>6</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>OFDMCORRS2LTHRESMETRIC3</name>
                <description>OFDM correlation S2l metric 3 threshold. It has a range of -31 .. 0. Default value is -10.</description>
                <lsb>12</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>OFDMCORRS2LTHRESMETRIC4</name>
                <description>OFDM correlation S2l metric 4 threshold. It has a range of -31 .. 0. Default value is -10.</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANEDOFDMCORRCONFIG3</name>
            <description>WLAN ED OFDM CORR CONFIG 3</description>
            <addressOffset>0x18</addressOffset>
