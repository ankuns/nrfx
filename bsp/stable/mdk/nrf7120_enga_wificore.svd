    <peripheral>
      <name>GLOBAL_LPCOMP</name>
      <description>Low-power comparator</description>
      <baseAddress>0x50106000</baseAddress>
      <alternatePeripheral>GLOBAL_COMP</alternatePeripheral>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>COMP_LPCOMP</name>
        <value>262</value>
      </interrupt>
      <groupName>LPCOMP</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>TASKS_START</name>
          <description>Start comparator</description>
