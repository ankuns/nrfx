                  <enumeratedValue>
                    <name>FftSizeConfiguredByT</name>
                    <description>FFT size configured by the FFTRADIXPASS1/IFFTRADIXPASS1 registers.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FftSizeConfiguredByS</name>
                    <description>FFT size configured by sideband signal.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IFFTRADIXPASS1</name>
                <description>Select the radix used on the first IFFT pass.
          Options are
          0-5 : reserved
          6 : radix=64
          7 : radix=128
          8 : radix=256
          9 : radix=512
          10-15 : reserved</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>FFTRADIXPASS1</name>
                <description>Select the radix used on the first FFT pass.
          Options are
          0-5 : reserved
          6 : radix=64
          7 : radix=128
          8 : radix=256
          9 : radix=512
          10-15 : reserved</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>FFTINPUTSHIFT</name>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoDataShiftAtTheInpu</name>
                    <description>No data shift at the input of the FFT engine. Input to FFT engine is in [0..N-1] order, where N is size of FFT.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DataAtTheInputOfTheF</name>
                    <description>Data at the input of the FFT engine is shifted such that the second half of input vector is swapped with the first half. Input to FFT engine is in [N/2..N-1,0,..N/2-1] order.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANEDMIDPACKET</name>
                <description>Mid-packet energy detection flag:</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DsssOrOfdmPacketDete</name>
                    <description>DSSS or OFDM packet detected</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MidPacketDetected</name>
                    <description>MID packet detected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTDISABLEPHYRESET</name>
                <description>Disable automatic PHY reset.</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PhyWillAutomatically</name>
                    <description>PHY will automatically reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PhyWillNotAutomatica</name>
                    <description>PHY will not automatically reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCMENABLED</name>
                <lsb>19</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DcmDecodingIsDisable</name>
                    <description>DCM decoding is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DcmDecodingIsEnabled</name>
                    <description>DCM decoding is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANFFTDYNAMICGAIN</name>
                <description>Dynamic FFT gain (stages shift values):</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FftGainConfiguredByT</name>
                    <description>FFT gain configured by the WLANFFTSHIFTVALUES registers.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FftGainConfiguredByS</name>
                    <description>FFT gain configured by sideband signal.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LATCHEDSOFTWARERESET</name>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RemoveReset</name>
                    <description>Remove reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ApplyReset</name>
                    <description>Apply reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PULSEDSOFTWARERESET</name>
                <description>This bit is automatically returns to 0</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ApplyAPulsedSoftware</name>
                    <description>Apply a pulsed software reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>SHIFTVALUES</name>
            <description>WLAN FFT SHIFT VALUES</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SHIFTVALUESTAGE1P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 1.
          Options are as above</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE2P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 2.
          Options are as above</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE3P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 3.
          Options are as above</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE4P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 4.
          Options are as above</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE5P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 5.
          Options are as above</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE6P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 6.
          Options are as above</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE7P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 7.
          Options are as above</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE8P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 8.
          Options are as above</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>SHIFTVALUESTAGE9P1</name>
                <description>SHIFT SELECT for Pass 1 / Stage 9.
          Options are as above</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMCONFIG</name>
            <description>WLAN FFT OFDM CONFIG</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INSERTGUARD</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForTransmit</name>
                    <description>For transmit, insert Guard to the FFT output data stream</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INSERTSUBCARRIERS</name>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForTransmit</name>
                    <description>For transmit, insert null sub-carriers into the FFT input data stream.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>REMOVESUBCARRIERS</name>
                <description>Pilots will be outputted first following by data sub-carriers.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNothing</name>
                    <description>Do nothing</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForReceive</name>
                    <description>For receive, remove the null sub-carriers from the FFT output data stream.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GUARDDURATION</name>
                <description>Specifies the guard duration to be inserted or removed:</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>04Us</name>
                    <description>0.4us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>08Us</name>
                    <description>0.8us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXPCPECFOEST</name>
                <description>When set enables the CFO estimation based on the CPE.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>RXPCPESTBC</name>
                <description>Selects STBC mode. HT-packets only.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonStbc</name>
                    <description>non-STBC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Stbc</name>
                    <description>STBC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXPCPEBYPASS</name>
                <description>CPE compensation control.
          This field is used when REMOVESUBCARRIERS is active (RX mode).
          In both cases pilots will be discarded but when bypass is not active
          CPE compensation will be performed.</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CpeCompensation</name>
                    <description>CPE compensation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Bypass</name>
                    <description>Bypass</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OPERATINGWINDOW</name>
                <description>For receive selects the operating window when the channel bandwidth is not equal to the signal bandwidth
          When the channel bandwidth is 40MHz and the signal bandwidth is 20MHz, the operating window should be configured to
          either value 1 (lower operating window) or 2 (upper operating window). When the channel bandwidth is 80MHz and the signal
          bandwidth is 20MHz, the operating window should be configured to either value 1, 2, 3, or 4. 80MHz cbw/ 40MHz sbw
          should follow the first case.</description>
                <lsb>10</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>3MostLowerOperating</name>
                    <description>-3 Most lower operating window</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1LowerOperatingWind</name>
                    <description>-1 Lower operating window</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1UpperOperatingWind</name>
                    <description>+1 Upper operating window</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3MostUpperOperating</name>
                    <description>+3 Most upper operating window</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>HELTFTYPE</name>
                <description>Type of HE-LTF preamble. For HE formats only.</description>
                <lsb>12</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>1XHeLtf</name>
                    <description>1x HE-LTF</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2XHeLtf</name>
                    <description>2x HE-LTF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4XHeLtf</name>
                    <description>4x HE-LTF</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SIGNALBANDWIDTH</name>
                <description>Selects the signal bandwidth
          Must be equal or less than CHANNELBANDWIDTH.
          For receive, see the OPERATINGWINDOW description.
          For transmit, when signal bandwidth is less than channel bandwidth, input OFDM symbol will be duplicated
          before performing inverse FFT. If channel bandwidth is two times signal bandwidth then OFDM symbol will be
          duplicated and if channel bandwidth is four times signal bandwidth then OFDM symbol will be quadrupled.</description>
                <lsb>14</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXCHANNELBANDWIDTH</name>
                <description>Selects the channel bandwidth</description>
                <lsb>17</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXCHANNELBANDWIDTH</name>
                <description>Selects the channel bandwidth</description>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMCONFIG2</name>
            <description>WLAN FFT OFDM CONFIG 2</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PACKETTYPE</name>
                <description>Selects packet type:
          Packets 0-3 (Legacy, HTMF, HTGF, VHT) are in Pre-HE group with OFDM symbol length of 3.2us.
          HE packet has 12.8us OFDM symbol length.
          NOTE: Whenever packettype is configured the initial state of scrambler will be set accordingly.
          Scrambler is used within CPE block to generate PN sequence for pilot sign generation. PN sequence
          has 127 elements and cyclically repeats after 127 OFDM symbols.</description>
                <lsb>0</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Legacy</name>
                    <description>Legacy</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtMf</name>
                    <description>HT-MF</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtGf</name>
                    <description>HT-GF</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Vht</name>
                    <description>VHT</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSu</name>
                    <description>HE-SU</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeMu</name>
                    <description>HE-MU</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeEr</name>
                    <description>HE-ER</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeTb</name>
                    <description>HE-TB</description>
                    <value>0x7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EhtMu</name>
                    <description>EHT-MU</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EhtTb</name>
                    <description>EHT-TB</description>
                    <value>0x9</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>HEMUPPDUSIGBW</name>
                <description>Operating BW of the BSS (Basic Service Set):
          NOTE: only used for HE-MU packets</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20 MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40 MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80 MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PPDU20MHZOFFSET</name>
                <description>Selects the 20MHz partition of the PPDU bandwidth (up to 80 MHz supported):
          0-1: when BSS operating bandwidth is 40 MHz
          0-3: when BSS operating bandwidth is 80 MHz
          NOTE: only used when HE-MU packet and HEMUPPDUSIGBW &amp;gt;= 40 MHz</description>
                <lsb>6</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RESOURCEUNIT</name>
                <description>Used to determine the positions of pilot and null sub-carriers.
          Valid range of values for SIGNALBANDWIDTH = 20 MHz are [0-8, 37-40, 53-54, 61].
          Valid range of values for SIGNALBANDWIDTH = 40 MHz are [0-17, 37-44, 53-56, 61-62, 65].
          Only applicable for HE packets.
          (SIGNALBANDWIDTH in WLANFFTOFDMCONFIG register)</description>
                <lsb>8</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>PEDURATION</name>
                <description>Duration of Packet Extension in microseconds. Only applicable for HE packets.</description>
                <lsb>15</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>ROTATIONMODE</name>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoRotation</name>
                    <description>No rotation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto</name>
                    <description>Rotation by gamma factor for 40MHz signal bandwidth</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto2</name>
                    <description>Rotation by gamma factor for 80MHz signal bandwidth</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DUPLICATIONMODE</name>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoDuplication</name>
                    <description>No duplication</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OfdmSymbolDuplicated</name>
                    <description>OFDM symbol duplicated prior to IFFT</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OfdmSymbolQuadrupled</name>
                    <description>OFDM symbol quadrupled prior to IFFT</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x8</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>RXPCPECHSTREAM1PILOT[%s]</name>
            <description>Description collection: WLAN FFT RXP CPE CH STREAM1 PILOT</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RXPCPECHSTREAM1PILOT</name>
                <description>Channel estimate for stream 1 on the pilot subcarrier.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x8</dim>
            <dimIncrement>0x4</dimIncrement>
