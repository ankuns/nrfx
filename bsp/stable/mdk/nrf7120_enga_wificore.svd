            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRTMTDEDAGCDEBUGS2LENA</name>
                <description>Enable/disable ED-AGC debug support : ED-AGC S2L-over signal from register WLANRTMTDEDAGCDEBUGS2LOVER.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMTDEDAGCDEBUGCFOENA</name>
                <description>Enable/disable ED-AGC debug support : ED-AGC CFO signals from registers WLANRTMTDEDAGCCFORE/WLANRTMTDEDAGCCFOIM.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMTDEDAGCDEBUGDCENA</name>
                <description>Enable/disable ED-AGC debug support : ED-AGC DC signals from registers WLANRTMTDEDAGCDCS2LRE/WLANRTMTDEDAGCDCS2LIM and WLANRTMTDEDAGCDC2NDRE/WLANRTMTDEDAGCDC2NDIM.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANRTMTDEDAGCDEBUGVARENA</name>
                <description>Enable/disable ED-AGC debug support : ED-AGC prime variance signals from registers WLANRTMTDEDAGCPRIME20VAR/WLANRTMTDEDAGCPRIME40VAR.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRTMTDEDAGCDEBUGS2LOVER</name>
