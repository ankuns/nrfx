        <register>
          <name>READ_DATA</name>
          <description>Read data received from Mipi RF front-end bus</description>
          <addressOffset>0x400</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DATA</name>
              <description>read data bytes received from Mipi RF front-end bus slave, starting from [7:0]. Unused bytes are all zero.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RFFE_STATUS</name>
          <description>Current state of RFFE state machine</description>
          <addressOffset>0x404</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>STATUS</name>
              <description>RFFE status. Encoding specified in specification</description>
              <lsb>0</lsb>
              <msb>3</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Rffe bus in idle state, clock and data driven actively low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SSC1</name>
                  <description>Rffe bus in first start sequence cycle (data high, clock low)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SSC0</name>
                  <description>Rffe bus in second start sequence cycle (data low, clock low)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMMAND_FRAME</name>
                  <description>Master is providing command frame to slave</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMMAND_PARITY</name>
                  <description>Master is providing command frame parity bit</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WRITE_BYTE</name>
                  <description>Sdata and sclk driven by master</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WRITE_PARITY</name>
                  <description>Master is providing parity bit</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSPARK_0</name>
                  <description>Buspark after write operation</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSPARK_1</name>
                  <description>Master is releasing sdata for slave between command frame and read bytes</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_BYTE</name>
                  <description>slave is driving data on sdata, sclk in read mode driven by master</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_PARITY</name>
                  <description>slave providing parity bit</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSPARK_END</name>
                  <description>Buspark after read operation, sdata controlled by slave, clock driven</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSPARK_SILENT</name>
                  <description>Silent Buspark at the end of synchronous read, sdata driven to low by master, clock is not driven</description>
                  <value>0xC</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
