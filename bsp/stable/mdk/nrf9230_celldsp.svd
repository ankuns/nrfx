            <size>0x20</size>
            <fields>
              <field>
                <name>LTEDSPLSRAM101</name>
                <description>LteDsp LS_RAM1 Ram 1 bits 0:4</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM100</name>
                <description>LteDsp LS_RAM1 Ram 0</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM007</name>
                <description>LteDsp LS_RAM0 Ram 7</description>
                <lsb>13</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM006</name>
                <description>LteDsp LS_RAM0 Ram 6</description>
                <lsb>21</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM005</name>
                <description>LteDsp LS_RAM0 Ram 5 bits 5:7</description>
                <lsb>29</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>REPAIR4</name>
            <description>SRAM repair register 4</description>
            <addressOffset>0x010</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LTEDSPLSRAM005</name>
                <description>LteDsp LS_RAM0 Ram 5 bits 0:4</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM004</name>
                <description>LteDsp LS_RAM0 Ram 4</description>
                <lsb>5</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM003</name>
                <description>LteDsp LS_RAM0 Ram 3</description>
                <lsb>13</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM002</name>
                <description>LteDsp LS_RAM0 Ram 2</description>
                <lsb>21</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>LTEDSPLSRAM001</name>
                <description>LteDsp LS_RAM0 Ram 1 bits 5:7</description>
                <lsb>29</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>REPAIR5</name>
            <description>SRAM repair register 5</description>
            <addressOffset>0x014</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LTEDSPLSRAM001</name>
                <description>LteDsp LS_RAM0 Ram 1 bits 0:4</description>
                <lsb>0</lsb>
                <msb>4</msb>
