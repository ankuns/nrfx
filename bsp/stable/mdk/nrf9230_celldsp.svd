    <peripheral>
      <name>GLOBAL_VPR120</name>
      <description>VPR peripheral registers 0</description>
      <baseAddress>0x5F8C8000</baseAddress>
      <headerStructName>VPR</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=S-->
      <!--Split access-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>VPR120</name>
        <value>200</value>
      </interrupt>
      <groupName>VPR</groupName>
      <size>0x20</size>
      <registers>
        <register>
