        <cluster>
          <name>CONFIG</name>
          <description>Configuration registers.</description>
          <headerStructName>TDM_CONFIG</headerStructName>
          <access>read-write</access>
          <addressOffset>0x504</addressOffset>
          <register>
            <name>MODE</name>
            <description>Mode configuration</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MODE</name>
                <description>Mode configuration</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Master</name>
                    <description>Master mode. SCK and FSYNC generated from internal master clock (MCK) and output on PSEL.SCK and PSEL.FSYNC.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Slave</name>
                    <description>Slave mode. SCK and FSYNC generated by external master and received on PSEL.SCK and PSEL.FSYNC.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>RXTXEN</name>
            <description>Reception (RX) and transmission (TX) enable.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RXTXEN</name>
                <description>Enable reception or transmission.</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Duplex</name>
                    <description>Enable both reception and transmission. Data will be written to the RXD.PTR address and data transmitted from the TXD.PTR address.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Rx</name>
                    <description>Enable reception, disable transmission. Data will be written to the RXD.PTR address.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Tx</name>
                    <description>Enable transmission, disable reception. Data will be transmitted from the TXD.PTR address.</description>
