              <lsb>13</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>ATDATASBIT111</name>
              <description>Read the value of ATDATAS[111] input to TMC</description>
              <lsb>14</lsb>
              <msb>14</msb>
            </field>
            <field>
              <name>ATDATASBIT119</name>
              <description>Read the value of ATDATAS[119] input to TMC</description>
              <lsb>15</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>ATDATASBIT127</name>
