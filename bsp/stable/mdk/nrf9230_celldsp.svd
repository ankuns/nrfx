              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Channel 0 is ignored by output trigger n.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>When an event occurs on channel 0, generate an event on output event n (ctitrigout[n]).</description>
                  <value>0x1</value>
