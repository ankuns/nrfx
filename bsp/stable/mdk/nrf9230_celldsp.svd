        </cluster>
        <register>
          <name>CRC32</name>
          <description>CRC32 value for FICR (except this word)</description>
          <addressOffset>0xBFC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>VALUE</name>
              <description>CRC32 value</description>
              <lsb>0</lsb>
              <msb>31</msb>
