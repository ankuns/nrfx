    <peripheral>
      <name>DSPCTRL</name>
      <description>DSP control</description>
      <baseAddress>0x45014000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>DSPCTRL</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>CPUID</name>
          <description>CPU domain ID</description>
          <addressOffset>0x400</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000005</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CPUID</name>
              <description>CPU domain ID</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ENABLEIRQIPCBLOCKING</name>
          <description>ENABLEIRQIPCBLOCKING should be enabled before DSP starts its shutdown or deepsleep routine. Register is
	  automatically cleared when DSP wakes up. ENABLEIRQIPCBLOCKING blocks the IPC interrupt wake-up mechanism and the
	  IRQ propagating to DSP interrupt input. If the IPC interrupt is not blocked, DSP can enter to unknown state, if IPC
	  IRQ occurs during deepsleep or shutdown sequence.</description>
          <addressOffset>0x404</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLEIRQIPCBLOCKING</name>
              <description>Enable for blocking the IPC interrupt wake-up mechanism</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Blocking disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Blocking enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ENABLEFORCEOFF</name>
          <description>Control for forcing off the DSP clock requesting</description>
          <addressOffset>0x408</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLEFORCEOFF</name>
              <description>Control for forcing off the DSP clock requesting</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>DSP clock request force off disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>DSP clock request force off enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <dim>0x10</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>MASTERPRIORITY[%s]</name>
          <description>Description collection: Control priority for AXI master connected to the local AXI bus matrix. NOTE: actual reset values vary across the register array.</description>
          <addressOffset>0x410</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
