                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRIGOUTEN_3</name>
              <description>Enables a cross trigger event to ctitrigout when channel 3 is activated.</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <enumeratedValues>
