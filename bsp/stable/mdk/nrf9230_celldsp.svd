                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CNTCHAIN</name>
              <description>For TRCCNTCTLR3 and TRCCNTCTLR1, this bit controls whether counter n decrements when a reload event occurs for counter n-1.</description>
