        <register>
          <name>ITATBCTR2</name>
          <description>Integration Test ATB Control 2 Register</description>
          <addressOffset>0xEF0</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATREADYS</name>
              <description>Set the value of ATREADYS output</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>AFVALIDS</name>
              <description>Set the value of AFVALIDS output</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
