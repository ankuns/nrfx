                <msb>13</msb>
              </field>
              <field>
                <name>GDRAMCTRL0102</name>
                <description>GD RAMC_01 Ram 2</description>
                <lsb>14</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>GDRAMCTRL0101</name>
                <description>GD RAMC_01 Ram 1</description>
                <lsb>22</lsb>
                <msb>29</msb>
