    <peripheral derivedFrom="GLOBAL_MVDMA120_NS">
      <name>GLOBAL_MVDMA120_S</name>
      <description>MVDMA performs direct-memory-accesses between memories. Data is transferred according to job descriptor lists.  Each transfer has corresponding source and sink descriptor lists with matching data amounts. The lists are in memory and they contain data buffer information, address pointers, buffer sizes and data type attributes. 1</description>
      <baseAddress>0x5F8D9000</baseAddress>
      <!--Security dma=SA-->
      <!--Security securemapping=US-->
      <interrupt>
        <name>MVDMA120</name>
        <value>217</value>
      </interrupt>
    </peripheral>
