                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ACTIVE</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>XRXOIR</name>
                <description>XIP Receive FIFO Overflow Raw Interrupt Status</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
                <enumeratedValues>
