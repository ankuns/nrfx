                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ACTIVE</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RSVD1232RISR</name>
                <description>Reserved bits - read as zero</description>
                <lsb>12</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TXEICR</name>
            <description>Transmit FIFO Error Interrupt Clear Register</description>
            <addressOffset>0x038</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>TXEICR</name>
                <description>Clear Transmit FIFO Overflow/Underflow Interrupt.</description>
                <lsb>0</lsb>
