                  <lsb>4</lsb>
                  <msb>4</msb>
                </field>
                <field>
                  <name>PPROG</name>
                  <description>Program Mode enabling.</description>
                  <lsb>5</lsb>
                  <msb>5</msb>
                </field>
                <field>
                  <name>PCLK</name>
                  <description>Clock input.</description>
                  <lsb>6</lsb>
                  <msb>6</msb>
                </field>
                <field>
                  <name>PCE</name>
                  <description>IP enabling.</description>
                  <lsb>7</lsb>
                  <msb>7</msb>
                </field>
                <field>
                  <name>PTR</name>
                  <description>Test row enable.</description>
                  <lsb>8</lsb>
                  <msb>8</msb>
                </field>
                <field>
                  <name>PDSTB</name>
                  <description>Deep standby mode enabling.</description>
                  <lsb>9</lsb>
                  <msb>9</msb>
                </field>
                <field>
                  <name>PENVDD2</name>
                  <description>VDD2 enable pin (VDD2 domain).</description>
                  <lsb>10</lsb>
                  <msb>10</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>OUT</name>
              <description>Reads directly from the output signals of the OTP macro.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>PBUSY</name>
                  <description>Auto enrollment busy pin.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                </field>
                <field>
                  <name>PS</name>
                  <description>Auto PUF margin read success.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
