              <lsb>0</lsb>
              <msb>16</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>HEFEAT1R</name>
          <description>Indicates the features of the STM.</description>
          <addressOffset>0xDF8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
