                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Priority inversion disabled, AXI always has priority over HW.</description>
                  <value>0x1</value>
                </enumeratedValue>
