                  <name>Cleared</name>
                  <description>Claim bit 0 is not set.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>Claim bit 0 is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
