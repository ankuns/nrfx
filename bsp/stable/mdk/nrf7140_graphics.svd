                <name>LOCK</name>
                <description>Enables the lock for PUF.READ.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>Pending</name>
