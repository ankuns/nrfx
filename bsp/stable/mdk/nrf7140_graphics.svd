      more details.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>TESTMODE</name>
                <description>Register for entering test mode. This register does not return the same value 
        as written.</description>
                <lsb>0</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Read: In normal mode.</description>
                    <value>0x0000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTMODE1</name>
                    <description>Read: In TESTMODE1 mode.</description>
                    <value>0x0001</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTMODE2</name>
                    <description>Read: In TESTMODE2 mode.</description>
                    <value>0x0002</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>SetNORMAL</name>
                    <description>Write: Sets NORMAL mode.</description>
                    <value>0x0000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SetTESTMODE1</name>
                    <description>Write: Sets TESTMODE1. Used for production tests.</description>
                    <value>0xBCDE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SetTESTMODE2</name>
                    <description>Write: Sets TESTMODE2. Used for production tests (Direct access to OTP macro signals).</description>
                    <value>0xABCD</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>LOCKTESTMODE</name>
            <description>Enables the lock for the TEST.TESTMODE</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EnableLock</name>
                <description>Enables the lock for TEST.TESTMODE.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>LockDisabled</name>
                    <description>Read: TEST.TESTMODE is not locked.</description>
                    <value>0x00000000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LockEnabled</name>
                    <description>Read: TEST.TESTMODE is locked.</description>
                    <value>0x00000001</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>EnableLock</name>
