                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>RSVDRXOICR</name>
                <description>Reserved bits - read as zero</description>
                <lsb>1</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RXUICR</name>
            <description>Receive FIFO Underflow Interrupt Clear Register</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RXUICR</name>
                <description>Clear Receive FIFO Underflow Interrupt.</description>
                <lsb>0</lsb>
                <msb>0</msb>
