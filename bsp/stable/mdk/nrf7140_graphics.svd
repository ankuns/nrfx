                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV_32</name>
                  <description>Divide by 32 (500 kHz)</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
