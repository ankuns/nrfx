      <size>0x20</size>
      <registers>
        <register>
          <name>SUPPORTEDPORTSIZES</name>
          <description>Each bit location is a single port size that is supported on the device.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PORT_SIZE_1</name>
              <description>Indicates whether the TPIU supports port size of 1-bit.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSupported</name>
                  <description>Port size 1 is not supported.</description>
