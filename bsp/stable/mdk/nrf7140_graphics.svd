          <access>read-write</access>
          <addressOffset>0x610</addressOffset>
          <cluster>
            <name>EMEMORY</name>
            <description>Unspecified</description>
            <headerStructName>GLOBAL_OTPC_TESTMODE1_EMEMORY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>READ</name>
              <description>Configures the OTP memory read mode. The PTM signals of the
                  OTP macro are set accordingly to this read mode during reads.</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>READ</name>
                  <description>OTP mempory read mode.</description>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Normal</name>
                      <description>Normal read mode.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PGMMargin</name>
                      <description>PGM margin read mode.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>InitialMargin</name>
                      <description>Initial margin read mode.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>PTR</name>
              <description>Enables the PTR (PTR is the direct signal to the
                  OTP macro, it enables the test row) for read or write. When 
                  enabled, the read and writes goes to test row instead of main
                  OTP memory.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <fields>
                <field>
                  <name>PTR</name>
                  <description>Enable PTR.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable PTR.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable PTR.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>TESTMODE2</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_OTPC_TESTMODE2</headerStructName>
          <access>read-write</access>
          <addressOffset>0x620</addressOffset>
          <cluster>
            <name>EMEMORY</name>
