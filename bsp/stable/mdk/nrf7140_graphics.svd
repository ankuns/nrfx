                    The PUF.READ is locked.</description>
                    <value>0x00000000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Read: PUF.READ is not locked.</description>
                    <value>0x00000001</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Read: PUF.READ is locked.</description>
                    <value>0x00000002</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Write: Enables the lock (Ignores any other value written).</description>
