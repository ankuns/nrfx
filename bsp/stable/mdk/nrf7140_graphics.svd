                  <enumeratedValue>
                    <name>ACTIVE</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXUIR</name>
                <description>Transmit FIFO Underflow Interrupt Raw Status</description>
                <lsb>7</lsb>
