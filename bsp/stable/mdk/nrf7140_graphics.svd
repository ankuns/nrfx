                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Increment2</name>
                    <description>Address auto-increment by two MRAM words</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WRITETRIGGER</name>
                <description>Configuration for write trigger</description>
                <lsb>8</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
