                <msb>9</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>SPITER</name>
                <description>SPI Transmit Error Interrupt status.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INACTIVE</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ACTIVE</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DONER</name>
                <description>SSI Done Interrupt Raw Status</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INACTIVE</name>
