          <addressOffset>0x428</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>NFCFRAMINGCORESTATE</name>
              <description>Current NFC Framing Core State</description>
              <lsb>0</lsb>
