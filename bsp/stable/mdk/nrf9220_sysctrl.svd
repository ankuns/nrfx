                  <name>NotReady</name>
                  <description>Chip configuration is not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ready</name>
                  <description>Chip configuration is completed</description>
                  <value>0x1</value>
                </enumeratedValue>
