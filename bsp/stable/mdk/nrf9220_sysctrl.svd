              <lsb>18</lsb>
              <msb>19</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotImplemented</name>
                  <description>STMTCSR.HWTEN is not implemented</description>
                  <value>0x1</value>
                </enumeratedValue>
