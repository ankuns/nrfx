            </field>
            <field>
              <name>APPULSE_1</name>
              <description>Setting a bit HIGH generates a channel event pulse for the selected channel. There is one bit of the register for each channel.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
