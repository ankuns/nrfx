                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Audio</name>
                  <description>Noiseshaping and decimating. Larger passband. Provides a 100kS/s cut off frequency, 8x the oversampling ratio. See design description for more information</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Accuracy</name>
                  <description>Noiseshaping and decimating. Smaller passband. Recommended resolution setting is 14 bits. Provides a 10kS/s cut off frequency, 32x the oversampling ratio. See design description for more information</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Stage1</name>
                  <description>Result from common 1st stage filter. For debugging only</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
