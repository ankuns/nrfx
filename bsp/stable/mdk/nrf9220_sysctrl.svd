              </field>
              <field>
                <name>CFGMEMYDATAWIDTHENABLE</name>
                <description>Enable use of Y block specific data width. Allowed only for MAR operation.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CFGMEMYOFFSET</name>
                <description>Offset value</description>
                <lsb>24</lsb>
