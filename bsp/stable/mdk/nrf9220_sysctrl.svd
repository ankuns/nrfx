            <fields>
              <field>
                <name>CFGWATCHDOGTIMERHREADY</name>
                <description>AXON will wait the programmed number of clock cyles to receive hready on AHB master port, otherwise the watchdog timer will expire and trigger an interrupt.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>CFGWATCHDOGTIMERHGRANT</name>
