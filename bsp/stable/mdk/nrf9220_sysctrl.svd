            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGDESCXADDR</name>
                <description>register address for X-block in SysMem. This address needs to be 16 byte algined when 8 bit packing is used, 8 byte aligned when 12/16 but packing issued and 4 byte aligned otherwise. Recommend to by 16 byte aligned to satisfy all modes.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGDESCXSIZERB</name>
            <description>X-block configuration register 2.</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGMEMXNUM</name>
                <description>Effective number of samples in X-block, maximum 2048 12bits. Must by multiple of 4 for (FIR, FIR.X, L2NOM, ACC, MAR,MAR.X. Must be 1024 for ACORR. Must be multiple of 2 for other operations.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>CFGMEMXSTRIDE</name>
                <description>Stride value, currently it is 2 bits.</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>CFGMEMXDATAWIDTH</name>
                <description>Data width for X block, when cfg_mem_x_data_width_enable is 1. Otherwise cfg_cu_data_width is used.</description>
                <lsb>20</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>CFGMEMXDATAWIDTHENABLE</name>
                <description>Enable use of X block specific data width. Allowed only for MAR operation.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CFGMEMXOFFSET</name>
                <description>Offset value</description>
                <lsb>24</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
