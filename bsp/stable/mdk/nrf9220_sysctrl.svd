        <register>
          <name>FFSR</name>
          <description>Formatter and Flush Status Register</description>
          <addressOffset>0x300</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FLINPROG</name>
              <description>This bit indicates whether the TMC is currently processing a flush on the ATB slave port. This bit reflects the status of the AFVALIDS output. The flush initiation is controlled by the flush-control bits in the FFCR register.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>FTSTOPPED</name>
              <description>This bit behaves the same way as the FtEmpty bit in the STS register, 0x00C.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FFCR</name>
          <description>Formatter and Flush Control Register</description>
          <addressOffset>0x304</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENFT</name>
              <description>If this bit is set, formatting is enabled.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>ENTI</name>
              <description>Setting this bit enables the insertion of triggers in the formatted trace stream.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>FONFLIN</name>
              <description>Setting this bit enables the detection of transitions on the FLUSHIN input by the TMC.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>FONTRIGEVT</name>
              <description>Setting this bit generates a flush when a Trigger event occurs.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>FLUSHMAN</name>
              <description>Manually generate a flush of the system.</description>
              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>TRIGONTRIGIN</name>
              <description>If this bit is set, a trigger is indicated on the trace stream when a rising edge is detected on the TRIGIN input.</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>TRIGONTRIGEVT</name>
              <description>If this bit is set, a trigger is indicated on the output trace stream when a Trigger Event occurs.</description>
              <lsb>9</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>TRIGONFL</name>
              <description>If this bit is set, a trigger is indicated on the trace stream on AFREADYS being returned.</description>
              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>STOPONFL</name>
              <description>If this bit is set, the formatter is stopped on completion of a flush operation.</description>
              <lsb>12</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>STOPONTRIGEVT</name>
              <description>If this bit is set, the formatter is stopped when a Trigger Event has been observed.</description>
              <lsb>13</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>DRAINBUFFER</name>
              <description>This bit is used to enable draining of the trace data through the ATB Master interface after the formatter has stopped.</description>
              <lsb>14</lsb>
              <msb>14</msb>
            </field>
          </fields>
        </register>
