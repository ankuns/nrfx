              <lsb>6</lsb>
              <msb>6</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotImplemented</name>
                  <description>STMTSFREQR is read-only.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Implemented</name>
                  <description>STMTSFREQR is read-write.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FORCETS</name>
              <description>Timestamp force configuration.</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotImplemented</name>
                  <description>STMTSSTIMR bit 0 is read-only.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Implemented</name>
                  <description>STMTSSTIMR bit 0 is read-write.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRACEBUS</name>
              <description>Trace bus support.</description>
              <lsb>10</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>TRIGCTL</name>
              <description>Trigger control support.</description>
              <lsb>14</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>TSPRESCALE</name>
              <description>Timestamp prescale support</description>
              <lsb>16</lsb>
              <msb>17</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotImplemented</name>
                  <description>Timestamp prescale is not implemented.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
