              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>CLKSCHEME</name>
              <description>This value indicates the TMC RAM clocking scheme used, ie. whether the TMC RAM operates synchronously or asynchronously to CLK.</description>
              <lsb>5</lsb>
              <msb>5</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYNC</name>
