            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGRESETSOFT</name>
                <description>Active high soft reset. To perform reset, SW should write this bit to 1 then write it to 0. Doesn't reset programmable registers. Reset is performed asynchronously. Deassertion of reset is synchronized and only takes a few cycles to propagate through internal synchrnonizers</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORMALOPERATION</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HOLDINRESET</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGCLK</name>
            <description>Clock Gating Register</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGCLKDISABLE</name>
                <description>Active high clock gating. Does not gate off clock to configuration registers to avoid lockup. This can be asserted when block is not in use to save power. This can also be used to measure leakage power in silicon with clocks disabled</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLOCKENABLED</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLOCKDISABLED</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGCLKIFMAPEN</name>
