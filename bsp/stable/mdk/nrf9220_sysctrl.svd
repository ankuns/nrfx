                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CFGWATCHDOGTIMERCMD</name>
                <description>AXON will wait the programmed number of clock cyles (x 2^8) for a command to finish processing, otherwise the watchdog timer will expire and trigger an interrupt.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>CFGWATCHDOGTIMERDESC</name>
                <description>AXON will wait the programmed number of clock cyles (x 2^16) for all the descriptos to finish processing, otherwise the watchdog timer will expire and trigger an interrupt.</description>
                <lsb>24</lsb>
                <msb>31</msb>
              </field>
            </fields>
