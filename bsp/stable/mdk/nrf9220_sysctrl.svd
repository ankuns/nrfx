    <peripheral>
      <name>GLOBAL_PROTOTYPE</name>
      <description>Prototype HW information registers.</description>
      <baseAddress>0x4F8D2000</baseAddress>
      <alternatePeripheral>GLOBAL_MUTEX120</alternatePeripheral>
      <headerStructName>PROTOTYPEINFO</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>PROTOTYPEINFO</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>PSPHWID</name>
          <description>PSP hardware ID register, unique ID for each prototype release. Used to identify RTL release that prototype is based on.</description>
          <addressOffset>0x800</addressOffset>
          <access>read-only</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PATCHRELEASEVERSION</name>
              <description>PSP patch/bugfix release version</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>HOTFIXRELEASEVERSION</name>
              <description>hotfix release version</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>RTLRELEASEVERSION</name>
              <description>First letter of RTL release version in ASCII corresponding to A-Z.</description>
              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>PRODUCTCONFIG</name>
              <description>Product Config</description>
              <lsb>24</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FPGATIMESTAMP</name>
          <description>32-bit timestamp value stored by the FPGA bitstream in format ddddd_MMMM_yyyyyy_hhhhh_mmmmmm_ssssss. Unique for every FPGA netlist implementation, not dependent to RTL synthesis.  0x87654321 set in emulator database.</description>
          <addressOffset>0x804</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FPGATIMESTAMP</name>
              <description>ddddd = 5 bits to represent 31 days in a month. MMMM = 4 bits to represent 12 months in a year. yyyyyy = 6 bits to represent 0 to 63 (to note year 2000 to 2063). hhhhh = 5 bits to represent 24 hours in a day. mmmmmm = 6 bits to represent 60 minutes in an hour. ssssss = 6 bits to represent 60 seconds in a minute.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>EMULATORSPEEDVALUE</name>
          <description>Used to store real speed of emulator is running. Used by SW to config UART speed etc, to ensure correct operation.</description>
          <addressOffset>0x808</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>EMULATORSPEEDVALUE</name>
              <description>Actual clock speed for FCLK 400M in emulator (Hz). In FPGA set to 0x0.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FPGACLOCKDIVIDERRATIO</name>
          <description>Overall clock divider ratio for FPGA</description>
          <addressOffset>0x80C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FPGACLOCKDIVIDERRATIO</name>
              <description>Overall clock divider ratio for FPGA. Set to 0 for emulator database.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
