            <fields>
              <field>
                <name>CFGMEMYADDR</name>
                <description>First register address for Y-block in SysMem. This address needs to be 16 byte algined when 8 bit packing is used, 8 byte aligned when 12/16 but packing issued and 4 byte aligned otherwise. Recommend to by 16 byte aligned to satisfy all modes.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
