                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A1</name>
                  <description>State READY_A1</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A1_SEL_RES</name>
                  <description>State READY_A1_SEL_RES</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A1_SDD_RES</name>
                  <description>State READY_A1_SDD_RES</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A2</name>
                  <description>State READY_A2</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A2_SEL_RES</name>
                  <description>State READY_A2_SEL_RES</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A2_SDD_RES</name>
                  <description>State READY_A2_SDD_RES</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_A</name>
                  <description>State ACTIVE_A</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLEEP_A</name>
                  <description>State SLEEP_A</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLEEP_A_SENS_RES</name>
                  <description>State SLEEP_A_SENS_RES</description>
                  <value>0xD</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MEASUREDFREQ</name>
          <description>The frequency measured on the 13.56 MHz NFC carrier signal</description>
          <addressOffset>0x434</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MEASUREDFREQ</name>
              <description>The frequency measured on the 13.56 MHz NFC carrier signal. This result is produced in response to triggering FREQMEASURE. Frequency = 16 MHz * MEASUREDFREQ / 1000</description>
              <lsb>0</lsb>
              <msb>10</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ROSCCALVALUE</name>
          <description>The current value used by the ring oscillator</description>
          <addressOffset>0x438</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000000F</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ROSCCALVALUE</name>
              <description>The current value used by the ring oscillator. Either given by the calibration engine, or by the override value.</description>
              <lsb>0</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Minimum</name>
                  <description>Minimum frequency</description>
                  <value>0x00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Nominal</name>
                  <description>Nominal frequency</description>
                  <value>0x0F</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Maximum</name>
                  <description>Maximum frequency</description>
                  <value>0x1F</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FIELDPRESENT</name>
          <description>Indicates the presence or not of a valid field</description>
          <addressOffset>0x43C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FIELDPRESENT</name>
              <description>Indicates if a valid field is present. Available only in the activated state.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoField</name>
                  <description>No valid field detected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FieldPresent</name>
                  <description>Valid field detected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCKDETECT</name>
              <description>Indicates if the low level has locked to the field</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotLocked</name>
                  <description>Not locked to field</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Locked</name>
                  <description>Locked to field</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CMFBPDREF</name>
          <description>Current value of common-mode voltage level at pad</description>
          <addressOffset>0x440</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CMFBPDREF</name>
              <description>Current value of common-mode voltage level at pad.</description>
              <lsb>0</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CMFBPDREF0</name>
                  <description>800 mV</description>
