            </field>
            <field>
              <name>TS</name>
              <description>Timestamp support.</description>
              <lsb>4</lsb>
              <msb>5</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Absolute</name>
                  <description>Absolute timestamps implemented.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSFREQ</name>
