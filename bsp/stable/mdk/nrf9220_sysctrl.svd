              <enumeratedValues>
                <enumeratedValue>
                  <name>PadNotConnected</name>
                  <description>NFC pads not connected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>NFCT peripheral disabled</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Sense</name>
                  <description>In sense state. But it is transitive state, so visible for one peripheral clock cycle only.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RampUp</name>
                  <description>NFCT peripheral ramping up</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CollisionResolution</name>
                  <description>Automatic collision resolution in progress</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Selected</name>
                  <description>In selected state</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Transmitting</name>
                  <description>Transmit in progress</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TransmitFinishing</name>
                  <description>Transmit finishing, reading from the RAM buffer completed</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>NFCANTICOLRESSTATE</name>
