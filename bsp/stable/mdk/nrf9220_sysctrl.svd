                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A0</name>
                  <description>State READY_A0</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A0_SEL_RES</name>
                  <description>State READY_A0_SEL_RES</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY_A0_SDD_RES</name>
