          </register>
          <register>
            <name>CFGCMDBUFFER</name>
            <description>Command Buffer Configuration Register</description>
            <addressOffset>0x0E4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGCMDBUFFERLENGTH</name>
                <description>Total number of DWORDS in command buffer.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>CFGCMDBUFFERVALID</name>
                <description>Number of valid DWORDS (32 bits) in command buffer. FW updates this field to synchronize with HW and let HW progress upto this location. Each Entry is atleast 64 bitss. Entry[15:0] = address. Entry[19:16] = active low write byte enable, 0 = write all 4 bytes, E=write only first byte. Entry[31:24] = number of data DWORDS. Entry[63:32] = data0, .... Little endian format, ie Entry[31:0] is lower address than Entry[63:32]</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
