                  <description>1.1 V</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMFBPDREF4</name>
                  <description>Spare</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
