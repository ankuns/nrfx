              </field>
            </fields>
          </register>
          <register>
            <name>INTMASK</name>
            <description>Interrupt Mask Enable Register. A zero setting in any INTe bit prevents corresponding interrupt from propagating to processor.</description>
            <addressOffset>0x020</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INTMASKRESULTREADYINTE</name>
                <description>Enable generating interrupt when Axon Pro processed a single command and result is ready</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INTERRUPTDISABLED</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INTERRUPTENABLED</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INTMASKFINISHEDINTE</name>
                <description>Enable generating interrupt when Axon Pro finished processing all command buffer</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INTERRUPTDISABLED</name>
                    <description>Unspecified</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INTERRUPTENABLED</name>
                    <description>Unspecified</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INTMASKCBVALIDINTE</name>
                <description>Enable generating interrupt when Axon Pro done processing valid portion of command buffer</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INTERRUPTDISABLED</name>
                    <description>Unspecified</description>
