            <name>CFGDESCCMDTYPERB</name>
            <description>Read Back for desc[0].  General configuration register for 1000_AXON, desc[0] is manily to set the command type</description>
            <addressOffset>0x000</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGCMD</name>
                <description>currently it is 5bits [4:0], specify a required operation to be executed. In the notation used below, capital letters (O,X,Y) represent vectors while small letters (o,a,b) represent scalars. When the output is a vector (O) it is written to memory, when the output is scallar (o) is is available in the accumulator status register (which can optionally be written to memory by setting cfg_write_acc in descriptor.)</description>
                <lsb>0</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OPNOP</name>
                    <description>Unspecified</description>
                    <value>0x00</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPFFT</name>
                    <description>Unspecified</description>
                    <value>0x01</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPMAR</name>
                    <description>Unspecified</description>
                    <value>0x02</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPFIR</name>
                    <description>Unspecified</description>
                    <value>0x03</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPFIRX</name>
                    <description>Unspecified</description>
                    <value>0x04</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPNORM</name>
                    <description>Unspecified</description>
                    <value>0x05</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPAXPBY</name>
                    <description>Unspecified</description>
                    <value>0x06</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPACC</name>
                    <description>Unspecified</description>
                    <value>0x08</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXPY</name>
                    <description>Unspecified</description>
                    <value>0x09</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXMY</name>
                    <description>Unspecified</description>
                    <value>0x0A</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPAXPB</name>
                    <description>Unspecified</description>
                    <value>0x0B</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPACORR</name>
                    <description>Unspecified</description>
                    <value>0x0C</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXSPYS</name>
                    <description>Unspecified</description>
                    <value>0x0D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXSMYS</name>
                    <description>Unspecified</description>
                    <value>0x0E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPSQRT</name>
                    <description>Unspecified</description>
                    <value>0x0F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPLOG</name>
                    <description>Unspecified</description>
                    <value>0x10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPEXP</name>
                    <description>Unspecified</description>
                    <value>0x11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXTY</name>
                    <description>Unspecified</description>
                    <value>0x12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPXS</name>
                    <description>Unspecified</description>
                    <value>0x13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPPREFETCH</name>
                    <description>Unspecified</description>
                    <value>0x14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OPMARX</name>
                    <description>Unspecified</description>
                    <value>0x16</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CFGFFTTAP</name>
                <description>Data TAP size, 512=3'b001,256=3'b010,128=3'b011,64=3'b100,32=3'b101.</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>CFGSAMPLESIZE</name>
                <description>12 bits, sample size is up to 2048 (12'b100_0000_0000).</description>
                <lsb>16</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>CFGACC32</name>
                <description>When 1, and cfg_write_acc and cfg_acc_pack are 1 the 32 bit accumulator is written into system memory. When 0, and cfg_write_acc and cfg_acc_pack are 1 the width of the accumulator written into system memory is determined by cfg_cu_data_width.</description>
                <lsb>29</lsb>
                <msb>29</msb>
              </field>
              <field>
                <name>CFGACCPACK</name>
                <description>When 1, and cfg_write_acc is 1 the accumulator packed in system memory according to data width cfg_cu_data_width and cfg_acc_32. When 0, and cfg_write_acc is 1 the 64bit accumulator is written into system memory.</description>
                <lsb>30</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>CFGMEMPACK</name>
                <description>When 1, Samples are packed in system memory according to data width cfg_cu_data_width. When 0, each system memory will contain only one sample.</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGDESCCUSETRB</name>
            <description>Read Back Configuration register for the compute_unit in 1000_AXON</description>
            <addressOffset>0x004</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CFGCUDATAWIDTH</name>
                <description>real width of data, 08_bit=2'b00,16_bit=2'b01,24_bit=2'b10,12_bit=2'b11.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>CFGCUROUNDEN</name>
                <description>Rounding enable.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>CFGCUROUNDSIZE</name>
                <description>Rounding size. Rounding operation devides output by 2^cfg_cu_round_size. Then rounds up if remainder is more than 0.5 or remainder is exactly 0.5 and quotient is odd. Maximum supported cfg_cu_round_size is 32.</description>
                <lsb>8</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>CFGCUCLAMPEN</name>
                <description>Clamping enable. Enabling clamping will saturate outputs and accumulator at their maximum postivie incase of overflow or minimum negative values incase of underflow. The default size for the Accumulator is 64 bits and for outputs is 24 bits. When packing (cfg_mem_pack) is enabled, the size of the output is specified by cfg_cu_data_width. When the accumulator is packed (cfg_acc_pack) and written into memory (cfg_write_acc) the accumulator size is determined by cfg_acc_32 and cfg_cu_data_width.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>CFGCURELUEN</name>
                <description>Relu function enable at the output of compute unit. The relu operation zeros out negative numbers. To perform only RELU, use the aX+b with a=1 and b=0</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>CFGWRITEACC</name>
                <description>Write value of 64bit accumulator into memory indicated by cfg_mem_q_addr. This should be used with coammnds that output the accumulator (ie ACC, MAR, MAR_S, L2NORM)</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CFGDESCXADDRRB</name>
            <description>Read Back for X-block configuration register.</description>
            <addressOffset>0x008</addressOffset>
