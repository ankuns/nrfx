          <size>0x20</size>
          <fields>
            <field>
              <name>PROTCTRLBIT0</name>
              <description>This bit controls the value driven on ARPROTM[0]/AWPROTM[0] on the AXI interface when performing AXI transfers.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>PROTCTRLBIT1</name>
              <description>This bit controls the value driven on ARPROTM[1]/AWPROTM[1] on the AXI interface when performing AXI transfers.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>CACHECTRLBIT0</name>
              <description>This bit controls the value driven on the ARCACHEM[0]/AWCACHEM[0] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>CACHECTRLBIT1</name>
              <description>This bit controls the value driven on the ARCACHEM[1]/AWCACHEM[1] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>CACHECTRLBIT2</name>
              <description>This bit controls the value driven on the ARCACHEM[2]/AWCACHEM[2] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>CACHECTRLBIT3</name>
              <description>This bit controls the value driven on the ARCACHEM[3]/AWCACHEM[3] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SCATTERGATHERMODE</name>
              <description>This bit indicates whether trace memory is accessed as a single buffer in system memory or as a linked-list based scatter-gather memory.</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>WRBURSTLEN</name>
