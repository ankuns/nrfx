                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXLEVEL2_NS</name>
              <description>In Non-secure state, each bit controls whether instruction tracing is enabled for the corresponding Exception level 2.</description>
