                <field>
                  <name>RSVDRXUICR</name>
                  <lsb>1</lsb>
                  <msb>31</msb>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>MSTICR</name>
              <description>Multi-Controller Interrupt Clear Register</description>
              <addressOffset>0x044</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>MSTICR</name>
                  <description>Clear Multi-Controller Contention Interrupt.</description>
                  <lsb>0</lsb>
