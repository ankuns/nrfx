        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000300</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATBINPORTCOUNT</name>
              <description>This value indicates the type/number of ATB multiplexing present on the input ATB.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>CLKSCHEME</name>
              <description>This value indicates the TMC RAM clocking scheme used, ie. whether the TMC RAM operates synchronously or asynchronously to CLK.</description>
              <lsb>5</lsb>
              <msb>5</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYNC</name>
                  <description>The TMC RAM operates synchronously to CLK.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CONFIGTYPE</name>
              <description>This value indicates TMC configuration type.</description>
              <lsb>6</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ETB</name>
                  <description>Unspecified</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ETR</name>
                  <description>Unspecified</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ETF</name>
                  <description>Unspecified</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MEMWIDTH</name>
              <description>This value indicates the width of the Memory interface databus.</description>
              <lsb>8</lsb>
              <msb>10</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>32BIT</name>
                  <description>Memory interface databus is 32 bits wide.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64BIT</name>
                  <description>Memory interface databus is 64 bits wide.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128BIT</name>
                  <description>Memory interface databus is 128 bits wide.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>256BIT</name>
                  <description>Memory interface databus is 256 bits wide.</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WBUF_DEPTH</name>
              <description>This value indicates, in powers of two, the number of entries in the Write buffer. Each entry is of size ATB_DATA_WIDTH.</description>
              <lsb>11</lsb>
              <msb>13</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4ENTRIES</name>
                  <description>Depth of the Write buffer is 4 entries.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8ENTRIES</name>
                  <description>Depth of the Write buffer is 8 entries.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16ENTRIES</name>
                  <description>Depth of the Write buffer is 16 entries.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32ENTRIES</name>
                  <description>Depth of the Write buffer is 32 entries.</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
