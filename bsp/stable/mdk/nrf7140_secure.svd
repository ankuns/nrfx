          <register>
            <name>MSHCVERIDR</name>
            <description>This register reflects the current release number of DWC_mshc/DWC_mshc_lite.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x30323030</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MSHCVERID</name>
                <description>Current release number</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>MSHCVERTYPER</name>
            <description>This register reflects the current release type of DWC_mshc/DWC_mshc_lite.</description>
            <addressOffset>0x004</addressOffset>
