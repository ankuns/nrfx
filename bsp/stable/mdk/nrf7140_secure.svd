              </field>
              <field>
                <name>MASKPHYERRSOTSYNCHS1</name>
                <description>Mask for phy_errsotsynchs_1</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
