                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES16K</name>
                    <description>16K bytes SDMA Buffer Boundary</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
