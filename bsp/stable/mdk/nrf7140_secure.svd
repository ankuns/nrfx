              <size>0x20</size>
              <fields>
                <field>
                  <name>RXOICR</name>
                  <description>Clear Receive FIFO Overflow Interrupt.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>RSVDRXOICR</name>
                  <lsb>1</lsb>
                  <msb>31</msb>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RXUICR</name>
              <description>Receive FIFO Underflow Interrupt Clear Register</description>
              <addressOffset>0x040</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>RXUICR</name>
                  <description>Clear Receive FIFO Underflow Interrupt.</description>
                  <lsb>0</lsb>
