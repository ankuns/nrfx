              </enumeratedValues>
            </field>
            <field>
              <name>HDBG</name>
              <description>Halt on Debug</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Do not halt on debug, HLTDBG signal into the counter has no effect.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Halt on debug, when HLTDBG is driven HIGH, the count value is held static.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
