                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTCRCFRAMEFATAL</name>
                <description>Status of int_st_crc_frame_fatal.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTPLDCRCFATAL</name>
                <description>Status of int_st_pld_crc_fatal.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTDATAID</name>
                <description>Status of int_st_data_id.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTECCCORRECTED</name>
