                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYSHUTDOWNZ</name>
            <description>Controls the PHY Shutdown mode. In this state, the PHY sets the analog and digital circuitry in the Reset state.</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYSHUTDOWNZ</name>
                <description>Shutdown input. This line is used to place the complete macro in power down. All analog blocks are in power down mode and digital logic is cleared. Active Low.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPHYRSTZ</name>
