              </field>
              <field>
                <name>DCSSW1PTX</name>
                <description>This bit configures the DCS short write packet with one parameter command transmission type:</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
