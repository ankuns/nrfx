                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>PHYTXEXITULPSCLK</name>
                <description>ULPS mode Exit on clock lane.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>PHYTXREQULPSLAN</name>
                <description>ULPS mode Request on all active data lanes.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>PHYTXEXITULPSLAN</name>
                <description>ULPS mode Exit on all active data lanes.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
