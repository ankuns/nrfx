              <field>
                <name>PHYTESTCLK</name>
                <description>Clock to capture testdin bus contents into the macro, with testen signal controlling the operation selection.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTESTCTRL1</name>
            <description>Control for vendor specific interface in the PHY.</description>
            <addressOffset>0x054</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
