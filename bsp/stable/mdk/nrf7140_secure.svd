          <resetValue>0x0000000F</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CLAIMSET</name>
              <description>This claim tag bit is implemented</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
