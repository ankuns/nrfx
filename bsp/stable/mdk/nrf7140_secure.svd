              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SCATTERGATHERMODE</name>
              <description>This bit indicates whether trace memory is accessed as a single buffer in system memory or as a linked-list based scatter-gather memory.</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
