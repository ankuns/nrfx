          <register>
            <name>PHYTESTCTRL0</name>
            <description>Control for vendor specific interface in the PHY.</description>
            <addressOffset>0x050</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
