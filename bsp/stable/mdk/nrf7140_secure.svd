        <register>
          <name>TRCCLAIMCLR</name>
          <description>Clears bits in the claim tag and determines the current value of the claim tag.</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CLR_0</name>
