                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Tx</name>
                    <description>Enable transmission, disable reception. Data will be transmitted from the TXD.PTR address.</description>
                    <value>0x2</value>
