              </enumeratedValues>
            </field>
            <field>
              <name>EXLEVEL3_S</name>
              <description>In Secure state, each bit controls whether instruction tracing is enabled for the corresponding Exception level 3.</description>
              <lsb>19</lsb>
              <msb>19</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>The trace unit does not generate instruction trace, in Secure state, for Exception level 3.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>The trace unit generates instruction trace, in Secure state, for Exception level 3.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXLEVEL0_NS</name>
              <description>In Non-secure state, each bit controls whether instruction tracing is enabled for the corresponding Exception level 0.</description>
              <lsb>20</lsb>
              <msb>20</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>The trace unit does not generate instruction trace, in Non-secure state, for Exception level 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>The trace unit generates instruction trace, in Non-secure state, for Exception level 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXLEVEL1_NS</name>
              <description>In Non-secure state, each bit controls whether instruction tracing is enabled for the corresponding Exception level 1.</description>
              <lsb>21</lsb>
              <msb>21</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>The trace unit does not generate instruction trace, in Non-secure state, for Exception level 1.</description>
