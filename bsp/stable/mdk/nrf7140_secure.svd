                <description>Description cluster: The initialization vector of the encryption algorithm used to protect the local domain firmware master encryption key generation [n].</description>
                <addressOffset>0x0000</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value of nonce used by AEAD.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <name>ATTR</name>
                <description>Description cluster: The attributes of the local domain firmware master encryption key generation [n]. This field is used as an additional authenticated data (AAD) in AEAD.</description>
                <addressOffset>0x0004</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>TYPE</name>
                    <description>Type of the key. This field should follow the key type encoding from PSA Crypto API v1.2.1.</description>
                    <lsb>0</lsb>
                    <msb>15</msb>
                  </field>
                  <field>
                    <name>LEN</name>
                    <description>Length of the key in bits.</description>
                    <lsb>16</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x8</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>CIPHERTEXT[%s]</name>
                <description>Description collection: The encrypted local domain firmware master encryption key generation [n].</description>
                <addressOffset>0x0008</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value for word [o] in the key value [n].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x4</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>MAC[%s]</name>
                <description>Description collection: The authentication tag of the local domain firmware master encryption key generation [n].</description>
                <addressOffset>0x0028</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>The word [o] of the authentication tag.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x2</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>RFU[%s]</name>
                <description>Description collection:</description>
                <addressOffset>0x0038</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>RFU word [o].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
            </cluster>
            <cluster>
              <dim>3</dim>
              <dimIncrement>0x060</dimIncrement>
              <name>AUTHDEBUGKEY[%s]</name>
              <description>Local domain authenticated debug access public key. The public key is stored as additional authenticated data (AAD) in unencrypted form using an AEAD scheme realized by AES-256 GCM mode,
        with the local domain KEK used as a secret key.
        The initialization vector is provided in NONCE register.
        Key attributes from ATTR register shall be used as an additional authenticated data (AAD) in AEAD.
        The content of PUBKEY registers shall be used as an additional authenticated data (AAD) in AEAD.</description>
              <headerStructName>SICR_AROT_WIFICORE_AUTHDEBUGKEY</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0080</addressOffset>
              <register>
                <name>NONCE</name>
                <description>Description cluster: The initialization vector of the encryption algorithm used to protect the local domain authenticated debug access public key generation [n].</description>
                <addressOffset>0x0000</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value of nonce used by AEAD.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <name>ATTR</name>
                <description>Description cluster: The attributes of the local domain firmware master encryption key generation [n]. This field is used as an additional authenticated data (AAD) in AEAD.</description>
                <addressOffset>0x0004</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>TYPE</name>
                    <description>Type of the key. This field should follow the key type encoding from PSA Crypto API v1.2.1.</description>
                    <lsb>0</lsb>
                    <msb>15</msb>
                  </field>
                  <field>
                    <name>LEN</name>
                    <description>Length of the key in bits.</description>
                    <lsb>16</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x10</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>PUBKEY[%s]</name>
                <description>Description collection: The local domain authenticated debug access public key generation [n].</description>
                <addressOffset>0x0008</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value for word [o] in the key value [n].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x4</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>MAC[%s]</name>
                <description>Description collection: The authentication tag of the local domain authenticated debug access public key generation [n].</description>
                <addressOffset>0x0048</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>The word [o] of the authentication tag.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x2</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>RFU[%s]</name>
                <description>Description collection:</description>
                <addressOffset>0x0058</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>RFU word [o].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
            </cluster>
            <cluster>
              <dim>3</dim>
              <dimIncrement>0x060</dimIncrement>
              <name>SUITPUBKEY[%s]</name>
              <description>Public key used by the local domain SUIT manifest. The public key is stored as additional authenticated data (AAD) in unencrypted form using an AEAD scheme realized by AES-256 GCM mode,
        with the local domain KEK used as a secret key.
        The initialization vector is provided in NONCE register.
        Key attributes from ATTR register shall be used as an additional authenticated data (AAD) in AEAD.
        The content of PUBKEY registers shall be used as an additional authenticated data (AAD) in AEAD.</description>
              <headerStructName>SICR_AROT_WIFICORE_SUITPUBKEY</headerStructName>
              <access>read-write</access>
              <addressOffset>0x01A0</addressOffset>
              <register>
                <name>NONCE</name>
                <description>Description cluster: The initialization vector of the encryption algorithm used to protect the local domain SUIT manifest public key generation [n].</description>
                <addressOffset>0x0000</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value of nonce used by AEAD.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <name>ATTR</name>
                <description>Description cluster: The attributes of the local domain firmware master encryption key generation [n]. This field is used as an additional authenticated data (AAD) in AEAD.</description>
                <addressOffset>0x0004</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>TYPE</name>
                    <description>Type of the key. This field should follow the key type encoding from PSA Crypto API v1.2.1.</description>
                    <lsb>0</lsb>
                    <msb>15</msb>
                  </field>
                  <field>
                    <name>LEN</name>
                    <description>Length of the key in bits.</description>
                    <lsb>16</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x10</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>PUBKEY[%s]</name>
                <description>Description collection: The local domain SUIT manifest public key generation [n].</description>
                <addressOffset>0x0008</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>Value for word [o] in the key value [n].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x4</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>MAC[%s]</name>
                <description>Description collection: The authentication tag of the local domain SUIT manifest public key generation [n].</description>
                <addressOffset>0x0048</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>The word [o] of the authentication tag.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <dim>0x2</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>RFU[%s]</name>
                <description>Description collection:</description>
                <addressOffset>0x0058</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>RFU word [o].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
            </cluster>
            <cluster>
              <name>DATAPROTECTION</name>
              <description>Elements used for validation of data provisioned onto a device by the local domain.</description>
              <headerStructName>SICR_AROT_WIFICORE_DATAPROTECTION</headerStructName>
              <access>read-write</access>
              <addressOffset>0x02C0</addressOffset>
              <cluster>
                <name>UICR</name>
                <description>Authentication tag used for validation of the content of the UICRs. The UICRs content provides information about a domain peripherals associations and memory layout configuration.
        It is stored in an unencrypted form in a dedicated memory location.
        A validation shall be performed using an AEAD scheme realized by AES-256 GCM mode,
        with the domain KEK used as a secret key and UICR content used as additional authenticated data (AAD).
        The initialization vector is provided in NONCE register.</description>
                <headerStructName>SICR_AROT_WIFICORE_DATAPROTECTION_UICR</headerStructName>
                <access>read-write</access>
                <addressOffset>0x0000</addressOffset>
                <register>
                  <name>NONCE</name>
                  <description>The initialization vector of the encryption algorithm used to protect the domain UICRs content.</description>
                  <addressOffset>0x0000</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>VALUE</name>
                      <description>Value of nonce used by AEAD.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                    </field>
                  </fields>
                </register>
                <register>
                  <dim>0x4</dim>
                  <dimIncrement>0x4</dimIncrement>
                  <name>MAC[%s]</name>
                  <description>Description collection: The authentication tag of the domain UICRs.</description>
                  <addressOffset>0x0004</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>VALUE</name>
                      <description>The word [n] of the authentication tag.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                    </field>
                  </fields>
                </register>
                <register>
                  <dim>0x3</dim>
                  <dimIncrement>0x4</dimIncrement>
                  <name>RFU[%s]</name>
                  <description>Description collection:</description>
                  <addressOffset>0x0014</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>VALUE</name>
                      <description>RFU word [n].</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                    </field>
                  </fields>
                </register>
              </cluster>
            </cluster>
            <cluster>
              <name>DOMAINSTATE</name>
              <description>Registers holding the information regarding the local domain state.</description>
              <headerStructName>SICR_AROT_WIFICORE_DOMAINSTATE</headerStructName>
              <access>read-write</access>
              <addressOffset>0x02E0</addressOffset>
              <register>
                <dim>0x3</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>RFU[%s]</name>
                <description>Description collection:</description>
                <addressOffset>0x0000</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>VALUE</name>
                    <description>RFU word [n].</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                  </field>
                </fields>
              </register>
              <register>
                <name>LCS</name>
                <description>The local domain lifecycle state as determined by the URoT.</description>
                <addressOffset>0x000C</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>STATE</name>
                    <description>The local domain lifecycle state.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>AssemblyAndTest</name>
                        <description>The local domain assets are installed in this state. This includes the optional local domain ARoT (its secure program).</description>
                        <value>0x3590FCC5</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>ARoTProvisioning</name>
                        <description>The optional local domain ARoT is provisioned in this state.</description>
                        <value>0xF6852179</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>Secured</name>
                        <description>The local domain assets are provisioned and secured.</description>
                        <value>0x9F6B5F01</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
            </cluster>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>RICR_S</name>
      <description>ROM Information Configuration Registers</description>
      <baseAddress>0x0FFFC000</baseAddress>
      <headerStructName>RICR</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=S-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>RICR</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <name>LCS</name>
          <description>Unspecified</description>
          <headerStructName>RICR_LCS</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0000</addressOffset>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>SIGNATURE[%s]</name>
            <description>Description collection: Signature to determine the re-entrant device life-cycle state (LCS).</description>
            <addressOffset>0x0000</addressOffset>
            <access>read-write</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VALUE</name>
                <description>Uninitialized when freshly out of factory, esle PUF-derived LCS signature.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNINITIALIZED</name>
                    <description>Value of LCS registers when the device is freshly manufactured
           (LCS state FFF), and  the MRAM and the info pages including RICR
           are uninitialized.</description>
                    <value>0xFFFFFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>UROT</name>
          <description>Unspecified</description>
          <headerStructName>RICR_UROT</headerStructName>
          <access>read-write</access>
          <addressOffset>0x0010</addressOffset>
          <cluster>
            <name>SMWD</name>
            <description>Signed Manifest verified by the secure domain ROM Code to establish the
        primary RoT with digest.</description>
            <headerStructName>RICR_UROT_SMWD</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0000</addressOffset>
            <cluster>
              <name>SM</name>
              <description>Signed Manifest verified by the Secure Domain ROM Code to establish the primary RoT.</description>
              <headerStructName>RICR_UROT_SMWD_SM</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0000</addressOffset>
              <cluster>
                <name>TBS</name>
                <description>Manifest describing the secure domain firmware.
          The secure domain ROM code verifies the signature on the digest of this register.</description>
                <headerStructName>RICR_UROT_SMWD_SM_TBS</headerStructName>
                <access>read-write</access>
                <addressOffset>0x0000</addressOffset>
                <cluster>
                  <name>PUBKEY</name>
                  <description>Raw public key used to verify the signed manifest.</description>
                  <headerStructName>RICR_UROT_SMWD_SM_TBS_PUBKEY</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0000</addressOffset>
                  <register>
                    <name>SIZE</name>
                    <description>The size of the raw public key(in bytes).</description>
                    <addressOffset>0x0000</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>SIZE</name>
                        <description>Key size</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The key is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>SizeEd25519</name>
                            <description>The size of the raw Ed25519 public key.
                  Currently this is the only size supported by the secure domain ROM code.</description>
                            <value>0x00000020</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>ADDR</name>
                    <description>Address of the raw public key.</description>
                    <addressOffset>0x0004</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ADDR</name>
                        <description>Public key address.</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The key is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
                <cluster>
                  <name>LAYOUT</name>
                  <description>The MRAM layout of UROT firmware and the recovery image.</description>
                  <headerStructName>RICR_UROT_SMWD_SM_TBS_LAYOUT</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0008</addressOffset>
                  <cluster>
                    <name>USLOT</name>
                    <description>Start adddress and max size of UROT slot (USLOT), Shall remain the same for firmware
               updates once programmed or unless transitioned back to LCS Empty.</description>
                    <headerStructName>RICR_UROT_SMWD_SM_TBS_LAYOUT_USLOT</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0000</addressOffset>
                    <register>
                      <name>START</name>
                      <description>Start address of the UROT firmware. Shall not overlap with the recovery slot (RSLOT).</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Undefined</name>
                              <description>The slot is not defined.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>MAX</name>
                      <description>Maximum size of the UROT firmware in bytes.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Undefined</name>
                              <description>The slot is not defined.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <cluster>
                    <name>RSLOT</name>
                    <description>Start adddress and max size of recovery slot (RSLOT), Shall remain the same for
                firmware updates once programmed or unless transitioned back to LCS Empty.</description>
                    <headerStructName>RICR_UROT_SMWD_SM_TBS_LAYOUT_RSLOT</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0008</addressOffset>
                    <register>
                      <name>START</name>
                      <description>Start address of the recovery firmware. Shall not overlap with the UROT slot(USLOT).</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Undefined</name>
                              <description>The slot is not defined.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>MAX</name>
                      <description>Maximum size of the recovery image in bytes.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Undefined</name>
                              <description>The slot is not defined.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                </cluster>
                <cluster>
                  <name>FW</name>
                  <description>FW verified by the secure domain ROM code.</description>
                  <headerStructName>RICR_UROT_SMWD_SM_TBS_FW</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0018</addressOffset>
                  <register>
                    <name>SIZE</name>
                    <description>The firmware size (in bytes). Shall not exceed the max defined
              limits for USLOT in case of UROT firmware.Shall not exceed the max
              defined limits for USLOT in case of UROT firmware.</description>
                    <addressOffset>0x0000</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>SIZE</name>
                        <description>Firmware size</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The FW is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>ADDR</name>
                    <description>Address of the firmware verified by the secure domain
              ROM code.</description>
                    <addressOffset>0x0004</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ADDR</name>
                        <description>Firmware address</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The FW is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <dim>0x10</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>DIGEST[%s]</name>
                    <description>Description collection: SHA2-512 digest of the firmware.</description>
                    <addressOffset>0x0008</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>SHA2-512 Digest value</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The FW digest, and hence the FW is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <dim>0x4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>VERSION[%s]</name>
                    <description>Description collection: 128-bit revision of the firmware; can be left Unprogrammed.</description>
                    <addressOffset>0x0048</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>nth word of the version.</description>
                        <lsb>0</lsb>
                        <msb>0</msb>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>TIMESTAMP</name>
                    <description>Unsigned 32-bit integer timestamp of the firmware in Unix time used to prevent
               downgrade of firmware on firmware update.</description>
                    <addressOffset>0x0058</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>Unsigned unix-time timestamp of the firmware</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The FW timestamp is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>PARTNO</name>
                    <description>Part-number for which the firmware is built. Must match
               the part number in OICR region.</description>
                    <addressOffset>0x005C</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>Part number of the device for which the firmware is built.</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The part number is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
                <cluster>
                  <name>POLICY</name>
                  <description>Set various policies on related to the firmware verification and
            update.</description>
                  <headerStructName>RICR_UROT_SMWD_SM_TBS_POLICY</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0078</addressOffset>
                  <register>
                    <name>UPDATE</name>
                    <description>Enable or Disable firmware update.</description>
                    <addressOffset>0x0000</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ENABLE</name>
                        <description>Possible values for this register.</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The policy is not programmed, hence any existing policy
                  on update is left unchanged.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Enabled</name>
                            <description>Enable firmware update.</description>
                            <value>0xC3965A5A</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Disabled</name>
                            <description>Disable firmware update.</description>
                            <value>0x47D13CA5</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>REVOKE</name>
                    <description>Configure key revocation policy.</description>
                    <addressOffset>0x0004</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ENABLE</name>
                        <description>Possible values for this register</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The policy is not programmed, hence any existing policy
                   on auto-revocation is left unchanged.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Enabled</name>
                            <description>Enable auto-revocation of keys.</description>
                            <value>0xC3965A5A</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Disabled</name>
                            <description>Disable auto-revocation of keys used to verify firmware.</description>
                            <value>0x47D13CA5</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>DGPREV</name>
                    <description>Configure the downgrade prevention policy.</description>
                    <addressOffset>0x0008</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ENABLE</name>
                        <description>Possible values for this register</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The policy is not programmed, hence any existing policy
                  on downgrade prevention is unaltered.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Enabled</name>
                            <description>Enable downgrade protection on firmware update.
                  If Enabled, the SM.TBS.FW.TIMESTAMP register cannot be left
                  Unprogrammed.</description>
                            <value>0xC3965A5A</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>Disabled</name>
                            <description>Disable downgrade protection on firmware updates.
                  If Disabled, the SM.TBS.FW.TIMESTAMP register shall be left
                  Unprogrammed.</description>
                            <value>0x47D13CA5</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <dim>0x5</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>RFU[%s]</name>
                    <description>Description collection: These registers are included when generating signature of the TBS content of SM.</description>
                    <addressOffset>0x000C</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>RFU</name>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The register is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
                <register>
                  <dim>0x10</dim>
                  <dimIncrement>0x4</dimIncrement>
                  <name>CIPHERDIGEST[%s]</name>
                  <description>Description collection: SHA2-512 digest of the AES-GCM AAD, IV and encrypted firmware.</description>
                  <addressOffset>0x0098</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>VALUE</name>
                      <description>SHA2-512 Digest value</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>Encrypted firmware digest, unprogrammed if the FW is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <dim>0x4</dim>
                  <dimIncrement>0x4</dimIncrement>
                  <name>RFU[%s]</name>
                  <description>Description collection: These registers are included when generating signature of the TBS content of SM</description>
                  <addressOffset>0x00D8</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>RFU</name>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The register is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>SIGNATURE</name>
                <description>Signature on the manifest defined in TBS</description>
                <headerStructName>RICR_UROT_SMWD_SM_SIGNATURE</headerStructName>
                <access>read-write</access>
                <addressOffset>0x00F4</addressOffset>
                <register>
                  <name>ALG</name>
                  <description>The signature algorithm identifier as defined in RFC8152.</description>
                  <addressOffset>0x0000</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>ID</name>
                      <description>Algorithm identifier</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature algorithm identifier is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>AlgIdEd25519</name>
                          <description>ARM ADAC-defined identifier for Ed25519.
                   The use of ARM ADAC-defined identifier ensures consistent
                   user interface on CTRL-AP and SICR.
                   Only Ed25519 curve is supported.</description>
                          <value>0x00000005</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SIZE</name>
                  <description>Size of the raw signature in bytes.</description>
                  <addressOffset>0x0004</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>SIZE</name>
                      <description>Signature size</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SizeEd25519</name>
                          <description>Size of Ed25519 signature bytestring.</description>
                          <value>0x00000040</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>MaxSize</name>
                          <description>Currently, the secure domain ROM code supports only Ed25519 (and only Ed25519 curve) signature scheme,
                   and hence the MaxSize is the same as the Ed25519 signature
                   size.</description>
                          <value>0x00000040</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ADDR</name>
                  <description>Address of the signature on the firmware manifest.</description>
                  <addressOffset>0x0008</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>ADDR</name>
                      <description>Signature address.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
              </cluster>
            </cluster>
            <register>
              <dim>0x10</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>DIGEST[%s]</name>
              <description>Description collection: SHA-512 Digest of the signed manifest used for intregrity check of the
          signed-manifest. Utilized in scenarios involving warm-boot and
          firmware update.</description>
              <addressOffset>0x0100</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
            </register>
          </cluster>
          <cluster>
            <name>OWNER</name>
            <description>Unspecified</description>
            <headerStructName>RICR_UROT_OWNER</headerStructName>
            <access>read-write</access>
            <addressOffset>0x01F8</addressOffset>
            <register>
              <name>UROT</name>
              <description>Indicates the owner of UROT firmware.</description>
              <addressOffset>0x0000</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
              <fields>
                <field>
                  <name>OWNER</name>
                  <description>Indicates whether UROT owner is uninitialized, Nordic or User.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Uninitialized</name>
                      <description>Owner is not initialized yet.</description>
                      <value>0xFFFFFFFF</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Nordic</name>
                      <description>Owner is Nordic.</description>
                      <value>0xFD3D8E75</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>User</name>
                      <description>Owner is customer(User).</description>
                      <value>0x67CA0593</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>RECOVERY</name>
              <description>Indicates the owner of Recovery firmware.</description>
              <addressOffset>0x0004</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
              <fields>
                <field>
                  <name>OWNER</name>
                  <description>Indicates whether Recovery owner is uninitialized, Nordic or User.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Uninitialized</name>
                      <description>Owner is not initialized yet.</description>
                      <value>0xFFFFFFFF</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Nordic</name>
                      <description>Owner is Nordic.</description>
                      <value>0xFD3D8E75</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>User</name>
                      <description>Owner is customer(User).</description>
                      <value>0x67CA0593</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>RECOVERY</name>
            <description>Unspecified</description>
            <headerStructName>RICR_UROT_RECOVERY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0200</addressOffset>
            <cluster>
              <name>SMWD</name>
              <description>Signed Manifest verified by the secure domain ROM Code to establish the
        primary RoT with digest.</description>
              <headerStructName>RICR_UROT_RECOVERY_SMWD</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0000</addressOffset>
              <cluster>
                <name>SM</name>
                <description>Signed Manifest verified by the Secure Domain ROM Code to establish the primary RoT.</description>
                <headerStructName>RICR_UROT_RECOVERY_SMWD_SM</headerStructName>
                <access>read-write</access>
                <addressOffset>0x0000</addressOffset>
                <cluster>
                  <name>TBS</name>
                  <description>Manifest describing the secure domain firmware.
          The secure domain ROM code verifies the signature on the digest of this register.</description>
                  <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0000</addressOffset>
                  <cluster>
                    <name>PUBKEY</name>
                    <description>Raw public key used to verify the signed manifest.</description>
                    <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_PUBKEY</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0000</addressOffset>
                    <register>
                      <name>SIZE</name>
                      <description>The size of the raw public key(in bytes).</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <description>Key size</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The key is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>SizeEd25519</name>
                              <description>The size of the raw Ed25519 public key.
                  Currently this is the only size supported by the secure domain ROM code.</description>
                              <value>0x00000020</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>ADDR</name>
                      <description>Address of the raw public key.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <description>Public key address.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The key is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <cluster>
                    <name>LAYOUT</name>
                    <description>The MRAM layout of UROT firmware and the recovery image.</description>
                    <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_LAYOUT</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0008</addressOffset>
                    <cluster>
                      <name>USLOT</name>
                      <description>Start adddress and max size of UROT slot (USLOT), Shall remain the same for firmware
               updates once programmed or unless transitioned back to LCS Empty.</description>
                      <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_LAYOUT_USLOT</headerStructName>
                      <access>read-write</access>
                      <addressOffset>0x0000</addressOffset>
                      <register>
                        <name>START</name>
                        <description>Start address of the UROT firmware. Shall not overlap with the recovery slot (RSLOT).</description>
                        <addressOffset>0x0000</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>ADDR</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                      <register>
                        <name>MAX</name>
                        <description>Maximum size of the UROT firmware in bytes.</description>
                        <addressOffset>0x0004</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>SIZE</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                    </cluster>
                    <cluster>
                      <name>RSLOT</name>
                      <description>Start adddress and max size of recovery slot (RSLOT), Shall remain the same for
                firmware updates once programmed or unless transitioned back to LCS Empty.</description>
                      <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_LAYOUT_RSLOT</headerStructName>
                      <access>read-write</access>
                      <addressOffset>0x0008</addressOffset>
                      <register>
                        <name>START</name>
                        <description>Start address of the recovery firmware. Shall not overlap with the UROT slot(USLOT).</description>
                        <addressOffset>0x0000</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>ADDR</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                      <register>
                        <name>MAX</name>
                        <description>Maximum size of the recovery image in bytes.</description>
                        <addressOffset>0x0004</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>SIZE</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                    </cluster>
                  </cluster>
                  <cluster>
                    <name>FW</name>
                    <description>FW verified by the secure domain ROM code.</description>
                    <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_FW</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0018</addressOffset>
                    <register>
                      <name>SIZE</name>
                      <description>The firmware size (in bytes). Shall not exceed the max defined
              limits for USLOT in case of UROT firmware.Shall not exceed the max
              defined limits for USLOT in case of UROT firmware.</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <description>Firmware size</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>ADDR</name>
                      <description>Address of the firmware verified by the secure domain
              ROM code.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <description>Firmware address</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x10</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>DIGEST[%s]</name>
                      <description>Description collection: SHA2-512 digest of the firmware.</description>
                      <addressOffset>0x0008</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>SHA2-512 Digest value</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW digest, and hence the FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x4</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>VERSION[%s]</name>
                      <description>Description collection: 128-bit revision of the firmware; can be left Unprogrammed.</description>
                      <addressOffset>0x0048</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>nth word of the version.</description>
                          <lsb>0</lsb>
                          <msb>0</msb>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>TIMESTAMP</name>
                      <description>Unsigned 32-bit integer timestamp of the firmware in Unix time used to prevent
               downgrade of firmware on firmware update.</description>
                      <addressOffset>0x0058</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>Unsigned unix-time timestamp of the firmware</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW timestamp is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>PARTNO</name>
                      <description>Part-number for which the firmware is built. Must match
               the part number in OICR region.</description>
                      <addressOffset>0x005C</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>Part number of the device for which the firmware is built.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The part number is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <cluster>
                    <name>POLICY</name>
                    <description>Set various policies on related to the firmware verification and
            update.</description>
                    <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_TBS_POLICY</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0078</addressOffset>
                    <register>
                      <name>UPDATE</name>
                      <description>Enable or Disable firmware update.</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                  on update is left unchanged.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable firmware update.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable firmware update.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>REVOKE</name>
                      <description>Configure key revocation policy.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                   on auto-revocation is left unchanged.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable auto-revocation of keys.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable auto-revocation of keys used to verify firmware.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>DGPREV</name>
                      <description>Configure the downgrade prevention policy.</description>
                      <addressOffset>0x0008</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                  on downgrade prevention is unaltered.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable downgrade protection on firmware update.
                  If Enabled, the SM.TBS.FW.TIMESTAMP register cannot be left
                  Unprogrammed.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable downgrade protection on firmware updates.
                  If Disabled, the SM.TBS.FW.TIMESTAMP register shall be left
                  Unprogrammed.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x5</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>RFU[%s]</name>
                      <description>Description collection: These registers are included when generating signature of the TBS content of SM.</description>
                      <addressOffset>0x000C</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>RFU</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The register is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <register>
                    <dim>0x10</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>CIPHERDIGEST[%s]</name>
                    <description>Description collection: SHA2-512 digest of the AES-GCM AAD, IV and encrypted firmware.</description>
                    <addressOffset>0x0098</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>SHA2-512 Digest value</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>Encrypted firmware digest, unprogrammed if the FW is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <dim>0x4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>RFU[%s]</name>
                    <description>Description collection: These registers are included when generating signature of the TBS content of SM</description>
                    <addressOffset>0x00D8</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>RFU</name>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The register is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
                <cluster>
                  <name>SIGNATURE</name>
                  <description>Signature on the manifest defined in TBS</description>
                  <headerStructName>RICR_UROT_RECOVERY_SMWD_SM_SIGNATURE</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x00F4</addressOffset>
                  <register>
                    <name>ALG</name>
                    <description>The signature algorithm identifier as defined in RFC8152.</description>
                    <addressOffset>0x0000</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ID</name>
                        <description>Algorithm identifier</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature algorithm identifier is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>AlgIdEd25519</name>
                            <description>ARM ADAC-defined identifier for Ed25519.
                   The use of ARM ADAC-defined identifier ensures consistent
                   user interface on CTRL-AP and SICR.
                   Only Ed25519 curve is supported.</description>
                            <value>0x00000005</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>SIZE</name>
                    <description>Size of the raw signature in bytes.</description>
                    <addressOffset>0x0004</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>SIZE</name>
                        <description>Signature size</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>SizeEd25519</name>
                            <description>Size of Ed25519 signature bytestring.</description>
                            <value>0x00000040</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>MaxSize</name>
                            <description>Currently, the secure domain ROM code supports only Ed25519 (and only Ed25519 curve) signature scheme,
                   and hence the MaxSize is the same as the Ed25519 signature
                   size.</description>
                            <value>0x00000040</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>ADDR</name>
                    <description>Address of the signature on the firmware manifest.</description>
                    <addressOffset>0x0008</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ADDR</name>
                        <description>Signature address.</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
              </cluster>
              <register>
                <dim>0x10</dim>
                <dimIncrement>0x4</dimIncrement>
                <name>DIGEST[%s]</name>
                <description>Description collection: SHA-512 Digest of the signed manifest used for intregrity check of the
          signed-manifest. Utilized in scenarios involving warm-boot and
          firmware update.</description>
                <addressOffset>0x0100</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
              </register>
            </cluster>
          </cluster>
          <cluster>
            <name>UPWD</name>
            <description>Update with digest. Digest is used to ensure SICR contents where not
        tampered when resuming any paused processing of the update.</description>
            <headerStructName>RICR_UROT_UPWD</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0340</addressOffset>
            <cluster>
              <name>UPDATE</name>
              <description>Description of FW Updates, if any.
        In case, SICR.UROT.TBS.POLICY.UPDATE is set to Disabled,
        these registers are ignored by the secure domain ROM code.</description>
              <headerStructName>RICR_UROT_UPWD_UPDATE</headerStructName>
              <access>read-write</access>
              <addressOffset>0x0000</addressOffset>
              <register>
                <name>OPERATION</name>
                <description>Command from the secure domain firmware to the secure domain ROM code.</description>
                <addressOffset>0x0000</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>OPCODE</name>
                    <description>Opcode to identify the command.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>Nop</name>
                        <description>No operation pending.</description>
                        <value>0xFFFFFFFF</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UROTVerify</name>
                        <description>Command to only verify UROT (plain-text or encrypted) firmware
                update without applying it.</description>
                        <value>0x80000001</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UROTActivate</name>
                        <description>Command to verify and update encrypted UROT firmware.</description>
                        <value>0x80000002</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RecoveryVerify</name>
                        <description>Command to verify the recovery (plain-text only) firmware update
                without applying it.</description>
                        <value>0x80000003</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RecoveryActivate</name>
                        <description>Command to verify and update plain-text Recovery firmware.</description>
                        <value>0x80000004</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UROTPlainTextActivate</name>
                        <description>Command to verify and update plain-text UROT firmware.</description>
                        <value>0x80000005</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>AROTRecovery</name>
                        <description>Instructs the ROM code to boot the recovery image in safe mode
                to download a AROT image instead of a UROT image.</description>
                        <value>0xA0000001</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATUS</name>
                <description>ROM code indicates the status of update to the secure
            domain firmware via this register.</description>
                <addressOffset>0x0004</addressOffset>
                <access>read-write</access>
                <size>0x20</size>
                <fields>
                  <field>
                    <name>CODE</name>
                    <description>Status code.</description>
                    <lsb>0</lsb>
                    <msb>31</msb>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>None</name>
                        <description>No operation pending to indicate any status.</description>
                        <value>0xFFFFFFFF</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UnknownOperation</name>
                        <description>Unknown OPCODE in SICR.UROT.UPDATE.OPERATION.</description>
                        <value>0xF0000001</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>InvalidManifest</name>
                        <description>The information in the manifest is invalid.</description>
                        <value>0xF0000002</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>StaleFW</name>
                        <description>The timestamp on the firmware is older than the current one.</description>
                        <value>0xF0000003</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>VerifyFailure</name>
                        <description>The signature did not verify.</description>
                        <value>0xF0000005</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>VerifyOK</name>
                        <description>Signature verification is successful.</description>
                        <value>0xF0000006</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UROTUpdateDisabled</name>
                        <description>UROT firmware update is disabled via policy.</description>
                        <value>0xF0000007</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UROTActivated</name>
                        <description>UROT firmware update verification and installation succeeded.</description>
                        <value>0xF0000008</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RecoveryActivated</name>
                        <description>Recovery firmware update verification and installation succeeded.</description>
                        <value>0xF0000009</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RecoveryUpdateDisabled</name>
                        <description>Recovery update is disabled via policy.</description>
                        <value>0xF000000A</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>AROTRecovery</name>
                        <description>Recovery image is booted so that the recovery image can download a
                AROT image that ROM does not verify.</description>
                        <value>0xF1000000</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
              <cluster>
                <name>DOWNLOAD</name>
                <description>Information about downloaded firmware update. The addresses described here
            are the location of the update and not the location they must be installed.
            The installation information is described in the signed manifest.</description>
                <headerStructName>RICR_UROT_UPWD_UPDATE_DOWNLOAD</headerStructName>
                <access>read-write</access>
                <addressOffset>0x0008</addressOffset>
                <register>
                  <name>FW</name>
                  <description>Location for the firmware update to be installed.</description>
                  <addressOffset>0x0000</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>ADDR</name>
                      <description>The MRAM Location of the firmware to be installed. This is not
                the  same as the address in the signed manifest. The signed
                manifest contains the target location where the firmware must
                be installed, not the current location where it is downloaded.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PUBKEY</name>
                  <description>Location of the public key to verify the signature on the firmware update.</description>
                  <addressOffset>0x0004</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>ADDR</name>
                      <description>MRAM Location for the signature on the firmware update.
                This is not the same as the address in the signed manifest. The
                signed manifest contains the target location where the public
                key must be kept once the update is installed, not the current
                location where it is downloaded.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SIGNATURE</name>
                  <description>Location for the signature on the firmware update to be verified
               before the update is installed.</description>
                  <addressOffset>0x0008</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>ADDR</name>
                      <description>MRAM Location for the signature on the firmware update.
                This is not the same as the address in the signed manifest.
                The signed manifest contains the target location where the
                signature must be kept once the update is installed, not the
                current location where it is downloaded.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>MAX</name>
                  <description>Max Size of the download.</description>
                  <addressOffset>0x000C</addressOffset>
                  <access>read-write</access>
                  <size>0x20</size>
                  <fields>
                    <field>
                      <name>SIZE</name>
                      <description>Max size of the downloaded firmware update. This define is
                ignored during update of UROT or the recovery image since the
                signed manifest contains the needed sizes. This field is used to
                define the writable MRAM region when the recovery image is
                started in  the safe mode.</description>
                      <lsb>0</lsb>
                      <msb>31</msb>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>Unprogrammed</name>
                          <description>The signature is not programmed.</description>
                          <value>0xFFFFFFFF</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>SM</name>
                <description>Signed Manifest verified by the Secure Domain ROM Code to establish the primary RoT.</description>
                <headerStructName>RICR_UROT_UPWD_UPDATE_SM</headerStructName>
                <access>read-write</access>
                <addressOffset>0x0020</addressOffset>
                <cluster>
                  <name>TBS</name>
                  <description>Manifest describing the secure domain firmware.
          The secure domain ROM code verifies the signature on the digest of this register.</description>
                  <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x0000</addressOffset>
                  <cluster>
                    <name>PUBKEY</name>
                    <description>Raw public key used to verify the signed manifest.</description>
                    <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_PUBKEY</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0000</addressOffset>
                    <register>
                      <name>SIZE</name>
                      <description>The size of the raw public key(in bytes).</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <description>Key size</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The key is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>SizeEd25519</name>
                              <description>The size of the raw Ed25519 public key.
                  Currently this is the only size supported by the secure domain ROM code.</description>
                              <value>0x00000020</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>ADDR</name>
                      <description>Address of the raw public key.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <description>Public key address.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The key is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <cluster>
                    <name>LAYOUT</name>
                    <description>The MRAM layout of UROT firmware and the recovery image.</description>
                    <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_LAYOUT</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0008</addressOffset>
                    <cluster>
                      <name>USLOT</name>
                      <description>Start adddress and max size of UROT slot (USLOT), Shall remain the same for firmware
               updates once programmed or unless transitioned back to LCS Empty.</description>
                      <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_LAYOUT_USLOT</headerStructName>
                      <access>read-write</access>
                      <addressOffset>0x0000</addressOffset>
                      <register>
                        <name>START</name>
                        <description>Start address of the UROT firmware. Shall not overlap with the recovery slot (RSLOT).</description>
                        <addressOffset>0x0000</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>ADDR</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                      <register>
                        <name>MAX</name>
                        <description>Maximum size of the UROT firmware in bytes.</description>
                        <addressOffset>0x0004</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>SIZE</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                    </cluster>
                    <cluster>
                      <name>RSLOT</name>
                      <description>Start adddress and max size of recovery slot (RSLOT), Shall remain the same for
                firmware updates once programmed or unless transitioned back to LCS Empty.</description>
                      <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_LAYOUT_RSLOT</headerStructName>
                      <access>read-write</access>
                      <addressOffset>0x0008</addressOffset>
                      <register>
                        <name>START</name>
                        <description>Start address of the recovery firmware. Shall not overlap with the UROT slot(USLOT).</description>
                        <addressOffset>0x0000</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>ADDR</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                      <register>
                        <name>MAX</name>
                        <description>Maximum size of the recovery image in bytes.</description>
                        <addressOffset>0x0004</addressOffset>
                        <access>read-write</access>
                        <size>0x20</size>
                        <fields>
                          <field>
                            <name>SIZE</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <enumeratedValues>
                              <enumeratedValue>
                                <name>Undefined</name>
                                <description>The slot is not defined.</description>
                                <value>0xFFFFFFFF</value>
                              </enumeratedValue>
                            </enumeratedValues>
                          </field>
                        </fields>
                      </register>
                    </cluster>
                  </cluster>
                  <cluster>
                    <name>FW</name>
                    <description>FW verified by the secure domain ROM code.</description>
                    <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_FW</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0018</addressOffset>
                    <register>
                      <name>SIZE</name>
                      <description>The firmware size (in bytes). Shall not exceed the max defined
              limits for USLOT in case of UROT firmware.Shall not exceed the max
              defined limits for USLOT in case of UROT firmware.</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>SIZE</name>
                          <description>Firmware size</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>ADDR</name>
                      <description>Address of the firmware verified by the secure domain
              ROM code.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ADDR</name>
                          <description>Firmware address</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x10</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>DIGEST[%s]</name>
                      <description>Description collection: SHA2-512 digest of the firmware.</description>
                      <addressOffset>0x0008</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>SHA2-512 Digest value</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW digest, and hence the FW is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x4</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>VERSION[%s]</name>
                      <description>Description collection: 128-bit revision of the firmware; can be left Unprogrammed.</description>
                      <addressOffset>0x0048</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>nth word of the version.</description>
                          <lsb>0</lsb>
                          <msb>0</msb>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>TIMESTAMP</name>
                      <description>Unsigned 32-bit integer timestamp of the firmware in Unix time used to prevent
               downgrade of firmware on firmware update.</description>
                      <addressOffset>0x0058</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>Unsigned unix-time timestamp of the firmware</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The FW timestamp is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>PARTNO</name>
                      <description>Part-number for which the firmware is built. Must match
               the part number in OICR region.</description>
                      <addressOffset>0x005C</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>VALUE</name>
                          <description>Part number of the device for which the firmware is built.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The part number is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <cluster>
                    <name>POLICY</name>
                    <description>Set various policies on related to the firmware verification and
            update.</description>
                    <headerStructName>RICR_UROT_UPWD_UPDATE_SM_TBS_POLICY</headerStructName>
                    <access>read-write</access>
                    <addressOffset>0x0078</addressOffset>
                    <register>
                      <name>UPDATE</name>
                      <description>Enable or Disable firmware update.</description>
                      <addressOffset>0x0000</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register.</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                  on update is left unchanged.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable firmware update.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable firmware update.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>REVOKE</name>
                      <description>Configure key revocation policy.</description>
                      <addressOffset>0x0004</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                   on auto-revocation is left unchanged.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable auto-revocation of keys.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable auto-revocation of keys used to verify firmware.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <name>DGPREV</name>
                      <description>Configure the downgrade prevention policy.</description>
                      <addressOffset>0x0008</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>ENABLE</name>
                          <description>Possible values for this register</description>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The policy is not programmed, hence any existing policy
                  on downgrade prevention is unaltered.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Enabled</name>
                              <description>Enable downgrade protection on firmware update.
                  If Enabled, the SM.TBS.FW.TIMESTAMP register cannot be left
                  Unprogrammed.</description>
                              <value>0xC3965A5A</value>
                            </enumeratedValue>
                            <enumeratedValue>
                              <name>Disabled</name>
                              <description>Disable downgrade protection on firmware updates.
                  If Disabled, the SM.TBS.FW.TIMESTAMP register shall be left
                  Unprogrammed.</description>
                              <value>0x47D13CA5</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                    <register>
                      <dim>0x5</dim>
                      <dimIncrement>0x4</dimIncrement>
                      <name>RFU[%s]</name>
                      <description>Description collection: These registers are included when generating signature of the TBS content of SM.</description>
                      <addressOffset>0x000C</addressOffset>
                      <access>read-write</access>
                      <size>0x20</size>
                      <fields>
                        <field>
                          <name>RFU</name>
                          <lsb>0</lsb>
                          <msb>31</msb>
                          <enumeratedValues>
                            <enumeratedValue>
                              <name>Unprogrammed</name>
                              <description>The register is not programmed.</description>
                              <value>0xFFFFFFFF</value>
                            </enumeratedValue>
                          </enumeratedValues>
                        </field>
                      </fields>
                    </register>
                  </cluster>
                  <register>
                    <dim>0x10</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>CIPHERDIGEST[%s]</name>
                    <description>Description collection: SHA2-512 digest of the AES-GCM AAD, IV and encrypted firmware.</description>
                    <addressOffset>0x0098</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>VALUE</name>
                        <description>SHA2-512 Digest value</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>Encrypted firmware digest, unprogrammed if the FW is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <dim>0x4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <name>RFU[%s]</name>
                    <description>Description collection: These registers are included when generating signature of the TBS content of SM</description>
                    <addressOffset>0x00D8</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>RFU</name>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The register is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
                <cluster>
                  <name>SIGNATURE</name>
                  <description>Signature on the manifest defined in TBS</description>
                  <headerStructName>RICR_UROT_UPWD_UPDATE_SM_SIGNATURE</headerStructName>
                  <access>read-write</access>
                  <addressOffset>0x00F4</addressOffset>
                  <register>
                    <name>ALG</name>
                    <description>The signature algorithm identifier as defined in RFC8152.</description>
                    <addressOffset>0x0000</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ID</name>
                        <description>Algorithm identifier</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature algorithm identifier is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>AlgIdEd25519</name>
                            <description>ARM ADAC-defined identifier for Ed25519.
                   The use of ARM ADAC-defined identifier ensures consistent
                   user interface on CTRL-AP and SICR.
                   Only Ed25519 curve is supported.</description>
                            <value>0x00000005</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>SIZE</name>
                    <description>Size of the raw signature in bytes.</description>
                    <addressOffset>0x0004</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>SIZE</name>
                        <description>Signature size</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>SizeEd25519</name>
                            <description>Size of Ed25519 signature bytestring.</description>
                            <value>0x00000040</value>
                          </enumeratedValue>
                          <enumeratedValue>
                            <name>MaxSize</name>
                            <description>Currently, the secure domain ROM code supports only Ed25519 (and only Ed25519 curve) signature scheme,
                   and hence the MaxSize is the same as the Ed25519 signature
                   size.</description>
                            <value>0x00000040</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                  <register>
                    <name>ADDR</name>
                    <description>Address of the signature on the firmware manifest.</description>
                    <addressOffset>0x0008</addressOffset>
                    <access>read-write</access>
                    <size>0x20</size>
                    <fields>
                      <field>
                        <name>ADDR</name>
                        <description>Signature address.</description>
                        <lsb>0</lsb>
                        <msb>31</msb>
                        <enumeratedValues>
                          <enumeratedValue>
                            <name>Unprogrammed</name>
                            <description>The signature is not programmed.</description>
                            <value>0xFFFFFFFF</value>
                          </enumeratedValue>
                        </enumeratedValues>
                      </field>
                    </fields>
                  </register>
                </cluster>
              </cluster>
            </cluster>
            <register>
              <dim>0x10</dim>
              <dimIncrement>0x4</dimIncrement>
              <name>DIGEST[%s]</name>
              <description>Description collection: SHA-512 Digest of the signed manifest used for integrity check of the
          signed-manifest.</description>
              <addressOffset>0x0120</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
            </register>
            <register>
              <name>STATE</name>
              <description>Internal state of any update.</description>
              <addressOffset>0x0160</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
            </register>
          </cluster>
          <cluster>
            <name>STATE</name>
            <description>Describes the currently booted firmware (UROT or recovery) and if the
        update of the two firmwares is currently enabled or disabled.</description>
            <headerStructName>RICR_UROT_STATE</headerStructName>
            <access>read-write</access>
            <addressOffset>0x04A4</addressOffset>
            <register>
              <name>CURRENTFW</name>
              <description>Indicate which of the firmware, UROT or recovery, is started.</description>
              <addressOffset>0x0000</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>MRAM location of either UROT or recovery firmware based on which
            firmware is started at cold boot. This address is updated by the ROM
            code and cold boot and used at warm boot to start the right firmware.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Unprogrammed</name>
                      <description>The address is not programmed.</description>
                      <value>0xFFFFFFFF</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>UROTFWUPDATE</name>
              <description>Indicates if UROT firmware update is enabled or disabled.</description>
              <addressOffset>0x0004</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
              <fields>
                <field>
                  <name>STATUS</name>
                  <description>ROM writes this field based on whether a valid recovery firmware
            exists and reads this field to process any request to update the
            UROT firmware.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>The update of UROT is disabled since no valid recovery firmware
                exists.</description>
                      <value>0xFFFFFFFF</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>The update of UROT is enabled since valid recovery firmware
                exists.</description>
                      <value>0x83A91C27</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>RECOVERYFWUPDATE</name>
              <description>Indicates if recovery firmware update is enabled or disabled.</description>
              <addressOffset>0x0008</addressOffset>
              <access>read-write</access>
              <size>0x20</size>
              <fields>
                <field>
                  <name>STATUS</name>
                  <description>ROM writes this field based on whether a valid UROT firmware
            exists and reads this field to process any request to update the
            recovery firmware.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>The update of recovery firmware is disabled since no valid UROT
                firmmware exists.</description>
                      <value>0xFFFFFFFF</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>The update of recovery firmware is enabled since valid UROT
                firmmware exists.</description>
                      <value>0x83A91C27</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>GLOBAL_FICR_NS</name>
      <description>Factory Information Configuration Registers</description>
      <baseAddress>0x0FFFE000</baseAddress>
      <headerStructName>FICR</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0xC00</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>FICR</groupName>
      <size>0x20</size>
      <registers>
        <cluster>
          <name>SOCINFO</name>
          <description>Unspecified</description>
          <headerStructName>FICR_SOCINFO</headerStructName>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <name>PARTNO</name>
            <description>Part number.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-only</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PART</name>
                <description>Part number.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>HWREVISION</name>
            <description>Hardware revision.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-only</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>HWREVISION</name>
                <description>Hardvare revision.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PRODUCTIONREVISION</name>
            <description>Production reversion.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-only</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PRODUCTIONREVISION</name>
                <description>Production reversion.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>BLE</name>
