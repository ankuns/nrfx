                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>INTENFULL</name>
                <description>Interrupt enable for FIFO full.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>SOFTRST</name>
                <description>Software reset:</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Normal mode.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTEST</name>
                    <description>The continuous test, the conditioning function and the FIFO are reset.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INTENPRE</name>
