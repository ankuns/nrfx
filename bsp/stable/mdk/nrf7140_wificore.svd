                  <lsb>0</lsb>
                  <msb>2</msb>
                </field>
                <field>
                  <name>RSVDSPICTRLR137</name>
                  <lsb>3</lsb>
                  <msb>7</msb>
                  <access>read-only</access>
                </field>
                <field>
                  <name>MAXWS</name>
                  <description>Maximum wait cycles allowed per transaction.</description>
                  <lsb>8</lsb>
                  <msb>11</msb>
                </field>
                <field>
                  <name>RSVDSPICTRLR11215</name>
                  <lsb>12</lsb>
                  <msb>15</msb>
                  <access>read-only</access>
