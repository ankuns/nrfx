                  <enumeratedValue>
                    <name>DEFMODE</name>
                    <description>Delay line defaut range setting</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EXTDLMODE</name>
                    <description>DelayLine works with extended delay range setting</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BYPASSEN</name>
                <description>Drives SD/eMMC CLK DelayLine's bypassen input</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DLMODE</name>
                    <description>Delay line active mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYPASSMODE</name>
                    <description>DelayLine is bypass mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INPSELCNFG</name>
                <description>Drives SD/eMMC CLK DelayLine's config input. Value here selects the input source to DelayLine</description>
                <lsb>2</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>UPDATEDC</name>
                <description>Prepares DealyLine for code update when '1'. Its recommended that this bit is 1 when SDCLKDL_DC is being written. Ensure this is '0' when not updating code.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DLMODE</name>
                    <description>DelayLine output is enabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYPASSMODE</name>
                    <description>output of DelayLine is DelayLine output active</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
