            <size>0x20</size>
            <fields>
              <field>
                <name>WLANTXPDEBUGENABLE</name>
                <description>Live state of the enable flow control signals0: TXP WR1: Vector Parser Output2: Header Generator Output3: Preamble Generator Output4: Aggregation Input5: DSSS PLCP Input6: TXP Core Input7: DSSS Input8: DSSS Output9: Scrambler Output10: BCC Encoder Output11: Post-FEC Padding Output12: HE-ER-SU Logic Output13: Repacker Output14: DCM Logic Output15: Stream Parser Output16: ODFM Modulator Input17: Interleaver Input18: Interleaver Output19: Mapper Input20: Mapper Output21: Pilot Insertion Output22: TXP RD</description>
                <lsb>0</lsb>
                <msb>22</msb>
