            </fields>
          </register>
          <register>
            <name>VIDVACTIVELINESACT</name>
            <description>Holds the value that controller is using for VID_VACTIVE_LINES.</description>
            <addressOffset>0x160</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VACTIVELINES</name>
                <description>This field specifies the Vertical Active period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>13</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDPKTSTATUS</name>
            <description>Contains information about the status of FIFOs related to DPI and eDPI interfaces.</description>
            <addressOffset>0x168</addressOffset>
            <access>read-write</access>
            <resetValue>0x00010005</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DPICMDWEMPTY</name>
                <description>This bit indicates the empty status of write command FIFO for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPICMDWFULL</name>
                <description>This bit indicates the full status of write command FIFO for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIPLDWEMPTY</name>
                <description>This bit indicates the empty status of write payload FIFO for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIPLDWFULL</name>
                <description>This bit indicates the full status of write payload FIFO for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIBUFFPLDEMPTY</name>
                <description>This bit indicates the empty status of the payload internal buffer for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIBUFFPLDFULL</name>
                <description>This bit indicates the full status of the payload internal buffer for video Mode. This bit is set to 0 for command Mode.</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>SDF3DACT</name>
            <description>Holds the value that controller is using for SDF_3D.</description>
            <addressOffset>0x190</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MODE3D</name>
                <description>This field specifies 3D Mode On/Off and Display Orientation:</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MODE0</name>
                    <description>3D Mode Off, 2D Mode On</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE1</name>
                    <description>3D Mode On, Portrait Orientation</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE2</name>
                    <description>3D Mode On, Landscape Orientation</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE3</name>
                    <description>Reserved, not used</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FORMAT3D</name>
                <description>This field specifies 3D Image Format:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LINE</name>
                    <description>Alternating lines of left and right data</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FRAME</name>
                    <description>Alternating frames of left and right data</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXEL</name>
                    <description>Alternating pixels of left and right data</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SECONDVSYNC</name>
                <description>This field specifies whether there is a second VSYNC pulse between Left and Right Images, when 3D Image Format is Frame-based:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NOSYNCPULSE</name>
                    <description>No sync pulses between left and right data.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SYNCPULSE</name>
                    <description>Sync pulse (HSYNC, VSYNC, blanking) between left and right data.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RIGHTFIRST</name>
                <description>This bit specifies the left/right order:</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LEFTFIRST</name>
                    <description>left eye is sent first, then right eye</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RIGHTFIRST</name>
                    <description>right eye data is sent first, then left eye</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SEND3DCFG</name>
                <description>When set, causes the next VSS packet to include 3D control payload in every VSS packet.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>CSI2</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_GSI_CSI2</headerStructName>
          <access>read-write</access>
          <addressOffset>0x2000</addressOffset>
          <register>
            <name>VERSION</name>
            <description>Contains the version of DWC_mipi_csi2_host coded in 32-bit ASCII code.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x30313534</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VERSION</name>
                <description>This field indicates the version of the DWC_mipi_csi2_host.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>NLANES</name>
            <description>Configures the number of active lanes that the DWC_mipi_csi2_host uses to receive the camera device data.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NLANES</name>
                <description>This can only be updated when the PHY lane is in stopstate.Number of active data lanes:</description>
                <lsb>0</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DATALANE1</name>
                    <description>1 Data Lane</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE2</name>
                    <description>2 Data Lanes</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE3</name>
                    <description>3 Data Lanes</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE4</name>
                    <description>4 Data Lanes - Only on D-PHY</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE5</name>
                    <description>5 Data Lanes - Only on D-PHY</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE6</name>
                    <description>6 Data Lanes - Only on D-PHY</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE7</name>
                    <description>7 Data Lanes - Only on D-PHY</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATALANE8</name>
                    <description>8 Data Lanes - Only on D-PHY</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CSI2RESETN</name>
            <description>Controls the DWC_mipi_csi2_host logic reset state. When activated, the internal logic of the controller goes into the reset state. The configuration is not reset to default values with this register, instead, only the internal controller logic is affected.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CSI2RESETN</name>
                <description>DWC_mipi_csi2_host reset output. Active Low.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTSTMAIN</name>
            <description>Contains the status of individual interrupt sources, regardless of the contents of the associated interrupt mask registers, so it is possible to service the interrupt status registers by polling. Reading INT_ST_MAIN register clears the interrupt pin.</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>STATUSINTSTPHYFATAL</name>
