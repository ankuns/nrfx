        <cluster>
          <name>PUF</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_OTPC_PUF</headerStructName>
          <access>read-write</access>
          <addressOffset>0x540</addressOffset>
          <register>
            <name>READ</name>
            <description>Read the PUF word XORed with the PUF pad value.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>Value</name>
                <description>PUF word from the the PUF bits stream XORed with the PUF pad value.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Locked</name>
                    <description>Reads a 0 when the PUF is locked.</description>
                    <value>0x00000000</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>PAD</name>
            <description>The PUF pad value used to XOR with the PUF word read.</description>
            <addressOffset>0x004</addressOffset>
            <access>write-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>Value</name>
                <description>PUF pad value</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>LOCK</name>
            <description>Locks the reads to the PUF.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LOCK</name>
                <description>Enables the lock for PUF.READ.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>Pending</name>
                    <description>Read: The PUF.PAD is not written.
                    The PUF.READ is locked.</description>
                    <value>0x00000000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Read: PUF.READ is not locked.</description>
                    <value>0x00000001</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Read: PUF.READ is locked.</description>
                    <value>0x00000002</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>Enable</name>
                    <description>Write: Enables the lock (Ignores any other value written).</description>
                    <value>0x10CC10CC</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <register>
          <name>WAITSTATES</name>
          <description>Wait states for OTP read.</description>
          <addressOffset>0x550</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000000B</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>WAITSTATENUM</name>
              <description>Register to read the current number of wait states for the OTP read and
        to set a new value.</description>
              <lsb>0</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>KEY</name>
              <description>Key to enable the writing to this register. Writes to this register are ignored if KEY is not set to 0xA66D.</description>
              <lsb>16</lsb>
              <msb>31</msb>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allowed</name>
                  <description>Write is allowed.</description>
                  <value>0xA66D</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>STANDBYTIMEOUT</name>
          <description>Timeout to go into standby mode.</description>
          <addressOffset>0x554</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TIMEOUT</name>
              <description>Timeout in terms of OTPC clock cycles, based on FREQUENCY.</description>
              <lsb>0</lsb>
              <msb>8</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FREQUENCY</name>
          <description>Clock frequency of OTPC.</description>
          <addressOffset>0x558</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000064</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FREQUENCY</name>
              <description>Frequency in MHz.</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <dim>0x6</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>REGION[%s]</name>
          <description>Description collection: Configuration for region [n]</description>
          <addressOffset>0x560</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>READ</name>
              <description>Read configuration to the region [n].</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allowed</name>
                  <description>Reads to the region [n] allowed.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NotAllowed</name>
                  <description>Reads to the region [n] not allowed.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WRITE</name>
              <description>Write configuration to the region [n].</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allowed</name>
                  <description>Writes to the region [n] allowed.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NotAllowed</name>
                  <description>Writes to the region [n] not allowed.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXECUTE</name>
              <description>Code execute configuration to the region [n].</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allowed</name>
                  <description>Code execute from the region [n] allowed.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NotAllowed</name>
                  <description>Code execute from region [n] not allowed.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCK</name>
              <description>Lock writes to this register.</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotLocked</name>
                  <description>Register is not locked.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Locked</name>
                  <description>Register is locked.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>TEST</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_OTPC_TEST</headerStructName>
          <access>read-write</access>
          <addressOffset>0x600</addressOffset>
          <register>
            <name>TESTMODE</name>
            <description>Register for entering test mode. Refer to the OTP test flow documentation for
      more details.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TESTMODE</name>
                <description>Register for entering test mode. This register does not return the same value
        as written.</description>
                <lsb>0</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Read: In normal mode.</description>
                    <value>0x0000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTMODE1</name>
                    <description>Read: In TESTMODE1 mode.</description>
                    <value>0x0001</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTMODE2</name>
                    <description>Read: In TESTMODE2 mode.</description>
                    <value>0x0002</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>SetNORMAL</name>
                    <description>Write: Sets NORMAL mode.</description>
                    <value>0x0000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SetTESTMODE1</name>
                    <description>Write: Sets TESTMODE1. Used for production tests.</description>
                    <value>0xBCDE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SetTESTMODE2</name>
                    <description>Write: Sets TESTMODE2. Used for production tests (Direct access to OTP macro signals).</description>
                    <value>0xABCD</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>LOCKTESTMODE</name>
            <description>Enables the lock for the TEST.TESTMODE</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EnableLock</name>
                <description>Enables the lock for TEST.TESTMODE.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <usage>read</usage>
                  <enumeratedValue>
                    <name>LockDisabled</name>
                    <description>Read: TEST.TESTMODE is not locked.</description>
                    <value>0x00000000</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LockEnabled</name>
                    <description>Read: TEST.TESTMODE is locked.</description>
                    <value>0x00000001</value>
                  </enumeratedValue>
                </enumeratedValues>
                <enumeratedValues>
                  <usage>write</usage>
                  <enumeratedValue>
                    <name>EnableLock</name>
                    <description>Write: Enables the lock (Ignores any other value written).</description>
                    <value>0x10CC10CC</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>TESTMODE1</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_OTPC_TESTMODE1</headerStructName>
          <access>read-write</access>
          <addressOffset>0x610</addressOffset>
          <cluster>
            <name>EMEMORY</name>
            <description>Unspecified</description>
            <headerStructName>GLOBAL_OTPC_TESTMODE1_EMEMORY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>READ</name>
              <description>Configures the OTP memory read mode. The PTM signals of the
                  OTP macro are set accordingly to this read mode during reads.</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>READ</name>
                  <description>OTP mempory read mode.</description>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Normal</name>
                      <description>Normal read mode.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PGMMargin</name>
                      <description>PGM margin read mode.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>InitialMargin</name>
                      <description>Initial margin read mode.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>PTR</name>
              <description>Enables the PTR (PTR is the direct signal to the
                  OTP macro, it enables the test row) for read or write. When
                  enabled, the read and writes goes to test row instead of main
                  OTP memory.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PTR</name>
                  <description>Enable PTR.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable PTR.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable PTR.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>TESTMODE2</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_OTPC_TESTMODE2</headerStructName>
          <access>read-write</access>
          <addressOffset>0x620</addressOffset>
          <cluster>
            <name>EMEMORY</name>
            <description>Unspecified</description>
            <headerStructName>GLOBAL_OTPC_TESTMODE2_EMEMORY</headerStructName>
            <access>read-write</access>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>IN</name>
              <description>Writes directly to the input signals of the OTP macro.</description>
              <addressOffset>0x000</addressOffset>
              <access>write-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PTM</name>
                  <description>Test mode enabling.</description>
                  <lsb>0</lsb>
                  <msb>3</msb>
                </field>
                <field>
                  <name>PWE</name>
                  <description>Define program cycle.</description>
                  <lsb>4</lsb>
                  <msb>4</msb>
                </field>
                <field>
                  <name>PPROG</name>
                  <description>Program Mode enabling.</description>
                  <lsb>5</lsb>
                  <msb>5</msb>
                </field>
                <field>
                  <name>PCLK</name>
                  <description>Clock input.</description>
                  <lsb>6</lsb>
                  <msb>6</msb>
                </field>
                <field>
                  <name>PCE</name>
                  <description>IP enabling.</description>
                  <lsb>7</lsb>
                  <msb>7</msb>
                </field>
                <field>
                  <name>PTR</name>
                  <description>Test row enable.</description>
                  <lsb>8</lsb>
                  <msb>8</msb>
                </field>
                <field>
                  <name>PDSTB</name>
                  <description>Deep standby mode enabling.</description>
                  <lsb>9</lsb>
                  <msb>9</msb>
                </field>
                <field>
                  <name>PENVDD2</name>
                  <description>VDD2 enable pin (VDD2 domain).</description>
                  <lsb>10</lsb>
                  <msb>10</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>OUT</name>
              <description>Reads directly from the output signals of the OTP macro.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PBUSY</name>
                  <description>Auto enrollment busy pin.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                </field>
                <field>
                  <name>PS</name>
                  <description>Auto PUF margin read success.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>PA</name>
              <description>Writes directly to the address input PA of the OTP macro.</description>
              <addressOffset>0x008</addressOffset>
              <access>write-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PA</name>
                  <description>Address input for read/write operation.</description>
                  <lsb>0</lsb>
                  <msb>11</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>PAIO</name>
              <description>Writes directly to the address input PAIO of the OTP macro</description>
              <addressOffset>0x00C</addressOffset>
              <access>write-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PAIO</name>
                  <description>Address input for write operation.</description>
                  <lsb>0</lsb>
                  <msb>5</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>DATA</name>
              <description>OTP read/write data</description>
              <addressOffset>0x010</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>DATA</name>
                  <description>OTP data register</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <register>
            <name>COUNTERCONFIG</name>
            <description>Configuration register for the counter.</description>
            <addressOffset>0x024</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OPERATIONMODE</name>
                <description>Enable counter-triggered latching of read data from OTP.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Direct</name>
                    <description>The TESTMODE2.EMEMORY.DATA[31:0] register reads the direct value of PDOUT[31:0]
            of eMemory OTP.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Latched</name>
                    <description>The TESTMODE2.EMEMORY.DATA register reads the latched value of PDOUT[31:0] of
            eMemory OTP.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>COUNTERSTART</name>
            <description>Starts the counter. Only applicable when TESTMODE2.COUNTERCONFIG.OPERATIONMODE
         = Direct.</description>
            <addressOffset>0x028</addressOffset>
            <access>write-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TRIGGER</name>
                <description>Start the counter.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoOperation</name>
                    <description>No operation.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Start</name>
                    <description>Start the counter. Only applicable when TESTMODE2.COUNTERCONFIG.OPERATIONMODE=Direct.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>COUNTERRELOAD</name>
            <description>Reload value for counter.</description>
            <addressOffset>0x02C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RELOAD</name>
                <description>This is the counter reload value, used each time the
          decrementing counter is triggered.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COUNTERRUN</name>
            <description>Status of the counter.</description>
            <addressOffset>0x030</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RUNNING</name>
                <description>Checks if counter is running.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NotRunning</name>
                    <description>Counter is not running.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Running</name>
                    <description>Counter is running.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="VPRLMAC">
      <name>GLOBAL_VPR120</name>
      <description>VPR peripheral registers 2</description>
      <baseAddress>0x5F8C8000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=S-->
      <!--Split access-->
      <interrupt>
        <name>VPR120</name>
        <value>200</value>
      </interrupt>
    </peripheral>
    <peripheral>
      <name>GLOBAL_SDCARD</name>
      <description>SD-Card and eMMC</description>
      <baseAddress>0x5F8C9000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>SDCARD</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>ENABLE</name>
          <description>Enable the SDCARD peripheral</description>
          <addressOffset>0x500</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable or disable SDCARD</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable SDCARD</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable SDCARD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>CORE</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_SDCARD_CORE</headerStructName>
          <access>read-write</access>
          <addressOffset>0x600</addressOffset>
          <register>
            <name>SDMASAR</name>
            <description>This register is used to configure a 32-bit Block Count or an SDMA System Address based on the Host Version 4 Enable bit in the Host Control 2 register. This register is applicable for both SD and eMMC modes.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BLOCKCNTSDMASA</name>
                <description>32-bit Block Count (SDMA System Address)</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SIZER</name>
            <description>This register is used to configure an SDMA buffer boundary and the number of bytes in a data block. This register is applicable for both SD and eMMC modes.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000</resetValue>
            <dataType>uint16_t</dataType>
            <size>0x10</size>
            <fields>
              <field>
                <name>XFERBLOCKSIZE</name>
                <description>Transfer Block Size</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>SDMABUFBDARY</name>
                <description>SDMA Buffer Boundary</description>
                <lsb>12</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BYTES4K</name>
                    <description>4K bytes SDMA Buffer Boundary</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES8K</name>
                    <description>8K bytes SDMA Buffer Boundary</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES16K</name>
                    <description>16K bytes SDMA Buffer Boundary</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES32K</name>
                    <description>32K bytes SDMA Buffer Boundary</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES64K</name>
                    <description>64K bytes SDMA Buffer Boundary</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES128K</name>
                    <description>128K bytes SDMA Buffer Boundary</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES256K</name>
                    <description>256K bytes SDMA Buffer Boundary</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTES512K</name>
                    <description>512K bytes SDMA Buffer Boundary</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RSVDBLOCKSIZE15</name>
                <description>This bit of the BLOCKSIZE_R register is reserved. It always returns 0.</description>
                <lsb>15</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>UNTR</name>
            <description>This register is used to configure the number of data blocks. This register is applicable for both SD and eMMC modes.</description>
            <addressOffset>0x006</addressOffset>
