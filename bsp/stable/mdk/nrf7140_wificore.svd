          <register>
            <name>TCTRLR</name>
            <description>This register is used to control the eMMC Boot operation.</description>
            <addressOffset>0x02E</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000</resetValue>
            <dataType>uint16_t</dataType>
            <size>0x10</size>
            <fields>
              <field>
                <name>MANBOOTEN</name>
                <lsb>0</lsb>
