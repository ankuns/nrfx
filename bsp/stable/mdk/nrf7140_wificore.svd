            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>STARTINGSTSNUM</name>
                <description>Starting STS num for cyclic shift delay</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>0</name>
                    <description>0</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2X</name>
                    <description>2x</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1X</name>
                    <description>1x</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3X</name>
                    <description>3x</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSRDSIGNATURE</name>
            <description>WLAN FFT TBUS RD SIGNATURE</description>
            <addressOffset>0xB8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00FFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTTBUSRDSIGNATURE</name>
                <description>TBus debug output data signature.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGGING</name>
            <description>WLAN FFT DEBUG</description>
            <addressOffset>0xBC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDEBUG</name>
                <description>Enable debug registers WLAN_FFT_DEBUG_VALID and WLAN_FFT_DEBUG_ENABLE</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnable</name>
                    <description>Valid, Enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StickyValidSticky</name>
                    <description>Sticky(Valid), Sticky(Enable)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ValidEnableSticky</name>
                    <description>Valid &amp;amp; Enable, Sticky(Valid &amp;amp; Enable)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGVALID</name>
            <description>WLAN FFT DEBUG VALID</description>
            <addressOffset>0xC0</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDEBUGVALID</name>
                <description>Live state of the valid flow control signals0: FFT WR1: Unused - Tied to 02: Unused - Tied to 03: Null SC Insertion Input4: Null SC Insertion Output5: FFT Input FIFO Input6: FFT Input FIFO Output7: Engine Input8: Engine Output9: RTM FFT Input10: RTM FFT Output11: FFT Output FIFO Input12: FFT Output FIFO Output13: Raw FFT Output14: Unused - Tied to 015: Unused - Tied to 016: Unused - Tied to 017: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DEBUGENABLE</name>
            <description>WLAN FFT DEBUG ENABLE</description>
            <addressOffset>0xC4</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDEBUGENABLE</name>
                <description>Live state of the enable flow control signals0: FFT WR1: Unused - Tied to 02: Unused - Tied to 03: Null SC Insertion Input4: Null SC Insertion Output5: FFT Input FIFO Input6: FFT Input FIFO Output7: Engine Input8: Engine Output9: RTM FFT Input10: RTM FFT Output11: FFT Output FIFO Input12: FFT Output FIFO Output13: Raw FFT Output14: Unused - Tied to 015: Unused - Tied to 016: Unused - Tied to 017: FFT RD</description>
                <lsb>0</lsb>
                <msb>17</msb>
              </field>
            </fields>
