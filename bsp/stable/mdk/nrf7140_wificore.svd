                  <description>High speed (PHY clock is running at 30 or 60 MHz)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FS3060</name>
                  <description>Full speed (PHY clock is running at 30 or 60 MHz)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LS6</name>
                  <description>Low speed (PHY clock is running at 6 MHz)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FS48</name>
                  <description>Full speed (PHY clock is running at 48 MHz)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERRTICERR</name>
              <description>Erratic Error (ErrticErr)</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INACTIVE</name>
                  <description>No Erratic Error</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description>Erratic Error</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SOFFN</name>
              <description>Frame or Microframe Number of the Received SOF  (SOFFN)</description>
              <lsb>8</lsb>
              <msb>21</msb>
              <access>read-only</access>
            </field>
            <field>
              <name>DEVLNSTS</name>
              <description>Device Line Status (DevLnSts)</description>
              <lsb>22</lsb>
              <msb>23</msb>
              <access>read-only</access>
            </field>
          </fields>
        </register>
