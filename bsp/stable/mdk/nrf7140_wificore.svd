            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYCLEAR</name>
                <description>Writing 1 to this bit sets ENERGY_EVENT to 0</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWCLEAR</name>
                <description>Writing 1 to this bit sets TBUS_OVERFLOW_EVENT to 0</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWCLEAR</name>
                <description>Writing 1 to this bit sets OVERFLOW_EVENT to 0</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPARECLEAR</name>
                <description>Writing 1 to this bit sets COMPARE_EVENT to 0</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSCLEAR</name>
