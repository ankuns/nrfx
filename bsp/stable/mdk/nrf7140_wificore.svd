          <register>
            <name>ATCTRLR</name>
            <description>This register controls some aspects of tuning and auto-tuning features. Do not program this register when HOST_CTRL2_R.SAMPLE_CLK_SEL is '1'</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x1F000005</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ATEN</name>
                <description>Setting this bit enables Auto tuning engine. This bit is enabled by default when core is configured with mode3 retuning support. Clear this bit to 0 when core is configured to have Mode3 re-tuning but SW wishes to disable mode3 re-tuning.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ATDISABLE</name>
                    <description>AutoTuning is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ATENABLE</name>
                    <description>AutoTuning is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CISEL</name>
                <description>Selects the interval when the corrected center phase select code can be driven on tuning_cclk_sel output.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WHENINBLKGAP</name>
                    <description>Driven in block gap interval</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WHENINIDLE</name>
                    <description>Driven at the end of the transfer</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SWINTHEN</name>
                <description>Sampling window Threshold enable</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LARGESTWINMODE</name>
                    <description>Tuning engine sweeps all taps and settles at the largest window</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>THRESHOLDMODE</name>
                    <description>Tuning engine selects the first complete sampling window that meets the threshold set by SWIN_TH_VAL field</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RPTTUNEERR</name>
                <description>Framing errors are not generated when executing tuning. This debug bit allows users to report these errors.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ERRORSDISABLED</name>
                    <description>Default mode where as per SD-HCI no errors are reported.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DEBUGERRORS</name>
                    <description>Debug mode for reporting framing errors</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SWTUNEEN</name>
                <description>This fields enables software-managed tuning flow.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>SWTUNINGDISABLE</name>
                    <description>Software-managed tuning disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SWTUNINGENABLE</name>
                    <description>Software-managed tuning enabled. AT_STAT_R.CENTER_PH_CODE Field is now writable.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RSDV2</name>
                <description>These bits (RSVD2) of the AT_CTRL_R register are reserved. They always return 0.</description>
                <lsb>5</lsb>
                <msb>7</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>WINEDGESEL</name>
                <description>This field sets the phase for Left and Right edges for drift monitoring. [Left edge offset + Right edge offset] must not be less than total taps of delayLine.</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>RSDV3</name>
                <description>These bits (RSVD3) of the AT_CTRL_R register are reserved. They always return 0.</description>
                <lsb>12</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>TUNECLKSTOPEN</name>
                <description>Clock stopping control for Tuning and auto-tuning circuit.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLECLKSTOPPING</name>
                    <description>Clocks not stopped. PHY ensures glitch free phase switching.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLECLKSTOPPING</name>
                    <description>Clocks stopped during phase code change</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PRECHANGEDLY</name>
                <description>Maximum Latency specification between cclk_tx and cclk_rx.</description>
                <lsb>17</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LATENCYLT1</name>
                    <description>Less than 1-cycle latency</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT2</name>
                    <description>Less than 2-cycle latency</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT3</name>
                    <description>Less than 3-cycle latency</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT4</name>
                    <description>Less than 4-cycle latency</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>POSTCHANGEDLY</name>
                <description>Time taken for phase switching and stable clock output.</description>
                <lsb>19</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LATENCYLT1</name>
                    <description>Less than 1-cycle latency</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT2</name>
                    <description>Less than 2-cycle latency</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT3</name>
                    <description>Less than 3-cycle latency</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LATENCYLT4</name>
                    <description>Less than 4-cycle latency</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SWINTHVAL</name>
                <description>Sampling window threshold value setting</description>
                <lsb>24</lsb>
                <msb>30</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ATSTATR</name>
            <description>Register to read the Center, Left and Right codes used by tuning and auto-tuning engines. Center code field is also used for software managed tuning.</description>
            <addressOffset>0x044</addressOffset>
            <access>read-write</access>
            <resetValue>0x80000006</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CENTERPHCODE</name>
                <description>Centered Phase code. Reading this field returns the current value on tuning_cclk_sel output. Setting AT_CTRL_R.SW_TUNE_EN enables software to write to this field and its contents are reflected on tuning_cclk_sel.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>REDGEPHCODE</name>
                <description>Right Edge Phase code. Reading this field returns the phase code value used by Auto-tuning engine to sample data on Right edge of sampling window.</description>
                <lsb>8</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>LEDGEPHCODE</name>
                <description>Left Edge Phase code. Reading this field returns the phase code value used by Auto-tuning engine to sample data on Left edge of sampling window.</description>
                <lsb>16</lsb>
                <msb>23</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>RSDV1</name>
                <description>These bits of the AT_STAT_R register are reserved. They always return 0.</description>
                <lsb>24</lsb>
                <msb>30</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DL2BUSY</name>
                <description>Delay Line 2 busy indication. If this bit is set then it indicates that the cclk_rx delay line is in the process of delay code updation.</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
