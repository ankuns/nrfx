              <field>
                <name>SETACTIVEFRAME</name>
                <lsb>18</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoChange</name>
                    <description>No change</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NoChange1</name>
                    <description>No change</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FrameAActive</name>
                    <description>Frame A Active</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FrameBActive</name>
                    <description>Frame B active</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TBUSFIFOFLUSH</name>
                <description>Writing '1' to this field causes the TBus output FIFO to be flushed.This bit clears automatically.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>MODE</name>
                <description>Defines the operating mode of the SCP as follows:0: Normal operation; SCP samples are output1: LO phase accumulator (MSB:MSB-11) is output on ILO phase accumulator(MSB-12:MSB-23) is output on Q2: Bypass mode 1; resampler results are output on I and Q3: Bypass mode 2; mixer results are output on I and Q4: Samples bypass the SCP completely</description>
                <lsb>21</lsb>
                <msb>23</msb>
              </field>
            </fields>
