          </register>
          <register>
            <name>INTERRUPTSTATUS</name>
            <description>SCP INTERRUPT STATUS</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYEVENT</name>
                <description>This bit is set to 1 when Energy Monitor outputs are ready to be read.Writing 1 sets this bit for test purposes (and hence asserts the interrupt if ENERGY_ENABLE is also set).</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWEVENT</name>
                <description>This bit is set to 1 if the TBus output FIFO overflows.Writing 1 sets this bit for test purposes (and hence asserts the interrupt if TBUS_OVERFLOW_ENABLE is also set).</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWEVENT</name>
                <description>This bit is set to 1 when the input synchroniser has overflowed.Writing 1 sets this bit for test purposes (and hence asserts the interrupt if OVERFLOW_ENABLE is also set).</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPAREEVENT</name>
                <description>This bit is set to 1 when the frame compare test has matched.Writing 1 sets this bit for test purposes (and hence asserts the interrupt if COMPARE_ENABLE is also set).</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSEVENT</name>
                <description>This bit is set to 1 when the AGC period has completed.Writing 1 sets this bit for test purposes (and hence asserts the interrupt if AGC_COUNTS_ENABLE is also set).</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTERRUPTENABLE</name>
            <description>SCP INTERRUPT ENABLE</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ENERGYENABLE</name>
                <description>IRQ_SCP is asserted when ENERGY_EVENT=1 and ENERGY_ENABLE=1.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>TBUSOVERFLOWENABLE</name>
                <description>IRQ_SCP is asserted when TBUS_OVERFLOW_EVENT=1 and TBUS_OVERFLOW_ENABLE=1.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>OVERFLOWENABLE</name>
                <description>IRQ_SCP is asserted when OVERFLOW_EVENT=1 and OVERFLOW_ENABLE=1.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>COMPAREENABLE</name>
                <description>IRQ_SCP is asserted when COMPARE_EVENT=1 and COMPARE_ENABLE=1.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>AGCCOUNTSENABLE</name>
                <description>IRQ_SCP is asserted when AGC_COUNTS_EVENT=1 and AGC_COUNTS_ENABLE=1.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTERRUPTCLEAR</name>
