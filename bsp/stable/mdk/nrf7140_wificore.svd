        </cluster>
        <cluster>
          <name>TXSCP</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_TXSCP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x11000</addressOffset>
          <register>
            <dim>0x1</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>CONFIG[%s]</name>
            <description>Description collection: TXSCP CONFIG</description>
            <addressOffset>0x0</addressOffset>
            <access>read-only</access>
            <resetValue>0x000000FF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TXSCPCFRPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the CFR block in the TX SCP.0: CFR not present.1: CFR present.Writing to field would not change its value.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>TXSCPDPDPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the DPD block in the TX SCP.0: DPD not present.1: DPD present.Writing to field would not change its value.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>TXSCPIQIMBALANCEPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the IQ imbalance block in the TX SCP.0: IQ imbalance not present.1: IQ imbalance present.Writing to field would not change its value.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>TXSCPINTERPOLATORPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Interpolator block in the TX SCP.0: Interpolator not present.1: Interpolator present.Writing to field would not change its value.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>TXSCPRESAMPLERPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Resampler block in the TX SCP.0: Resampler not present.1: Resampler present.Writing to field would not change its value.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>TXSCPMIXERPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Mixer block in the TX SCP.0: Mixer not present.1: Mixer present.Writing to field would not change its value.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>TXSCPGAINANGLEPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the Gain Angle block in the TX SCP.0: Gain Angle not present.1: Gain Angle present.Writing to field would not change its value.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>TXSCPDCOFFSETPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the DC Offset block in the TX SCP.0: DC Offset not present.1: DC Offset present.Writing to field would not change its value.</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>TXSCPCFRPREINTERPPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the pre interpolator block in the TX SCP.0: Pre interpolator not present.1: Pre interpolator present.Writing to field would not change its value.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>TXSCPPCFPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the PCF block in the TX SCP.0: PCF not present.1: PCF present.Writing to field would not change its value.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>TXSCPPREINTERPIQIMBALANCEPRESENT</name>
                <description>This is a read-only field. Value read out indicates the presence of the pre interpolator IQ Imbalance block in the TX SCP.0: Pre interpolator IQ Imbalance not present.1: Pre interpolator IQ Imbalance present.Writing to field would not change its value.</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x1</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>CTRL[%s]</name>
            <description>Description collection: TXSCP CTRL</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000708</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MIXEROUTGAIN</name>
                <description>Selects Mixer output gain:0: Gain of 1.0 is applied to the output of Mixer rotator (default).1: Gain of 2.0 is applied to the output of Mixer rotator (used to compensate for 0.5 gain in real input mode).Relevant when MIXER_DISABLE = 0.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MIXERINVERTSPECTRUM</name>
                <description>Selects Mixer spectrum inversion:0: The mixer output spectrum is not inverted.1: The mixer output spectrum is inverted by swapping I and Q.The mixer design under normal operation inverts the output I and Q samples even if this field is set to 0. To re-invert set field to 1.Relevant when MIXER_DISABLE = 0.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>RESAMPSCALINGFACTOR</name>
                <description>X8 output scaled by a factor of:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>025</name>
                    <description>0.25</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>050</name>
                    <description>0.50</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>100</name>
                    <description>1.00</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>200</name>
                    <description>2.00</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>IQIMBALANCEDISABLE</name>
                <description>Used to set the bypass mode of the IQ imbalance compensation block:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
