            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF14</name>
                <description>Filter Coefficient 14 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>PCFCOEFF15</name>
                <description>Filter Coefficient 15 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PCFCOEFF9</name>
            <description>TXSCP PCF COEFF9</description>
            <addressOffset>0x3E4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF16</name>
                <description>Filter Coefficient 16 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>PCFCOEFF17</name>
                <description>Filter Coefficient 17 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>12</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PCFCOEFF10</name>
            <description>TXSCP PCF COEFF10</description>
            <addressOffset>0x3E8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF18</name>
                <description>Filter Coefficient 18 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>PCFCOEFF19</name>
