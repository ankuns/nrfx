                    <value>0x0D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RTRANSFER</name>
                    <description>Read Data Transfer State.</description>
                    <value>0x0E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RIBI</name>
                    <description>In-Band Interrupt(SIR) Read Data State.</description>
                    <value>0x0F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>IBIAUTODISABLE</name>
                    <description>In-Band Interrupt Auto-Disable State</description>
                    <value>0x10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DDRCRCGEN</name>
                    <description>HDR-DDR CRC Data Generation/Receive State.</description>
                    <value>0x11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLKEXTEND</name>
                    <description>Clock Extension State.</description>
                    <value>0x12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HALT</name>
                    <description>Halt State.</description>
                    <value>0x13</value>
