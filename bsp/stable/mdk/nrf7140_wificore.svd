                <lsb>14</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DescramblerDisabled</name>
                    <description>Descrambler disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DescramblerEnabled</name>
                    <description>Descrambler enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGCMLOADED</name>
                <description>Assume channel matrices are already loaded into the MIMO decoder</description>
                <lsb>15</lsb>
                <msb>15</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DonTAssumeChannelMa</name>
                    <description>Don't assume channel matrices have been loaded</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AssumeChannelMatrice</name>
                    <description>Assume channel matrices have been loaded</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
