                <msb>9</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>CQCCAPRSVD1</name>
                <description>These bits of the CQCAP register are reserved. They always return 0.</description>
                <lsb>10</lsb>
                <msb>11</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ITCFMUL</name>
                <description>Internal Timer Clock Frequency Multiplier (ITCFMUL)</description>
                <lsb>12</lsb>
                <msb>15</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLK1KHZ</name>
                    <description>1KHz clock</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLK10KHZ</name>
                    <description>10KHz clock</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLK100KHZ</name>
                    <description>100KHz clock</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLK1MHZ</name>
                    <description>1MHz clock</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLK10MHZ</name>
                    <description>10MHz clock</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CQCCAPRSVD2</name>
                <description>These bits [27:16] of the CQCAP register are reserved. They always return 0.</description>
                <lsb>16</lsb>
                <msb>27</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>CRYPTOSUPPORT</name>
                <lsb>28</lsb>
                <msb>28</msb>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FALSE</name>
                    <description>Crypto not Supported</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TRUE</name>
                    <description>Crypto Supported</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CQCCAPRSVD3</name>
                <description>These bits [31:29] of the CQCAP register are reserved. They always return 0.</description>
                <lsb>29</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
