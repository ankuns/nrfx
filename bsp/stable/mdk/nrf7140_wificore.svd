            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANLDPCDECODERCODE</name>
                <description>Select LDPC code:0: Codeword length 648 rate 1/21: Codeword length 648 rate 2/32: Codeword length 648 rate 3/43: Codeword length 648 rate 5/64: Codeword length 1296 rate 1/25: Codeword length 1296 rate 2/36: Codeword length 1296 rate 3/47: Codeword length 1296 rate 5/68: Codeword length 1944 rate 1/29: Codeword length 1944 rate 2/310: Codeword length 1944 rate 3/411: Codeword length 1944 rate 5/612-15: Reserved</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ITERATIONS</name>
            <description>WLAN LDPC DECODER ITERATIONS</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000005</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANLDPCDECODERITERATIONS</name>
                <description>Number of iterations the decoder performs for each codeword.Note that the valid is stored '-1'.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CODEWORDS</name>
            <description>WLAN LDPC DECODER CODEWORDS</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
