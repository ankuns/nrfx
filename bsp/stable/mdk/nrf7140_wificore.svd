            <resetValue>0x0004</resetValue>
            <dataType>uint16_t</dataType>
            <size>0x10</size>
            <fields>
              <field>
                <name>TESTMODEEN</name>
                <description>enables test mode interface for all PADS. Functional interface is disabled.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PADFUNCMODE</name>
                    <description>PAD's functional mode I/F is active</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PADTESTMODE</name>
                    <description>PAD's test mode interface is active</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TESTDLYLINEEN</name>
                <description>Test enable for delay line testing</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TESTDLYLINEDIS</name>
                    <description>Testing of Delay line disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTDLYLINEEN</name>
                    <description>Testing of delay line enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TESTCLKEN</name>
                <description>. While updating delay codes during testmode, this signal is used to gate the test clock. Functional interface is disabled.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TESTCLKGATED</name>
                    <description>Gate the test clock</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TESTCLKENABLED</name>
                    <description>Test clock is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RSVD1</name>
                <description>RSVD1 field is reserved</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>TESTOE</name>
                <description>test interface OE control. Drive's PHY's itest_oe inputs.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
            </fields>
