                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>LPM capability is enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>APPL1RES</name>
