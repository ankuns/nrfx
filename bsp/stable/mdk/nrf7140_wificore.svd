                  <enumeratedValue>
                    <name>AccumulateStatistics</name>
                    <description>Accumulate statistics for STAT_REQ_SEL requestor only.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AccumulateStatistics1</name>
                    <description>Accumulate statistics across all requestors.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STATREQENABLE</name>
                <description>Statistic accumulation control:</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AccumulationOfStatis</name>
                    <description>Accumulation of statistics disabled (power saving mode).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AccumulationOfStatis1</name>
                    <description>Accumulation of statistics enabled (debug mode).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DCPCYCLECNT</name>
            <description>EDC SYS DCP CYCLE CNT</description>
            <addressOffset>0x428</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCPCYCLECNT</name>
                <description>Wrapping DCP cycle count.Write any value to clear.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCPISSUECNT</name>
            <description>EDC SYS DCP ISSUE CNT</description>
            <addressOffset>0x42C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCPISSUECNT</name>
                <description>Wrapping DCP issue count.Write any value to clear.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DCPWAITCNT</name>
            <description>EDC SYS DCP WAIT CNT</description>
            <addressOffset>0x430</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCPWAITCNT</name>
                <description>Wrapping DCP wait count.Write any value to clear.</description>
                <lsb>0</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>BURSTCTRL</name>
            <description>EDC SYS BURST CTRL</description>
            <addressOffset>0x434</addressOffset>
            <access>read-write</access>
            <resetValue>0x7F000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EDCMAXBURSTLEN</name>
                <description>Maximum ExtRAM burst length '-1'. Supports bursts of maximum 16 words length.</description>
                <lsb>24</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>EDCBREAKNONLINEAR</name>
                <description>Defines whether ExtRAM bursts are broken on non-consecutive addresses.</description>
                <lsb>28</lsb>
                <msb>28</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotBreakBurstsOnNo</name>
                    <description>Do not break bursts on non-linear addresses</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BreakBurstsOnNonLin</name>
                    <description>Break bursts on non-linear addresses</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>EDCPAGEBREAK</name>
                <description>Defines page boundary on which ExtRAM bursts are broken.</description>
                <lsb>29</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>None</name>
                    <description>None</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>256ByteBoundary</name>
                    <description>256 Byte Boundary</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>512ByteBoundary</name>
                    <description>512 Byte Boundary</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>1KbyteBoundaryDefau</name>
                    <description>1 kByteBoundary (default)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2KbyteBoundary</name>
                    <description>2 kByteBoundary</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4KbyteBoundary</name>
                    <description>4 kByteBoundary</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>8KbyteBoundary</name>
                    <description>8 kByteBoundary</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16KbyteBoundary</name>
                    <description>16kByteBoundary</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>EDCEXTRAMBURSTTIMEOUT[%s]</name>
            <description>Description collection: EDC EXT RAM BURST TIMEOUT</description>
            <addressOffset>0x438</addressOffset>
            <access>read-write</access>
            <resetValue>0x0000100F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BURSTTIMEOUTVALUE</name>
                <description>Timeout counter value</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>BURSTTIMEOUTENABLE</name>
                <description>When set high burst timeouts are enabled.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIGURATIONSTATUS</name>
            <description>EDC SYS CONFIGURATION STATUS</description>
            <addressOffset>0x448</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>FULLAGENSTATUS</name>
                <description>Status register bit that indicates if full address generator is present or not.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FullAddressGenerator</name>
                    <description>Full address generator not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FullAddressGenerator1</name>
                    <description>Full address generator present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FULLOFFSETLUTSSTATUS</name>
                <description>Status register bit that indicates if GRAM offset LUTs are present or not.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GramOffsetLutsNotPre</name>
                    <description>GRAM offset LUTs not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GramOffsetLutsPresen</name>
                    <description>GRAM offset LUTs present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FULLOFFSETADJLUTSSTATUS</name>
                <description>Status register bit that indicates if GRAM offset adjustment LUTs are present or not.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GramOffsetAdjustment</name>
                    <description>GRAM offset adjustment LUTs not present</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GramOffsetAdjustment1</name>
                    <description>GRAM offset adjustment LUTs present</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>EDC_PERIP</name>
          <description>Unspecified</description>
          <headerStructName>RPUPBUS_EDC_PERIP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x06000</addressOffset>
          <cluster>
            <dim>64</dim>
            <dimIncrement>0x020</dimIncrement>
            <name>EDCPERIPCHANREGS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDC_PERIP_EDCPERIPCHANREGS</headerStructName>
            <access>read-write</access>
            <addressOffset>0x0</addressOffset>
            <register>
              <name>BASIC0</name>
              <description>Description cluster: EDC PERIP BASIC0</description>
              <addressOffset>0x0</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LATCHEDRESET</name>
                  <description>Latched transfer engine channel software reset.Note: Use of PULSED_RESET is preferred over LATCHED_RESET.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                </field>
                <field>
                  <name>PULSEDRESET</name>
                  <description>Pulsed channel transfer engine software reset, clears automatically at start of next transfer on channel.Note: Once set must remain high before a DCP start/run instruction, so if set before ldbasic/ldfull it must be set again by the ldbasic/ldfull before the start/run.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                </field>
                <field>
                  <name>FINERATE</name>
                  <description>COARSE_RATE and FINE_RATE together define the rate at which EDC_BURST_LENGTH byte bursts may be transferred on this channel.0 : FR = 71 : FR = 62 : FR = 53 : FR = 4FR bursts every CR sysclk periods, giving (sysclk * EDC_BURST_LENGTH * FR * CR) bytes / sec)Notes:1. If COARSE_RATE=0 and FINE_RATE=0 then the burst rate is not controlled.2. COARSE_RATE is unused for TFR_MODE=100,101, where the COARSE_RATE for the ECN linked channel with TFR_MODE=001,011 is used once for both transfers.</description>
                  <lsb>3</lsb>
                  <msb>4</msb>
                </field>
                <field>
                  <name>PERBUS</name>
                  <description>Selects bus for peripheral transfers:0 : Peripheral transfer is carried over the transfer bus (TBus) using hardware flow control of peripheral accesses.1 : Peripheral transfer is carried over the non-stalling peripheral bus (SysBus or PBus) using (PA + incrOffset) as the peripheral addressNotes:1. Must be set to 0 when TFR_MODE=110.2. Must be set to 1 when PW=11.</description>
                  <lsb>5</lsb>
                  <msb>5</msb>
                </field>
                <field>
                  <name>TFRMODE</name>
                  <description>000 : Read from memory (MA+agenOffset), write to peripheral (PA+incrOffset)001 : Read from memory(MA+agenOffset), write to EDC channel (ECN)010 : Read from peripheral (PA+incrOffset), write to memory (MA+agenOffset)011 : Read from peripheral (PA+incrOffset), write to EDC channel (ECN)100 : Read from EDC channel (ECN), write to memory (MA+agenOffset)101 : Read from EDC channel (ECN), write to peripheral (PA+incrOffset)110 : Read FDSG/LFSR/PRBS offsets from MMR (MA+[0:3]), write to transfer bus (TBus)111 : Read from peripheral (PA+incrOffset), write to peripheral (MA+incr2Offset)Notes: 1. ITEMS must match for peripheral to peripheral transfers.2. Partial address masks only supported at end of transfers.3. 'from EDC channel (ECN)' transfers should be configured/started before 'to EDC channel (ECN)' transfers.4. ITEM_BYTES must be set to 3 bytes for TFR_MODE=110</description>
                  <lsb>6</lsb>
                  <msb>8</msb>
                </field>
                <field>
                  <name>EOPMASK</name>
                  <description>Selects the mask for the last memory write in case of EOP:</description>
                  <lsb>9</lsb>
                  <msb>9</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>MaskFromAddressGener</name>
                      <description>Mask from address generator is used.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>MaskFromTbusReadPort</name>
                      <description>Mask from TBus read port is used.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TRANSFERMODE</name>
                  <description>Selects multiple 16-bit items length or single 24-bit items length transfer:0 : Perform TRANSFERS * ITEMS item transfers.1 : Perform single '(TRANSFERS &amp;lt;&amp;lt; 16) | ITEMS' item transfer.Notes:1. TRANSFERS_MODE must be written before writing TRANSFERS and ITEMS to BASIC1.2. TRANSFERS will always return 1 after switching TRANSFERS_MODE from 1 to 0.3. Single 24-bit items length transfer supported only when address generator is in row-column mode. Note that row-column mode is available only when EDC_SYS_CONFIGURATION_STATUS[0] = '1'; therefore 24-bit items transferis supported only when EDC_SYS_CONFIGURATION_STATUS[0] = '1'.The required row-column parameters to have modulo addressing are N0=anything that divides N2 and such that N0 &amp;gt;= GRAM_REQS-1 (the second condition is required to have best performance), N1=1, N2=modulo, A=0, B=0, O=start index.</description>
                  <lsb>10</lsb>
                  <msb>10</msb>
                </field>
                <field>
                  <name>EOPMODE</name>
                  <description>Specifies the end of packet mode:Notes: 1. When enabled, EOP signal terminates all TRANSFERS, not just ITEMS within current transfer.</description>
                  <lsb>11</lsb>
                  <msb>12</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DmaJobCompletesAfter</name>
                      <description>DMA job completes after TRANSFERS*ITEMS transfers.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Reserve</name>
                      <description>This is reserved.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DmaJobCompletesAfter2</name>
                      <description>DMA job completes after TRANSFERS*ITEMS transfers, or on receipt of EOP signal from peripheral, whichever occurs first.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Reserve3</name>
                      <description>This is reserved.</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DISCARDOP</name>
                  <description>Controls whether output of transfers should be discarded:0 : Output not discarded.1 : Output discarded, transfers otherwise operate as normal.Notes:1. this control cannot be used for 'to EDC channel (ECN)' transfers where it should instead be set for the 'from EDC channel (ECN)' transfer.2. this register is double buffered at start of job.</description>
                  <lsb>13</lsb>
                  <msb>13</msb>
                </field>
                <field>
                  <name>INCR</name>
                  <description>Specifies incrementing peripheral address burst mode.By default all operations to the peripheral are to a single register location.Note: Only applicable to SysBus or PBus transfers.</description>
                  <lsb>14</lsb>
                  <msb>14</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>StaticPeripheralAddr</name>
                      <description>Static peripheral address defined by PA.Typically used when transferring to/from a FIFO mapped to a single data port peripheral address.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IncrementingPeripher</name>
                      <description>Incrementing peripheral address, start address defined by PA. Typically used when transferring to a block of configuration registers.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>BITREV</name>
                  <description>Specifies bit reversal within transferred bytes:0 : Bytes are not bit reversed1 : Bytes are bit reversedNotes :1. Applied to destination transfers only.2. Just the parameter for the destination channel is used when linked using ECN.</description>
                  <lsb>15</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>COARSERATE</name>
                  <description>COARSE_RATE defines the rate at which EDC_BURST_LENGTH byte bursts may be transferred on this channel.0 : CR = 1 / 81 : CR = 1 / 162 : CR = 1 / 323 : CR = 1 / 644 : CR = 1 / 1285 : CR = 1 / 2566 : CR = 1 / 5127 : CR = 1 / 1024FR bursts every CR sysclk periods, giving (sysclk * EDC_BURST_LENGTH * FR * CR) bytes / sec)Notes:1. If COARSE_RATE=0 and FINE_RATE=0 then the burst rate is not controlled.2. COARSE_RATE is unused for TFR_MODE=100,101, where the COARSE_RATE for the ECN linked channel with TFR_MODE=001,011 is used once for both transfers.</description>
                  <lsb>16</lsb>
                  <msb>18</msb>
                </field>
                <field>
                  <name>PALIGN</name>
                  <description>Specifies the alignment of peripheral data:</description>
                  <lsb>19</lsb>
                  <msb>19</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DataIsRightAligned</name>
                      <description>Data is right aligned</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DataIsLeftAligned</name>
                      <description>Data is left aligned</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PW</name>
                  <description>Specifies the width of the peripheral transfer.If transfers are being performed on the wide Tbus then parallel transfers of this width take place.</description>
                  <lsb>20</lsb>
                  <msb>21</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>8BitPbusOrTbus</name>
                      <description>8 bit(PBus or TBus)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>16BitPbusOrTbus</name>
                      <description>16 bit (PBus or TBus)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>24BitPbusOrTbus</name>
                      <description>24 bit (PBus or TBus)</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>32BitSysbus</name>
                      <description>32 bit (SysBus)</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DCPPRIORITY</name>
                  <description>Specifies the priority of DCP thread execution:</description>
                  <lsb>22</lsb>
                  <msb>22</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>LowPriorityDcpThread</name>
                      <description>Low priority DCP thread.)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>HighPriorityDcpThrea</name>
                      <description>High priority DCP thread (use for realtime peripherals such as the SCP).</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>MEMBSWAP</name>
                  <description>Big/little endian byte swap.If set, byte order will be reversed in all memory read/write transfers.MEM_BSWAP is applied on 24-bit GRAM or 32-bit External RAM memory accesses.MEM_BSWAP is applied on the memory word after the peripheral data to transfer has been packed, or on the memory word read from RAM before it is unpacked for transfer to the peripheral.Note : Applied to both source and destination memory transfers.</description>
                  <lsb>23</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC1</name>
              <description>Description cluster: EDC PERIP BASIC1</description>
              <addressOffset>0x4</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ITEMS</name>
                  <description>The number of items in each DMA transfer, represented in 'natural' format (ITEMS=1 gives one transfer).The total number of items in a DMA job is (TRANSFERS * ITEMS).If transferring to/from TBus peripherals, (ITEM_BYTES+1)*ITEMS must be divisible by (PW+1)*PERIP_NUM, with any surplus being discarded, and whilst a byte mask isprovided to TBus peripherals to indicate shortfall few peripherals make use of this.Decremented by 'ITEM_BYTES+1'.Note: This register is double buffered at start of job.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>TRANSFERS</name>
                  <description>When TRANSFERS_MODE=0:The number of DMA transfers in the DMA job, represented in 'natural' format (TRANSFERS=1 specifies one transfer).TRANSFERS = 0 selects a different mode of operation -Skip the number of items defined by ITEMS, then generate one item without updating the state of the address generator.This mode is used for applying error correction to the Outer Decoder input data.When TRANSFERS_MODE=1:ITEMS[23:0] (TRANSFERS is internally fixed at 1).Note: when EOP_MODE = '10', TRANSFERS &amp;gt; 1 is not supported.</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC2</name>
              <description>Description cluster: EDC PERIP BASIC2</description>
              <addressOffset>0x8</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PA</name>
                  <description>For transfers over the non-stalling peripheral bus (SysBus or PBus), PA specifies the base peripheral address.For transfers over the stalling transfer bus (TBus), PA[13:0] selects the port ID within the following TBus read/write port selection groups:PA[15:14]=00 : Peripheral TBus write ports.PA[15:14]=01 : EDC Address Generator Offset write ports.PA[15:14]=10 : Peripheral TBus read portsNotes:1. INCR=1 produces a sequence of incrementing addressesPA, PA+1, PA+2, ...2. Address generator offset TBus write requests must be allocated to a higher priority (lower number) EDC channelthan the EDC channel address generator that they are feeding.3. Address generator offset TBus write requests EDC channel must be started before the EDC channel address generator that they are feeding.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>ECN</name>
                  <description>When TFR_MODE=000 ... 110 :EDC channel number to connect with for memory-to-memory transferNote: When linking channels using ECN the ITEMS setting for each channel must match, though TRANSFERS need not be the same.This hardware restriction arises because each transfer consists of a sequence of EDC_BURST_LENGTH byte bursts,with one final burst which carries the number of bytes required to complete the transfer.The number of bytes in the final burst of a transfer is rem(ITEMS * (ITEM_BYTES+1), EDC_BURST_LENGTH).When TFR_MODE=111 :ECN[4:3]=PW_2 : Specifies the width of the destination peripheral transfer.If transfers are being performed on the wide Tbus then parallel transfers of this width take place.00 : 8 bit(PBus or TBus)01 : 16 bit (PBus or TBus)10 : 24 bit (PBus or TBus)11 : 32 bit (SysBus)ECN[2]=PALIGN_2 : Specifies the alignment of destination peripheral data:0 : Data is right aligned1 : Data is left alignedECN[1]=INCR_2 : Specifies incrementing destination peripheral address burst mode.By default all operations to the destination peripheral are to a single register location.0 : Static destination peripheral address defined by MA.Typically used when transferring to a FIFO mapped to a single data port destination peripheral address.1 : Incrementing destination peripheral address, start address defined by MA. Typically used when transferring to a block of configuration registers.Note: Only applicable to SysBus or PBus transfers.ECN[0]=PER_BUS_2 : Selects bus for destination peripheral transfers:0 : Destination peripheral transfer is carried over the transfer bus (TBus) using hardware flow control of destination peripheral accesses.1 : Destination peripheral transfer is carried over the non-stalling peripheral bus (SysBus or PBus) using (MA + incr2Offset) as the destination peripheral address</description>
                  <lsb>16</lsb>
                  <msb>21</msb>
                </field>
                <field>
                  <name>PAEXT</name>
                  <description>Extended PA address bit.</description>
                  <lsb>22</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BASIC3</name>
              <description>Description cluster: EDC PERIP BASIC3</description>
              <addressOffset>0xC</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>MA</name>
                  <description>When TFR_MODE=000 ... 110 :Memory Address defines the base address of the memory transfers controlled by this DMA channel.The units of MA are physical RAM locations, and the physical RAM bus targetted by this DMA channel is selected by BUS_BYTES. The byte address of the memory base in the chosen RAM space is MA * BUS_BYTES.When TFR_MODE=111 :For transfers over the non-stalling peripheral bus (SysBus or PBus), MA specifies the base peripheral address.For transfers over the stalling transfer bus (TBus), MA[13:0] selects the port ID within the following TBus write port selection groups:MA[15:14]=00 : Peripheral TBus write ports.MA[15:14]=01 : EDC Address Generator Offset write ports.Notes:1. INCR=1 produces a sequence of incrementing addressesMA, MA+1, MA+2, ... (where MA is shadowed for transfer rather than current MA used by DCP)2. Address generator offset TBus write requests must be allocated to a higher priority (lower number) EDC channelthan the EDC channel address generator that they are feeding.3. Address generator offset TBus write requests EDC channel must be started before the EDC channel address generator that they are feeding.4. This register is double buffered at start of job.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN4</name>
              <description>Description cluster: EDC PERIP AGEN4</description>
              <addressOffset>0x10</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N0</name>
                  <description>Address generator N0 parameter.Use depends on selected mode:Modulo mode : modulo (0 value gives 2^16 modulo)Repeat-skip mode: number of items in one sequenceRow-column mode : number of items in one block (rows * columns)Twisted row-column mode : number of items in one burstBurst row-column mode : number of items in one burstFIFO mode : number of items in one burst (one burst for each FIFO )Run-length mode : number of items to skip after one 'run'Row-column-CD mode: number of FIFOs</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>BUSBYTES</name>
                  <description>The byte width of the memory bus targetted by the address generator.Note: this register is double buffered at start of job.</description>
                  <lsb>16</lsb>
                  <msb>16</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>3BytesGlobalRamBus</name>
                      <description>3 bytes (global RAM bus)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>4BytesExternalRamBu</name>
                      <description>4 bytes (external RAM bus)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ITEMBYTES</name>
                  <description>The number of bytes in each item of the data structure accessed by the address generator.0 : 1 byte1 : 2 bytes2 : 3 bytes3 : 4 bytesNotes:1. This must be programmed correctly even when the address generator is not in use.2. This register is double buffered at start of job.</description>
                  <lsb>17</lsb>
                  <msb>18</msb>
                </field>
                <field>
                  <name>CLRABO</name>
                  <description>Setting CLR=1 clears the internal registers a, b and o in the address generator for this channel.This register clears automatically.</description>
                  <lsb>19</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>MODE</name>
                  <description>Note: If EDC_SYS_CONFIGURATION_STATUS[0] = '0', only modulo mode is supported.</description>
                  <lsb>21</lsb>
                  <msb>23</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Modulo</name>
                      <description>modulo</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RepeatSkip</name>
                      <description>repeat-skip</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RowColumn</name>
                      <description>row-column</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TwistedRowColumn</name>
                      <description>twisted row-column</description>
                      <value>0x3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>BurstRowColumn</name>
                      <description>burst row-column</description>
                      <value>0x4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Fifo</name>
                      <description>FIFO</description>
                      <value>0x5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RunLength</name>
                      <description>run-length</description>
                      <value>0x6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RowColCd</name>
                      <description>row-col-cd</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN5</name>
              <description>Description cluster: EDC PERIP AGEN5</description>
              <addressOffset>0x14</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N1</name>
                  <description>Address generator N1 parameter.Use depends on EDC_SYS_CONFIGURATION_STATUS register and OFFSET_ADD field of EDC_PERIP_JOB0 register:If EDC_SYS_CONFIGURATION_STATUS[1] = '1' and OFFSET_ADD = '1' then only 10 LSBs are used and it represents the LUT read pointer. Automatically incremented. When LUT are used, address generator increment is not needed.Else use depends on selected mode:Modulo mode : increment per itemRepeat-skip mode: number of repeats of each sequenceRow-column mode : number of rowsTwisted row-column mode : number of rowsBurst row-column mode : number of rowsFIFO mode : number of FIFOsRun-length mode : unusedRow-column-CD mode: rem((d1-d0) * numFifos + buffLen, buffLen), where d0 is the delay of FIFO 0 and d1 is the delay of FIFO 1, both measured in itemsNotes:1. If EDC_SYS_CONFIGURATION_STATUS[1] = '1', this register is double buffered (only 10 LSBs) at start of job, to allow reconfiguration of LUT read pointer while job is still active.2. If EDC_SYS_CONFIGURATION_STATUS[1:0] = '00', this register is not present and the increment per item if fixed to 1.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN6</name>
              <description>Description cluster: EDC PERIP AGEN6</description>
              <addressOffset>0x18</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>N2</name>
                  <description>Address generator N2 parameter.Use depends on selected mode:Modulo mode : if AGEN_STATE_B[0]=0, start index (must be in the range 0 to N0-1), else unusedRepeat-skip mode: number of items from the start of one sequence to the start of the next sequenceRow-column mode : number of items in the set of blocks (rows * columns * blocks)Twisted row-column mode : number of items in one block(rows * columns)Burst row-column mode : number of items in one block minus number of items in one burst(rows * columns - N0)FIFO mode : number of items in the whole FIFO structureRun-length mode : unusedRow-column-CD mode: number of items in the CD buffer.Note: N2 must be an integer multiple of abs(d1-d0) * numFifos, where d0 is the delay of FIFO 0 and d1 is the delay of FIFO 1, both measured in itemsIf OFFSET_ADD is in use and EDC_SYS_CONFIGURATION_STATUS[1] = '1', N2 can be set to enforce a modulo on the LUT read pointer.Notes:1. This register is double buffered at start of job.2. If EDC_SYS_CONFIGURATION_STATUS[0] = '0', only 16 LSBs are used.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGEN7</name>
              <description>Description cluster: EDC PERIP AGEN7</description>
              <addressOffset>0x1C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LP0</name>
                  <description>FIFO mode: maxItems - the maximum number of items in a paired bufferNote: If read ITEMS is not equal to write ITEMS then LP0 must be &amp;gt;= 2 * EDC_BURST_LENGTHBLOCK mode : itemsPerBlock - the number of items in a block</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>LP1</name>
                  <description>FIFO mode: not usedBLOCK mode : maxBlocks - the maximum number of blocks in a paired buffer</description>
                  <lsb>16</lsb>
                  <msb>21</msb>
                </field>
                <field>
                  <name>LINKMODE</name>
                  <description>Controls pairing of even numbered write channel 'N' and odd numbered read channel 'N+1':00 : Pairing disabled01 : Pair using FIFO mode10 : Pair using BLOCK mode11 : reservedNotes:1. Linked channels must have the same ITEM_BYTES configuration.2. LINK_MODE must be disabled on channels with EXT_RAM_READ_AHEAD set to 1(but can be set on channels ECN linked to these that have EXT_RAM_READ_AHEAD set to 0).3. Changing LINK_MODE setting causes read and write buffer counts to be reset.4. If EDC_SYS_CONFIGURATION_STATUS[0] = '0', the pairing is not supported.</description>
                  <lsb>22</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <dim>64</dim>
            <dimIncrement>0x010</dimIncrement>
            <name>EDCPERIPCTXTREGS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDC_PERIP_EDCPERIPCTXTREGS</headerStructName>
            <access>read-write</access>
            <addressOffset>0x800</addressOffset>
            <register>
              <name>AGENCONTEXT0</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT0</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEA</name>
                  <description>Address generator A variable.If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGENCONTEXT1</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT1</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEB</name>
                  <description>Address generator B variable.If MODE=0 (modulo mode) AGEN_STATE_B[0]=1 causes N2 to be substituted with offsets fed from another channel.If AGEN_STATE_B[0]=1, N1 must be different than 1 to prevent linear mode logic to be enabled, since it does not support offset addition.If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>AGENCONTEXT2</name>
              <description>Description cluster: EDC PERIP AGEN CONTEXT2</description>
              <addressOffset>0x008</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>AGENSTATEO</name>
                  <description>Address generator O variable.If this register is loaded by the DCP then it should be fenced using LDBASIC/LDFULL before the RUN instruction.</description>
                  <lsb>0</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>STATUS</name>
              <description>Description cluster: EDC PERIP STATUS</description>
              <addressOffset>0x00C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ITEMSLEFT</name>
                  <description>The number of items remaining in each DMA transfer, represented in 'natural' format.Note: This is updated to represent the number of items completed when a job completes for EOP_MODE=10.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>TRANSFERSLEFT</name>
                  <description>When TRANSFERS_MODE=0:The number of DMA transfers remaining in the DMA job, represented in 'natural' format.When TRANSFERS_MODE=1:ITEMS_LEFT[23:0].</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <register>
            <name>EDCGPIO0OUT</name>
            <description>EDC GPIO0 OUT</description>
            <addressOffset>0xC00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO0OUT</name>
                <description>Value output on bits 15:0 of UCCP top level GPIO_OUT pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO1OUT</name>
            <description>EDC GPIO1 OUT</description>
            <addressOffset>0xC04</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO1OUT</name>
                <description>Value output on bits 31:16 of UCCP top level GPIO_OUT pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO0IN</name>
            <description>EDC GPIO0 IN</description>
            <addressOffset>0xC08</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO0IN</name>
                <description>Value input on bits 15:0 of UCCP top level GPIO_IN pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCGPIO1IN</name>
            <description>EDC GPIO1 IN</description>
            <addressOffset>0xC0C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GPIO1IN</name>
                <description>Value input on bits 31:16 of UCCP top level GPIO_IN pins.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSRSTCTRL</name>
            <description>EDC PERIP TBUS RST CTRL</description>
            <addressOffset>0xC10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RESETTBUSID</name>
                <description>Port ID of TBus to reset.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>RESETOFFSETUNPACKER</name>
                <description>Reset Address Generator Offset unpacker.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>RESETTBUSWRUNPACKER</name>
                <description>Reset TBus write unpacker.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>RESETTBUSRDPACKER</name>
                <description>Reset TBus read packer.</description>
                <lsb>22</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>RESETTBUSRDPORT</name>
                <description>Reset TBus read port data held for next transfer.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PERFCTRL</name>
            <description>EDC PERIP PERF CTRL</description>
            <addressOffset>0xC14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMREADAHEAD</name>
                <description>0 : Do not read-ahead from ExtRAM (appropriate setting for multi-channel ExtRAM reads).1 : Read-ahead from ExtRAM (appropriate setting for single-channel ExtRAM reads or multi-channel only where each channel has a unique EXT_RAM_ID in range 0 to EDC_EXT_RAM_REQS-1).For use in high read latency ExtRAM systems, should not be used in low latency ExtRAM systems as can reduce performance due to additional destination address generation latency.When enabled, address generator modes that make use of offsets (run-length, twisted-row-col, FIFO) are not supported for ExtRAM or GRAM TFR_MODE=4 destination transfer from an ExtRAM source TFR_MODE=1 transfer.ExtRAM-to-ExtRAM transfers are not supported when enabled.</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCSCPCTRL</name>
            <description>EDC SCP CTRL</description>
            <addressOffset>0xC18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EDCSCPKICK</name>
                <description>EDC_SCP_KICK[n]=1 causes update of SET_ADC_POWER/SET_SCP_POWER/NEW_ADC_POWER/NEW_SCP_POWER/INPUT_I/INPUT_Q registers within SCP[n] when SCP_CONTROL2[n].SCP_KICK_ENABLE=1.Register auto-clears.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCDCPBASEADDR</name>
            <description>EDC DCP BASE ADDR</description>
            <addressOffset>0xC1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DCPBASEADDR</name>
                <description>Base address of combined DCP code image (for use by debugger).</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANRXCTRL</name>
            <description>EDC PERIP WLAN RX CTRL</description>
            <addressOffset>0xC20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXFINAL</name>
                <description>Set to flag last Rx Job before posting final SCP input transfer.Must be cleared following completion of SCP input job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>WLANTXCTRL</name>
            <description>EDC PERIP WLAN TX CTRL</description>
            <addressOffset>0xC24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANTXFINAL</name>
                <description>Set to flag last Tx Job before posting final TX-SCP output transfer.Must be cleared following completion of TX-SCP output job.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS0</name>
            <description>EDC PERIP MEM ADDR MSBS0</description>
            <addressOffset>0xC2C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID0ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 0 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS1</name>
            <description>EDC PERIP MEM ADDR MSBS1</description>
            <addressOffset>0xC30</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID1ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 1 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS2</name>
            <description>EDC PERIP MEM ADDR MSBS2</description>
            <addressOffset>0xC34</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID2ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 2 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBS3</name>
            <description>EDC PERIP MEM ADDR MSBS3</description>
            <addressOffset>0xC38</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID3ADDRMSBS</name>
                <description>Defines bits 37:23 of ExtRAM request ID 3 word address (bits 39:25 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBSEXT0</name>
            <description>EDC PERIP MEM ADDR MSBS EXT0</description>
            <addressOffset>0xC3C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID0ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 0 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBSEXT1</name>
            <description>EDC PERIP MEM ADDR MSBS EXT1</description>
            <addressOffset>0xC40</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID1ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 1 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBSEXT2</name>
            <description>EDC PERIP MEM ADDR MSBS EXT2</description>
            <addressOffset>0xC44</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID2ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 2 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MEMADDRMSBSEXT3</name>
            <description>EDC PERIP MEM ADDR MSBS EXT3</description>
            <addressOffset>0xC48</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID3ADDRMSBSEXT</name>
                <description>Defines bits 61:38 of ExtRAM request ID 3 word address (bits 63:40 of the byte address).Note if greater than 64MBytes ExtRAM supported, MA[23] must be set to 0 and the lsb of this register used instead.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x40</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>JOB0[%s]</name>
            <description>Description collection: EDC PERIP JOB0</description>
            <addressOffset>0xD00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EXTRAMID</name>
                <description>ExtRAM request ID used for ExtRAM transfers on this channel.Note: DCP uses ID of 0 for instruction fetch and loads/stores.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>FORCEFLEXIBLEAGEN</name>
                <description>Note: if EDC_SYS_CONFIGURATION_STATUS[0] = '0', this register is notpresent.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DoNotUseFlexibleAddr</name>
                    <description>Do not use flexible address generator when linear mode is configured.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ForceUsageOfFlexible</name>
                    <description>Force usage of flexible address generator (over linear address generator) even if linear mode is configured.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETINCR</name>
                <description>Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AdvanceOffsetEveryGr</name>
                    <description>Advance offset every GRAM access.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery2G</name>
                    <description>Advance offset every 2 GRAM accesses.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery4G</name>
                    <description>Advance offset every 4 GRAM accesses.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdvanceOffsetEvery8G</name>
                    <description>Advance offset every 8 GRAM accesses.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETADD</name>
                <description>0: Disable addition of offsets to GRAM addresses.1: Enable addition of offsets to GRAM addresses.Notes:1. This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.2. Only ITEM_BYTES = '10' is supported.3. Modulo wrap of item index is not supported.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>OFFSETDELTA</name>
                <description>Defines the delta to be added to MA in case of GRAM accesses with OFFSET_ADD = 1 and OFFSET_INCR &amp;gt; 0.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[1] = '1'.</description>
                <lsb>7</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>HOLDOFFSAT</name>
                <description>Indicates that the transfer hold-off FINE_RATE accumulator has saturated.Automatically cleared at start of next DMA job.</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>FLAGDONETIMING</name>
                <description>Note: Channel DISCARD_OP/PW/PALIGN settings cannot be changed safely following completion of a TBus write job when FLAG_DONE_EARLY=1 because these are used following the output buffer.</description>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FlagCompletionOfTbus</name>
                    <description>Flag completion of TBus write job on output to peripheral.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FlagCompletionOfTbus1</name>
                    <description>Flag completion of TBus write job on write to output buffer, providing additional time to configure subsequent jobs for realtime output peripherals (e.g. DAC, TSO).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FlagCompletionOfTran</name>
                    <description>Flag completion of transfer to ExtRAM/GRAM/PBus/SysBus only once final store has reached destination.This could impact performance.Not supported for write to EDC channel or write to TBus transfer modes (TFR_MODE=001,011,110 or TFR_MODE=000,101,111 &amp;amp;&amp;amp; PER_BUS=0).</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETLUTADDR</name>
            <description>EDC OFFSET LUT ADDR</description>
            <addressOffset>0xE00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFFSETLUTADDR</name>
                <description>Offset lookup table address. Automatically incremented when all the entries (number of entries per location = GRAM_REQS-1) at the same address have been written.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETLUTDATA</name>
            <description>EDC OFFSET LUT DATA</description>
            <addressOffset>0xE04</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFFSETLUTDATA</name>
                <description>Offset lookup table value to be written into the offset LUT.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTADDR</name>
            <description>EDC OFFSET ADJ LUT ADDR</description>
            <addressOffset>0xE08</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFFSETADJLUTADDR</name>
                <description>Offset adjustment lookup table address. Automatically incremented.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTDATA</name>
            <description>EDC OFFSET ADJ LUT DATA</description>
            <addressOffset>0xE0C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFFSETADJLUTDATA</name>
                <description>Offset adjustment lookup table value to be written into the offset adjustment LUT.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>EDCOFFSETADJLUTCTRL</name>
            <description>EDC OFFSET ADJ LUT CTRL</description>
            <addressOffset>0xE10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>OFFSETADJENABLE</name>
                <description>Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DisableAdditionOfOff</name>
                    <description>Disable addition of offset adjustments to GRAM addresses.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EnableAdditionOfOffs</name>
                    <description>Enable addition of offset adjustments to GRAM addresses.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OFFSETADJCHANNEL</name>
                <description>Select which EDC channel the offset adjustments are applied to.Note: Selected EDC channel must be configured for offset addressing OFFSET_ADD=1.</description>
                <lsb>4</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>OFFSETADJMULFACTOR</name>
                <description>Defines the multiplication factor used for the offset adjustments.Note: This feature can be used only if EDC_SYS_CONFIGURATION_STATUS[2] = '1'.</description>
                <lsb>12</lsb>
                <msb>21</msb>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x4</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>L4CHECKSUMCTRL[%s]</name>
            <description>Description collection: EDC PERIP L4 CHECKSUM CTRL</description>
            <addressOffset>0xE40</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>L4CSUMBLOCKENABLE</name>
                <description>Enable signal for L4 checksum block:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumBlockDisab</name>
                    <description>L4 checksum block disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L3ChecksumBlockEnabl</name>
                    <description>L3 checksum block enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L3CSUMENABLE</name>
                <description>Enable signal for L3 checksum calculation in case of IPV4 ethernet type:</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L3ChecksumCalculatio</name>
                    <description>L3 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L3ChecksumCalculatio1</name>
                    <description>L3 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV4TCPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV4 ethernet type and TCP protocol:</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV4UDPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV4 ethernet type and UDP protocol:</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV6TCPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV6 ethernet type and TCP protocol:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV6UDPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV6 ethernet type and UDP protocol:</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CSUMOP</name>
                <description>L4 checksum operation:0:TX operation. L3 and L4 checksums are calculated,1:RX operation. L3 and L4 checksums are calculated and compared with thecorresponding received checksum values.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>MACHEADERLENGTH</name>
                <description>MAC header length in bytes.This is the number of bytes at the start of packet that are skipped and notincluded in the L4 checksum calulation.Note: only even values for MAC header lengths are supported.</description>
                <lsb>7</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>EDCCHANNELSELECT</name>
                <description>EDC channel select.Selects the EDC channel connected to L4 checksum instance.</description>
                <lsb>15</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>L4CSUMIPV6ICMPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV6 ethernet type and ICMP protocol:</description>
                <lsb>21</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>L4CSUMIPV4ICMPENABLE</name>
                <description>Enable signal for L4 checksum calculation in case of IPV4 ethernet type and ICMP protocol:</description>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio</name>
                    <description>L4 checksum calculation disabled,</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>L4ChecksumCalculatio1</name>
                    <description>L4 checksum calculation enabled.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <cluster>
            <dim>4</dim>
            <dimIncrement>0x00C</dimIncrement>
            <name>EDCPERIPL4CHECKSUMSTATUS[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDC_PERIP_EDCPERIPL4CHECKSUMSTATUS</headerStructName>
            <access>read-write</access>
            <addressOffset>0xE50</addressOffset>
            <register>
              <name>L3CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L3 CHECKSUM TX</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L3CHECKSUMTX</name>
                  <description>Calculated L3 checksum.Note: L3 checksum is calculated only for IPV4 ethernet type.This register will hold calculated L3 checksum value for both operations TX and RX andit will be cleared at the start of every new packet.Note: This field should be read once the TX_CHECKSUM_VALID flag is asserted in TX operation.In RX operation this value can be used for debug and checked after RX_CHECKSUM_VALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3CHECKSUMTXOFFSET</name>
                  <description>L3 checksum TX offset.This field gives the information on offset of L3 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>20</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTX</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x0000FFFF</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L4CHECKSUMTX</name>
                  <description>Calculated L4 checksum.This field will hold calculated L4 checksum value for both operations TX and RXand it will be cleared at the start of every new packet.Note: This field should be read once the TX_CHECKSUM_VALID flag is asserted in TX operation.In RX operation this value can be used for debug and checked after RX_CHECKSUM_VALID flag assertion.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L4CHECKSUMTXOFFSET</name>
                  <description>L4 checksum TX offset.This field gives the information on offset of L4 checksum within the packet.</description>
                  <lsb>16</lsb>
                  <msb>22</msb>
                </field>
                <field>
                  <name>TXCHECKSUMVALID</name>
                  <description>TX checksum valid flag.This bit gets set once the L4 checksum calculation for TX operation is completedand it will be cleared at the start of every new packet.</description>
                  <lsb>23</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMTXRXSTATUS</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM TX RX STATUS</description>
              <addressOffset>0x008</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>RXCHECKSUMSTATUS</name>
                  <description>RX checksum status flag.Note: This bit should be checked once the RX_CHECKSUM_VALID flag is asserted.It will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>FailCalculatedL4Che</name>
                      <description>FAIL - Calculated L4 checksum and L4 checksum extracted from packet header are mismatching,</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PassCalculatedL4Che</name>
                      <description>PASS - Calculated L4 checksum and L4 checksum extracted from packet header are matching.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CHECKSUMINFO</name>
                  <description>TX_RX checksum info flag.Note: This bit is used for both TX and RX operation.It will be cleared at the start of every new packet.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>CalculationOfL4Check</name>
                      <description>Calculation of L4 checksum was skipped,</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>L4ChecksumCalculated</name>
                      <description>L4 checksum calculated and was not skipped.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>RXCHECKSUMVALID</name>
                  <description>RX checksum valid flag.This bit gets set once the L4 checksum calculation for RX operation is completedand L4 checksum status is ready. It will be cleared at the start of every new packet.</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <dim>4</dim>
            <dimIncrement>0x010</dimIncrement>
            <name>EDCPERIPL4CHECKSUMDEBUG[%s]</name>
            <description>Unspecified</description>
            <headerStructName>RPUPBUS_EDC_PERIP_EDCPERIPL4CHECKSUMDEBUG</headerStructName>
            <access>read-write</access>
            <addressOffset>0xE90</addressOffset>
            <register>
              <name>L4CHECKSUMDEBUG0</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM DEBUG0</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L3HDRCHECKSUM</name>
                  <description>L3 checksum extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMDEBUG1</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM DEBUG1</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L4HDRCHECKSUM</name>
                  <description>L4 checksum extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMDEBUG2</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM DEBUG2</description>
              <addressOffset>0x008</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ETHERNETTYPE</name>
                  <description>Ethernet type information extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3HDRVERSION</name>
                  <description>Protocol Version extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>16</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>L3HDRLENGTH</name>
                  <description>Length of the IP header in 32 bit words extracted from the packet.For example value 5 means 5*4 = 20 bytes.This field will be cleared at the start of every new packet.</description>
                  <lsb>20</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>L4CHECKSUMDEBUG3</name>
              <description>Description cluster: EDC PERIP L4 CHECKSUM DEBUG3</description>
              <addressOffset>0x00C</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>L3HDRTOTALLENGTH</name>
                  <description>Total length of packet in bytes extracted from the packet.Note: In case of IPV4 ethernet type this field is the sum of the IP header lengthL3_HDR_LENGTH and the IP payload length.In case of IPV6 ethernet type this field represents the IP payload length only.This field will be cleared at the start of every new packet.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>L3HDRPROTOCOL</name>
                  <description>Transport layer protocol information extracted from the packet.This field will be cleared at the start of every new packet.</description>
                  <lsb>16</lsb>
                  <msb>23</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
