          <register>
            <name>OFDMCONFIG2</name>
            <description>WLAN FFT OFDM CONFIG 2</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PACKETTYPE</name>
                <description>Selects packet type:0 : Legacy1 : HT-MF2 : HT-GF3 : VHT4 : HE-SU5 : HE-MU6 : HE-ER7 : HE-TBPackets 0-3 (Legacy, HT_MF, HT_GF, VHT) are in Pre-HE group with OFDM symbol length of 3.2us.HE packet has 12.8us OFDM symbol length.NOTE: Whenever packet_type is configured the initial state of scrambler will be set accordingly.Scrambler is used within CPE block to generate PN sequence for pilot sign generation. PN sequencehas 127 elements and cyclically repeats after 127 OFDM symbols.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>HEMUPPDUSIGBW</name>
                <description>Operating BW of the BSS (Basic Service Set):NOTE: only used for HE-MU packets</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>20Mhz</name>
                    <description>20 MHz</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>40Mhz</name>
                    <description>40 MHz</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80Mhz</name>
                    <description>80 MHz</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PPDU20MHZOFFSET</name>
                <description>Selects the 20MHz partition of the PPDU bandwidth (up to 80 MHz supported):0-1: when BSS operating bandwidth is 40 MHz0-3: when BSS operating bandwidth is 80 MHzNOTE: only used when HE-MU packet and HEMU_PPDU_SIGBW &amp;gt;= 40 MHz</description>
                <lsb>6</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>RESOURCEUNIT</name>
                <description>Used to determine the positions of pilot and null sub-carriers.Valid range of values for SIGNAL_BANDWIDTH = 20 MHz are [0-8, 37-40, 53-54, 61].Valid range of values for SIGNAL_BANDWIDTH = 40 MHz are [0-17, 37-44, 53-56, 61-62, 65].Only applicable for HE packets.(SIGNAL_BANDWIDTH in WLAN_FFT_OFDM_CONFIG register)</description>
                <lsb>8</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>PEDURATION</name>
                <description>Duration of Packet Extension in microseconds. Only applicable for HE packets.</description>
                <lsb>15</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>ROTATIONMODE</name>
                <lsb>20</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoRotation</name>
                    <description>No rotation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto</name>
                    <description>Rotation by gamma factor for 40MHz signal bandwidth</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RotationByGammaFacto2</name>
                    <description>Rotation by gamma factor for 80MHz signal bandwidth</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DUPLICATIONMODE</name>
                <lsb>22</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoDuplication</name>
                    <description>No duplication</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OfdmSymbolDuplicated</name>
                    <description>OFDM symbol duplicated prior to IFFT</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
