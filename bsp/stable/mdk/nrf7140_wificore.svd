              <lsb>2</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Priority inversion, when AXI flush is finished, HW gets priority until HW flush is done.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Priority inversion disabled, AXI always has priority over HW.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKON</name>
              <description>Provides override control for architectural clock gate enable.</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <enumeratedValues>
