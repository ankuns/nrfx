                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Claimed</name>
                  <description>Claim tag bit 0 is set</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>Unclaim</name>
                  <description>Clear bit 0 of the claim tag</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLR_1</name>
              <description>Determines whether claim bit 1 is implemented</description>
              <lsb>1</lsb>
              <msb>1</msb>
