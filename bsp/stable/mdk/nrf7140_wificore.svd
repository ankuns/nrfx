              <lsb>0</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>DW</name>
              <description>Triggers a write to MRAMC macro on the ready next timeout in direct write mode
                  (CONFIG.WEN = 2) and 
                  some data written into the internal write buffer.</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>No write trigger</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Write trigger</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
