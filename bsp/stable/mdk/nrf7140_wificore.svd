                  <enumeratedValue>
                    <name>OutputOfdmData</name>
                    <description>Output OFDM data</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGMCS</name>
                <description>MCSLegacy-0: BPSK rate 1/2Legacy-1: BPSK rate 3/4Legacy-2: QPSK rate 1/2Legacy-3: QPSK rate 3/4Legacy-4: 16-QAM rate 1/2Legacy-5: 16-QAM rate 3/4Legacy-6: 64-QAM rate 2/3Legacy-7: 64-QAM rate 3/4HT-0: BPSK rate 1/2HT-1: QPSK rate 1/2HT-2: QPSK rate 3/4HT-3: 16-QAM rate 1/2HT-4: 16-QAM rate 3/4HT-5: 64-QAM rate 2/3HT-6: 64-QAM rate 3/4HT-7: 64-QAM rate 5/6VHT-0: BPSK rate 1/2VHT-1: QPSK rate 1/2VHT-2: QPSK rate 3/4VHT-3: 16-QAM rate 1/2VHT-4: 16-QAM rate 3/4VHT-5: 64-QAM rate 2/3VHT-6: 64-QAM rate 3/4VHT-7: 64-QAM rate 5/6VHT-8: 256-QAM rate 3/4VHT-9: 256-QAM rate 5/6HE-0: BPSK rate 1/2HE-1: QPSK rate 1/2HE-2: QPSK rate 3/4HE-3: 16-QAM rate 1/2HE-4: 16-QAM rate 3/4HE-5: 64-QAM rate 2/3HE-6: 64-QAM rate 3/4HE-7: 64-QAM rate 5/6HE-8: 256-QAM rate 3/4HE-9: 256-QAM rate 5/6HE-10: 1024-QAM rate 3/4HE-11: 1024-QAM rate 5/6</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGFECTYPE</name>
                <description>FEC type</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Bcc</name>
                    <description>BCC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ldpc</name>
                    <description>LDPC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGSTBC</name>
                <description>STBC mode</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>StbcModeDisabled</name>
                    <description>STBC mode disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StbcModeEnabled</name>
                    <description>STBC mode enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
