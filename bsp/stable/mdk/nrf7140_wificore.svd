                  </enumeratedValues>
                </field>
                <field>
                  <name>VoltageLevel</name>
                  <description>Enable voltage level detectors (VDETs) on supply lines. An automatic system reset is issued when voltage on the corresponding supply line is too low.</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable voltage level detectors.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable voltage level detectors.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
