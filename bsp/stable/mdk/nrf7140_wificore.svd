              </field>
              <field>
                <name>WLANRXPAUTOCONFIGDCM</name>
                <description>Dual carrier modulation</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DcmDisabled</name>
                    <description>DCM disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DcmEnabled</name>
                    <description>DCM enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGDECOFDM</name>
                <description>Decode OFDM data (output MUX selection)</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OutputDsss11BData</name>
                    <description>Output DSSS (11b) data</description>
                    <value>0x0</value>
