                  <lsb>16</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>RSVDSPICTRLR12031</name>
                  <lsb>20</lsb>
                  <msb>31</msb>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>SPITECR</name>
              <description>SPI Transmit Error Interrupt Clear Register</description>
              <addressOffset>0x01C</addressOffset>
