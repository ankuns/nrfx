                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DLOUTEN</name>
                    <description>DelayLine outputs on PAD enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
