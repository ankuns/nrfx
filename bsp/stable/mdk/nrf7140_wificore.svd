            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRTMTDSCOCCUPANCYLEVEL</name>
                <description>Sub-carriers occupancy level:0: High : &amp;gt;= 81.25 percent of sub-carriers in a OFDM symbol are used1: Mid: &amp;gt;= 20.3125 percent of sub-carriers in a OFDM symbol are used2: Low: &amp;lt;20.3125 percent of sub-carriersin a OFDM symbolare usedConsidered valid if WLAN_RTM_TD_CONTROL_VALID is 3.Note: default value set when software reset</description>
                <lsb>0</lsb>
                <msb>1</msb>
