    <peripheral>
      <name>GLOBAL_DISPC</name>
      <description>DISPC</description>
      <baseAddress>0x49004000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DISPC_0</name>
        <value>112</value>
      </interrupt>
      <interrupt>
        <name>DISPC_1</name>
        <value>113</value>
      </interrupt>
      <interrupt>
        <name>DISPC_2</name>
        <value>114</value>
      </interrupt>
      <groupName>DISPC</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>EVENTS_CORE</name>
