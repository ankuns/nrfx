          <register>
            <name>VIDVFPLINESACT</name>
            <description>Holds the value that controller is using for VID_VFP_LINES.</description>
            <addressOffset>0x15C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VFPLINES</name>
                <description>This field specifies the Vertical Front Porch period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
                <access>read-only</access>
