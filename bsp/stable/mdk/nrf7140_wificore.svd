                <lsb>8</lsb>
                <msb>19</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONTROL2</name>
            <description>SCP CONTROL2</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SCPKICKENABLE</name>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WritesToSetAdcPowe</name>
                    <description>Writes to SET_ADC_POWER/SET_SCP_POWER/NEW_ADC_POWER/NEW_SCP_POWER/INPUT_I/INPUT_Q registers not deferred until kick received from EDC_SCP_KICK register to synchroniser update of these registers to multiple SCPs.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WritesToSetAdcPowe1</name>
                    <description>Writes to SET_ADC_POWER/SET_SCP_POWER/NEW_ADC_POWER/NEW_SCP_POWER/INPUT_I/INPUT_Q registers deferred until kick received from EDC_SCP_KICK register to synchroniser update of these registers to multiple SCPs.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANEDAGCSTART</name>
                <description>Note: In mode 1 the input data rate to the SCP must be greater than or equal to the output data rate.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ScpNotUsedForProcess</name>
                    <description>SCP not used for processing Wi-Fi samples. No hold off provided to synchronize output samples with ADC input, DMA output enabled at start of frame.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ScpUsedForProcessing</name>
                    <description>SCP used for processing Wi-Fi samples. Provides hold off to synchronize output samples with ADC input, DMA output enabled by agc_done signal from Wi-Fi AGC.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
