              </field>
            </fields>
          </register>
          <register>
            <name>PCFCOEFF13</name>
            <description>TXSCP PCF COEFF13</description>
            <addressOffset>0x3F4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF24</name>
                <description>Filter Coefficient 24 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>PCFCOEFF25</name>
                <description>Filter Coefficient 25 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>12</lsb>
                <msb>23</msb>
