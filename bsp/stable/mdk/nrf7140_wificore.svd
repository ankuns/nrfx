                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTSEQFRAMEFATAL</name>
                <description>Status of int_st_seq_frame_fatal.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTCRCFRAMEFATAL</name>
                <description>Status of int_st_crc_frame_fatal.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTPLDCRCFATAL</name>
                <description>Status of int_st_pld_crc_fatal.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTDATAID</name>
                <description>Status of int_st_data_id.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTECCCORRECTED</name>
                <description>Status of int_st_ecc_corrected.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>STATUSINTSTPHY</name>
                <description>Status of int_st_phy.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYSHUTDOWNZ</name>
            <description>Controls the PHY Shutdown mode. In this state, the PHY sets the analog and digital circuitry in the Reset state.</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYSHUTDOWNZ</name>
                <description>Shutdown input. This line is used to place the complete macro in power down. All analog blocks are in power down mode and digital logic is cleared. Active Low.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPHYRSTZ</name>
            <description>Controls the PHY Reset mode. In this state, the PHY sets the digital circuitry in the Reset State.</description>
            <addressOffset>0x044</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DPHYRSTZ</name>
                <description>PHY reset output. Active Low.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYRX</name>
