            <size>0x20</size>
            <fields>
              <field>
                <name>PHYSTOPSTATEDATA0</name>
                <description>Data lane 0 in Stop state.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYSTOPSTATEDATA1</name>
