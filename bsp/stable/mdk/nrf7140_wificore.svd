                    <value>0x00</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VER200</name>
                    <description>SD Host Controller Specification Version 2.00</description>
                    <value>0x01</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VER300</name>
                    <description>SD Host Controller Specification Version 3.00</description>
                    <value>0x02</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VER400</name>
                    <description>SD Host Controller Specification Version 4.00</description>
                    <value>0x03</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VER410</name>
                    <description>SD Host Controller Specification Version 4.10</description>
                    <value>0x04</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VER420</name>
                    <description>SD Host Controller Specification Version 4.20</description>
                    <value>0x05</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VENDORVERSIONNUM</name>
                <description>Vendor Version Number</description>
                <lsb>8</lsb>
                <msb>15</msb>
