            <addressOffset>0xC8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00125255</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANFFTDYNAMICGAINSHIFTHIGH</name>
                <description>FFT gain configuration (shift values) when WLAN_FFT_DYNAMIC_GAIN is set and SC occupancy is High</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANFFTDYNAMICGAINSHIFTMID</name>
                <description>FFT gain configuration (shift values) when WLAN_FFT_DYNAMIC_GAIN is set and SC occupancy is Mid</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANFFTDYNAMICGAINSHIFTLOW</name>
                <description>FFT gain configuration (shift values) when WLAN_FFT_DYNAMIC_GAIN is set and SC occupancy is Low</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
