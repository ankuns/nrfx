          </register>
          <register>
            <name>AUTOCONFIG1</name>
            <description>WLAN RXP AUTO CONFIG 1</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPAUTOCONFIGMIMOSYMBOLSINT</name>
                <description>Number of OFDM symbols for which the channel matrices are valid for the MIMO decoder. When this register is set to zero, the channel matrices will never be invalidated.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGHESIGAMODE</name>
                <description>Determines the state of HE-SIGA decoding, used in the LLR combining process</description>
                <lsb>10</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HeSuDefaultStateA</name>
                    <description>HE-SU - Default state, assumes packet is HE-SU (or any non-HE packet), but may be determined as non HE-SU after decoding LSIG</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>XIntermediateStateB</name>
                    <description>X - Intermediate state before determining packet is either HE-MU or HE-ER</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeMuPacketDetermin</name>
                    <description>HE-MU - Packet determined as HE-MU</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeErPacketDetermin</name>
                    <description>HE-ER - Packet determined as HE-ER</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGHEMUEXTRALDPC</name>
                <description>Force LDPC extra segment flag for decoder configuration for HE-MU packet decoding.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGHESIGBMODE</name>
                <description>Indicates if HE-SIG-B is being decoded and its format:</description>
                <lsb>13</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NormalVhtPacket</name>
                    <description>Normal VHT packet</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBUncompressed</name>
                    <description>HE-SIG-B uncompressed 20/40 MHz ppduBW (18-bit common field, 52-bit User block field)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBUncompressed2</name>
                    <description>HE-SIG-B uncompressed 80 MHz ppduBw (27-bit common field,52-bit User block field)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeSigBCompressedN</name>
                    <description>HE-SIG-B compressed (no common field, 52-bit User block field)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>AUTOCONFIG2</name>
            <description>WLAN RXP AUTO CONFIG 2</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
