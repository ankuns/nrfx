                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYRXULPSCLKNOT</name>
                <description>Active Low. This signal indicates that D-PHY Clock Lane module has entered the Ultra Low Power state</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYRXCLKACTIVEHS</name>
