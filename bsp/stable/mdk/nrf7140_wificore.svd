                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SHORTENEDBITS</name>
            <description>WLAN LDPC DECODER SHORTENED BITS</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANLDPCDECODERSHORTENEDBITS</name>
                <description>Number of shortened bits per codeword.Calculated as floor(N_shrt/N_CW).</description>
                <lsb>0</lsb>
                <msb>10</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PUNCTUREDBITS</name>
