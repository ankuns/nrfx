        </cluster>
        <cluster>
          <name>WLAN_BIT_DEINT</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_BIT_DEINT</headerStructName>
          <access>read-write</access>
          <addressOffset>0x12000</addressOffset>
          <register>
            <name>CONFIG00</name>
            <description>WLAN BIT DEINT CONFIG 00</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGMODULATION</name>
                <description>Specify the modulation of the LLR data being processed by the Wireless LAN Bit Deinterleaver.Valid values are below.Other values are reserved and should not be used.</description>
                <lsb>0</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BpskConstellationSi</name>
                    <description>BPSK (Constellation size M = 2) (Nbpsc = 1, 1 LLRper data word)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>QpskConstellationSi</name>
                    <description>QPSK (Constellation size M = 4) (Nbpsc = 2, 1 LLRper data word)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16QamConstellation</name>
                    <description>16-QAM (Constellation size M =16) (Nbpsc = 4, 2 LLRs per data word)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>64QamConstellation</name>
                    <description>64-QAM (Constellation size M =64) (Nbpsc = 6, 3 LLRs per data word)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>256QamConstellatio</name>
                    <description>256-QAM (Constellation size M = 256) (Nbpsc = 8, 4 LLRs per data word)</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG01</name>
            <description>WLAN BIT DEINT CONFIG 01</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNROWS</name>
                <description>Specifies the number of active Rows the Bit Deinterleaver should use when processing LLR data.Note that each element in a row contains 4 sub-elements, where each sub-element holds one LLR.The number of LLRs stored in a Row element varies based on the modulation scheme in use.Valid values are below.Other values are reserved and should not be used.Legacy: 3 (BPSK) or6 (non-BPSK)HT/VHT 20 MHz:4 (BPSK) or8 (non-BPSK)HT/VHT 40 MHz:6 (BPSK) or 12 (non-BPSK)VHT80 MHz:9 (BPSK) or 18 (non-BPSK)</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG02</name>
            <description>WLAN BIT DEINT CONFIG 02</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNCOLS</name>
                <description>Specifies the number of active Columns the Bit Deinterleaver should use when processing LLR data.Valid values are below.Other values are reserved and should not be used.Legacy: 16HT/VHT 20 MHz:13HT/VHT 40 MHz:18VHT80 MHz:26Note that the maximum number of columns is 18 when BUILD_WLAN_AC = 0.</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG03</name>
            <description>WLAN BIT DEINT CONFIG 03</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGINIROWOFFSET</name>
                <description>Initial Row Offset.This is the row in which the first element of LLRs are written.Note that a Row is made up of elements, each of which holds four sub-elements capable of storing one LLR.Note 1. CONFIG_INI_ROW_OFFSET has the range 0 to CONFIG_N_ROWS-1Note 2. If the value in this register is non-zero then registers CONFIG_INI_WRITE_POINTER and CONFIG_INI_ROW_SWAP_TYPE should be configured appropriately.Note 3. The value in this register is derived from the Row Offset equation, see section 2.4.1 (Bit Deinterleaver Stage one (Frequency rotation)) for the RowOffset formula.Where Row Offset in this register is the value from the RowOffset equation divided by S.Note 4. S defines the number of LLRs stored in each element of the BDI buffer grid for the current modulation scheme.S is defined as: S=Max((log2(M)/2),1) or S=Max(Nbpsc/2),1)Where M (Constellation size) and Nbpsc are defined in the description for register CONFIG_MODULATION</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG04</name>
            <description>WLAN BIT DEINT CONFIG 04</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGINICOLOFFSET</name>
                <description>Initial Column index.This is the column in which the first LLR is written.Note that a column is made up of elements, each of which holds four sub-elements capable of storing one LLR.Note 1. CONFIG_INI_COL_OFFSET has the range 0 to CONFIG_N_COLS-1.Note 2. If the value in this register is non-zero then registers CONFIG_INI_WRITE_POINTER and CONFIG_INI_ROW_SWAP_TYPE should be configured appropriately.</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG05</name>
            <description>WLAN BIT DEINT CONFIG 05</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGBUFFERSIZE</name>
                <description>This register specifies the number of buffer storage elements required for the Bit Deinterleaver operation.Note that an element consists of four sub-elements each capable of storing one LLR.It is defined as CONFIG_N_ROWS multiplied by CONFIG_N_COLS.The value in this register is ONLY valid when it is derived from valid values in CONFIG_N_ROWS and CONFIG_N_COLS.Other values are not valid and must not be used.When register CONFIG_USE_AS_BUFFER = 1 the usage of this register is relaxed - this is described further in the description of register CONFIG_USE_AS_BUFFER.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG06</name>
            <description>WLAN BIT DEINT CONFIG 06</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGINIWRITEPOINTER</name>
                <description>This register specifies the initial value of the write pointer for writing the first element of LLR data into the write buffer.The value in this register is calculated as follows:((CONFIG_INI_ROW_OFFSET * CONFIG_N_COLS) + CONFIG_INI_COL_OFFSET)Note 1. Check the descriptions of CONFIG_INI_ROW_OFFSET and CONFIG_INI_COL_OFFSET for further notes on the values in these registers.Note 2. Note that row swapping may be required by the data being written into the elements of the write buffer.This row swapping is performed by the logic in the Bit Deinterleaver and does not need to be accounted for in this register, since this register defines the first write element, and not the organisation of the LLR data within that element.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG07</name>
            <description>WLAN BIT DEINT CONFIG 07</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGINIROWSWAPTYPE</name>
                <description>This register is used to specify the row swapping type in use in the column CONFIG_INI_COL_OFFSET.It is only used when the modulation, set in register CONFIG_MODULATION, is set to a modulation scheme that requires row swapping - i.e. not BPSK (Nbpsc = 1) or QPSK (Nbpsc = 2).The value in this register is calculated as follows:For16-QAM (Nbpsc = 4): CONFIG_INI_COL_OFFSET percent2i.e. 0x0 when CONFIG_INI_COL_OFFSET is an even number0x1 when CONFIG_INI_COL_OFFSET is an odd numberFor64-QAM (Nbpsc = 6): CONFIG_INI_COL_OFFSET percent3i.e. 0x0 when CONFIG_INI_COL_OFFSET is 0,3,6, 9,12,etc0x1 when CONFIG_INI_COL_OFFSET is 1,4,7,10,13,etc0x2 when CONFIG_INI_COL_OFFSET is 2,5,8,11,14,etcFor 256-QAM (Nbpsc = 8): CONFIG_INI_COL_OFFSET percent4i.e. 0x0 when CONFIG_INI_COL_OFFSET is 0,4, 8,12,etc0x1 when CONFIG_INI_COL_OFFSET is 1,5, 9,13,etc0x2 when CONFIG_INI_COL_OFFSET is 2,6,10,14,etc0x3 when CONFIG_INI_COL_OFFSET is 3,7,11,15,etc</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG08</name>
            <description>WLAN BIT DEINT CONFIG 08</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGUSEASBUFFER</name>
                <description>This register is used to set the Deinterleaver into a buffer only mode.0x0: Operate as normal Bit Deinterleaver0x1: Operate as a Simple FIFO Buffer onlyWhen the Simple FIFO Buffer mode is selected the Bit Deinterleaver does not perform the usual Deinterleaving, but operates only as a FIFO buffer where both the write pointer and the read pointer use a linear incrementing address scheme.In this mode only the CONFIG_BUFFER_SIZE and CONFIG_MODULATION configuration registers are valid.The register CONFIG_BUFFER_SIZE should be set to the value of the required buffer size (columns multiplied by rows).The register CONFIG_MODULATION should be set with the modulation scheme of the current stream; this is used to determine the number of active LLRs in each LLR data word so that unused bytes can be masked to zero.Other configuration registers must not be used and should be set to zero.In the Simple FIFO Buffer mode the restrictions on the use of register CONFIG_BUFFER_SIZE are relaxed.Any value may be used in CONFIG_BUFFER_SIZE providing the value does NOT exceed the number of words available in the RAM instances (216 words for 802.11n and 472 words for 802.11ac).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSOUTPUTMODE</name>
            <description>WLAN BIT DEINT TBUS OUTPUT MODE</description>
            <addressOffset>0xA0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TBUSOUTPUTDISCARD</name>
                <description>Set this register to '1' to discard the output from the T-Bus Read component that routes LLR data out from the Bit Deinterleaver to the T-Bus Port.This register will only discard output when register field TBUS_OUTPUT_MODE = 1 (i.e. when routing output LLR data to the P-Bus debug registers).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSOUTPUTSIGNATURE</name>
            <description>WLAN BIT DEINT TBUS OUTPUT SIGNATURE</description>
            <addressOffset>0xB8</addressOffset>
            <access>read-only</access>
            <resetValue>0x00FFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TBUSOUTPUTSIGNATURE</name>
                <description>This register outputs a data signature from the T-Bus Output port driver.It is used for debug only.Reading from this register has no consequence.Writing to this Read Only register has no effect.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SWRESET</name>
            <description>WLAN BIT DEINT SW RESET</description>
            <addressOffset>0xF0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SWRESET</name>
                <description>Wireless LAN Bit Deinterleaver, Software Reset register SW_RESETThis register provides a means for resetting all the logic in the Wireless LAN Bit Deinterleaver block.The register is sticky so any reset has to be cleared manually.In other words, any reset applied with this register will NOT automatically clear; it must be manually cleared by writing '0' to this register.This software reset register will reset all logic in the Wireless LAN Bit Deinterleaver including:i. T-Bus Write port (LLR Input data)ii.T-Bus Read port (LLR Output data)iii. The Wireless LAN Bit Deinterleaver processing core (and all blocks within the core)iv.Top level Random StallersIt WILL NOT reset the wlan_bit_deint_regwrap Register Block Wrapper which includes the generated Register Bank.If the wlan_bit_deint_regwrap needs to be reset then the entire Wireless LAN Bit Deinterleaver must be reset using the software reset control in the UCCP_CORE registers.Alternatively a hardware reset can be performed.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ClearBlockResetDefa</name>
                    <description>Clear block reset (default state)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PlaceAndHoldWholeBlo</name>
                    <description>Place and hold whole block in Reset.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>COREIDREG</name>
            <description>WLAN BIT DEINT CORE ID REG</description>
            <addressOffset>0xF8</addressOffset>
            <access>read-only</access>
            <resetValue>0x000F0900</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANBITDEINTCORECONFIGURATION</name>
                <description>Configuration of the core.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANBITDEINTCOREID</name>
                <description>Identifies the member of the IP group. [0x09 = Wireless LAN Bit Deinterleaver (WLAN_BIT_DEINT)]</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANBITDEINTGROUPID</name>
                <description>Identifies core as part of an IMG IP family group.[0x0F = UCC].</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COREREVISIONREG</name>
            <description>WLAN BIT DEINT CORE REVISION REG</description>
            <addressOffset>0xFC</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANBITDEINTMAINTENANCEREV</name>
                <description>Maintenance Release Revision</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANBITDEINTMINORREV</name>
                <description>Core Minor Release Revision</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANBITDEINTMAJORREV</name>
                <description>Family Major Release Revision</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_DEPARSER</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_DEPARSER</headerStructName>
          <access>read-write</access>
          <addressOffset>0x13000</addressOffset>
          <register>
            <name>CONFIG00</name>
            <description>WLAN DEPARSER CONFIG 00</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNUMSTREAMS</name>
                <description>The number of Input Streams that are active to process OFDM symbols for the current data stream configuration.Unsigned value with possible range of 0-7.Valid values are below:Note: The valid values above will be restricted if the Wireless LAN Stream Deparser has fewer than four Stream Input ports available.</description>
                <lsb>0</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OneStreamInputActive</name>
                    <description>One Stream Input active. Deparser will read input LLRs from Stream Input0 only.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TwoStreamInputsActiv</name>
                    <description>Two Stream Inputs active.Deparser will read input LLRs from Stream Inputs 0 and 1.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ThreeStreamInputsAct</name>
                    <description>Three Stream Inputs active.Deparser will read input LLRs from Stream Inputs 0, 1 and 2.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FourStreamInputsActi</name>
                    <description>Four Stream Inputs active. Deparser will read input LLRs from Stream Inputs 0, 1, 2 and 3.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve5</name>
                    <description>This is reserved.</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve6</name>
                    <description>This is reserved.</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve7</name>
                    <description>This is reserved.</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CONFIGNUMLLRSYMBFULL</name>
                <description>Number of LLRs per OFDM symbol.</description>
                <lsb>4</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG01</name>
            <description>WLAN DEPARSER CONFIG 01</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNUMDECODERS</name>
                <description>The number of Decoders that are needed to process OFDM symbols for the current data stream configuration.Unsigned value with possible range of 0-3.Valid values are below:Note: The valid values above will be restricted if the Wireless LAN Stream Deparser has fewer than two Decoder Output ports available.</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Reserve</name>
                    <description>This is reserved.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OneDecoderOutputActi</name>
                    <description>One Decoder output active.Output OFDM symbols to Decoder 0 output only.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TwoDecoderOutputsAct</name>
                    <description>Two Decoder outputs active.Output OFDM symbols to Decoder 0 and Decoder 1 outputs.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Reserve3</name>
                    <description>This is reserved.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CONFIGNUMLLRSYMBSHORT</name>
                <description>Number of LLRs per OFDM symbol : last symbol or last pair for STBC.</description>
                <lsb>4</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG02</name>
            <description>WLAN DEPARSER CONFIG 02</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNUMSUBCARRIERS</name>
                <description>The number of Sub Carriers that the Stream Deparser should process for each OFDM symbol of the current data stream configuration.Unsigned value with possible range of 0-511.The valid values for this register are the results of the formula below when derived using the valid values for each element of the formula.All other values are reserved and should not be used.The 32-bit inputs to the Stream Deparser carry up to 4 LLRs per clock, which varies according to the modulation scheme used by each Stream Input.When the Stream Deparser processes one sub-carrier (as defined by this register) it processes one 32-bit word of LLRs from the selected Stream Input.Thus this register defines the number of32-bit words that need to be processed on each Stream Input.This value is also used by the STBC Mux to detect OFDM symbol boundaries - which occur once the STBC mux has processed the number of 32-bit words defined by this register.The value written into this register is calculated using the following formula:(N_SC * Constellation factor) / N_ESWhere:N_SC is the number of Sub-Carriers in each OFDM symbol, i.e. 48, 52, 108 or 234N_ES is the number of Decoder outputs programmed in CONFIG_NUM_DECODERS, i.e. 1 or 2Constellation factor is 1 for BPSK modulation and 2 for non BPSK modulation schemesNote that if BPSK is selected on any Stream Input, other active Stream Inputs can only be set to BPSK modulation.Configuring the active Stream Inputs for a mix of BPSK and non-BPSK Modulation schemes is not valid.</description>
                <lsb>0</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG03</name>
            <description>WLAN DEPARSER CONFIG 03</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGNUMOFDMSYMBOLS</name>
                <description>Number of OFDM symbols to process.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG04</name>
            <description>WLAN DEPARSER CONFIG 04</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGSTREAM0CONSTELLATION</name>
                <description>This defines the Constellation in use on Stream 0 Input port for each Sub-Carrier.The value in this field represents the value Nbpsc/2 (with a minimum value of 1) for the Constellation type in use on this Stream Input.The valid values for this field are determined by the index below.All other values are reserved and should not be used.Note that if BPSK is selected on any Stream Input, other active Stream Inputs can only be set to BPSK modulation.Configuring the active Stream Inputs for a mix of BPSK and non-BPSK Modulation schemes is not valid.</description>
                <lsb>0</lsb>
                <msb>2</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Bpsk1LlrPerSubCarr</name>
                    <description>BPSK = 1 LLRper Sub-Carrier</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Qpsk1LlrPerSubCarr</name>
                    <description>QPSK = 1 LLRper Sub-Carrier</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Qam2LlrsPerSubC</name>
                    <description>16-QAM = 2 LLRs per Sub-Carrier</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>64Qam3LlrsPerSubC</name>
                    <description>64-QAM = 3 LLRs per Sub-Carrier</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>256Qam4LlrsPerSub</name>
                    <description>256-QAM = 4 LLRs per Sub-Carrier</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CONFIGSTREAM1CONSTELLATION</name>
                <description>This defines the Constellation in use on Stream 1 Input port for each Sub-Carrier.The programming convention for this field is the same as given for field CONFIG_STREAM_0_CONSTELLATION.</description>
                <lsb>8</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>CONFIGSTREAM2CONSTELLATION</name>
                <description>This defines the Constellation in use on Stream 2 Input port for each Sub-Carrier.The programming convention for this field is the same as given for field CONFIG_STREAM_0_CONSTELLATION.</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG05</name>
            <description>WLAN DEPARSER CONFIG 05</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGSTREAM3CONSTELLATION</name>
                <description>This defines the Constellation in use on Stream 3 Input port for each Sub-Carrier.The programming convention for this field is the same as given for field CONFIG_STREAM_0_CONSTELLATION.</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG08</name>
            <description>WLAN DEPARSER CONFIG 08</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGSTBCMODE</name>
                <description>This register is used to set the Deparser into STBC mode.0x0: Operate Stream Deparser in normal mode (with NO STBC muxing)0x1: Operate Stream Deparser with STBC muxing enabledIn this mode the STBC muxing is enabled in the Wireless LAN Stream Deparser.The way this mode operates is detailed fully in the Wireless LAN Stream Deparser TRM.When STBC mode is selected the registers CONFIG_STBC_LLRS_PER_OFDM_SYMBOL_[0/1] must be programmed according to the descriptions in those registers.Note 1. STBC Mode is only valid for the configurations below:CONFIG_NUM_STREAMS (Nss) = 1: Input data expected on Stream Inputs 0 and 1 (STBC Mux routes data to Deparser processing core Input 0)CONFIG_NUM_STREAMS (Nss) = 2: Input data expected on Stream Inputs 0, 1, 2, and 3 (STBC Mux routes data to Deparser processing core Inputs 0 and 1)Other values in CONFIG_NUM_STREAMS are not valid with STBC mode.Note 2. STBC Mode is only available when input generic N_SS (NUM_WIFI_SS) &amp;gt;= 2 (to support STBC when Nss=1)or input generic N_SS (NUM_WIFI_SS) &amp;gt;= 4 (to support STBC when Nss=[1|2])</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>CONFIGDCMDROPLASTSAMPLE</name>
                <description>Enable dropping last sample of each OFDM symbol when DCM is enabled, MCS is 0, BCC FEC type and 242 or 106 tone RU type is configured (53 to 64)</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>CONFIGDCMRUSIZEINDEX</name>
                <description>RU size used when CONFIG_DCM_DROP_LAST_SAMPLE is set.0x0: 106 tone0x1: 242 tone</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OUTPUTPACKERNUMLLRSLSBS</name>
            <description>WLAN DEPARSER OUTPUT PACKER NUM LLRS LSBS</description>
            <addressOffset>0x24</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGOUTPUTPACKERNUMLLRSLSBS</name>
                <description>Number of LLRs in the packet (24 LSBs).Used by the output packer to flush LLRs at the end of the packet.When zero, no flushing will be performed.</description>
                <lsb>0</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>OUTPUTPACKERNUMLLRSMSBS</name>
            <description>WLAN DEPARSER OUTPUT PACKER NUM LLRS MSBS</description>
            <addressOffset>0x28</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CONFIGOUTPUTPACKERNUMLLRSMSBS</name>
                <description>Number of LLRs in the packet (12 MSBs).Used by the output packer to flush LLRs at the end of the packet.When zero, no flushing will be performed.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>TBUSDATAPBUSDISCARD</name>
            <description>WLAN DEPARSER TBUS DATA PBUS DISCARD</description>
            <addressOffset>0xAC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TBUSDECODER0PBUSDISCARD</name>
                <description>Set this register to '1' to discard the output from the T-Bus Read component that routes data from the Decoder 0 Output to the T-Bus.This register will only discard output when register field TBUS_DECODER0_ROUTING = 1 (i.e. when routing to the P-Bus debug registers).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>TBUSDECODER1PBUSDISCARD</name>
                <description>Set this register to '1' to discard the output from the T-Bus Read component that routes data from the Decoder 1 Output to the T-Bus.This register will only discard output when register field TBUS_DECODER1_ROUTING = 1 (i.e. when routing to the P-Bus debug registers).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SWRESET</name>
            <description>WLAN DEPARSER SW RESET</description>
            <addressOffset>0x1F0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SWRESET</name>
                <description>Wireless LAN Stream Deparser, Software Reset register SW_RESETThis register provides a means for resetting all the logic in the Wireless LAN Stream Deparser block.The register is sticky so any reset has to be cleared manually.In other words, any reset applied with this register will NOT automatically clear; it must be manually cleared by writing '0' to this register.This software reset register will reset all logic in the Wireless LAN Stream Deparser including:i. T-Bus Write ports (input data to Stream Input Ports)ii.T-Bus Read ports (output data from Decoder Output Ports)iii. The Wireless LAN Stream Deparser processing coreiv.The STBC MultiplexerIt WILL NOT reset the wlan_deparser_regwrap Register Block Wrapper which contains the generated register bank.If the wlan_deparser_regwrap needs to be reset then the entire Wireless LAN Stream Deparser must be reset using the software reset control in the UCCP_CORE registers.Alternatively a hardware reset can be performed.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ClearBlockResetDefa</name>
                    <description>Clear block reset (default state)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PlaceAndHoldWholeBlo</name>
                    <description>Place and hold whole block in Reset.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>COREIDREG</name>
            <description>WLAN DEPARSER CORE ID REG</description>
            <addressOffset>0x1F8</addressOffset>
            <access>read-only</access>
            <resetValue>0x000F0800</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANDEPARSERCORECONFIGURATION</name>
                <description>Configuration of the core.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANDEPARSERCOREID</name>
                <description>Identifies the member of the IP group. [0x08 = Wireless LAN Stream Deparser (WLAN_DEPARSER)]</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANDEPARSERGROUPID</name>
                <description>Identifies core as part of an IMG IP family group.[0x0F = UCC].</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>COREREVISIONREG</name>
            <description>WLAN DEPARSER CORE REVISION REG</description>
            <addressOffset>0x1FC</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANDEPARSERMAINTENANCEREV</name>
                <description>Maintenance Release Revision</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>WLANDEPARSERMINORREV</name>
                <description>Core Minor Release Revision</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANDEPARSERMAJORREV</name>
                <description>Family Major Release Revision</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>WLAN_RXP</name>
          <description>Unspecified</description>
          <headerStructName>WIFIPHY_WLAN_RXP</headerStructName>
          <access>read-write</access>
          <addressOffset>0x14000</addressOffset>
          <register>
            <name>RESET</name>
            <description>WLAN RXP RESET</description>
            <addressOffset>0x0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPPULSEDSOFTWARERESET</name>
                <description>Self-clearing software reset.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRXPLATCHEDSOFTWARERESET</name>
                <description>Latched software reset.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRXPSTATSCOUNTERSRESET</name>
                <description>Self-clearing software reset for the statistics counters.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>WLAN RXP CONFIG</description>
            <addressOffset>0x4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00C00008</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPCONFIGUSERMTAILBITS</name>
                <description>Configure the removal of tail bits at the output of the Viterbi</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NeverRemoveTailBits</name>
                    <description>Never remove tail bits</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RemoveTailBitsAtTheO</name>
                    <description>Remove tail bits at the output of Viterbi during DATA decoding (cfg_dec_field = 0).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGBITDEINTERLEAVER1</name>
                <description>Configure bit de-interleaver for first spatial stream.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BypassBitDeInterlea</name>
                    <description>Bypass bit de-interleaver</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseBitDeInterleaver</name>
                    <description>Use bit de-interleaver</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGBITDEINTERLEAVER2</name>
                <description>Configure bit de-interleaver for second spatial stream.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BypassBitDeInterlea</name>
                    <description>Bypass bit de-interleaver</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseBitDeInterleaver</name>
                    <description>Use bit de-interleaver</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGBITDEINTERLEAVER3</name>
                <description>Configure bit de-interleaver for third spatial stream.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BypassBitDeInterlea</name>
                    <description>Bypass bit de-interleaver</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseBitDeInterleaver</name>
                    <description>Use bit de-interleaver</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGBITDEINTERLEAVER4</name>
                <description>Configure bit de-interleaver for fourth spatial stream.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BypassBitDeInterlea</name>
                    <description>Bypass bit de-interleaver</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseBitDeInterleaver</name>
                    <description>Use bit de-interleaver</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGSTREAMDEPARSEROUTPUT</name>
                <description>Route first stream deparser output stream to either TBus port or LDPC block formation unit.</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RouteOutputDataToTbu</name>
                    <description>Route output data to TBus port</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RouteOutputDataToLdp</name>
                    <description>Route output data to LDPC block formation unit</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGRXP11B</name>
                <description>Select 802.11b RX demodulator.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OfdmDemodulator</name>
                    <description>OFDM demodulator</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>80211BDemodulator</name>
                    <description>802.11b demodulator</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGMIMOCHANNELMATRIX</name>
                <description>Select MIMO decoder channel matrix TBus write port destination.</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MimoDecoder</name>
                    <description>MIMO decoder</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdpcDecoder</name>
                    <description>LDPC decoder</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGPHYOUTPUT</name>
                <description>Select PHY output.</description>
                <lsb>18</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ViterbiDecoder1Enco</name>
                    <description>Viterbi decoder (1 encoder stream, chain 1)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ViterbiDecoder1Enco1</name>
                    <description>Viterbi decoder (1 encoder stream, chain 2)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ViterbiDecoder2Enco</name>
                    <description>Viterbi decoder (2 encoder streams)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdpcDecoder</name>
                    <description>LDPC decoder</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGDESCRAMBLERENABLED</name>
                <description>Enable descrambler.</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BypassDescrambler</name>
                    <description>Bypass descrambler</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EnableDescrambler</name>
                    <description>Enable descrambler</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPDISABLEPHYRESET</name>
                <description>Disable automatic PHY reset.</description>
                <lsb>21</lsb>
                <msb>21</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PhyWillAutomatically</name>
                    <description>PHY will automatically reset</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PhyWillNotAutomatica</name>
                    <description>PHY will not automatically reset</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPRXVECTORENABLED</name>
                <description>Enable Rx-vector generation.</description>
                <lsb>22</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RxVectorNotGenerate</name>
                    <description>Rx-vector not generated</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RxVectorIsSentBefor</name>
                    <description>Rx-vector is sent before the decoded data</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCONFIGAUTOMATIC</name>
                <description>Enable automatic configuration of the RXP.</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ManualConfigurationM</name>
                    <description>Manual configuration mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AutomaticConfigurati</name>
                    <description>Automatic configuration mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>OFDMCONFIG</name>
            <description>WLAN RXP OFDM CONFIG</description>
            <addressOffset>0x8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPCPEFIELD</name>
                <description>Selects packet type:0: LSIG (L)1: LDATA (L)2: HTSIG (L)3: HTDATA (HT)4: VHTSIGA (L)5: VHTSIGB (HT)6: VHTDATA (VHT)7: RLSIG (L)8: HESIGA_SU (HT)9: HESIGA_X (HT)10 : HESIGA_ER (HT)11 : HESIGA_MU (HT)12 : HESIGB (VHT)13 : HEDATA_SU (HE)14 : HEDATA_ER (HE)15 : HEDATA_MU (HE)Packet types 0-3 (Legacy, HT_MF, HT_GF, VHT) are in Pre-HE group with OFDM symbol length of 3.2us.HE packet has 12.8us OFDM symbol length.NOTE: Whenever field is configured the initial state of scrambler will be set accordingly.Scrambler is used within CPE block to generate PN sequence for pilot sign generation. PN sequencehas 127 elements and cyclically repeats after 127 OFDM symbols.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>WLANRXPGUARDDURATION</name>
                <description>Specifies the guard duration to be inserted or removed:</description>
                <lsb>4</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>04Us</name>
                    <description>0.4us</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>08Us</name>
                    <description>0.8us</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>16Us</name>
                    <description>1.6us</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>32Us</name>
                    <description>3.2us</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCPECFOEST</name>
                <description>When set enables the CFO estimation based on the CPE.</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>WLANRXPCPESTBC</name>
                <description>Selects STBC mode. HT-packets only.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NonStbc</name>
                    <description>non-STBC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Stbc</name>
                    <description>STBC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCPEBYPASS</name>
                <description>CPE compensation control.0 : CPE compensation1 : BypassThis field is used when REMOVE_SUB_CARRIERS is active (RX mode).In both cases pilots will be discarded but when bypass is not activeCPE compensation will be performed.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANRXPDLBBYPASS</name>
                <description>Delay buffer bypass</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DlbEnabled</name>
                    <description>DLB enabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DlbBypassed</name>
                    <description>DLB bypassed</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPSIGNALBANDWIDTH</name>
                <description>Selects the signal bandwidth0 : 20MHz1 : 40MHz2 : 80MHz3 : reservedMust be equal or less than CHANNEL_BANDWIDTH.For receive, see the OPERATING_WINDOW description.For transmit, when signal bandwidth is less than channel bandwidth, input OFDM symbol will be duplicatedbefore performing inverse FFT. If channel bandwidth is two times signal bandwidth then OFDM symbol will beduplicated and if channel bandwidth is four times signal bandwidth then OFDM symbol will be quadrupled.</description>
                <lsb>11</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRXPCPERU</name>
                <description>HE resource unit allocation for CPE module</description>
                <lsb>13</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANRXPMCSVALUE</name>
                <description>Modulation and coding scheme</description>
                <lsb>20</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CPECONFIG</name>
            <description>WLAN RXP CPE CONFIG</description>
            <addressOffset>0xC</addressOffset>
            <access>read-write</access>
            <resetValue>0x000F1062</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPCFOPPMCONVFACT</name>
                <description>Carrier Frequency Offset, to PPM conversion factor: value of OpBW/fc,where OpBw is the operating bandwidth and fc is the channel centre frequency. (u-4.20)Note: default value set for OpBW = 20MHz and fc = 5GHz</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRXPCPEESTNUMSYM</name>
                <description>Number of CPE estimations used for the CPE based frequency offset estimation.</description>
                <lsb>16</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>WLANRXPCPEESTHEMUMODE</name>
                <description>CPE based frequency offset estimation mode for HE-MU packets:</description>
                <lsb>21</lsb>
                <msb>22</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UseHeSigBAndDataSy</name>
                    <description>Use HE-SIG-B and Data symbols CPE estimations (final HE-SIG-B in ppm is sum to the Data ppm estimations)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseHeSigBSymbolsCp</name>
                    <description>Use HE-SIG-B symbols CPE estimations only</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UseDataSymbolsCpeEst</name>
                    <description>Use Data symbols CPE estimations only (if there is only one data Symbol then the HE-SIG-B is used)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPCPECFOESTDIS</name>
                <description>Disable the CFO estimation based on the CPE : ignore RXP_CPE_CFO_EST field</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CPESTATUS</name>
            <description>WLAN RXP CPE STATUS</description>
            <addressOffset>0x10</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPCPEFREQUENCYOFFSET</name>
                <description>CPE based frequency offset estimation (s-5.20).</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CPECONFIG2</name>
            <description>WLAN RXP CPE CONFIG 2</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00001062</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPSFOPPMCONVFACT</name>
                <description>Sampling Frequency Offset, time tracking conversion factor: value of [resampler factor] * OpBW/fc,where OpBw is the operating bandwidth and fc is the channel centre frequency. (u-4.20)Note: default value set for resampler factor = 1, OpBW = 20MHz and fc = 5GHz</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRXPCPERESAMPLERENA</name>
                <description>Enable CPE estimation based SFO error update to the SCP resampler.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>AUTOCONFIG</name>
            <description>WLAN RXP AUTO CONFIG</description>
            <addressOffset>0x20</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRXPAUTOCONFIGDSSSOFDM</name>
                <description>DSSS or OFDM</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Dsss</name>
                    <description>DSSS</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Ofdm</name>
                    <description>OFDM</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WLANRXPAUTOCONFIGFRAMEFORMAT</name>
                <description>Frame format</description>
                <lsb>1</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Legacy</name>
