                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Override, clock is enabled.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AFREADYHIGH</name>
              <description>Provides override control for the AFREADY output</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
