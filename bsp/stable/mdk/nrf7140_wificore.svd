                    <description>Generic long packet data types</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>YUV</name>
                    <description>YUV data</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RGB</name>
                    <description>RGB data</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RAW</name>
                    <description>RAW data</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BYTE</name>
                    <description>User Defined byte-based data</description>
                    <value>0x6</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WORDCOUNT</name>
            <description>Number of words in the current packet.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WORDCOUNT</name>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>ECC</name>
            <description>Error Correction Code.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ECC</name>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>DMA</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_GSI_DMA</headerStructName>
          <access>read-write</access>
          <addressOffset>0x600</addressOffset>
          <cluster>
            <name>STATUS</name>
            <description>EasyVDMA status registers.</description>
            <headerStructName>GLOBAL_GSI_DMA_STATUS</headerStructName>
            <access>read-write</access>
            <addressOffset>0x000</addressOffset>
            <register>
              <name>BYTECOUNT</name>
              <description>Number of bytes sent or received during processing of current descriptor list</description>
              <addressOffset>0x000</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>BYTECOUNT</name>
                  <description>Number of bytes sent or received during processing of current descriptor list</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>ATTRIBUTE</name>
              <description>Latest job attribute being processed.</description>
              <addressOffset>0x004</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ATTRIBUTE</name>
                  <description>Latest job attribute being processed.</description>
                  <lsb>0</lsb>
                  <msb>5</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>ADDRESS</name>
              <description>Latest address being accessed.</description>
              <addressOffset>0x008</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ADDRESS</name>
                  <description>Latest address being accessed.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>JOBCOUNT</name>
              <description>Number of completed jobs in current descriptor list.</description>
              <addressOffset>0x00C</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>JOBCOUNT</name>
                  <description>Number of completed jobs in current descriptor list.</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>BUSERROR</name>
              <description>AXI bus error status.</description>
              <addressOffset>0x010</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>BUSERROR</name>
                  <description>AXI bus error type</description>
                  <lsb>0</lsb>
                  <msb>2</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NoError</name>
                      <description>There are no errors.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadError</name>
                      <description>Error related to memory when reading joblist, or error related to memory/register when reading data.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ReadDecodeError</name>
                      <description>Error related to the joblist address when reading joblist, or error related to address when reading memory/register.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>WriteError</name>
                      <description>Error related to memory/register when writing data.</description>
                      <value>0x3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>WriteDecodeError</name>
                      <description>Error related to the memory/register address when writing data.</description>
                      <value>0x4</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>FIFO</name>
              <description>Data fifo status.</description>
              <addressOffset>0x014</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>RXFIFO</name>
                  <description>Memory-to-Peripheral direction data fifo status</description>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Empty</name>
                      <description>Fifo is empty.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>NotEmpty</name>
                      <description>Fifo contains data.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Full</name>
                      <description>Fifo is full.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TXFIFO</name>
                  <description>Peripheral-to-Memory direction data fifo status</description>
                  <lsb>2</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Empty</name>
                      <description>Fifo is empty.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>NotEmpty</name>
                      <description>Fifo contains data.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Full</name>
                      <description>Fifo is full.</description>
                      <value>0x2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>ACTIVE</name>
              <description>DMA activity state.</description>
              <addressOffset>0x018</addressOffset>
              <access>read-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ACTIVE</name>
                  <description>DMA activity state.</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Idle</name>
                      <description>DMA is in idle state.</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Active</name>
                      <description>Data is being transferred.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>CONFIG</name>
            <description>General config registers</description>
            <headerStructName>GLOBAL_GSI_DMA_CONFIG</headerStructName>
            <access>read-write</access>
            <addressOffset>0x100</addressOffset>
            <register>
              <name>BUFFERFILL</name>
              <description>Data to be used when data is sent with BufferFill attribute</description>
              <addressOffset>0x000</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>BUFFERFILL</name>
                  <description>Data to be used when data is sent with BufferFill attribute</description>
                  <lsb>0</lsb>
                  <msb>7</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>LISTPTR</name>
              <description>Start address of descriptor list</description>
              <addressOffset>0x004</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LISTPTR</name>
                  <description>Start address of descriptor list</description>
                  <lsb>0</lsb>
                  <msb>31</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>LISTPARTTHRESH</name>
              <description>Threshold value for generating event EVENTS_DONE.PARTLIST when descriptor list is partially completed. Value is number of jobs.</description>
              <addressOffset>0x008</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LISTPARTTHRESH</name>
                  <description>Threshold value.</description>
                  <lsb>0</lsb>
                  <msb>15</msb>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>PCGCSLAVE</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_GSI_PCGCSLAVE</headerStructName>
          <access>read-write</access>
          <addressOffset>0xF00</addressOffset>
          <register>
            <dim>0x2</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>PENALTY[%s]</name>
            <description>Description collection: Penalty level for power/clock pair n. When FULL_PCP_ZERO feature is not supported, PENALTY[0] address overlaps the PENALTY0 address and register description for PENALTY[0] is not valid.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0xFFFFFFFC</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PENALTY</name>
                <description>Penalty level</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PENALTY0</name>
            <description>Penalty level for power/clock pair 0. The register description is valid only when FULL_PCP_ZERO feature is not supported</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <alternateRegister>PENALTY[%s]</alternateRegister>
            <size>0x20</size>
            <fields>
              <field>
                <name>PENALTY</name>
                <description>Penalty level</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>0x2</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>FORCEOVERRIDE[%s]</name>
            <description>Description collection: Force override of power/clock pair n.</description>
            <addressOffset>0x80</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CLOCKFORCINGPRE</name>
                <description>CLOCKFORCINGPRE</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>DOFORCECLOCKPRE</name>
                <description>DOFORCECLOCKPRE</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>POWERFORCINGPRE</name>
                <description>POWERFORCINGPRE</description>
                <lsb>8</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>DOFORCEPOWERPRE</name>
                <description>DOFORCEPOWERPRE</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>DSI</name>
          <description>Unspecified</description>
          <headerStructName>GLOBAL_GSI_DSI</headerStructName>
          <access>read-write</access>
          <addressOffset>0x1000</addressOffset>
          <register>
            <name>VERSION</name>
            <description>Contains the version of the DSI host controller.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x30313531</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VERSION</name>
                <description>This field indicates the version of the DSI.</description>
                <lsb>0</lsb>
                <msb>31</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PWRUP</name>
            <description>Controls the power up of the controller.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SHUTDOWNZ</name>
                <description>This bit configures the controller either to power up or to reset.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>RESET</name>
                    <description>Reset the controller</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>POWERUP</name>
                    <description>Power up the controller</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CLKMGRCFG</name>
            <description>Configures the factor for internal dividers to divide lanebyteclk for timeout purposes.</description>
            <addressOffset>0x008</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TXESCCLKDIVISION</name>
                <description>This field indicates the division factor for the TX Escape clock source (lanebyteclk). The values 0 and 1 stop the TX_ESC clock generation.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>TOCLKDIVISION</name>
                <description>This field indicates the division factor for the Time Out clock used as the timing unit in the configuration of high-speed to low-power and low-power to high-speed transition error.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPIVCID</name>
            <description>Configures the Virtual Channel ID for DPI traffic.</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DPIVCID</name>
                <description>This field configures the DPI virtual channel id that is indexed to the Video mode packets.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPICOLORCODING</name>
            <description>Configures DPI color coding.</description>
            <addressOffset>0x010</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DPICOLORCODING</name>
                <description>This field configures the DPI color for Video Mode/eDPI Command Mode coding as follows:</description>
                <lsb>0</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CC00</name>
                    <description>16-bit configuration 1</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC01</name>
                    <description>16-bit configuration 2</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC02</name>
                    <description>16-bit configuration 3</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC03</name>
                    <description>18-bit configuration 1</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC04</name>
                    <description>18-bit configuration 2</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC05</name>
                    <description>24-bit</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC06</name>
                    <description>20-bit YCbCr 4:2:2 loosely packed / Reserved for eDPI Command Mode</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC07</name>
                    <description>24-bit YCbCr 4:2:2 / Reserved for eDPI Command Mode</description>
                    <value>0x7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC08</name>
                    <description>16-bit YCbCr 4:2:2 / Reserved for eDPI Command Mode</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC09</name>
                    <description>30-bit - DSC_ENC 10bit / Reserved for eDPI Command Mode</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC10</name>
                    <description>36-bit / Reserved for eDPI Command Mode</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC11</name>
                    <description>12-bit YCbCr 4:2:0 / Reserved for eDPI Command Mode</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC12</name>
                    <description>DSC24 compressed Data</description>
                    <value>0xC</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC13</name>
                    <description>Unspecified</description>
                    <value>0xD</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC14</name>
                    <description>Unspecified</description>
                    <value>0xE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CC15</name>
                    <description>Unspecified</description>
                    <value>0xF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LOOSELY18EN</name>
                <description>When set to 1, this bit activates loosely packed variant to 18-bit configurations.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPICFGPOL</name>
            <description>Configures the polarity of DPI signals.</description>
            <addressOffset>0x014</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DATAENACTIVELOW</name>
                <description>When set to 1, this bit configures the data enable pin (dpidataen) as active low.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>VSYNCACTIVELOW</name>
                <description>When set to 1, this bit configures the vertical synchronism pin (dpivsync) as active low.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>HSYNCACTIVELOW</name>
                <description>When set to 1, this bit configures the horizontal synchronism pin (dpihsync) as active low.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>SHUTDACTIVELOW</name>
                <description>When set to 1, this bit configures the shutdown pin (dpishutdn) as active low.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>COLORMACTIVELOW</name>
                <description>When set to 1, this bit configures the color mode pin (dpicolorm) as active low.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DPILPCMDTIM</name>
            <description>Configures the timing for low-power commands sent while in video mode.</description>
            <addressOffset>0x018</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INVACTLPCMDTIME</name>
                <description>This field is used for the transmission of commands in low-power mode. It defines the size, in bytes, of the largest packet that can fit in a line during the VACT region.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>OUTVACTLPCMDTIME</name>
                <description>This field is used for the transmission of commands in low-power mode. It defines the size, in bytes, of the largest packet that can fit in a line during the VSA, VBP, and VFP regions.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DBIVCID</name>
            <description>Configures Virtual Channel ID for DBI traffic.</description>
            <addressOffset>0x01C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DBIVCID</name>
                <description>This field configures the virtual channel id that is indexed to the DCS packets from DBI.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DBICFG</name>
            <description>Configures the bit width of pixels for DBI.</description>
            <addressOffset>0x020</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INDBICONF</name>
                <description>This field configures the DBI input pixel data as follows:</description>
                <lsb>0</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PIXELDATA0</name>
                    <description>8-bit 8 bpp</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA1</name>
                    <description>8-bit 12 bpp</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA2</name>
                    <description>8-bit 16 bpp</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA3</name>
                    <description>8-bit 18 bpp</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA4</name>
                    <description>8-bit 24 bpp</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA5</name>
                    <description>9-bit 18 bpp</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA6</name>
                    <description>16-bit 8 bpp</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA7</name>
                    <description>16-bit 12 bpp</description>
                    <value>0x7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA8</name>
                    <description>16-bit 16 bpp</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA9</name>
                    <description>16-bit 18 bpp, option 1</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA10</name>
                    <description>16-bit 18 bpp, option 2</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA11</name>
                    <description>16-bit 24 bpp, option 1</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA12</name>
                    <description>16-bit 24 bpp, option 2</description>
                    <value>0xC</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OUTDBICONF</name>
                <description>This field configures the DBI output pixel data as follows:</description>
                <lsb>8</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PIXELDATA0</name>
                    <description>8-bit 8 bpp</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA1</name>
                    <description>8-bit 12 bpp</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA2</name>
                    <description>8-bit 16 bpp</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA3</name>
                    <description>8-bit 18 bpp</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA4</name>
                    <description>8-bit 24 bpp</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA5</name>
                    <description>9-bit 18 bpp</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA6</name>
                    <description>16-bit 8 bpp</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA7</name>
                    <description>16-bit 12 bpp</description>
                    <value>0x7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA8</name>
                    <description>16-bit 16 bpp</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA9</name>
                    <description>16-bit 18 bpp, option 1</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA10</name>
                    <description>16-bit 18 bpp, option 2</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA11</name>
                    <description>16-bit 24 bpp, option 1</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXELDATA12</name>
                    <description>16-bit 24 bpp, option 2</description>
                    <value>0xC</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LUTSIZECONF</name>
                <description>This field configures the size used to transport the Write Lut commands as follows:</description>
                <lsb>16</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LUTSIZE0</name>
                    <description>16-bit color display</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE1</name>
                    <description>18-bit color display</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE2</name>
                    <description>24-bit color display</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUTSIZE3</name>
                    <description>32-bit color display</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DBIPARTITIONINGEN</name>
            <description>Configures whether DSI is to partition DBI traffic automatically.</description>
            <addressOffset>0x024</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PARTITIONINGEN</name>
                <description>When set to 1, this bit enables the use of write_memory_continue input commands (system needs to ensure correct partitioning of Long Write commands). When not set, partitioning is automatically performed in the DSI.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>DBICMZE</name>
            <description>Configures the command size and the size for automatic partitioning of DBI packets.</description>
            <addressOffset>0x028</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WRCMDSIZE</name>
                <description>This field configures the size of the DCS write memory commands. The size of DSI packet payload is the actual payload size minus 1, because the DCS command is in the DSI packet payload.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>ALLOWEDCMDSIZE</name>
                <description>This field configures the maximum allowed size for a DCS write memory command. This field is used to partition a write memory command into one write_memory_start and a variable number of write_memory_continue commands. It is only used if the partitioning_en bit of the DBI_CFG register is disabled. The size of the DSI packet payload is the actual payload size minus 1, because the DCS command is in the DSI packet payload.</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PCKHDLCFG</name>
            <description>Configures how EoTp, BTA, CRC and ECC are to be used, to meet peripherals characteristics</description>
            <addressOffset>0x02C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>EOTPTXEN</name>
                <description>When set to 1, this bit enables the EoTp transmission in high-speed.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>EOTPRXEN</name>
                <description>When set to 1, this bit enables the EoTp reception.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>BTAEN</name>
                <description>When set to 1, this bit enables the Bus Turn-Around (BTA) request.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>ECCRXEN</name>
                <description>When set to 1, this bit enables the ECC reception, error correction, and reporting.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>CRCRXEN</name>
                <description>When set to 1, this bit enables the CRC reception and error reporting.</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>EOTPTXLPEN</name>
                <description>When set to 1, this bit enables the EoTp transmission in low-power.</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GENVCID</name>
            <description>Configures the Virtual Channel ID of READ responses to store and return to Generic interface.</description>
            <addressOffset>0x030</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GENVCIDRX</name>
                <description>This field indicates the Generic interface read-back virtual channel identification.</description>
                <lsb>0</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>GENVCIDTEARAUTO</name>
                <description>This field indicates the virtual channel identification for tear effect by hardware</description>
                <lsb>8</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>GENVCIDTXAUTO</name>
                <description>This field indicates the Generic interface virtual channel identification where generic packet is automatically generated &amp;amp; transmitted.</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>MODECFG</name>
            <description>Configures the mode of operation between Video or Command Mode. (Commands can still be sent while in video mode.)</description>
            <addressOffset>0x034</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CMDVIDEOMODE</name>
                <description>This bit configures the operation mode:</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VIDMODE</name>
                    <description>video mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CMDMODE</name>
                    <description>command mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDMODECFG</name>
            <description>Configures several aspects of Video mode operation, the transmission mode, switching to low-power in the middle of a frame, enabling acknowledge and whether to send commands in low-power.</description>
            <addressOffset>0x038</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDMODETYPE</name>
                <description>This field indicates the video mode transmission type as follows:</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VIDMODE0</name>
                    <description>Non-burst with sync pulses</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE1</name>
                    <description>Non-burst with sync events</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE2</name>
                    <description>Burst mode</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIDMODE3</name>
                    <description>Burst mode</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LPVSAEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VSA period when timing allows.</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>LPVBPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VBP period when timing allows.</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>LPVFPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VFP period when timing allows.</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>LPVACTEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the VACT period when timing allows.</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>LPHBPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the HBP period when timing allows.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LPHFPEN</name>
                <description>When set to 1, this bit enables the return to low-power inside the HFP period when timing allows.</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>FRAMEBTAACKEN</name>
                <description>When set to 1, this bit enables the request for an acknowledge response at the end of a frame.</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>LPCMDEN</name>
                <description>When set to 1, this bit enables the command transmission only in low-power mode.</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>VPGEN</name>
                <description>When set to 1, this bit enables the video mode pattern generator.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>VPGMODE</name>
                <description>This field is to select the pattern:</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>COLORBAR</name>
                    <description>horizontal or vertical</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BERPATTERN</name>
                    <description>vertical only</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VPGORIENTATION</name>
                <description>This field indicates the color bar orientation as follows:</description>
                <lsb>24</lsb>
                <msb>24</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VPGORENT0</name>
                    <description>Vertical mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VPGORENT1</name>
                    <description>Horizontal mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDPKTSIZE</name>
            <description>Configures the video packet size.</description>
            <addressOffset>0x03C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDPKTSIZE</name>
                <description>This field configures the number of pixels in a single video packet.</description>
                <lsb>0</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDNUMCHUNKS</name>
            <description>Configures the number of chunks to use. The data in each chunk has the size provided by VID_PKT_SIZE.</description>
            <addressOffset>0x040</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDNUMCHUNKS</name>
                <description>This register configures the number of chunks to be transmitted during a Line period (a chunk is pair made of a video packet and a null packet). If set to 0 or 1, video line is still transmitted in a single packet. If set to 1 that packet is part of a chunk, meaning that a null packet follows it (if vid_null_size&amp;gt;0). Otherwise, multiple chunks are used to transmit each video line.</description>
                <lsb>0</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDNULLSIZE</name>
            <description>Configures the size of null packets.</description>
            <addressOffset>0x044</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDNULLSIZE</name>
                <description>This register configures the number of bytes inside a null packet. Setting to 0 disables null packets.</description>
                <lsb>0</lsb>
                <msb>12</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHSATIME</name>
            <description>Configures the video HSA time.</description>
            <addressOffset>0x048</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDHSATIME</name>
                <description>This field configures the Horizontal Synchronism Active period in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHBPTIME</name>
            <description>Configures the video HBP time.</description>
            <addressOffset>0x04C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDHBPTIME</name>
                <description>This field configures the Horizontal Back Porch period in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDHLINETIME</name>
            <description>Configures the overall time for each video line.</description>
            <addressOffset>0x050</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VIDHLINETIME</name>
                <description>This field configures the size of the total line time (HSA+HBP+HACT+HFP) counted in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>14</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVSALINES</name>
            <description>Configures the VSA period.</description>
            <addressOffset>0x054</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VSALINES</name>
                <description>This field configures the Vertical Synchronism Active period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVBPLINES</name>
            <description>Configures the VBP period.</description>
            <addressOffset>0x058</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VBPLINES</name>
                <description>This field configures the Vertical Back Porch period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVFPLINES</name>
            <description>Configures the VFP period.</description>
            <addressOffset>0x05C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VFPLINES</name>
                <description>This field configures the Vertical Front Porch period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>VIDVACTIVELINES</name>
            <description>Configures the vertical resolution of video.</description>
            <addressOffset>0x060</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VACTIVELINES</name>
                <description>This field configures the Vertical Active period measured in number of horizontal lines.</description>
                <lsb>0</lsb>
                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CMDMODECFG</name>
            <description>Configures several aspect of command mode operation, tearing effect, acknowledge for each packet and the speed mode to transmit each Data Type related to commands.</description>
            <addressOffset>0x068</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TEARFXEN</name>
                <description>When set to 1, this bit enables the tearing effect acknowledge request.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>ACKRQSTEN</name>
                <description>When set to 1, this bit enables the acknowledge request after each packet transmission.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>GENSW0PTX</name>
                <description>This bit configures the Generic short write packet with zero parameter command transmission type:</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENSW1PTX</name>
                <description>This bit configures the Generic short write packet with one parameter command transmission type:</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENSW2PTX</name>
                <description>This bit configures the Generic short write packet with two parameters command transmission type:</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENSR0PTX</name>
                <description>This bit configures the Generic short read packet with zero parameter command transmission type:</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENSR1PTX</name>
                <description>This bit configures the Generic short read packet with one parameter command transmission type:</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENSR2PTX</name>
                <description>This bit configures the Generic short read packet with two parameters command transmission type:</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GENLWTX</name>
                <description>This bit configures the Generic long write packet command transmission type:</description>
                <lsb>14</lsb>
                <msb>14</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCSSW0PTX</name>
                <description>This bit configures the DCS short write packet with zero parameter command transmission type:</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCSSW1PTX</name>
                <description>This bit configures the DCS short write packet with one parameter command transmission type:</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCSSR0PTX</name>
                <description>This bit configures the DCS short read packet with zero parameter command transmission type:</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DCSLWTX</name>
                <description>This bit configures the DCS long write packet command transmission type:</description>
                <lsb>19</lsb>
                <msb>19</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MAXRDPKTSIZE</name>
                <description>This bit configures the maximum read packet size command transmission type:</description>
                <lsb>24</lsb>
                <msb>24</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>HIGHSPEED</name>
                    <description>Transition type is high-speed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWPOWER</name>
                    <description>Transition type is low-power</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>GENHDR</name>
            <description>Sets the header for new packets sent using the Generic interface.</description>
            <addressOffset>0x06C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GENDT</name>
                <description>This field configures the packet Data Type of the header packet.</description>
                <lsb>0</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>GENVC</name>
                <description>This field configures the Virtual Channel ID of the header packet.</description>
                <lsb>6</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>GENWCLSBYTE</name>
                <description>This field configures the least significant byte of the header packet's Word count for long packets or data 0 for short packets.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>GENWCMSBYTE</name>
                <description>This field configures the most significant byte of the header packet's word count for long packets or data 1 for short packets.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>GENPLDDATA</name>
            <description>Sets the payload for packets sent using the Generic interface and, when read returns the contents of READ responses from the peripheral.</description>
            <addressOffset>0x070</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GENPLDB1</name>
                <description>This field indicates byte 1 of the packet payload.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>GENPLDB2</name>
                <description>This field indicates byte 2 of the packet payload.</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>GENPLDB3</name>
                <description>This field indicates byte 3 of the packet payload.</description>
                <lsb>16</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>GENPLDB4</name>
                <description>This field indicates byte 4 of the packet payload.</description>
                <lsb>24</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CMDPKTSTATUS</name>
            <description>Contains information about the status of FIFOs related to DBI and Generic interface.</description>
            <addressOffset>0x074</addressOffset>
            <access>read-write</access>
            <resetValue>0x05051515</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>GENCMDEMPTY</name>
                <description>This bit indicates the empty status of the generic command FIFO.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENCMDFULL</name>
                <description>This bit indicates the full status of the generic command FIFO.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDWEMPTY</name>
                <description>This bit indicates the empty status of the generic write payload FIFO.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDWFULL</name>
                <description>This bit indicates the full status of the generic write payload FIFO.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDREMPTY</name>
                <description>This bit indicates the empty status of the generic read payload FIFO.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDRFULL</name>
                <description>This bit indicates the full status of the generic read payload FIFO.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENRDCMDBUSY</name>
                <description>This bit is set when a read command is issued and cleared when the entire response is stored in the FIFO for GENERIC interface.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBICMDEMPY</name>
                <description>This bit indicates the empty status of the DBI command FIFO.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBICMDFULL</name>
                <description>This bit indicates the full status of the DBI command FIFO.</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDWEMPTY</name>
                <description>This bit indicates the empty status of the DBI write payload FIFO.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDWFULL</name>
                <description>This bit indicates the full status of the DBI write payload FIFO.</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDREMPTY</name>
                <description>This bit indicates the empty status of the DBI read payload</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDRFULL</name>
                <description>This bit indicates the full status of the DBI read payload FIFO.</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIRDCMDBUSY</name>
                <description>This bit is set when a read command is issued and cleared when the entire response is stored in the FIFO for DBI interface.</description>
                <lsb>14</lsb>
                <msb>14</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENBUFFCMDEMPTY</name>
                <description>This bit indicates the empty status of the generic command internal buffer.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENBUFFCMDFULL</name>
                <description>This bit indicates the full status of the generic command internal buffer.</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENBUFFPLDEMPTY</name>
                <description>This bit indicates the empty status of the generic payload internal buffer.</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENBUFFPLDFULL</name>
                <description>This bit indicates the full status of the generic payload internal buffer.</description>
                <lsb>19</lsb>
                <msb>19</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIBUFFCMDEMPTY</name>
                <description>This bit indicates the empty status of the DBI command internal buffer.</description>
                <lsb>24</lsb>
                <msb>24</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIBUFFCMDFULL</name>
                <description>This bit indicates the full status of the DBI command internal buffer.</description>
                <lsb>25</lsb>
                <msb>25</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIBUFFPLDEMPTY</name>
                <description>This bit indicates the empty status of the DBI payload internal buffer.</description>
                <lsb>26</lsb>
                <msb>26</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIBUFFPLDFULL</name>
                <description>This bit indicates the full status of the DBI payload internal buffer.</description>
                <lsb>27</lsb>
                <msb>27</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TOCNTCFG</name>
            <description>Configures counters that trigger timeout errors. These are used to warn the system of a failure, through an interrupt, and restart the controller in case of unexpected situations that cause deadlock conditions.</description>
            <addressOffset>0x078</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LPRXTOCNT</name>
                <description>This field configures the timeout counter that triggers a low-power reception timeout contention detection (measured in TO_CLK_DIVISION cycles).</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>HSTXTOCNT</name>
                <description>This field configures the timeout counter that triggers a high-speed transmission timeout contention detection (measured in TO_CLK_DIVISION cycles).</description>
                <lsb>16</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>HSRDTOCNT</name>
            <description>Configures the Peripheral Response timeout after high-speed Read operations.</description>
            <addressOffset>0x07C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>HSRDTOCNT</name>
                <description>This field sets a period for which DSI keeps the link still, after sending a high-speed Read operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>LPRDTOCNT</name>
            <description>Configures the Peripheral Response timeout after low-power Read operations.</description>
            <addressOffset>0x080</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LPRDTOCNT</name>
                <description>This field sets a period for which DSI keeps the link still, after sending a low-power Read operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>HSWRTOCNT</name>
            <description>Configures the Peripheral Response timeout after high-speed Write operations.</description>
            <addressOffset>0x084</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>HSWRTOCNT</name>
                <description>This field sets a period for which DSI keeps the link still, after sending a high-speed Write operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>LPWRTOCNT</name>
            <description>Configures the Peripheral Response timeout after low-power Write operations.</description>
            <addressOffset>0x088</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>LPWRTOCNT</name>
                <description>This field sets a period for which DSI keeps the link still, after sending a low-power Write operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>BTATOCNT</name>
            <description>Configures the Peripheral Response timeout after Bus Turnaround completion.</description>
            <addressOffset>0x08C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BTATOCNT</name>
                <description>This field sets a period for which DSI keeps the link still, after completing a Bus Turnaround. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>SDF3D</name>
            <description>Stores 3D control information for VSS packets in video mode.</description>
            <addressOffset>0x090</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MODE3D</name>
                <description>This field defines 3D Mode On/Off and Display Orientation:</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MODE0</name>
                    <description>3D Mode Off , 2D Mode On</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE1</name>
                    <description>3D Mode On, Portrait Orientation</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE2</name>
                    <description>3D Mode On, Landscape Orientation</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE3</name>
                    <description>Reserved, not used</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FORMAT3D</name>
                <description>This field defines 3D Image Format:</description>
                <lsb>2</lsb>
                <msb>3</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LINE</name>
                    <description>Alternating lines of left and right data</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FRAME</name>
                    <description>Alternating frames of left and right data</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PIXEL</name>
                    <description>Alternating pixels of left and right data</description>
                    <value>0x2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SECONDVSYNC</name>
                <description>This field defines whether there is a second VSYNC pulse between Left and Right Images, when 3D Image Format is Frame-based:</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NOSYNC</name>
                    <description>No sync pulses between left and right data</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SYNC</name>
                    <description>Sync pulse HSYNC, VSYNC, blanking between left and right data</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RIGHTFIRST</name>
                <description>This bit defines the left/right order:</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LFIRST</name>
                    <description>left eye is sent first, then right eye</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RFIRST</name>
                    <description>right eye data is sent first, then left eye</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SEND3DCFG</name>
                <description>When set, causes the next VSS packet to include 3D control payload in every VSS packet.</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>LPCLKCTRL</name>
            <description>Configures the possibility for using non continuous clock in the clock lane.</description>
            <addressOffset>0x094</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYTXREQUESTCLKHS</name>
                <description>This bit controls the D-PHY PPI txrequestclkhs signal.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>AUTOCLKLANECTRL</name>
                <description>This bit enables the automatic mechanism to stop providing clock in the clock lane when time allows.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTMRLPCLKCFG</name>
            <description>Sets the time that DSI assumes in calculations for the clock lane to switch between high-speed and low-power.</description>
            <addressOffset>0x098</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYCLKLP2HSTIME</name>
                <description>This field configures the maximum time that the D-PHY clock lane takes to go from low-power to high-speed transmission measured in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>PHYCLKHS2LPTIME</name>
                <description>This field configures the maximum time that the D-PHY clock lane takes to go from high-speed to low-power transmission measured in lane byte clock cycles.</description>
                <lsb>16</lsb>
                <msb>25</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTMRCFG</name>
            <description>Sets the time that DSI assumes in calculations for the data lanes to switch between high-speed and low-power.</description>
            <addressOffset>0x09C</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYLP2HSTIME</name>
                <description>This field configures the maximum time that the D-PHY data lanes take to go from low-power to high-speed transmission measured in lane byte clock cycles.</description>
                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>PHYHS2LPTIME</name>
                <description>This field configures the maximum time that the D-PHY data lanes take to go from high-speed to low-power transmission measured in lane byte clock cycles.</description>
                <lsb>16</lsb>
                <msb>25</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYRSTZ</name>
            <description>Controls resets and the PLL of the D-PHY.</description>
            <addressOffset>0x0A0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYSHUTDOWNZ</name>
                <description>When set to 0, this bit places the complete D-PHY macro in power-down state.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>PHYRSTZ</name>
                <description>When set to 0, this bit places the digital section of the D-PHY in the reset state.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>PHYENABLECLK</name>
                <description>When set to 1, this bit enables the D-PHY Clock Lane Module.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>PHYFORCEPLL</name>
                <description>When the D-PHY is in ULPS, this bit enables the D-PHY PLL.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYIFCFG</name>
            <description>Configures the number of active lanes and the minimum time to remain in stop state.</description>
            <addressOffset>0x0A4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NLANES</name>
                <description>This field configures the number of active data lanes:</description>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ONELANES</name>
                    <description>lane 0</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TWOLANES</name>
                    <description>lanes 0 and 1</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>THREELANES</name>
                    <description>lanes 0, 1, and 2</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FOURLANES</name>
                    <description>lanes 0, 1, 2, and 3</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PHYSTOPWAITTIME</name>
                <description>This field configures the minimum time PHY needs to stay in StopState before requesting an high-speed transmission</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYULPSCTRL</name>
            <description>Configures entering and leaving ULPS in the D-PHY.</description>
            <addressOffset>0x0A8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYTXREQULPSCLK</name>
                <description>ULPS mode Request on clock lane.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>PHYTXEXITULPSCLK</name>
                <description>ULPS mode Exit on clock lane.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>PHYTXREQULPSLAN</name>
                <description>ULPS mode Request on all active data lanes.</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>PHYTXEXITULPSLAN</name>
                <description>ULPS mode Exit on all active data lanes.</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTXTRIGGERS</name>
            <description>Configures the pins that activate triggers in the D-PHY.</description>
            <addressOffset>0x0AC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYTXTRIGGERS</name>
                <description>This field controls the trigger transmissions.</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYSTATUS</name>
            <description>Contains information about the status of the D-PHY.</description>
            <addressOffset>0x0B0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000140</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYLOCK</name>
                <description>This bit indicates the status of phylock D-PHY signal.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYDIRECTION</name>
                <description>This bit indicates the status of phydirection D-PHY signal.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYSTOPSTATECLKLANE</name>
                <description>This bit indicates the status of phystopstateclklane D-PHY signal.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYULPSACTIVENOTCLK</name>
                <description>This bit indicates the status of phyulpsactivenotclk D-PHY signal.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYSTOPSTATE0LANE</name>
                <description>This bit indicates the status of phystopstate0lane D-PHY signal.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYULPSACTIVENOT0LANE</name>
                <description>This bit indicates the status of ulpsactivenot0lane D-PHY signal.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYRXULPSESC0LANE</name>
                <description>This bit indicates the status of rxulpsesc0lane D-PHY signal.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYSTOPSTATE1LANE</name>
                <description>This bit indicates the status of phystopstate1lane D-PHY signal.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYULPSACTIVENOT1LANE</name>
                <description>This bit indicates the status of ulpsactivenot1lane D-PHY signal.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTSTCTRL0</name>
            <description>Controls clock and clear pins of the D-PHY vendor specific interface.</description>
            <addressOffset>0x0B4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000001</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYTESTCLR</name>
                <description>PHY test interface clear (active high).</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>PHYTESTCLK</name>
                <description>This bit is used to clock the TESTDIN bus into the D-PHY.</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>PHYTSTCTRL1</name>
            <description>Controls data and enable pins of the D-PHY vendor specific interface.</description>
            <addressOffset>0x0B8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PHYTESTDIN</name>
                <description>PHY test interface input 8-bit data bus for internal register programming and test functionalities access.</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>PHTTESTDOUT</name>
                <description>PHY output 8-bit data bus for read-back and internal probing functionalities.</description>
                <lsb>8</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYTESTEN</name>
                <description>PHY test interface operation selector:</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WRITEDATA</name>
                    <description>the data write operation is set on the rising edge of the testclk signal.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WRITEADDR</name>
                    <description>the address write operation is set on the falling edge of the testclk signal.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PHYTESTSEL</name>
                <description>PHY BiDIR MUX selector</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>INTST0</name>
            <description>Contains the status of interrupt sources from acknowledge reports and the D-PHY.</description>
            <addressOffset>0x0BC</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>ACKWITHERR0</name>
                <description>This bit retrieves the SoT error from the Acknowledge error report.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR1</name>
                <description>This bit retrieves the SoT Sync error from the Acknowledge error report.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR2</name>
                <description>This bit retrieves the EoT Sync error from the Acknowledge error report.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR3</name>
                <description>This bit retrieves the Escape Mode Entry Command error from the Acknowledge error report.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR4</name>
                <description>This bit retrieves the low-power Transmit Sync error from the Acknowledge error report.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR5</name>
                <description>This bit retrieves the Peripheral Timeout error from the Acknowledge error report.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR6</name>
                <description>This bit retrieves the False Control error from the Acknowledge error report.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR7</name>
                <description>This bit retrieves the Contention Detected error from the Acknownledge error report.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR8</name>
                <description>This bit retrieves the ECC error, single-bit (detected and corrected) from the Acknowledge error report.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR9</name>
                <description>This bit retrieves the ECC error, multi-bit (detected, not corrected) from the Acknowledge error report.</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR10</name>
                <description>This bit retrieves the checksum error (long packet only) from the Acknowledge error report.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR11</name>
                <description>This bit retrieves the not recognized DSI data type from the Acknowledge error report.</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR12</name>
                <description>This bit retrieves the DSI VC ID Invalid from the Acknowledge error report.</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR13</name>
                <description>This bit retrieves the invalid transmission length from the Acknowledge error report.</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR14</name>
                <description>This bit retrieves the reserved (specific to device) from the Acknowledge error report.</description>
                <lsb>14</lsb>
                <msb>14</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ACKWITHERR15</name>
                <description>This bit retrieves the DSI protocol violation from the Acknowledge error report.</description>
                <lsb>15</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPHYERRORS0</name>
                <description>This bit indicates ErrEsc escape entry error from Lane 0.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPHYERRORS1</name>
                <description>This bit indicates ErrSyncEsc low-power data transmission synchronization error from Lane 0.</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPHYERRORS2</name>
                <description>This bit indicates control error ErrControl from Lane 0.</description>
                <lsb>18</lsb>
                <msb>18</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPHYERRORS3</name>
                <description>This bit indicates LP0 contention error ErrContentionLP0 from Lane 0.</description>
                <lsb>19</lsb>
                <msb>19</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPHYERRORS4</name>
                <description>This bit indicates LP1 contention error ErrContentionLP1 from Lane 0.</description>
                <lsb>20</lsb>
                <msb>20</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>INTST1</name>
            <description>Contains the status of interrupt sources related to timeouts, ECC, CRC, packet size, EoTp, Generic and DBI interfaces.</description>
            <addressOffset>0x0C0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TOHSTX</name>
                <description>This bit indicates that the high-speed transmission timeout counter reached the end and contention has been detected.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>TOLPRX</name>
                <description>This bit indicates that the low-power reception timeout counter reached the end and contention has been detected.</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ECCSINGLEERR</name>
                <description>This bit indicates that the ECC single error has been detected and corrected in a received packet.</description>
                <lsb>2</lsb>
                <msb>2</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>ECCMULTPLERR</name>
                <description>This bit indicates that the ECC multiple error has been detected in a received packet.</description>
                <lsb>3</lsb>
                <msb>3</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>CRCERR</name>
                <description>This bit indicates that the CRC error has been detected in the received packet payload.</description>
                <lsb>4</lsb>
                <msb>4</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>PKTSIZEERR</name>
                <description>This bit indicates that the packet size error has been detected during the packet reception.</description>
                <lsb>5</lsb>
                <msb>5</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>EOPTERR</name>
                <description>This bit indicates that the EoTp packet has not been received at the end of the incoming peripheral transmission.</description>
                <lsb>6</lsb>
                <msb>6</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIPLDWRERR</name>
                <description>This bit indicates that during a DPI pixel line storage, the payload FIFO becomes full and the data stored is corrupted.</description>
                <lsb>7</lsb>
                <msb>7</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENCMDWRERR</name>
                <description>This bit indicates that the system tried to write a command through the Generic interface and the FIFO is full. Therefore, the command is not written.</description>
                <lsb>8</lsb>
                <msb>8</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDWRERR</name>
                <description>This bit indicates that the system tried to write a payload data through the Generic interface and the FIFO is full. Therefore, the payload is not written.</description>
                <lsb>9</lsb>
                <msb>9</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDSENDERR</name>
                <description>This bit indicates that during a Generic interface packet build, the payload FIFO becomes empty and corrupt data is sent.</description>
                <lsb>10</lsb>
                <msb>10</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDRDERR</name>
                <description>This bit indicates that during a DCS read data, the payload FIFO becomes empty and the data sent to the interface is corrupted.</description>
                <lsb>11</lsb>
                <msb>11</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>GENPLDRECEVERR</name>
                <description>This bit indicates that during a generic interface packet read back, the payload FIFO becomes full and the received data is corrupted.</description>
                <lsb>12</lsb>
                <msb>12</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBICMDWRERR</name>
                <description>This bit indicates that the system tried to write a command through the DBI but the command FIFO is full. Therefore, the command is not written.</description>
                <lsb>13</lsb>
                <msb>13</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDWRERR</name>
                <description>This bit indicates that the system tried to write the payload data through the DBI interface and the FIFO is full. Therefore, the command is not written.</description>
                <lsb>14</lsb>
                <msb>14</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDRDERR</name>
                <description>This bit indicates that during a DCS read data, the payload FIFO goes empty and the data sent to the interface is corrupted.</description>
                <lsb>15</lsb>
                <msb>15</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIPLDRECVERR</name>
                <description>This bit indicates that during a DBI read back packet, the payload FIFO becomes full and the received data is corrupted.</description>
                <lsb>16</lsb>
                <msb>16</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DBIILEGALCOMMERR</name>
                <description>This bit indicates that an attempt to write an illegal command on the DBI interface is made and the controller is blocked by transmission.</description>
                <lsb>17</lsb>
                <msb>17</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>DPIBUFFPLDUNDER</name>
                <description>This bit indicates that an underflow has occurred when reading payload to build DSI packet for video mode</description>
                <lsb>19</lsb>
                <msb>19</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>INTMSK0</name>
            <description>Configures masks for the sources of interrupts that affect the INT_ST0 register. Write 1 to un-mask each error report.</description>
            <addressOffset>0x0C4</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MASKACKWITHERR0</name>
                <description>Mask for ack_with_err_0</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>MASKACKWITHERR1</name>
                <description>Mask for ack_with_err_1</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>MASKACKWITHERR2</name>
                <description>Mask for ack_with_err_2</description>
                <lsb>2</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>MASKACKWITHERR3</name>
                <description>Mask for ack_with_err_3</description>
                <lsb>3</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>MASKACKWITHERR4</name>
                <description>Mask for ack_with_err_4</description>
                <lsb>4</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>MASKACKWITHERR5</name>
                <description>Mask for ack_with_err_5</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
              <field>
                <name>MASKACKWITHERR6</name>
                <description>Mask for ack_with_err_6</description>
                <lsb>6</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>MASKACKWITHERR7</name>
                <description>Mask for ack_with_err_7</description>
                <lsb>7</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>MASKACKWITHERR8</name>
                <description>Mask for ack_with_err_8</description>
                <lsb>8</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>MASKACKWITHERR9</name>
                <description>Mask for ack_with_err_9</description>
                <lsb>9</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>MASKACKWITHERR10</name>
                <description>Mask for ack_with_err_10</description>
                <lsb>10</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>MASKACKWITHERR11</name>
                <description>Mask for ack_with_err_11</description>
                <lsb>11</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>MASKACKWITHERR12</name>
                <description>Mask for ack_with_err_12</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>MASKACKWITHERR13</name>
                <description>Mask for ack_with_err_13</description>
                <lsb>13</lsb>
                <msb>13</msb>
              </field>
              <field>
                <name>MASKACKWITHERR14</name>
                <description>Mask for ack_with_err_14</description>
                <lsb>14</lsb>
                <msb>14</msb>
              </field>
              <field>
                <name>MASKACKWITHERR15</name>
                <description>Mask for ack_with_err_15</description>
                <lsb>15</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>MASKDPHYERRORS0</name>
                <description>Mask for dphy_errors_0</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>MASKDPHYERRORS1</name>
                <description>Mask for dphy_errors_1</description>
                <lsb>17</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>MASKDPHYERRORS2</name>
                <description>Mask for dphy_errors_2</description>
                <lsb>18</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>MASKDPHYERRORS3</name>
                <description>Mask for dphy_errors_3</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
