                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LSig</name>
                    <description>L-SIG</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HtSig</name>
                    <description>HT-SIG</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigA1</name>
                    <description>VHT-SIG-A1</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VhtSigA2</name>
                    <description>VHT-SIG-A2</description>
