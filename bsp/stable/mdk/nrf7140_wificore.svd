              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NYET_RESP</name>
                  <description>The core responds with a NYET when an error is detected in either of the LPM token packets due to corruption</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACK_RESP</name>
                  <description>The core responds with an ACK only on a successful LPM transaction</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HIRD</name>
              <description>Host-Initiated Resume Duration (HIRD)</description>
              <lsb>2</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>BREMOTEWAKE</name>
              <description>RemoteWakeEnable (bRemoteWake)</description>
              <lsb>6</lsb>
              <msb>6</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Remote Wakeup is disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>In Host or device mode, this field takes the value of remote wake up</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENBLSLPM</name>
              <description>Enable utmi_sleep_n (EnblSlpM)</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
