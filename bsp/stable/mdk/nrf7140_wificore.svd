            <access>read-write</access>
            <resetValue>0x0074C7D0</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>R11R13</name>
                <description>Coefficient of resampler filter in 2's complement format.Only valid for 12-bit SCP, SCP_RESAMPLERCOEFF_ADDR/DATA must be used for 16-bit SCP.</description>
