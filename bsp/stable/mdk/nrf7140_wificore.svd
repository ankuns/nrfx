          <register>
            <name>PCFCOEFF12</name>
            <description>TXSCP PCF COEFF12</description>
            <addressOffset>0x3F0</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF22</name>
                <description>Filter Coefficient 22 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
                <lsb>0</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>PCFCOEFF23</name>
