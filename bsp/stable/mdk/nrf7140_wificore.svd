              </field>
            </fields>
          </register>
          <register>
            <name>RESP23R</name>
            <description>This register stores 71-40 bits of the Response Field for an SD/eMMC mode. This register is used to store the response from the cards. The response can be a maximum of 128 bits. These 128 bits are segregated into four 32-bit</description>
