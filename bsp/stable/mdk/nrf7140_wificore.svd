                    <description>Data - decoded data sent to EDC</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HeaderDecodedDataSe</name>
                    <description>Header - decoded data sent to receiver training mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
