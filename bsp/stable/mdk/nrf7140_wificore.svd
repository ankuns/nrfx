            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>IQCORRENABLE</name>
                <description>Used to enable the IQ Correlator for detecting angle error on a Zero-IF input signal</description>
                <lsb>23</lsb>
                <msb>23</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>IqCorrelatorIsDisabl</name>
                    <description>IQ Correlator is disabled</description>
