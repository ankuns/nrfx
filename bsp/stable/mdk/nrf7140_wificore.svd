                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUTPUTEN</name>
                    <description>CMD/DATA output is enable PHY Loopback mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
