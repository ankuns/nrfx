        <register>
          <name>PHASE</name>
          <description>Selection of delay on the clock line (to avoid potential setup&amp;amp;hold timing violation on input data)</description>
          <addressOffset>0x53C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PHASE</name>
              <description>To avoid potential setup&amp;amp;hold timing violation on input data, this register provides selection between 14 phase delay registers (15 taps), which each provide an additional 31.25ns delay of pdmClockToPad relative to pdmClockToFilter.</description>
