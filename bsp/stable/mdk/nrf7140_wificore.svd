                    <description>Boot Ack disable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TRUE</name>
                    <description>Boot Ack enable</description>
                    <value>0x1</value>
                  </enumeratedValue>
