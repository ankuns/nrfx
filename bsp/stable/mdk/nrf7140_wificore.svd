                    <value>0x05</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SDRWTRANSFER</name>
                    <description>Private I3C SDR Write Transfer.</description>
                    <value>0x06</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SDRRTRANSFER</name>
                    <description>Private I3C SDR Read Transfer.</description>
                    <value>0x07</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SDRWTRANSFERI2C</name>
                    <description>Private I2C SDR Write Transfer.</description>
                    <value>0x08</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SDRRTRANSFERI2C</name>
                    <description>Private I2C SDR Read Transfer.</description>
                    <value>0x09</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TSWTRANSFER</name>
                    <description>Private HDR Ternary Symbol(TS) Write Transfer.</description>
                    <value>0x0A</value>
