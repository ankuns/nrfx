          </register>
          <register>
            <name>PCFCOEFF14</name>
            <description>TXSCP PCF COEFF14</description>
            <addressOffset>0x3F8</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PCFCOEFF26</name>
                <description>Filter Coefficient 26 for PCF. This is a 12-bit 2s complement value. Relevant when PCF_ENABLE = 1.</description>
