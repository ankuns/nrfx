          <register>
            <name>CONFIG1</name>
            <description>WLAN RTM TD CONFIG 1</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00225C62</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRTMTDFSBENERGYSHIFT</name>
                <description>Fine symbol boundary energy scale shift (u3.0).</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
              <field>
                <name>WLANRTMTDFSBENERGYTHRESH</name>
                <description>Fine symbol boundary peak detection threshold ratio (u0.7).</description>
                <lsb>3</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>WLANRTMTDFSBCORRTHRESHOLD</name>
                <description>Fine symbol boundary energy correlation threshold ratio (u0.8).</description>
                <lsb>10</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>WLANRTMTDRXWAKEUPTIMEUS</name>
                <description>Standby to Active time in us (u4.2).Note: Used to enable RX prior to expiry of the packet duration counter when Power Save mode is active.</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG2</name>
            <description>WLAN RTM TD CONFIG 2</description>
            <addressOffset>0x14</addressOffset>
            <access>read-write</access>
            <resetValue>0x00001062</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRTMTDSFOPPMCONVFACT</name>
                <description>Sampling Frequency Offset, time tracking conversion factor: value of [resampler factor] * OpBW/fc,where OpBw is the operating bandwidth and fc is the channel centre frequency. (u-4.20)Note: default value set for resampler factor = 1, OpBW = 20MHz and fc = 5GHz</description>
                <lsb>0</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMTDSFOBYPASS</name>
                <description>Bypass Sample Frequency Offset when set to 1</description>
                <lsb>16</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>WLANRTMTDFSBDETECTLENCRR</name>
                <description>Fine symbol boundary detection length correction factor (s5.0).</description>
                <lsb>18</lsb>
                <msb>23</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG3</name>
            <description>WLAN RTM TD CONFIG 3</description>
            <addressOffset>0x18</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000400</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>WLANRTMTDCCACONTROLDIS</name>
                <description>Disable / enable CCA control for correlation indication and status known (ED).Timer non-zero flag always zero when disabled.</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCDIS</name>
                <description>Disable / enable AGC control for the second estimation (ED/AGC).</description>
                <lsb>1</lsb>
                <msb>1</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCADJUST</name>
                <description>Second AGC start wait time adjustment in number of samples. (s6.0)</description>
                <lsb>2</lsb>
                <msb>8</msb>
              </field>
              <field>
                <name>WLANRTMTDSECONDAGCLENSEL</name>
                <description>Second AGC estimation window length selection: ceil(log2(0.8*Fs)) - 3, where Fs is the ADC sampling rate.Note: default value is set assuming Fs equals 40MHz</description>
                <lsb>9</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLENABLE</name>
                <description>Enable/disable Jammer Rejection Logic : ED threshold and minimum variance for OFDM correlation PASS increased toED RSSI snapshot + EdThresholdMargin when Jammer is detected.</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLDETECTIONTHRESHOLD</name>
                <description>Jammer Detection Threshold. Total number of s2lFails required to trigger Jammer detection - 1 (u3.0).</description>
                <lsb>13</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>WLANRTMTDJRLEDTHRESHOLDMARGIN</name>
                <description>Headroom added to the minimum variance for OFDM correlation once Jammer signal is detected in dB (u3.0).</description>
                <lsb>16</lsb>
                <msb>18</msb>
              </field>
              <field>
                <name>WLANRTMTDDCGDCOFFSETHTSTFMODE</name>
                <description>0: DC offset compensation for HT-STF/VHT-STF/HE-STF based on RTM-DCG DC estimation (2nd AGC enabled).1: DC offset compensation for HT-STF/VHT-STF/HE-STF based on ED DC estimation.</description>
                <lsb>19</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>WLANRTMTDDCGDCOFFSETLSTFMODE</name>
                <description>0: DC offset compensation for L-STF based on RTM-DCG DC estimation.1: DC offset compensation for L-STF based on ED DC estimation.</description>
                <lsb>20</lsb>
                <msb>20</msb>
              </field>
            </fields>
          </register>
