            </field>
            <field>
              <name>APPCLEAR_1</name>
              <description>Sets the corresponding bits in the CTIAPPSET to 0. There is one bit of the register for each channel.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
