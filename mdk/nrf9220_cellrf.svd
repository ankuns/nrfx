                  <name>PROG</name>
                  <description>Program signal</description>
                  <lsb>6</lsb>
                  <msb>6</msb>
                </field>
                <field>
                  <name>ERASE</name>
                  <description>Erase signal</description>
                  <lsb>7</lsb>
                  <msb>7</msb>
                </field>
                <field>
                  <name>SCE</name>
