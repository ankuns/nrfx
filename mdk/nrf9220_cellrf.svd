              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>DES_0</name>
              <description>Bits [3:0] of the JEDEC identity code indicating the designer of the component, together with the continuation code.</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDR2</name>
          <description>Peripheral ID2 Register</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000001B</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DES_1</name>
              <description>Bits [6:4] of the JEDEC identity code indicating the designer of the component, together with the continuation code.</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
