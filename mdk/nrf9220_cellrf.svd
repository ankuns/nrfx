    </peripheral>
    <peripheral>
      <name>GLOBAL_ETB</name>
      <description>Embedded Trace Buffer</description>
      <baseAddress>0xBF044000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>ETB</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>RDP</name>
          <description>ETB RAM Depth Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ETB_RAM_DEPTH</name>
              <description>Defines the depth, in words, of the trace RAM.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>STS</name>
          <description>ETB Status Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000008</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FULL</name>
              <description>RAM Full. The flag indicates when the RAM write pointer has wrapped around.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>TRIGGERED</name>
              <description>The Triggered bit is set when a trigger has been observed. This does not indicate that a trigger has been embedded in the trace data by the formatter, but is determined by the programming of the Formatter and Flush Control Register.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>ACQCOMP</name>
              <description>The acquisition complete flag indicates that capture has been completed when the formatter stops because of any of the methods defined in the Formatter and Flush Control Register, or TraceCaptEn = 0. This also results in FtStopped in the Formatter and Flush Status Register going HIGH.</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>FTEMPTY</name>
              <description>Formatter pipeline empty. All data stored to RAM.</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RRD</name>
          <description>ETB RAM Read Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RAM_READ_DATA</name>
              <description>Data read from the ETB Trace RAM.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RRP</name>
          <description>ETB RAM Read Pointer Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RAM_READ_POINTER</name>
              <description>Sets the read pointer used to read entries from the Trace RAM over the APB interface.</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RWP</name>
          <description>ETB RAM Write Pointer Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RAM_WRITE_POINTER</name>
              <description>Sets the write pointer used to write entries from the CoreSight bus into the Trace RAM.</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>TRG</name>
          <description>ETB Trigger Counter Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRIGGER_COUNTER</name>
              <description>The counter is used as follows:Trace after - The counter is set to a large value, slightly less than the number of entries in the RAM. Trace before - The counter is set to a small value. Trace about - The counter is set to half the depth of the Trace RAM. This register must not be written to when trace capture is enabled (FtStopped=0, TraceCaptEn=1). If a write is attempted, the register is not updated. A read access is permitted with trace capture enabled.</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CTL</name>
          <description>ETB Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRACECAPTEN</name>
              <description>ETB Trace Capture Enable. This is the master enable bit forcing FtStopped HIGH when TraceCaptEn is LOW. When capture is disabled, any remaining data in the ATB formatter is stored to RAM. When all data is stored the formatter outputs FtStopped. Capture is fully disabled, or complete, when FtStopped goes HIGH. See ETB Formatter and Flush Status Register, FFSR, 0x300.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RWD</name>
          <description>ETB RAM Write Data Register</description>
          <addressOffset>0x24</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RAM_WRITE_DATA</name>
              <description>Data written to the ETB Trace RAM. When trace capture is disabled, the contents of this register are placed into the ETB Trace RAM when this register is written to. Writing to this register increments the RAM Write Pointer Register. If trace capture is enabled, and this register is accessed, then a read from this register outputs 0xFFFFFFFF. Reads of this register never increment the RAM Write Pointer Register. A constant stream of 1s being output corresponds to a synchronization output from the ETB. If a write access is attempted, the data is not written into Trace RAM.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FFSR</name>
          <description>ETB Formatter and Flush Status Register</description>
          <addressOffset>0x300</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FLINPROG</name>
              <description>Flush In Progress. This is an indication of the current state of afvalids.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>FTSTOPPED</name>
              <description>Formatter stopped. The formatter has received a stop request signal and all trace data and post-amble has been output. Any more trace data on the ATB interface is ignored and atreadys goes HIGH.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FFCR</name>
          <description>ETB Formatter and Flush Control Register</description>
          <addressOffset>0x304</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENFTC</name>
              <description>Do not embed Triggers into the formatted stream. Trace disable cycles and triggers are indicated by TRACECTL, where fitted. Can only be changed when FtStopped is HIGH. This bit is clear on reset.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>ENFCONT</name>
              <description>Continuous mode in the ETB corresponds to normal mode with the embedding of triggers. Can only be changed when FtStopped is HIGH. This bit is clear on reset.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>FONFLIN</name>
              <description>Set this bit to enable use of the flushin connection. This is clear on reset.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>FONTRIG</name>
              <description>Generate flush using Trigger event. Set this bit to cause a flush of data in the system when a Trigger Event occurs. This bit is clear on reset. A Trigger Event is defined as when the Trigger counter reaches zero (where fitted) or, in the case of the trigger counter being zero (or not fitted), when trigin is HIGH.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>FONMAN</name>
              <description>Setting this bit causes a flush to be generated. This is cleared when this flush has been serviced. This bit is clear on reset.</description>
              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>TRIGIN</name>
              <description>Indicate a trigger on trigin being asserted.</description>
              <lsb>8</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>TRIGEVT</name>
              <description>Indicate a trigger on a Trigger Event.</description>
              <lsb>9</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>TRIGFL</name>
              <description>Indicates a trigger on Flush completion (afreadys being returned).</description>
              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>STOPFL</name>
              <description>This forces the FIFO to drain off any part-completed packets. Setting this bit enables this function but this is clear on reset (disabled).</description>
              <lsb>12</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>STOPTRIG</name>
              <description>Stop the formatter after a Trigger Event is observed. Reset to disabled (zero).</description>
              <lsb>13</lsb>
              <msb>13</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITMISCOP0</name>
          <description>Integration Test Miscellaneous Output Register 0</description>
          <addressOffset>0xEE0</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ACQCOMP</name>
              <description>Set the value of acqcomp.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>FULL</name>
              <description>Set the value of full output port.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITTRFLINACK</name>
          <description>Integration Test Trigger In and Flush In Acknowledge Register</description>
          <addressOffset>0xEE4</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRIGINACK</name>
              <description>Set the value of triginack.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>FLUSHINACK</name>
              <description>Set the value of flushinack.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITTRFLIN</name>
          <description>Integration Test Trigger In and Flush In Register</description>
          <addressOffset>0xEE8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRIGIN</name>
              <description>Read the value of trigin.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>FLUSHIN</name>
              <description>Read the value of flushin.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBDATA0</name>
          <description>Integration Test ATB Data Register 0</description>
          <addressOffset>0xEEC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATDATA_0</name>
              <description>Read the value of atdatas[0].</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>ATDATA_7</name>
              <description>Read the value of atdatas[7].</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>ATDATA_15</name>
              <description>Read the value of atdatas[15].</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>ATDATA_23</name>
              <description>Read the value of atdatas[23].</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>ATDATA_31</name>
              <description>Read the value of atdatas[31].</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR2</name>
          <description>Integration Test ATB Control Register 2</description>
          <addressOffset>0xEF0</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATREADYS</name>
              <description>Set the value of atreadys.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>AFVALIDS</name>
              <description>Set the value of afvalids.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR1</name>
          <description>Integration Test ATB Control Register 1</description>
          <addressOffset>0xEF4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATID</name>
              <description>Read the value of atids.</description>
              <lsb>0</lsb>
              <msb>6</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITATBCTR0</name>
          <description>Integration Test ATB Control Register 0</description>
          <addressOffset>0xEF8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ATVALID</name>
              <description>Read the value of atvalids.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>AFREADY</name>
              <description>Read the value of afreadys.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>ATBYTES</name>
              <description>Read the value of atbytess.</description>
              <lsb>8</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ITCTRL</name>
          <description>Integration Mode Control Register</description>
          <addressOffset>0xF00</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>INTEGRATION_MODE</name>
              <description>Allows the component to switch from functional mode to integration mode or back.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMSET</name>
          <description>Claim Tag Set Register</description>
          <addressOffset>0xFA0</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000000F</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CLAIMSET</name>
              <description>This claim tag bit is implemented</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CLAIMCLR</name>
          <description>Claim Tag Clear Register</description>
          <addressOffset>0xFA4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CLAIMCLR</name>
              <description>The value present reflects the current setting of the Claim Tag.</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>LAR</name>
          <description>Lock Access Register</description>
          <addressOffset>0xFB0</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ACCESS_W</name>
              <description>A write of 0xC5ACCE55 enables further write access to this device. A write of any value other than 0xC5ACCE55 will have the affect of removing write access.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Lock Status Register</description>
          <addressOffset>0xFB4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000003</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>LOCKEXIST</name>
              <description>Indicates that a lock control mechanism exists for this device. This bit reads as 0 when read from an external debugger (paddrdbg31 = 1) since external debugger accesses are not subject to Lock Registers.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>LOCKGRANT</name>
              <description>Returns the current status of the Lock. This bit reads as 0 when read from an external debugger (paddrdbg31 = 1) since external debugger accesses are not subject to Lock Registers.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>LOCKTYPE</name>
              <description>Indicates if the Lock Access Register (0xFB0) is implemented as 8-bit or 32-bit</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTHSTATUS</name>
          <description>Authentication Status Register</description>
          <addressOffset>0xFB8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>NSID</name>
              <description>Indicates the security level for non-secure invasive debug</description>
              <lsb>0</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>NSNID</name>
              <description>Indicates the security level for non-secure non-invasive debug</description>
              <lsb>2</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>SID</name>
              <description>Indicates the security level for secure invasive debug</description>
              <lsb>4</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SNID</name>
              <description>Indicates the security level for secure non-invasive debug</description>
              <lsb>6</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVID</name>
          <description>Device Configuration Register</description>
          <addressOffset>0xFC8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>EXTMUXNUM</name>
              <description>When non-zero this value indicates the type/number of ATB multiplexing present on the input to the ATB.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>RAMCLK</name>
              <description>This bit returns 0 on reads indicating that the ETB RAM operates synchronously to atclk.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVTYPE</name>
          <description>Device Type Identifier Register</description>
          <addressOffset>0xFCC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000021</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MAJOR_TYPE</name>
              <description>Major classification grouping for this debug/trace component</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>SUB_TYPE</name>
              <description>Sub-classification within the major category</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PERIPHID4</name>
          <description>Peripheral ID4 Register</description>
          <addressOffset>0xFD0</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000004</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DES_2</name>
              <description>JEDEC continuation code indicating the designer of the component (along with the identity code)</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>SIZE</name>
              <description>This is a 4-bit value that indicates the total contiguous size of the memory window used by this component in powers of 2 from the standard 4KB. If a component only requires the standard 4KB then this should read as 0x0, 4KB only, for 8KB set to 0x1, 16KB == 0x2, 32KB == 0x3, and so on.</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PERIPHID0</name>
          <description>Peripheral ID0 Register</description>
          <addressOffset>0xFE0</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000007</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PART_0</name>
              <description>Bits [7:0] of the component's part number. This is selected by the designer of the component.</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PERIPHID1</name>
          <description>Peripheral ID1 Register</description>
          <addressOffset>0xFE4</addressOffset>
          <access>read-only</access>
          <resetValue>0x000000B9</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PART_1</name>
              <description>Bits [11:8] of the component's part number. This is selected by the designer of the component.</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>DES_0</name>
              <description>Bits 3:0 of the JEDEC identity code indicating the designer of the component (along with the continuation code)</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PERIPHID2</name>
          <description>Peripheral ID2 Register</description>
          <addressOffset>0xFE8</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000004B</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DES_1</name>
              <description>Bits 6:4 of the JEDEC identity code indicating the designer of the component (along with the continuation code)</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>JEDEC</name>
              <description>Always set. Indicates that a JEDEC assigned value is used</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>REVISION</name>
              <description>The Revision field is an incremental value starting at 0x0 for the first design of this component. This only increases by 1 for both major and minor revisions and is simply used as a look-up to establish the exact major/minor revision.</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PERIPHID3</name>
          <description>Peripheral ID3 Register</description>
          <addressOffset>0xFEC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CMOD</name>
              <description>Where the component is reusable IP, this value indicates if the customer has modified the behavior of the component. In most cases this field is zero.</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>REVAND</name>
              <description>This field indicates minor errata fixes specific to this design, for example metal fixes after implementation. In most cases this field is zero. It is recommended that component designers ensure this field can be changed by a metal fix if required, for example by driving it from registers that reset to zero.</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPID0</name>
          <description>Component ID0 Register</description>
          <addressOffset>0xFF0</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000000D</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PRMBL_0</name>
              <description>Contains bits [7:0] of the component identification</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPID1</name>
          <description>Component ID1 Register</description>
          <addressOffset>0xFF4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000090</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PRMBL_1</name>
              <description>Contains bits [11:8] of the component identification</description>
              <lsb>0</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>CLASS</name>
              <description>Class of the component. E. g. ROM table, CoreSight component etc. Constitutes bits [15:12] of the component identification.</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPID2</name>
          <description>Component ID2 Register</description>
          <addressOffset>0xFF8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000005</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PRMBL_2</name>
              <description>Contains bits [23:16] of the component identification</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>COMPID3</name>
          <description>Component ID3 Register</description>
          <addressOffset>0xFFC</addressOffset>
          <access>read-only</access>
          <resetValue>0x000000B1</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PRMBL_3</name>
              <description>Contains bits [31:24] of the component identification</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>GLOBAL_ETR</name>
      <description>Embedded Trace Router</description>
      <baseAddress>0xBF045000</baseAddress>
      <!--Security dma=NA-->
      <!--Security securemapping=NS-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <groupName>ETR</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>RSZ</name>
          <description>RAM Size register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RSZ</name>
              <description>Size of the RAM in 32-bit words.</description>
              <lsb>0</lsb>
              <msb>30</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>STS</name>
          <description>Status Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-only</access>
          <resetValue>0x0000000C</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FULL</name>
              <description>This bit can be used to help determine how much of the trace buffer contains valid data.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>TRIGGERED</name>
              <description>The Triggered bit is set when trace capture is in progress and the TMC has detected a trigger event.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>TMCREADY</name>
              <description>TMC ready</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>FTEMPTY</name>
              <description>This bit is set when trace capture has stopped, and all internal pipelines and buffers have drained.</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>EMPTY</name>
              <description>If set, this bit indicates that the TMC does not contain any valid trace data in the trace memory.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>MEMERR</name>
              <description>This bit indicates that an error has occurred on the AXI master interface.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RRD</name>
          <description>RAM Read Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RRD</name>
              <description>Reads return data from Trace RAM</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RRP</name>
          <description>RAM Read Pointer Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RRP</name>
              <description>This value represents the location in trace memory that will be accessed on a subsequent RRD read.</description>
              <lsb>0</lsb>
              <msb>8</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RWP</name>
          <description>RAM Write Pointer Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RWP</name>
              <description>This value represents the location in trace memory that will be accessed on a subsequent write to the trace memory.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>TRG</name>
          <description>Trigger Counter Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRG</name>
              <description>This count represents the number of 32-bit words between a TRIGIN/trigger packet and a trigger event.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CTL</name>
          <description>Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TRACECAPTEN</name>
              <description>Setting this bit to 1 enables the TMC to capture trace data.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RWD</name>
          <description>RAM Write Data Register</description>
          <addressOffset>0x24</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RWD</name>
              <description>Data written to this register is placed in the Trace RAM.</description>
              <lsb>0</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MODE</name>
          <description>Mode Register</description>
          <addressOffset>0x28</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MODE</name>
              <description>Selects the operating mode.</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CIRCULARBUF</name>
                  <description>Circular Buffer mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FIFO</name>
                  <description>Software FIFO mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>LBUFLEVEL</name>
          <description>Latched Buffer Fill Level</description>
          <addressOffset>0x2C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>LBUFLEVEL</name>
              <description>Indicates the maximum fill level of the trace memory in 32-bit words since this register was last read.</description>
              <lsb>0</lsb>
              <msb>30</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CBUFLEVEL</name>
          <description>Current Buffer Fill Level</description>
          <addressOffset>0x30</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CBUFLEVEL</name>
              <description>Indicates the current fill level of the trace memory in 32-bit words.</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>BUFWM</name>
          <description>Buffer Level Water Mark</description>
          <addressOffset>0x34</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>BUFWM</name>
              <description>Indicates the desired threshold vacancy level in 32-bit words in the trace memory.</description>
              <lsb>0</lsb>
              <msb>6</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RRPHI</name>
          <description>RAM Read Pointer High Register</description>
          <addressOffset>0x38</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RRPHI</name>
              <description>Bits[39:32] of the read pointer</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RWPHI</name>
          <description>RAM Write Pointer High Register</description>
          <addressOffset>0x3C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>RWPHI</name>
              <description>Bits[39:32] of the write pointer</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>AXICTL</name>
          <description>AXI Control Register</description>
          <addressOffset>0x110</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PROTCTRLBIT0</name>
              <description>This bit controls the value driven on ARPROTM[0]/AWPROTM[0] on the AXI interface when performing AXI transfers.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>PROTCTRLBIT1</name>
              <description>This bit controls the value driven on ARPROTM[1]/AWPROTM[1] on the AXI interface when performing AXI transfers.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>CACHECTRLBIT0</name>
              <description>This bit controls the value driven on the ARCACHEM[0]/AWCACHEM[0] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>CACHECTRLBIT1</name>
              <description>This bit controls the value driven on the ARCACHEM[1]/AWCACHEM[1] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>CACHECTRLBIT2</name>
              <description>This bit controls the value driven on the ARCACHEM[2]/AWCACHEM[2] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>4</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>CACHECTRLBIT3</name>
              <description>This bit controls the value driven on the ARCACHEM[3]/AWCACHEM[3] signal on the AXI interface when performing AXI transfers.</description>
              <lsb>5</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SCATTERGATHERMODE</name>
              <description>This bit indicates whether trace memory is accessed as a single buffer in system memory or as a linked-list based scatter-gather memory.</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>WRBURSTLEN</name>
