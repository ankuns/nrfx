        <register>
          <name>PENALTY_REG_1</name>
          <description>Penalty register for PCP 1.</description>
          <addressOffset>0xC04</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFC</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PENALTY</name>
              <description>Penalty level.</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Full</name>
                  <description>(Auto 0) Full penalty</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Semi0</name>
                  <description>(Auto 1) Semi (power on, clock off)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Semi1</name>
                  <description>(Auto 2) Semi (power on, clock core on, clock buffer off)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Zero</name>
                  <description>(Auto 3) Zero penalty</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
