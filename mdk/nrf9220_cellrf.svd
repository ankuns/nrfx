                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Read: PUF.READ is not locked.</description>
                    <value>0x00000001</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
