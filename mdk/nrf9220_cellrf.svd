                </enumeratedValue>
                <enumeratedValue>
                  <name>64cycles</name>
                  <description>64 cycles</description>
                  <value>0x3F</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FALL_LIMIT</name>
