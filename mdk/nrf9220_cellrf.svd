          <description>Send or receive command directly to/from the AdPllLte digital island. Only write to this register when FSASYNCBUSBUSY returns 0</description>
          <addressOffset>0x0400</addressOffset>
          <access>read-write</access>
          <resetValue>0x00BC0050</resetValue>
          <alternateRegister>FSCOMMAND_ANA_ISOLATION</alternateRegister>
          <size>0x20</size>
          <fields>
            <field>
              <name>NORM_TRK_COUNT_CLIPS</name>
              <description>The TRK bank overflow happens if the value stays outside min/max of TRK for more than this number of cycles. If it does, we signal an TRK bank overflow and bump the ACQ control word, and lower the TRK control word.</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>FSCOMMANDADDR</name>
              <description>Address for the async interface. ALWAYS 0xBC.</description>
              <lsb>16</lsb>
              <msb>27</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORM_TRK_COUNT_CLIPS_ADDR</name>
                  <description>ALWAYS 0xBC.</description>
                  <value>0x0BC</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>READ</name>
              <description>When 1, a read transaction is initiated. When the event COMPLETETRANS is set, read back this register</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
