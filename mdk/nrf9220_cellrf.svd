              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Multiplier disabled.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Multiplier enabled.</description>
