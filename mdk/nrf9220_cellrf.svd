            <size>0x20</size>
            <fields>
              <field>
                <name>V</name>
                <description>NFCID1 byte V</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>U</name>
                <description>NFCID1 byte U</description>
                <lsb>8</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>T</name>
                <description>NFCID1 byte T</description>
                <lsb>16</lsb>
                <msb>23</msb>
