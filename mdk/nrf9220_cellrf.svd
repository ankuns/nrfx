          <description>Status bit indicating whether the unitrigger is currently busy or not</description>
          <addressOffset>0x041C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>UNITRIGGERBUSY</name>
