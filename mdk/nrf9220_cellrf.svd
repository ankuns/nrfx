      <registers>
        <cluster>
          <dim>16</dim>
          <dimIncrement>0x1000000</dimIncrement>
          <name>DOMAIN[%s]</name>
          <description>Unspecified</description>
          <headerStructName>STMDATA_DOMAIN</headerStructName>
          <access>read-write</access>
          <addressOffset>0x000</addressOffset>
          <register>
            <dim>0x1000000</dim>
            <dimIncrement>0x1</dimIncrement>
            <name>DATA[%s]</name>
            <description>Description collection: STM extended stimulus port data buffer area for domain n. NonSecure writes to this region generates trace packets with id n+96. Secure writes to this region generates trace packets with id n+32.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00</resetValue>
            <dataType>uint8_t</dataType>
            <size>0x8</size>
            <!--Security securemapping=NS-->
          </register>
        </cluster>
      </registers>
    </peripheral>
