          <addressOffset>0x650</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>OVRENPWRUP</name>
              <description>Override enable for OVERRIDE_PWRUP</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>OVRENMODULATION</name>
              <description>Override enable for modulation on/off</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>OVRENCMFBPDREF</name>
