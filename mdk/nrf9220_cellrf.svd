                  <msb>17</msb>
                </field>
                <field>
                  <name>ECCBYPS</name>
                  <description>Bypass ECC Encoder and Decoder</description>
                  <lsb>18</lsb>
                  <msb>18</msb>
                </field>
                <field>
                  <name>DPD</name>
