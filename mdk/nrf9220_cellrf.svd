          <fields>
            <field>
              <name>TRK_OVERFLOW_PAUSE_EST_KDTC</name>
              <description>When the TRK bank overflows, we disable the input to the kDTC estimator for a while (multiplied by 8)</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>TRK_OVERFLOW_GO_TO_GEAR_SETTING</name>
              <description>Go to one of the configured gear settings when the TRK bank overflows. 0: off, 1: Go to FSM_TRK_THIRD_GEAR, 2: Go to FSM_TRK_SECOND_GEAR, 3: Go to FSM_TRK_FIRST_GEAR</description>
              <lsb>5</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>TRK_OVERFLOW_RESET_UNWRAP</name>
              <description>Reset the unwrap accumulator when overflowing the TRK bank and stepping the ACQ bank</description>
              <lsb>7</lsb>
              <msb>7</msb>
            </field>
            <field>
