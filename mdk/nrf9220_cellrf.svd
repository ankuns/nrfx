              <msb>4</msb>
            </field>
            <field>
              <name>ACTIVE</name>
              <description>Status of dsaActive, i.e. an indication whether DSA2 is currently executing a sequence.</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
