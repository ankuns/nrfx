      </addressBlock>
      <groupName>TPIU</groupName>
      <size>0x20</size>
      <registers>
        <register>
          <name>SUPPORTEDPORTSIZES</name>
          <description>Each bit location is a single port size that is supported on the device.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PORT_SIZE_1</name>
              <description>Indicates whether the TPIU supports port size of 1-bit.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSupported</name>
                  <description>Port size 1 is not supported.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Supported</name>
                  <description>Port size 1 is supported.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PORT_SIZE_2</name>
              <description>Indicates whether the TPIU supports port size of 2-bit.</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSupported</name>
                  <description>Port size 2 is not supported.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Supported</name>
                  <description>Port size 2 is supported.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PORT_SIZE_3</name>
              <description>Indicates whether the TPIU supports port size of 3-bit.</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotSupported</name>
                  <description>Port size 3 is not supported.</description>
                  <value>0x0</value>
