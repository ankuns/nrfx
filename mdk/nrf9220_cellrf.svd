        <register>
          <name>RX_CONFIGDONE</name>
          <description>RX configuration done.</description>
          <addressOffset>0x51C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>This bit  indicates that RX digital has been configured. This bit must be asserted at the end of the configuration so that e.g. synchronization of registers to the core works correctly. This bit must be deasserted  when RX digital is disabled.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ConfNotDone</name>
                  <description>Configuration not done</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ConfDone</name>
                  <description>Configuration done</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RX_IQ_CONFIG</name>
