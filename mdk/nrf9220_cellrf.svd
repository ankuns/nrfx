        <register>
          <name>FSASYNCBUSCONF</name>
          <description>Some special settings for the asynchronous bus configuration</description>
          <addressOffset>0x0420</addressOffset>
          <access>read-write</access>
          <resetValue>0x0000000A</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DISABLEAUTOSETTING</name>
              <description>Do not send settings at the beginning to AdPllLte</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>CHECKSTATUSAUTO</name>
              <description>When set to 1, monitor the transactions while in auto-send mode. Upon the first erroneous transaction, halt the state machine immediately</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>IGNORECLOCKSTARTED</name>
              <description>The bus scheduler will not wait for AdPllLte to say clockStarted</description>
