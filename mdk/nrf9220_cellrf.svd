          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TX_TXDAC_TM</name>
              <description>DAC test mode control. See Test modes section.</description>
              <lsb>0</lsb>
              <msb>9</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low_RL</name>
                  <description>connects extra 200 ohm resistors parallel to DAC load in order to reduce output resistance and increase the bandwidth via WATB. Both I and Q.</description>
                  <value>0x200</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable_IplusQ_DAC_bias</name>
                  <description>to force I and Q DAC bias off even if PWRUP =1</description>
                  <value>0x100</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBD2</name>
                  <description>TBD</description>
