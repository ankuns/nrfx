        <register>
          <name>FESTATUS</name>
          <description>Frontend readout register</description>
          <addressOffset>0x904</addressOffset>
          <access>read-only</access>
          <resetValue>0x00001010</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CALPHI</name>
              <description>calPhi from IQCal</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>CALAMP</name>
              <description>calAmp from IQCal</description>
              <lsb>8</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>CALFIN</name>
              <description>High when IQCal search finished</description>
              <lsb>15</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>MAGNITUDE</name>
              <description>Magnitude output from BB peak detector</description>
              <lsb>16</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FECONFIG</name>
          <description>Config register</description>
          <addressOffset>0x908</addressOffset>
          <access>read-write</access>
          <resetValue>0x10800005</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ALPHA</name>
              <description>Alpha for IIR filter used in logMag calculation</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>SCALERDECAY</name>
              <description>The number of clock cycles to wait before stepping down the internal memory for the scaling. The value 0 means that the decay feature is off.</description>
              <lsb>8</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>SCALECONST</name>
              <description>A constant scaling that overrides dynamic scaling behaviour in the IQ Scaler. Value != 0 enables constant scaling.</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>SCALERMODE</name>
              <description>Mode for narrow scaling output.</description>
              <lsb>20</lsb>
              <msb>20</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Classic log based scaling mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>LUT based scaling mode.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SCALERWRAPPROTEN</name>
              <description>Wraparound protection in IQ Scaler.</description>
              <lsb>23</lsb>
              <msb>23</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable wraparound protection. Not recommended to disable with constant scaling.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Disable wraparound protection. Scaled input is set to max or min instead of wrapping around.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>QDISABLE</name>
