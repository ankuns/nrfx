                  <description>Use SFD match from UTxRxChain</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RXSYNC</name>
          <description>RxSyncEngine configuration</description>
          <addressOffset>0xB98</addressOffset>
          <access>read-write</access>
          <resetValue>0x00006390</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ALPHAFREQ</name>
              <description>Coefficient to update frequency offset. Default value is 10000, corresponds to 1/2.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>BETAFREQ</name>
              <description>Coefficient to update frequency offset. Default value is 11100, corresponds to 7/8.</description>
              <lsb>5</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>PEAKTH</name>
              <description>Threshold value for peak strength. Default value is 0001100, corresponds to (0.31^2) scaled by 2^7 .</description>
              <lsb>10</lsb>
              <msb>16</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>TXCONFIG</name>
          <description>Tx configuration</description>
          <addressOffset>0xC00</addressOffset>
