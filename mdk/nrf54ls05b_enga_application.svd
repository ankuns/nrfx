              <lsb>14</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>DONOTTRANSFER</name>
              <description>When 1, we do not transfer this word to AdPll at power up</description>
              <lsb>31</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>KDTC</name>
          <description>This value is written to the AdPll when powering up the digital island</description>
