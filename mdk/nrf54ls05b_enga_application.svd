          <register>
            <name>GAIN</name>
            <description>Gain boundary settings and gain steps</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x11091107</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCRFGAINMAX</name>
                <description>Maximum gain of RF gain</description>
                <lsb>0</lsb>
                <msb>3</msb>
              </field>
              <field>
                <name>AGCRFGAINMIN</name>
                <description>Minimum gain of RF gain</description>
                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>AGCRFGAINSTEPUP</name>
                <description>gain step for increasing RF gain</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>AGCRFGAINSTEPDOWN</name>
                <description>gain step for decreasing RF gain</description>
                <lsb>12</lsb>
                <msb>15</msb>
              </field>
              <field>
                <name>AGCIFGAINMAX</name>
                <description>Maximum gain of IF gain</description>
                <lsb>16</lsb>
                <msb>19</msb>
              </field>
              <field>
                <name>AGCIFGAINMIN</name>
                <description>Minimum gain of IF gain</description>
                <lsb>20</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>AGCIFGAINSTEPUP</name>
                <description>gain step for increasing IF gain</description>
                <lsb>24</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>AGCIFGAINSTEPDOWN</name>
                <description>gain step for decreasing IF gain</description>
                <lsb>28</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>Configuration to adjust gain control loop</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x801230C3</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>AGCENABLEGAINSWITCH</name>
                <description>Causes the RF gain to be decreased and the IF gain to be increased if the overall gain can be maintained</description>
                <lsb>0</lsb>
                <msb>0</msb>
              </field>
              <field>
                <name>AGCRFPKDETRESETCOUNT</name>
                <description>The number of clock cycles after the adjustment of gain that the reset signal to the RF peak detector is set high</description>
                <lsb>1</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>AGCWAIT</name>
                <description>The number of clock cycles between each adjustment of the gain while addressMatch is low</description>
                <lsb>5</lsb>
                <msb>10</msb>
              </field>
              <field>
                <name>AGCWAITPACKET</name>
                <description>The number of clock cycles between each adjustment of the gain while addressMatch is high</description>
                <lsb>11</lsb>
                <msb>16</msb>
              </field>
              <field>
                <name>AGCAAFOVERRIDE</name>
                <description>Override value for aafGain</description>
                <lsb>17</lsb>
                <msb>20</msb>
              </field>
              <field>
                <name>AGCMIXOVERRIDE</name>
                <description>Override value for mixGain</description>
                <lsb>21</lsb>
                <msb>21</msb>
              </field>
              <field>
                <name>AGCLNAOVERRIDE</name>
                <description>Override value for lnaGain</description>
                <lsb>22</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>AGCOVERRIDEGAIN</name>
                <description>0: AGC takes control of all gains, 1: Control all gains (aafGain, mixGain, lnaGain) from registers</description>
                <lsb>28</lsb>
                <msb>28</msb>
              </field>
              <field>
                <name>AGCTOGGLE</name>
                <description>Enable(1) or disable(0) functional testmode for AGC</description>
                <lsb>29</lsb>
                <msb>30</msb>
              </field>
              <field>
                <name>AGCENABLEGAINREVERT</name>
                <description>Gain reversion. 0: reduce IF gain before RF gain, 1: reduce RF gain before IF gain.</description>
                <lsb>31</lsb>
                <msb>31</msb>
              </field>
            </fields>
          </register>
