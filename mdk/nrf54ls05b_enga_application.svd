          <access>read-write</access>
          <addressOffset>0x760</addressOffset>
          <register>
            <name>TIMINGALL0</name>
            <description>Timing parameters for signals activated in both Rx and Tx mode</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x010000A0</resetValue>
            <size>0x20</size>
            <fields>
              <field>
