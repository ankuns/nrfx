          <addressOffset>0x081C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FSUNITRIGCALVAL</name>
              <description>Read the calibrated value for the universal trigger</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSUNITRIGMANUAL</name>
