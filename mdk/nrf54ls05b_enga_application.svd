          </fields>
        </register>
        <register>
          <name>DBCCORR</name>
          <description>Thresholds for the double correlator</description>
          <addressOffset>0xB40</addressOffset>
          <access>read-write</access>
          <resetValue>0x1FFFFF90</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TH</name>
              <description>Correlation threshold for double correlator in normal operation</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>STRICT</name>
              <description>Correlation threshold for double correlator used in BleLr mode to resync to another preamble while already working on a previous preamble. Also applies for Ieee 802.15.4 mode</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>PREVREQUIR</name>
              <description>Correlation threshold for double correlator used in BleLr mode to reject a later resync using DBCCORRTHSTRICT. Also applies for Ieee 802.15.4 mode</description>
              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>ADDRTIMEOUT</name>
              <description>Override value for address match timeout, [in bit periods] (hypermode). 0 means no timeout. If BALEN is 3, the actual value of DBCADDRTIMEOUT will be the value written to this register minus 8.</description>
              <lsb>24</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
