                <msb>13</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>Readout latest gain control status</description>
            <addressOffset>0x00C</addressOffset>
            <access>read-only</access>
            <resetValue>0x0000007F</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RSSI</name>
                <description>Raw status of received signal strength indicator, directly from RxAgc without buffering</description>
                <lsb>0</lsb>
                <msb>6</msb>
              </field>
              <field>
                <name>AAFGAIN</name>
                <description>Raw AAF gain status</description>
                <lsb>8</lsb>
                <msb>11</msb>
              </field>
              <field>
                <name>MIXGAIN</name>
                <description>Raw mixer gain status</description>
                <lsb>12</lsb>
                <msb>12</msb>
              </field>
              <field>
                <name>LNAGAIN</name>
                <description>Raw LNA gain status</description>
                <lsb>16</lsb>
                <msb>17</msb>
              </field>
              <field>
                <name>RFPKDET</name>
                <description>RF peak detector output after sync. Represent state[5:4] in RxAgc.</description>
                <lsb>24</lsb>
                <msb>25</msb>
              </field>
              <field>
                <name>IFPKDET</name>
                <description>IF peak detector output. Represent state[3:2] in RxAgc.</description>
                <lsb>26</lsb>
                <msb>27</msb>
              </field>
              <field>
                <name>BBPKDET</name>
                <description>BB peak detector output. Represent state[1:0] in RxAgc.</description>
                <lsb>28</lsb>
                <msb>29</msb>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>RXIF</name>
          <description>Unspecified</description>
          <headerStructName>RADIO_RXIF</headerStructName>
          <access>read-write</access>
          <addressOffset>0x7E4</addressOffset>
          <register>
            <name>RXPEAKDETECT</name>
