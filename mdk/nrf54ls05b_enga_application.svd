            <field>
              <name>BYPASSMAJVOTE</name>
              <description>Bypass majority vote</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Pass</name>
                  <description>Majority vote</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bypass</name>
                  <description>Bypass through majority vote</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SOFTBITMODE</name>
              <description>Method used for the softbit calulation</description>
              <lsb>8</lsb>
              <msb>9</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Max</name>
                  <description>Softbit calculation in MFB uses the maximum</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Sum</name>
                  <description>Softbit calculation in MFB uses the sum</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WSum1</name>
                  <description>Softbit calculation in MFB uses the weighted sum 1</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WSum2</name>
                  <description>Softbit calculation in MFB uses the weighted sum 2</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>USEMJ</name>
              <description>Use hard bit from majority vote as the output of the RxMFB. Use hard bit from soft bit generator otherwise.</description>
              <lsb>10</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>USEMJFB</name>
              <description>Use hard bit from majority vote as the feedback inside the RxMFB. Use hard bit from soft bit generator otherwise.</description>
              <lsb>11</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>ENABLEFEEDBACK</name>
              <description>Enable decision feedback for matched filter bank</description>
              <lsb>12</lsb>
              <msb>12</msb>
            </field>
          </fields>
