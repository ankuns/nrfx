                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>TFM is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>NUMSAMPLES</name>
