              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>SATDLYDEC</name>
              <description>Mode dependent saturation delay in decimation filters for different modes</description>
              <lsb>8</lsb>
              <msb>9</msb>
            </field>
