                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Include</name>
                    <description>LENGTH includes CRC</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PREAMPTRN</name>
