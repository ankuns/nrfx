          <cluster>
            <name>CALIBRATION</name>
            <description>Calibration values written from FICR</description>
            <headerStructName>REGULATORS_VREGMAIN_CALIBRATION</headerStructName>
            <access>read-write</access>
            <addressOffset>0x3C</addressOffset>
            <register>
              <name>CAL1</name>
              <description>Unspecified</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x083FC598</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>MAXCOILILIM</name>
                  <description>Set coil current limit to avoid core saturation</description>
                  <lsb>0</lsb>
                  <msb>3</msb>
                </field>
                <field>
                  <name>PFMICMPCAL</name>
                  <description>Calibration of PFM mode overcurrent comparator through duty cycle control (twos complement)</description>
                  <lsb>4</lsb>
                  <msb>6</msb>
                </field>
                <field>
                  <name>ENABLEELVMODE</name>
                  <description>Enable ELV mode (Extreme Low Voltage) to be automatically switched to in PFM mode if there is no power requests</description>
                  <lsb>7</lsb>
                  <msb>7</msb>
                </field>
                <field>
                  <name>PFMICMPTIMERSEL</name>
                  <description>Configure the time to stay in PWM mode after a PFM ICMP request. The timer has a minimum value of 32us and maximum value of 2ms, with exponential increments (32us, 64us, 128us, etc..). The timer has 3 bits to select the time value (n), where time = 32*(2^n) us. The value n=7, is not a valid configuration.</description>
                  <lsb>8</lsb>
                  <msb>10</msb>
                </field>
                <field>
                  <name>PWMMINTIMERSEL</name>
                  <description>Configure the minimum time to stay in PWM mode after a PWM mode request. The timer has a minimum value of 32us and maximum value of 256us, with linear increments of 32us (32us, 64us, 96us, etc..). The timer has 3 bits to select the timer value (n), where time = 32*(n + 1) us.</description>
                  <lsb>11</lsb>
                  <msb>13</msb>
                </field>
                <field>
                  <name>CLOCKPHASEOSCPWM8M</name>
                  <description>Configure the phase of the generated DCDC clock (for PWM mode) with respect to the system clock, 0 in phase and 1 is out of phase</description>
                  <lsb>14</lsb>
                  <msb>14</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>InPhase</name>
                      <description>In Phase</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>OutOfPhase</name>
                      <description>Out of phase</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEHELPERELV</name>
                  <description>Enable fast exit from ELV (helper mode in ELV, LDO will be powered ON)</description>
                  <lsb>15</lsb>
                  <msb>15</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>ELV helper mode ELV is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>ELV helper mode is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEHELPERPFM</name>
                  <description>Enable helper mode in PFM mode (LDO will be powered ON)</description>
                  <lsb>16</lsb>
                  <msb>16</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>PFM helper mode is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>PFM helper mode is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEHELPERPWM</name>
                  <description>Enable helper mode in PWM mode (LDO will be powered ON)</description>
                  <lsb>17</lsb>
                  <msb>17</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>PWM helper mode is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>PWM helper mode is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEPFMICMP</name>
                  <description>Enable PFM ICMP (to auto detect high load)</description>
                  <lsb>18</lsb>
                  <msb>18</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>PFM ICMP is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>PFM ICMP is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEPWMICMP</name>
                  <description>Enable PWM ICMP (to auto detect no high load current is present)</description>
                  <lsb>19</lsb>
                  <msb>19</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>PWM ICMP is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>PWM ICMP is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENABLEFASTELVEXIT</name>
                  <description>Enable fast exit from ELV. This must be enabled along with the ENABLEHELPERELV</description>
                  <lsb>20</lsb>
                  <msb>20</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Fast exit is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Fast exit is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PWMICMPPULSESSEL</name>
                  <description>Configure the number of PWM ICMP pulses to count before switching back to PFM. The counter can be configured with 32 (4us) and 64 (8us) pulse count for n=1,2 respectively. The counter can disabled with n=0. The value n=3, is not a valid configuration.</description>
                  <lsb>21</lsb>
                  <msb>22</msb>
                </field>
                <field>
                  <name>PWMVOLTCAL</name>
                  <description>Calibration of BUCK_LP_PWM output voltage</description>
                  <lsb>23</lsb>
                  <msb>27</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>CAL2</name>
              <description>Unspecified</description>
              <addressOffset>0x04</addressOffset>
              <access>read-write</access>
              <resetValue>0x1F0F7BC0</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>LDOTRIMDEFAULT</name>
                  <description>Calibration of LDO reference voltage for normal operation, 2nd complement</description>
                  <lsb>0</lsb>
                  <msb>4</msb>
                </field>
                <field>
                  <name>LDOTRIMHELPERELV</name>
                  <description>Calibration of LDO reference voltage for ELV helper mode operation, 2nd complement</description>
                  <lsb>5</lsb>
                  <msb>9</msb>
                </field>
                <field>
                  <name>LDOTRIMHELPERPFM</name>
                  <description>Calibration of LDO reference voltage for PFM helper mode operation, 2nd complement</description>
                  <lsb>10</lsb>
                  <msb>14</msb>
                </field>
                <field>
                  <name>LDOTRIMHELPERPWM</name>
                  <description>Calibration of LDO reference voltage for PWM helper mode operation, 2nd complement</description>
                  <lsb>15</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>PFMVOLTCAL</name>
                  <description>Calibration of BUCK_LP_PFM output voltage</description>
                  <lsb>20</lsb>
                  <msb>24</msb>
                </field>
                <field>
                  <name>PFMELVVOLTCAL</name>
                  <description>Calibration of ELV output voltage</description>
                  <lsb>25</lsb>
                  <msb>29</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
