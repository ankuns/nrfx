            <field>
              <name>VALUE_1</name>
              <description>Waitstates value for frequency index [1]</description>
              <lsb>4</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>VALUE_2</name>
              <description>Waitstates value for frequency index [2]</description>
              <lsb>8</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>RDONE</name>
              <description>Use RDONE (read done) signal from the RRAM macro in addition to waitstates 
                  specified above. The data is read after RDONE signal is set, regardless of waitstates value.</description>
              <lsb>12</lsb>
              <msb>12</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Do not use RDONE signal from the RRAM macro</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Use RDONE signal from the RRAM macro</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key to enable the writing to this register</description>
              <lsb>16</lsb>
              <msb>31</msb>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable the writing to this register</description>
                  <value>0x0000</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable the writing to this register</description>
                  <value>0xA66D</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
