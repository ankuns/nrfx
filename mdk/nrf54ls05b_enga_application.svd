            <access>read-write</access>
            <resetValue>0x000000A0</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>NUMSAMPLES</name>
                <description>Maximum value supported is 160</description>
                <lsb>0</lsb>
                <msb>7</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>NEXTFREQUENCY</name>
