        <register>
          <name>FSASYNCBUSCONF</name>
          <description>Some special settings for the asynchronous bus configuration</description>
          <addressOffset>0x0828</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CHECKSTATUS</name>
              <description>When 1, every write transaction uses 8 x 32 MHz clock cycles instead of 4 x 32 MHz clock cycles. Confirmation is received whether the transaction was actually received by AdPll.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>DISABLEAUTOSETTING</name>
              <description>Do not send settings at the beginning to AdPll</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>CHECKSTATUSAUTO</name>
              <description>When 1, check the first transaction during sending auto. If errorenous stop the state machine</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>IGNORECLOCKSTARTED</name>
              <description>The bus scheduler will not wait for AdPll to say clockStarted</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>FSASYNCBUSBUSY</name>
          <description>Status bit indicating whether the bus is currently busy or not</description>
          <addressOffset>0x082C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FSASYNCBUSBUSY</name>
              <description>Whether the bus is currently busy or not</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>ADPLLCOMPANIONBACKDOORS</name>
          <description>This value is written to the AdPll when powering up the digital island</description>
          <addressOffset>0x0830</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000320</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>FLIPSSEL</name>
              <description>If 0, we flip the interpretation of the sSel signal (to work around a bug if we have managed to flip it somewhere in the design process)</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>REQUESTCLOCKOVERRIDE</name>
              <description>In normal operation we request clock when pwrupFsLdoDig0 is set. By setting this to 1, we will request clock even when pwrupFsLdoDig0. This may be useful for current measurements of FS_DIG</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>OVRENCK32MCORE</name>
              <description>Make it possible to manually control whether ck32MCore is sent to the AdPll digital island. Needed to test complete clock silence in the AdPll island. It can also be used to enable the clock activity on the clock net even when the clock is not selected.</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>OVRVALCK32MCORE</name>
              <description>Whether ck32MCore is active or not when OVRENCK32MCORE is set. See also description of OVRENCK32MCORE</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>ONTHEFLYWILLTRIGGER</name>
              <description>0: no relock, 1: first gear of TRK, 2: back to ACQ, 3: back to full lock</description>
              <lsb>4</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>RELOADFREQWILLTRIGGER</name>
              <description>0: no relock, 1: first gear of TRK, 2: back to ACQ, 3: back to full lock</description>
              <lsb>8</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>PVTTOT</name>
          <description>This value is written to the AdPll when powering up the digital island</description>
          <addressOffset>0x0840</addressOffset>
          <access>read-write</access>
          <resetValue>0x80000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PVTTOT</name>
