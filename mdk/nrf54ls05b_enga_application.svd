              <lsb>0</lsb>
              <msb>12</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DEVIATION</name>
          <description>Frequency deviation for modulation</description>
          <addressOffset>0x0808</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DEVIATION</name>
              <description>Frequency deviation for modulation</description>
              <lsb>0</lsb>
              <msb>9</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MODRATE</name>
          <description>Select modulation rate</description>
          <addressOffset>0x080C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MODRATE</name>
