                    <name>Pierce</name>
                    <description>Force to Pierce mode</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ExtSqrSin192M</name>
                    <description>Force to External Square or External Sine 192MHz mode</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ExtSin</name>
                    <description>Force to External Sine mode</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>EN</name>
                <description>Enable force mode for the XOSC32M</description>
                <lsb>31</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable force mode for FSM</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable force mode for FSM</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>PEAKDETECTOR</name>
            <description>Peak Detector pkdOut</description>
            <addressOffset>0x08</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PEAKDETECTOR</name>
                <description>Current Peak Detector pkdOut</description>
                <lsb>0</lsb>
                <msb>2</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>IDACCODE</name>
            <description>IDAC Regulation Code</description>
            <addressOffset>0x0C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>CURRENTIDACCODE</name>
                <description>Current IDAC Regulation Code</description>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
              <field>
                <name>GOODIDACCODE</name>
                <description>The IDAC Regulation Took Place, and the Current IDAC Code is a Good Code</description>
                <lsb>5</lsb>
                <msb>5</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>CLOCKQUALITY</name>
            <description>Clock quality indicator</description>
            <addressOffset>0x10</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>INDICATOR</name>
                <lsb>0</lsb>
                <msb>1</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NoStatus</name>
                    <description>XOSC32M has not started</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Starting</name>
                    <description>XOSC32M has started but has not yet reached the specified frequency tolerance requirement fTOL_HFXO</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Started</name>
                    <description>XOSC32M has started and is operating with the specified frequency tolerance requirement fTOL_HFXO</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <cluster>
            <name>CONFIG</name>
            <description>Unspecified</description>
            <headerStructName>OSCILLATORS_XOSC32M_CONFIG</headerStructName>
            <access>read-write</access>
            <addressOffset>0x14</addressOffset>
            <register>
              <name>INJECTMODEENABLE</name>
              <description>Enable injection mode for kickstarting the oscillator Do not use, place holder</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Enable injection mode</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Disable injection mode</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Enable injection mode</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>FSMFREEZE</name>
              <description>Freeze both Main FSM and IDAC FSM in the current mode (no inputs will change the FSM and this is used when requesting PIXO mode)</description>
              <addressOffset>0x04</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Enable FSM freeze</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Disable FSM freeze</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Enable FSM freeze</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>INTCAP</name>
              <description>Crystal load capacitor as seen by the crystal across its terminals, including pin capacitance but excluding PCB stray capacitance.</description>
              <addressOffset>0x08</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000020</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Crystal load capacitor value</description>
                  <lsb>0</lsb>
                  <msb>5</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>UPDATEIDACCODE</name>
              <description>Update IDAC code from APB (IDAC register).</description>
              <addressOffset>0x0C</addressOffset>
              <access>write-only</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>UPDATE</name>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Trigger</name>
                      <description>Trigger task.</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>TCFG</name>
              <description>Test configuration bits</description>
              <addressOffset>0x10</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>CAPCAL</name>
                  <description>Enable or disable capacitor calibration module</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable capacitor calibration module</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable capacitor calibration module</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>RESETCHARGECAP</name>
                  <description>Reset charge on capacitor within capacitor calibration module</description>
                  <lsb>1</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable reset charge</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Reset charge on capacitor</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>INVCAPCAL</name>
                  <description>Invert capacitor calibration comparator output</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NoInvert</name>
                      <description>No invert for capacitor calibration comparator output</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Invert</name>
                      <description>Invert capacitor calibration comparator output</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENPIXOVCOCALINTREF</name>
                  <description>Enable or disable PIXO VCO calibration comparator with internal reference voltage (resistive divider from VDD_ANA_0V9)</description>
                  <lsb>3</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable PIXO VCO calibration comparator</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable PIXO VCO calibration comparator</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENPIXOVCOCALEXT</name>
                  <description>Enable or disable PIXO VCO calibration comparator with external reference voltage (via ATB0)</description>
                  <lsb>4</lsb>
                  <msb>4</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable PIXO VCO calibration comparator</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable PIXO VCO calibration comparator</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>BYPASSRADIOCKFILTER</name>
                  <description>Disable sharp edges filtering (RC filter) on radio clock</description>
                  <lsb>5</lsb>
                  <msb>5</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Filter</name>
                      <description>RC filtered clock</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bypass</name>
                      <description>Bypass RC-filter</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENBIASCURRENTATB0</name>
                  <description>Enable 8 uA biasing current to ATB0 from internal biasing module</description>
                  <lsb>6</lsb>
                  <msb>6</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable 8 uA biasing current</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable 8 uA biasing current</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>AREGCURRENTATB0</name>
                  <description>Enable copy of AREG current to ATB0 (scaled down by x25)</description>
                  <lsb>7</lsb>
                  <msb>7</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable copy of AREG current to ATB0</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable copy of AREG current to ATB0</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENINTBIAS</name>
                  <description>TCFG bit to enable bias (bias is normally only enabled when Pierce, SIN2SQR or PKD is enabled. This bit gives additional control of bias)</description>
                  <lsb>8</lsb>
                  <msb>8</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable internal bias enabling</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable internal bias enabling</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DISABLECAPDIVIDERAREG</name>
                  <description>Enable or disable capacitive divider at AREG input when going to Pierce mode. This functionality will reduce start-up times in Pierce mode PKD will automatically disable the capacitive divider internally in AREG when PKD_OUT[1] goes high</description>
                  <lsb>9</lsb>
                  <msb>9</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable capacitive divider at AREG</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable capacitive divider at AREG</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ENMEASUREMENTCAPCALCURRENT</name>
                  <description>Enable or disable measurement of 2 uA CAP_CAL current</description>
                  <lsb>10</lsb>
                  <msb>10</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disable</name>
                      <description>Disable measurement of 2 uA CAP_CAL current</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enable</name>
                      <description>Enable measurement of 2 uA CAP_CAL current</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>ATB0CFG</name>
              <description>Analog testbus 0 configuration</description>
              <addressOffset>0x14</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ATB0CFG</name>
                  <lsb>0</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>HiZ0</name>
                      <description>Allow other IPs to use ATB0</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IbppAtb8u</name>
                      <description>8 uA bias generator test current</description>
                      <value>0x8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>VcoCalCmp</name>
                      <description>Force external reference voltage to PIXO VCO calibration comparator (instead of using internal reference). This gives possibility to compare VCTRL of PIXO VCO with externally applied voltage.</description>
                      <value>0x9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IbppCapCal2u</name>
                      <description>2 uA current used for capacitor calibration</description>
                      <value>0xA</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IbppAregCpy</name>
                      <description>Copy of AREG current (divided down by x25)</description>
                      <value>0xB</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>ATB1CFG</name>
              <description>Analog testbus 1 configuration</description>
              <addressOffset>0x18</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ATB1CFG</name>
                  <lsb>0</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>HiZ0</name>
                      <description>Allow other IPs to use ATB1</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>VddInt3V0</name>
                      <description>Measure internal 3V0 voltage on ATB1</description>
                      <value>0x8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Xosc32MPierce</name>
                      <description>Pierce clock on ATB1 for PN measurement in lab. Keep capacitance on ATB1 as low as possible for this measurement (maximum 30 pF)</description>
                      <value>0xB</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Xosc32MPixo</name>
                      <description>PIXO clock on ATB1 for PN measurement in lab. Keep capacitance on ATB1 as low as possible for this measurement (maximum 30 pF)</description>
                      <value>0xC</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>DTBCFG</name>
              <description>Digital Test Bus configuration</description>
              <addressOffset>0x1C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>PKDVCO</name>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Pkd123</name>
                      <description>Monitoring of amplitude regulation process</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Xosc32MReady</name>
                      <description>Divided version of version of output clock and READY. Clock is divided down to 4 MHz internally</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PixoVcoComp</name>
                      <description>Output from PIXO VCO calibration comparator and output from capacitor calibration comparator</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RdyPkd1Pkd2</name>
                      <description>READY, PKD_1 and PKD_2 on DTB makes it easier to measure start-up time in the lab since edge of READY can be used as reference start-point, while PKD outputs can be used as reference stop-points</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DTB0TOMUX</name>
                  <description>Connect DTB0 to internal MUX</description>
                  <lsb>2</lsb>
                  <msb>2</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disconnect</name>
                      <description>Disconnect from test bus</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Connect</name>
                      <description>Connect to test bus</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DTB1TOMUX</name>
                  <description>Connect DTB1 to internal MUX</description>
                  <lsb>3</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disconnect</name>
                      <description>Disconnect from test bus</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Connect</name>
                      <description>Connect to test bus</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DTB2TOMUX</name>
                  <description>Connect DTB2 to internal MUX</description>
                  <lsb>4</lsb>
                  <msb>4</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disconnect</name>
                      <description>Disconnect from test bus</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Connect</name>
                      <description>Connect to test bus</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>PIXODRIVER</name>
              <description>Second complement trim bus for PIXO drive strength</description>
              <addressOffset>0x20</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000001</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <lsb>0</lsb>
                  <msb>2</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>CALIBRATION</name>
            <description>Unspecified</description>
            <headerStructName>OSCILLATORS_XOSC32M_CALIBRATION</headerStructName>
            <access>read-write</access>
            <addressOffset>0x38</addressOffset>
            <register>
              <name>CAL1</name>
              <description>Calibration registers written from FICR</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x2A000010</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>BIAS</name>
                  <description>Second complement trim bus for bias generator</description>
                  <lsb>0</lsb>
                  <msb>3</msb>
                </field>
                <field>
                  <name>IDACREGULATIONTIMERSEL</name>
                  <description>Configure the IDAC regulation time constant 256*(1 + n) us</description>
                  <lsb>4</lsb>
                  <msb>6</msb>
                </field>
                <field>
                  <name>PIXOVCO</name>
                  <description>Second complement trim bus for PIXO VCO</description>
                  <lsb>7</lsb>
                  <msb>11</msb>
                </field>
                <field>
                  <name>PKD1</name>
                  <description>Second complement trim bus for first peak detector</description>
                  <lsb>12</lsb>
                  <msb>15</msb>
                </field>
                <field>
                  <name>PKD2</name>
                  <description>Second complement trim bus for second peak detector</description>
                  <lsb>16</lsb>
                  <msb>19</msb>
                </field>
                <field>
                  <name>PKD3</name>
                  <description>Second complement trim bus for third peak detector</description>
                  <lsb>20</lsb>
                  <msb>23</msb>
                </field>
                <field>
                  <name>IDACCODE</name>
                  <description>IDAC Configuration Value</description>
                  <lsb>24</lsb>
                  <msb>28</msb>
                </field>
                <field>
                  <name>IDACREGULATIONTIMEOUTSEL</name>
                  <description>Configure the number of IDAC Regulation attempts before stopping the regulation. Regulation attempts = 32*n attempts (attempts*IDACREGULATIONTIMERSEL us). The counter can be disabled with n=0</description>
                  <lsb>29</lsb>
                  <msb>30</msb>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>OVERRIDE</name>
            <description>Unspecified</description>
            <headerStructName>OSCILLATORS_XOSC32M_OVERRIDE</headerStructName>
            <access>read-write</access>
            <addressOffset>0x3C</addressOffset>
            <register>
              <name>PWRUPXOSC32M</name>
              <description>Override the PWRUP_XOSC32M signal in the analog module</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Override value</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                </field>
                <field>
                  <name>EN</name>
                  <description>Enable the override</description>
                  <lsb>31</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Override is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Override is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>PWRUPPIXO</name>
              <description>Override the XOSC32M_PIXO_PWRUP signal in the analog module</description>
              <addressOffset>0x04</addressOffset>
              <access>read-write</access>
