              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>PWRUPEXTLNABEFORERAMPUP</name>
              <description>In legacy timing mode, pwrupExtLna can be powered on before starting to ramp up by setting this registers to 1</description>
              <lsb>30</lsb>
              <msb>30</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AfterRampup</name>
                  <description>Power up external LNA at (RADIO_rampup_start_time + TPWRUPEXTLNA)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BeforeRampup</name>
                  <description>Power up external LNA at (RADIO_rampup_start_time - TPWRUPEXTLNA)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWRUPEXTPABEFORERAMPUP</name>
              <description>In legacy timing mode, pwrupExtPa can be powered on before starting to ramp up by setting this registers to 1</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AfterRampup</name>
                  <description>Power up external PA at (RADIO_rampup_start_time + TPWRUPEXTPA)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BeforeRampup</name>
                  <description>Power up external PA at (RADIO_rampup_start_time - TPWRUPEXTPA)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
