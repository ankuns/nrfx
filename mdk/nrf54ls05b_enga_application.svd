                <lsb>20</lsb>
                <msb>22</msb>
              </field>
              <field>
                <name>PREAMBLEEXTEND</name>
                <description>Extra bit to enable longer preambles. Length is PREAMBLEEXTEND,PCNF0.PLEN bytes + 8bits (or 4bits for LR and 15.4)</description>
                <lsb>23</lsb>
                <msb>23</msb>
              </field>
              <field>
                <name>ENDIAN</name>
