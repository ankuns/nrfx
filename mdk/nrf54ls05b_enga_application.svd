              <lsb>15</lsb>
              <msb>15</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MFB</name>
          <description>Matched Filter Bank (MFB) configuration</description>
          <addressOffset>0xB48</addressOffset>
          <access>read-write</access>
          <resetValue>0x00001C03</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>STRBOFFSET</name>
              <description>Override value for strobe offset</description>
              <lsb>0</lsb>
              <msb>2</msb>
