        <cluster>
          <name>VREGMAIN</name>
          <description>Register interface for main voltage regulator.</description>
          <headerStructName>REGULATORS_VREGMAIN</headerStructName>
          <access>read-write</access>
          <addressOffset>0x600</addressOffset>
          <register>
            <name>DCDCEN</name>
            <description>Enable DC/DC converter for better power efficiency</description>
            <addressOffset>0x00</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>VAL</name>
                <description>Enable DC/DC buck converter</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Disabled</name>
                    <description>Disable DC/DC converter and use LDO</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Enabled</name>
                    <description>Enable DC/DC converter</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>INDUCTORDET</name>
            <description>VREGMAIN inductor detection</description>
            <addressOffset>0x04</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>DETECTED</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>InductorNotDetected</name>
                    <description>VREGMAIN inductor not detected</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>InductorDetected</name>
                    <description>VREGMAIN inductor detected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>Voltage regulator status</description>
            <addressOffset>0x08</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MODE</name>
                <description>Current voltage regulator mode</description>
                <lsb>0</lsb>
                <msb>6</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Reset</name>
                    <description>Reset mode</description>
                    <value>0x01</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PfmLdo</name>
                    <description>Transition state between PFM to LDO</description>
                    <value>0x0B</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LdoPwm</name>
                    <description>Transition state between LDO and PWM</description>
                    <value>0x0D</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PfmPwm</name>
                    <description>Transition state between PFM to PWM</description>
                    <value>0x0E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PwmPfm</name>
                    <description>Transition state between PWM to PFM</description>
                    <value>0x2E</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>PFMICMPRUNNING</name>
            <description>Current PFM ICMP status</description>
            <addressOffset>0x0C</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>TIMERRUNNING</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NotRunning</name>
                    <description>PFM ICMP timer is not running</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Running</name>
                    <description>PFM ICMP timer is running</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>PFMICMPFLAG</name>
            <description>PFM ICMP has been triggered</description>
            <addressOffset>0x10</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PFMICMPFLAG</name>
                <lsb>0</lsb>
                <msb>0</msb>
                <modifiedWriteValues>oneToClear</modifiedWriteValues>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NotTriggered</name>
                    <description>PFM ICMP has not been triggered</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Triggered</name>
                    <description>PFM ICMP has been triggered</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>BUCKLSCOUNT</name>
            <description>Read counter output controlling low-side current threshold for PFM mode</description>
            <addressOffset>0x14</addressOffset>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>BUCKLSCOUNT</name>
                <lsb>0</lsb>
                <msb>4</msb>
              </field>
            </fields>
          </register>
          <cluster>
            <name>CONFIG</name>
            <description>Configure the MMI behavior</description>
            <headerStructName>REGULATORS_VREGMAIN_CONFIG</headerStructName>
            <access>read-write</access>
            <addressOffset>0x18</addressOffset>
            <register>
              <name>FORCEMODE</name>
              <description>Force the MMI into a certain mode. The Force Mode is NOT retained through SystemOff. If External mode is required through SystemOff, please refer to REQUESTEXTERNAL register.</description>
              <addressOffset>0x00</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Current voltage regulator mode</description>
                  <lsb>0</lsb>
                  <msb>1</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Ext</name>
                      <description>Force to external supply mode</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Ldo</name>
                      <description>Force to LDO mode</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Pfm</name>
                      <description>Force to PFM mode</description>
                      <value>0x2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Pwm</name>
                      <description>Force to PWM mode</description>
                      <value>0x3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>EN</name>
                  <description>Enable force mode for the regulator</description>
                  <lsb>31</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Force mode is disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>Force mode is enabled</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>REQUESTEXTERNAL</name>
              <description>Request external mode, and switch OFF the regulator This request is retain through SystemOff</description>
              <addressOffset>0x04</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Request external mode for the regulator</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>External mode is not requested</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Enabled</name>
                      <description>External mode is requested</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>VREGENLOAD</name>
              <description>Enable test load for P_LR0V9 pad</description>
              <addressOffset>0x08</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <description>Enable test load for P_LR0V9 pad</description>
                  <lsb>0</lsb>
                  <msb>0</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NormalOperation</name>
                      <description>No load</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TestLoad</name>
                      <description>88 Ohm test load, about 10mA load current at 0.9V</description>
                      <value>0x1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>BUCKSETLSCOUNTER</name>
              <description>Force the counter in the zero-cross detector to the set value for PFM mode. Setting MSB high (5) enables forcing using the first five bits (4:0). If MSB is low (5), the trim-code will be auto-calibrated in PFM with initial value 31.</description>
              <addressOffset>0x0C</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>BUCKSETLSCOUNTER</name>
                  <lsb>0</lsb>
                  <msb>5</msb>
                </field>
              </fields>
            </register>
            <register>
              <name>DEBUGCONTROL</name>
              <description>Analog module debug control signals</description>
              <addressOffset>0x10</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>VAL</name>
                  <lsb>0</lsb>
                  <msb>7</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Bit0</name>
                      <description>Force ELV mode.</description>
                      <value>0x01</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bit1</name>
                      <description>Force resistive feedback in FB_DIV and REF_DIV.</description>
                      <value>0x02</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bit2</name>
                      <description>Enable comparator in BUCK_LP_PFM to turn off high-side driver.</description>
                      <value>0x04</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bit3</name>
                      <description>Force PWM_ICMP low.</description>
                      <value>0x08</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bit4</name>
                      <description>Force PFM_ICMP low.</description>
                      <value>0x10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>Bit7</name>
                      <description>Disable counter counting PFM pulses during ELV exit.</description>
                      <value>0x80</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>ATB0CFG</name>
              <description>Analog testbus 0 configuration</description>
              <addressOffset>0x14</addressOffset>
              <access>read-write</access>
              <resetValue>0x00000000</resetValue>
              <size>0x20</size>
              <fields>
                <field>
                  <name>ATB0CFG</name>
                  <lsb>0</lsb>
                  <msb>3</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>HiZ</name>
                      <description>Allow other IPs to use ATB0</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>VregBg</name>
                      <description>VREG bandgap voltage</description>
                      <value>0x8</value>
                    </enumeratedValue>
                    <enumeratedValue>
