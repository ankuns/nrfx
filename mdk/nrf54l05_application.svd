                <lsb>4</lsb>
                <msb>7</msb>
              </field>
              <field>
                <name>OPSEL</name>
                <description>Select PKE operation with Isolated Key</description>
                <lsb>8</lsb>
                <msb>9</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PUBKEY</name>
