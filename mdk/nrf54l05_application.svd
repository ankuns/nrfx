              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>STTTIMEOUT</name>
              <description>Strobe time tracking: adjustment timeout (min distance in symbolperiods between strobe adjustments in same direction)</description>
              <lsb>16</lsb>
              <msb>23</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DRIFTLR</name>
          <description>Drift Controls in Long Range</description>
          <addressOffset>0xB78</addressOffset>
