    <peripheral>
      <name>GLOBAL_POWER_NS</name>
      <description>Power control 0</description>
      <baseAddress>0x4010E000</baseAddress>
      <alternatePeripheral>GLOBAL_CLOCK_NS</alternatePeripheral>
      <headerStructName>POWER</headerStructName>
      <!--Security dma=NA-->
      <!--Security securemapping=US-->
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
