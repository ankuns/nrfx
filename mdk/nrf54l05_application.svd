              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1MHz</name>
                  <description>1 MHz IF</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2MHz</name>
                  <description>2 MHz IF</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4MHz</name>
                  <description>4 MHz IF</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
