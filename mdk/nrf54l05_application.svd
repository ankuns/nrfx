            </field>
            <field>
              <name>STTTIMEOUTLR</name>
              <description>Strobe time tracking timeout in BLE LR mode</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>STTCNFG</name>
