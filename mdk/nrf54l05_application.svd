            <resetValue>0x01F72200</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>MAXOPSIZE</name>
                <description>Maximum operand size (number of bytes).</description>
                <lsb>0</lsb>
                <msb>11</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>NBMULT</name>
