              <msb>15</msb>
            </field>
            <field>
              <name>PNMIDSQUARED</name>
              <description>Squared value of Pn which can be used to find Mn associated with the last double correlator detect</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CNEARLYLATE</name>
          <description>The Cn value associated with the clock cycle before and after the actually double correlator peak was found (detect)</description>
          <addressOffset>0xB60</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CNEARLYSQUARED</name>
              <description>Squared value of Cn before the peak</description>
              <lsb>0</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>CNLATESQUARED</name>
              <description>Squared value of Cn after the peak</description>
              <lsb>16</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>MFBSTTCNFG</name>
          <description>Matched Filter Bank (MFB) symbol time tracking configuration</description>
          <addressOffset>0xB64</addressOffset>
          <access>read-write</access>
          <resetValue>0x00C87D5A</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>STTERRORTH</name>
              <description>Strobe time tracking: strobe time error threshold</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>STTTIMEOUT</name>
              <description>Period in bits where it is not allowed to set incStrb or decStrb</description>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>PAYLOADSIZE</name>
              <description>Minumum payload size for when STT is enabled</description>
              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>STTEN</name>
              <description>Enable for symbol time tracking logic in RxMFB.</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>RXAA</name>
          <description>32-bit Hyper Access Address as decoded; for 1M, 2M and 4M BLE and proprietary modes</description>
