              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>FSUNITRIGGERCALEN</name>
              <description>The fsUniTriggerCalEn signal when using manual control</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>FSUNITRIGGERSRC</name>
              <description>The fsUniTriggerCalSrc signal when using manual control</description>
              <lsb>8</lsb>
              <msb>14</msb>
            </field>
