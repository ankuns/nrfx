                    <value>0x0E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>StdHypAaBitsMux</name>
                    <description>Serial data+valid muxed stream Hyper, Standard and AA demodulators</description>
                    <value>0x0F</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FeDecIQ</name>
                    <description>Frontend IQ after decimation</description>
                    <value>0x10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FeMixIQ</name>
                    <description>Frontend IQ after decimation and downmix</description>
                    <value>0x12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AdPllTrace</name>
