        <register>
          <name>BOOTCONF</name>
          <description>Immutable boot region configuration.</description>
          <addressOffset>0x080</addressOffset>
          <access>read-writeonce</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>READ</name>
              <description>Read access. Must be enabled in order for the Arm Cortex CPU to start executing from RRAM.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotAllowed</name>
                  <description>Reading from the region is not allowed.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Allowed</name>
                  <description>Reading from the region is allowed</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WRITE</name>
              <description>Write access</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotAllowed</name>
