              <name>ELVLFXO</name>
              <description>Allow or prevent ELV mode when LFXO is ON</description>
              <lsb>20</lsb>
              <msb>20</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allow</name>
                  <description>Allow ELV mode when LFXO is ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Prevent</name>
                  <description>Prevent ELV mode when LFXO is ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ELVGRTC</name>
