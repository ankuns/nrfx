              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SUBSCRIBE_CONSTLAT</name>
          <description>Subscribe configuration for task CONSTLAT</description>
          <addressOffset>0xB0</addressOffset>
