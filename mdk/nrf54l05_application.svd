            <field>
              <name>ALPHA</name>
              <description>Alpha for IIR filter used in logMag calculation</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>SCALERDECAY</name>
              <description>The number of clock cycles to wait before stepping down the internal memory for the scaling. The value 0 means that the decay feature is off.</description>
              <lsb>8</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>SCALECONST</name>
              <description>A constant scaling that overrides dynamic scaling behaviour in the IQ Scaler. Value != 0 enables constant scaling.</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>SCALERMODE</name>
              <description>Mode for narrow scaling output.</description>
              <lsb>20</lsb>
              <msb>20</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Classic log based scaling mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>LUT based scaling mode.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SCALERWRAPPROTEN</name>
              <description>Wraparound protection in IQ Scaler.</description>
              <lsb>23</lsb>
              <msb>23</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable wraparound protection. Not recommended to disable with constant scaling.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Disable wraparound protection. Scaled input is set to max or min instead of wrapping around.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>QDISABLE</name>
              <description>Disable Q samples to save power</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
            <field>
              <name>INVERTI</name>
              <description>Invert I channel in case Q channel leads I</description>
              <lsb>28</lsb>
              <msb>28</msb>
            </field>
            <field>
              <name>SELINPUTMIX</name>
              <description>Mixer Input Select between Decimator's Output and Injection DMA, i.e., SELINPUTMIX = 0 for Decimator; SELINPUTMIX = 1 for Injection DMA</description>
              <lsb>29</lsb>
              <msb>29</msb>
            </field>
            <field>
              <name>SELINPUTCHAN</name>
              <description>Channel Filters Input Select between Mixer and Injection DMA, i.e., SELINPUTCHAN = 0 for Mixer; SELINPUTCHAN = 1 for Injection DMA</description>
              <lsb>30</lsb>
              <msb>30</msb>
            </field>
          </fields>
