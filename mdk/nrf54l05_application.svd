              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>RATE2M</name>
              <description>For modes with 2M on-air bit rate, unit: 1 bit period (Nrf_2Mbit/Ble_2Mbit/Ieee802154_250Kbit)</description>
              <lsb>4</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>RATE1M</name>
              <description>For modes with 1M on-air bit rate, unit: 1/2 bit period (Nrf_1Mbit/Ble_1Mbit/Ble_LR125Kbit/Ble_LR500Kbit)</description>
              <lsb>8</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>RATE250K</name>
              <description>For modes with 250k on-air bit rate, unit: 1/8 bit period (Nrf_250Kbit)</description>
              <lsb>12</lsb>
              <msb>14</msb>
            </field>
          </fields>
        </register>
