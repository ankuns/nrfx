              <enumeratedValues>
                <enumeratedValue>
                  <name>AfterRampup</name>
                  <description>Power up external PA at (RADIO_rampup_start_time + TPWRUPEXTPA)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BeforeRampup</name>
                  <description>Power up external PA at (RADIO_rampup_start_time - TPWRUPEXTPA)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
