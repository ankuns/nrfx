          <resetValue>0x0C8A0008</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>LOWTH</name>
              <description>Value for driftLowTh, drift estimator (hypermode)</description>
              <lsb>0</lsb>
              <msb>8</msb>
            </field>
            <field>
              <name>MAXDIST</name>
              <description>Value for driftMaxDist, drift estimator (hypermode)</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>DELAYTH</name>
              <description>Value for driftDelayTh, drift estimator (hypermode)</description>
              <lsb>20</lsb>
              <msb>28</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DSSS</name>
          <description>DSSS synchronizer trim values</description>
          <addressOffset>0xB84</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000202</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>PEAKDISTTOL</name>
              <description>Minimum tolerance of peak distance</description>
              <lsb>0</lsb>
              <msb>2</msb>
            </field>
            <field>
              <name>MINPEAKCOUNT</name>
              <description>Minimum number of peaks</description>
              <lsb>8</lsb>
              <msb>10</msb>
            </field>
            <field>
              <name>MINPEAKCOUNTSTRICT</name>
              <description>Min number of peaks to detect before resyncing to another preamble while already working on a previous preamble in BleLrx. Also applies for Ieee 802.15.4 mode</description>
              <lsb>16</lsb>
              <msb>18</msb>
            </field>
            <field>
              <name>ENCFOAVE</name>
              <description>Enable CFO averaging</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
            <field>
              <name>ENSTAVE</name>
              <description>Enable strobe time averaging</description>
              <lsb>25</lsb>
              <msb>25</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>AUTOCORR</name>
          <description>Autocorrelator configuration</description>
          <addressOffset>0xB88</addressOffset>
          <access>read-write</access>
          <resetValue>0x0007BD0F</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable autocorrelator gating of peaks.</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
            <field>
              <name>ADAPEN</name>
              <description>Enable adaptive autocorrelator threshold settings based on historically observed correlator output values.</description>
              <lsb>1</lsb>
              <msb>1</msb>
            </field>
            <field>
              <name>TH</name>
              <description>Default correlator threshold for deciding if valid correlator match is seen. Low setting of 0.10 is default.</description>
              <lsb>2</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>ADAPTH</name>
              <description>A ratio to update the autocorrelator ratio threshold when adaptive threshold is enabled and a strong peak is found. Fraction of highest correlator match historically seen. Setting of 0.8125 is default.</description>
              <lsb>7</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>ADAPDE</name>
              <description>A ratio to decay the autocorrelator ratio threshold when using adaptive threshold and a weak peak is found.</description>
              <lsb>12</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>ALPHA</name>
              <description>Gain factor for low pass filter used to smoothen autocorrelator output. Set to 0000 indicates to select Max filter instead of LPF.</description>
              <lsb>17</lsb>
              <msb>20</msb>
            </field>
            <field>
              <name>OFFS</name>
              <description>Offset for comparing between current and historical AC magnitude</description>
              <lsb>21</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>LRSYNC</name>
          <description>LrSyncEngine configuration</description>
          <addressOffset>0xB8C</addressOffset>
          <access>read-write</access>
          <resetValue>0x003D1DE0</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>MODE</name>
              <description>Modifying how the multiple lr125Front modules are used when synchronizing.</description>
              <lsb>0</lsb>
              <msb>3</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AllFrontends</name>
                  <description>Use all the front ends</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OneFrontend</name>
                  <description>Use only one front end</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>COUNTERLELRBLKECAC</name>
              <description>A counter is used to indicate the time window of e-CAC check. It counts the number of outputs from DeSpreadLELong and compares it with this configured value to see whether e-CAC result is valid.</description>
              <lsb>4</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>COUNTERREDUCTION</name>
              <description>When a strong peak event is triggered and the average peak strength is higher than the history stored in the block, the timeout counter is reduced by the number configured in this register. The default value is 7.</description>
              <lsb>10</lsb>
              <msb>13</msb>
            </field>
            <field>
              <name>COUNTERLELRBLKTO</name>
              <description>A counter is used to reset the LelrBlk125 block that is active. It counts the number of outputs from DeSpreadLELong and compares it with this configured value to see whether a timeout event happens. The range is 32 to 60. Default value is 52.</description>
              <lsb>14</lsb>
              <msb>18</msb>
            </field>
            <field>
              <name>POSSTARTTRACKER</name>
              <description>A toggle to tell when to start the trackers inside each LelrBlk125.</description>
              <lsb>19</lsb>
              <msb>20</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>disabled for all times</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EnabledAfterFec1</name>
                  <description>enabled after FEC1 is decoded</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EnabledAfterFrameSync</name>
                  <description>enabled after frame sync is achieved</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EnabledAfterLelrBlk125</name>
                  <description>enabled after LelrBlk125 is activated</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FSMODE</name>
              <description>Select between classic and MLSD based frame sync</description>
              <lsb>21</lsb>
              <msb>21</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Classic</name>
                  <description>classic mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mlsd</name>
                  <description>MLSD mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUTOCORROFFTIME</name>
              <description>Select when RxAutoCorr is turned off</description>
              <lsb>28</lsb>
              <msb>28</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>frameSync</name>
                  <description>Turn off after local frameSync to save power. Will be turned on before timeout to let samples propagate into RxAutoCorr so that output is ready at timeout</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>addressMatch</name>
                  <description>Override to turn off after addressMatch from outside RxSyncEngine. RxAutoCorr output is not used unless there is a timeout waiting for addressMatch</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE26</name>
          <description>Override for selecting whether to use LrSyncEngine or the classic demodulator.</description>
          <addressOffset>0xB90</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>USELRSYNCENGINE</name>
              <description>Select whether to use LrSyncEngine or the classic demodulator.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Classic</name>
                  <description>use classic demodulator</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LrSyncEngine</name>
                  <description>Use LrSyncEngine demodulator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>QOVERRIDE27</name>
          <description>Override for selecting whether to use enhanced IEEE 802.15.4 or the classic IEEE 802.15.4 demodulator.</description>
          <addressOffset>0xB94</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>USE154SYNCENGINE</name>
              <description>Select whether to use enhanced IEEE 802.15.4 or the classic IEEE 802.15.4 demodulator.</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Classic</name>
                  <description>Use classic demodulator</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ieee154SyncEngine</name>
                  <description>Use IEEE 802.15.4 sync demodulator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SFDMATCHRXSYNC154</name>
              <description>SFD match configuration in RxSyncEngine for improved IEEE 802.15.4</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Use SFD match from RxSyncEngine</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Override</name>
                  <description>Use SFD match from UTxRxChain</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RXSYNC</name>
          <description>RxSyncEngine configuration</description>
          <addressOffset>0xB98</addressOffset>
          <access>read-write</access>
          <resetValue>0x00006390</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ALPHAFREQ</name>
              <description>Coefficient to update frequency offset. Default value is 10000, corresponds to 1/2.</description>
              <lsb>0</lsb>
              <msb>4</msb>
            </field>
            <field>
              <name>BETAFREQ</name>
              <description>Coefficient to update frequency offset. Default value is 11100, corresponds to 7/8.</description>
              <lsb>5</lsb>
              <msb>9</msb>
            </field>
            <field>
              <name>PEAKTH</name>
              <description>Threshold value for peak strength. Default value is 0001100, corresponds to (0.31^2) scaled by 2^7 .</description>
              <lsb>10</lsb>
              <msb>16</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>TXCONFIG</name>
          <description>Tx configuration</description>
          <addressOffset>0xC00</addressOffset>
          <access>read-write</access>
          <resetValue>0x00005878</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CODEPOLY0</name>
              <description>Code polynomial 0</description>
              <lsb>0</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>CODEPOLY1</name>
              <description>Code polynomial 1</description>
              <lsb>8</lsb>
              <msb>14</msb>
            </field>
            <field>
              <name>LRSPREADSWAP</name>
              <description>Swap pattern mapping. Default 0, 0 is mapped to a 0011 sequence, 1 is mapped to a 1100 sequence. If swap bit is set, 1 is mapped to a 0011 sequence, 0 is mapped to a 1100 sequence.</description>
              <lsb>16</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>BYPASSPRECODE</name>
              <description>Bypass MSK precoding</description>
              <lsb>17</lsb>
              <msb>17</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NotBypassed</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bypassed</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IQMODENABLE</name>
              <description>Enable IQ modulator</description>
              <lsb>18</lsb>
              <msb>18</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INVERTPOLARITY</name>
              <description>Invert Tx polarity</description>
              <lsb>19</lsb>
              <msb>19</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
                  <description>Default</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverted</name>
                  <description>Inverted</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TXCTRL</name>
          <description>Tx control</description>
          <addressOffset>0xC04</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>BLELONGRANGE</name>
              <description>Enable Tx for BLE long range modes (Do not enable both Ieee802154_250Kbit and BLE long range)</description>
              <lsb>0</lsb>
              <msb>0</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable Tx for BLE long range modes</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable Tx for BLE long range modes</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IEEE802154</name>
              <description>Enable Tx for Ieee802154_250Kbit mode and long range modes (Do not enable both Ieee802154_250Kbit and long range)</description>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable Tx for Ieee802154_250Kbit mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable Tx for Ieee802154_250Kbit mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IQMODINDEX</name>
              <description>IQMOD modulation index</description>
              <lsb>8</lsb>
              <msb>10</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ModIndex0h25</name>
                  <description>Modulation index = 0.25(Future)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ModIndex0h32</name>
                  <description>Modulation index = 0.32(Future)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ModIndex0h5</name>
                  <description>Modulation index = 0.5(Future)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ModIndex1h0</name>
                  <description>Modulation index = 1(Future)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ModIndex2h0</name>
                  <description>Modulation index = 2(Future)</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IQMODBT</name>
              <description>IQMOD GFSK bandwidth</description>
              <lsb>16</lsb>
              <msb>17</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1BT00</name>
                  <description>BT=1.00</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0BT60</name>
                  <description>BT=0.60</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2BT00</name>
                  <description>BT=2.00</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0BT40</name>
                  <description>BT=0.40</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IQMODSYMBOL</name>
              <description>IQMOD additional symbol mapping not set by MODE(Future)</description>
              <lsb>20</lsb>
              <msb>22</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFEMODE</name>
          <description>Whether to use Angle-of-Arrival (AOA) or Angle-of-Departure (AOD)</description>
          <addressOffset>0xD00</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>DFEOPMODE</name>
              <description>Direction finding operation mode</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Direction finding mode disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AoD</name>
                  <description>Direction finding mode set to AoD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AoA</name>
                  <description>Direction finding mode set to AoA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DFESTATUS</name>
          <description>DFE status information</description>
          <addressOffset>0xD04</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SWITCHINGSTATE</name>
              <description>Internal state of switching state machine</description>
              <lsb>0</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>Switching state Idle</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Offset</name>
                  <description>Switching state Offset</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Guard</name>
                  <description>Switching state Guard</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ref</name>
                  <description>Switching state Ref</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Switching</name>
                  <description>Switching state Switching</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ending</name>
                  <description>Switching state Ending</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SAMPLINGSTATE</name>
              <description>Internal state of sampling state machine</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>Sampling state Idle</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Sampling</name>
                  <description>Sampling state Sampling</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL1</name>
          <description>Various configuration for Direction finding</description>
          <addressOffset>0xD10</addressOffset>
          <access>read-write</access>
          <resetValue>0x00023282</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>NUMBEROF8US</name>
              <description>Length of the AoA/AoD procedure in number of 8 us units</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>DFEINEXTENSION</name>
              <description>Add CTE extension and do antenna switching/sampling in this extension</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CRC</name>
                  <description>AoA/AoD procedure triggered at end of CRC</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Payload</name>
                  <description>Antenna switching/sampling is done in the packet payload</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSWITCHSPACING</name>
              <description>Interval between every time the antenna is changed in the SWITCHING state</description>
              <lsb>8</lsb>
              <msb>10</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8us</name>
                  <description>8us</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4us</name>
                  <description>4us</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2us</name>
                  <description>2us</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1us</name>
                  <description>1us</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>500ns</name>
                  <description>0.5us</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>250ns</name>
                  <description>0.25us</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TRIGGERWITHTASKONLY</name>
              <description>Trigger AoA/AoD procedure using only task</description>
              <lsb>11</lsb>
              <msb>11</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OnlyTask</name>
                  <description>Only allow triggering a procedure with TASKS_DFESTART</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Multiple</name>
                  <description>Trigger also with other signals</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSAMPLESPACINGREF</name>
              <description>Interval between samples in the REFERENCE period</description>
              <lsb>12</lsb>
              <msb>14</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8us</name>
                  <description>8us</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4us</name>
                  <description>4us</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2us</name>
                  <description>2us</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1us</name>
                  <description>1us</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>500ns</name>
                  <description>0.5us</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>250ns</name>
                  <description>0.25us</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>125ns</name>
                  <description>0.125us</description>
                  <value>0x6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SAMPLETYPE</name>
              <description>Whether to sample I/Q or magnitude/phase</description>
              <lsb>15</lsb>
              <msb>15</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IQ</name>
                  <description>Complex samples in I and Q</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MagPhase</name>
                  <description>Complex samples as magnitude and phase</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSAMPLESPACING</name>
              <description>Interval between samples in the SWITCHING period when CTEINLINECTRLEN is 0</description>
              <lsb>16</lsb>
              <msb>18</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4us</name>
                  <description>4us</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2us</name>
                  <description>2us</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1us</name>
                  <description>1us</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>500ns</name>
                  <description>0.5us</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>250ns</name>
                  <description>0.25us</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>125ns</name>
                  <description>0.125us</description>
                  <value>0x6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REPEATPATTERN</name>
              <description>Repeat every antenna pattern N times.</description>
              <lsb>20</lsb>
              <msb>23</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoRepeat</name>
                  <description>Do not repeat (1 time in total)</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AGCBACKOFFGAIN</name>
              <description>Gain will be lowered by the specified number of gain steps at the start of CTE</description>
              <lsb>24</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL2</name>
          <description>Start offset for Direction finding</description>
          <addressOffset>0xD14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>TSWITCHOFFSET</name>
              <description>Signed value offset after the end of the CRC before starting switching in number of 16M cycles</description>
              <lsb>0</lsb>
              <msb>12</msb>
            </field>
            <field>
              <name>TSAMPLEOFFSET</name>
              <description>Signed value offset before starting sampling in number of 16M cycles relative to the beginning of the REFERENCE state - 12 us after switching start</description>
              <lsb>16</lsb>
              <msb>27</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL3</name>
          <description>Various hacker/tuning configuration for Direction finding</description>
          <addressOffset>0xD18</addressOffset>
          <access>read-write</access>
          <resetValue>0x28433000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SPACINGBETWEEN</name>
              <description>Signed tuning value for the spacing between the last sample in the reference period and the first sample in the first sample slot</description>
              <lsb>0</lsb>
              <msb>5</msb>
            </field>
            <field>
              <name>SPACINGBETWEEN2US</name>
              <description>Same as SPACINGBETWEEN when using CTEINLINECTRL and CTEType is 2 us slots</description>
              <lsb>6</lsb>
              <msb>11</msb>
            </field>
            <field>
              <name>COMP4USSWITCHING</name>
              <description>Number of 4us periods to subtract from numberOf8us when calculating total number of antenna slots switches</description>
              <lsb>12</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>COMP4USSAMPLING</name>
              <description>Number of 4us periods to subtract from numberOf8us when calculating total number of samples to capture</description>
              <lsb>16</lsb>
              <msb>19</msb>
            </field>
            <field>
              <name>TGUARDPERIOD</name>
              <description>Length of GUARD period in number of microseconds, normally 4</description>
              <lsb>20</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>TREFPERIOD</name>
              <description>Length of REFERENCE period in number of microseconds, normally 8</description>
              <lsb>24</lsb>
              <msb>28</msb>
            </field>
            <field>
              <name>CHANGESAMPLERATE</name>
              <description>Whether to have the ability to have separate sampling rate in the REFERENCE period vs the SWITCHING state</description>
              <lsb>29</lsb>
              <msb>29</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Same</name>
                  <description>Always use sample spacing given by TSAMPLESPACINGREF</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Change</name>
                  <description>Use TSAMPLESPACINGREF in the REFERENCE period, and TSAMPLESPACING or CTEINLINEAODRXMODExUS in the SWITCHING period</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MIRRORSEQUENCE</name>
              <description>When reaching the last antenna pattern, it repeats that pattern, and then goes back down again.</description>
              <lsb>30</lsb>
              <msb>30</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Do not mirror the sequence</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Mirror the sequence</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SHORTENMIRRORSEQUENCE</name>
              <description>Applies only when MIRRORSEQUENCE is set. Selects whether to repeat the end pattern (in both ends) or not</description>
              <lsb>31</lsb>
              <msb>31</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>End patterns are repeated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>End patterns are not repeated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL4</name>
          <description>Various hacker/tuning configuration for Direction finding</description>
          <addressOffset>0xD1C</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFF7FF00</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SAMPLESTARTRELATIVETO</name>
              <description>Start point of TSAMPLEOFFSET sampling relative to which part in the switching state machine</description>
              <lsb>0</lsb>
              <msb>1</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reference</name>
                  <description>At the start of the reference antenna period</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Switching</name>
                  <description>At the start of antenna switching after the reference antenna period</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>When it is triggered Either TASKS_DFESTART, address match or AoA/AoD procedure trigger source</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Guard</name>
                  <description>At the start of the GUARD period</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNORE8USLENGTH</name>
              <description>Ignore the length specification in numberOf8us</description>
              <lsb>2</lsb>
              <msb>2</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DoNotIgnore</name>
                  <description>Use the length specification</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ignore</name>
                  <description>Ignore the length specification</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNOREMAXSPEC</name>
              <description>Ignore the maximum number of samples and antenna slots specified with MAXTOTALSAMPLES and MAXTOTALSLOTS</description>
              <lsb>3</lsb>
              <msb>3</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DoNotIgnore</name>
                  <description>Use the max specs</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ignore</name>
                  <description>Ignore the max specs</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWITCHBACKTOREF</name>
              <description>Insert reference antenna(SWITCHPATTERN[1]) between antenna switches, from SWITCHPATTERN[2] onwards</description>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Do not insert reference antenna between switches</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Insert reference antenna between switches</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IGNOREENDOFPACKET</name>
              <description>Ignore that the UTxRxChain says that the packet has been received Continue running if more time to run</description>
              <lsb>5</lsb>
              <msb>5</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DoNotIgnore</name>
                  <description>Do not ignore the end of packet</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ignore</name>
                  <description>Ignore the end of packet</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ONESAMPLEPERSLOT</name>
              <description>TSAMPLESPACING is ignored for the samples taken in the SWITCHING state TSAMPLESPACINGREF is still used for the first samples (REFERENCE period)</description>
              <lsb>6</lsb>
              <msb>6</msb>
            </field>
            <field>
              <name>DFECORREN</name>
              <description>Enable correlator before Direction Finding samples</description>
              <lsb>7</lsb>
              <msb>7</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Disable correlator</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable correlator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MAXTOTALSLOTS</name>
              <description>Maximum number of antenna slots</description>
              <lsb>8</lsb>
              <msb>18</msb>
            </field>
            <field>
              <name>RETURNTOREFATEND</name>
              <description>Start position of repeated part of switching pattern sequence</description>
              <lsb>19</lsb>
              <msb>19</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Return to SWITCHPATTERN[2] after reaching the end of the switching pattern sequence</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Return to SWITCHPATTERN[1] after reaching the end of the switching pattern sequence</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MAXTOTALSAMPLES</name>
              <description>Maximum number of samples to capture</description>
              <lsb>20</lsb>
              <msb>31</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DFECTRL5</name>
          <description>Various hacker/tuning configuration for Direction finding</description>
          <addressOffset>0xD20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SATURATIONMODE</name>
              <description>Set how input saturation will be present in the captured samples</description>
              <lsb>16</lsb>
              <msb>17</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Off</name>
                  <description>No saturation is presented</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SetMinVal</name>
                  <description>Saturation is marked by setting both I and Q to -32768 (or mag/phase if SAMPLETYPE is 1)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SaturationBit</name>
                  <description>Bit 15 of both the I and Q values indicates saturation. I and Q are hence only 15 bit values</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEVERIGNORESAT</name>
              <description>Selects whether saturation (being reported from the radio front-end) should be ignored in the beginning of the slot or not</description>
              <lsb>18</lsb>
              <msb>18</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Ignore</name>
                  <description>Saturation being indicated from the front-end is ignored if it happens in the first 40 percent of the sample spacing after a sample was saved to RAM</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NeverIgnore</name>
                  <description>Saturation is always reported in RAM if detected by the frontend</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DFEOFFSETSTDHYP</name>
              <description>Tuning of the timing difference between the hypermode demodulator and the standard demodulator for the DFE start event, in 62.5 ns units</description>
              <lsb>24</lsb>
              <msb>28</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>SWITCHPATTERN</name>
          <description>GPIO patterns to be used for each antenna</description>
          <addressOffset>0xD28</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>SWITCHPATTERN</name>
              <description>Fill array of GPIO patterns for antenna control</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>CLEARPATTERN</name>
          <description>Clear the GPIO pattern array for antenna control</description>
          <addressOffset>0xD2C</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>CLEARPATTERN</name>
              <description>Clear the GPIO pattern array for antenna control Behaves as a task register, but does not have PPI nor IRQ</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
          </fields>
        </register>
        <cluster>
          <name>PSEL</name>
          <description>Unspecified</description>
          <headerStructName>RADIO_PSEL</headerStructName>
          <access>read-write</access>
          <addressOffset>0xD30</addressOffset>
          <register>
            <dim>0x8</dim>
            <dimIncrement>0x4</dimIncrement>
            <name>DFEGPIO[%s]</name>
            <description>Description collection: Pin select for DFE pin n</description>
