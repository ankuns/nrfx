                  <name>KVCOBIAS192MHZ</name>
                  <description>KVCOBIAS for 192 MHz mode</description>
                  <lsb>20</lsb>
                  <msb>21</msb>
                </field>
                <field>
                  <name>TRIMCOMPENSATIONTHRESHOLD</name>
                  <description>Threshold for enabling trim compenastion. Trim compensation actived when measured cycles are below the threshold.</description>
                  <lsb>24</lsb>
                  <msb>27</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>T132</name>
                      <description>Threshold at 132 cycles (~0.75  percent)</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T131</name>
                      <description>Threshold at 131 cycles (~1.5  percent)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T117</name>
                      <description>Threshold at 117 cycles (~12  percent)</description>
                      <value>0xF</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TRIMCOMPENSATIONVALUE</name>
                  <description>Trim compensation when deviation larger than TRIMCOMPENSATIONTHRESHOLD is detected.</description>
                  <lsb>28</lsb>
                  <msb>30</msb>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>Disabled</name>
                      <description>Trim compensation disabled</description>
                      <value>0x0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T1</name>
                      <description>Compensate with 1 trim step (~1.5  percent)</description>
                      <value>0x1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>T7</name>
                      <description>Compensate with 7 trim step (~10.5  percent)</description>
                      <value>0x7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CLOCKREQFILTERDISABLE</name>
                  <description>Disable clock request filter</description>
                  <lsb>31</lsb>
                  <msb>31</msb>
                  <enumeratedValues>
                    <enumeratedValue>
