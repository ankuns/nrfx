              <lsb>16</lsb>
              <msb>23</msb>
            </field>
            <field>
              <name>ADDRTIMEOUT</name>
              <description>Override value for address match timeout, [in bit periods] (hypermode). 0 means no timeout. If BALEN is 3, the actual value of DBCADDRTIMEOUT will be the value written to this register minus 8.</description>
              <lsb>24</lsb>
              <msb>31</msb>
            </field>
