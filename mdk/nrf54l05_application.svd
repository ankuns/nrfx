            </field>
          </fields>
        </register>
        <register>
          <name>DRIFT1</name>
          <description>Drift Estimator configuration</description>
          <addressOffset>0xB7C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00002820</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ALPHA</name>
              <description>Value for IIR feedback , drift estimator (hypermode)</description>
              <lsb>0</lsb>
              <msb>7</msb>
            </field>
            <field>
              <name>VALIDTH</name>
              <description>Value for driftValidTh, drift estimator (hypermode)</description>
              <lsb>8</lsb>
              <msb>16</msb>
            </field>
            <field>
              <name>SATENABLEALWAYS</name>
              <description>Enable saturation in drift calculator for all modes</description>
              <lsb>24</lsb>
              <msb>24</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>DRIFT2</name>
          <description>Drift Estimator configuration</description>
          <addressOffset>0xB80</addressOffset>
