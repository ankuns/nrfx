          <addressOffset>0x0820</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <size>0x20</size>
          <fields>
            <field>
              <name>ENABLEMANUAL</name>
              <description>Enable manual control</description>
              <lsb>0</lsb>
              <msb>0</msb>
            </field>
