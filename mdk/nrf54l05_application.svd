                <lsb>0</lsb>
                <msb>9</msb>
              </field>
              <field>
                <name>BITERROR2</name>
                <description>Bit position of second error</description>
                <lsb>16</lsb>
                <msb>25</msb>
              </field>
            </fields>
          </register>
          <register>
            <name>RAMERRORSTATUS</name>
            <description>RAM error status register.</description>
            <addressOffset>0x044</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>RAMCORRECTION</name>
                <description>This bit indicates that a 1-bit error has been detected and corrected on RAM interface</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>read-only</access>
              </field>
              <field>
                <name>RAMFAILURE</name>
                <description>This bit indicates that an uncorrectable error has been detected on the data RAM interface</description>
                <lsb>1</lsb>
                <msb>1</msb>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>IKG</name>
          <description>Unspecified</description>
          <headerStructName>CRACENCORE_IKG</headerStructName>
          <access>read-write</access>
          <addressOffset>0x3000</addressOffset>
          <register>
            <name>START</name>
            <description>Start register.</description>
            <addressOffset>0x000</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>START</name>
                <description>Start the Isolated Key Generation.</description>
                <lsb>0</lsb>
                <msb>0</msb>
                <access>write-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>Status register.</description>
            <addressOffset>0x004</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>SEEDERROR</name>
