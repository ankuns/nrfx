                <name>PALL</name>
                <lsb>0</lsb>
                <msb>31</msb>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Unprotected</name>
                    <description>Unprotected, TAMPC is locked for all other values than Unprotected.</description>
                    <value>0x50FA50FA</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>PROTECT1</name>
            <description>Description cluster: DFT enable register</description>
            <addressOffset>0x01C</addressOffset>
            <access>read-writeonce</access>
            <resetValue>0xFFFFFFFF</resetValue>
            <size>0x20</size>
            <fields>
              <field>
                <name>PALL</name>
