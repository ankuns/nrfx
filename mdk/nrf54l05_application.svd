                <enumeratedValue>
                  <name>Adjust</name>
                  <description>AGC gain settings will keep adjusting during CTE</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Freeze</name>
                  <description>AGC gain settings will freeze (not keep adjusting) during CTE</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PHYENDTXDELAY</name>
          <description>Configurable delay of PHYEND event for TX, separate values per on-air bit rate, maximum supported value is 3.5us (unit: 0.5us)</description>
          <addressOffset>0x518</addressOffset>
