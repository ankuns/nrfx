                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Conservative</name>
                  <description>Request helper mode when PLL HF output or PD_MCU are requested.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
