                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Enable</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AGCFREEZEAFTERREF</name>
              <lsb>1</lsb>
              <msb>1</msb>
              <enumeratedValues>
