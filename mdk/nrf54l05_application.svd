              <lsb>21</lsb>
              <msb>21</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allow</name>
                  <description>Allow ELV mode when GRTC core is active</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Prevent</name>
                  <description>Prevent ELV mode when GRTC core is active</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ELVGRTCPWM</name>
              <description>Allow or prevent ELV mode when GRTC PWM is active</description>
              <lsb>22</lsb>
              <msb>22</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allow</name>
                  <description>Allow ELV mode when GRTC PWM is active</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Prevent</name>
                  <description>Prevent ELV mode when GRTC PWM is active</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ELVGRTCCLKOUT</name>
              <description>Allow or prevent ELV mode when GRTC CKOUT is active</description>
              <lsb>23</lsb>
              <msb>23</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allow</name>
                  <description>Allow ELV mode when GRTC CKOUT is active</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Prevent</name>
                  <description>Prevent ELV mode when GRTC CKOUT is active</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PFMHELPERCONFIG</name>
              <description>Condition for enabling PFM helper mode</description>
              <lsb>24</lsb>
              <msb>24</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Default</name>
